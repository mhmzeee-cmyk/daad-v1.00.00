// ═══════════════════════════════════════════════════════════════
// مدير مهام — بلغة ض
// إضافة / عرض / إنجاز / حذف المهام + إحصائية
// ═══════════════════════════════════════════════════════════════

نص المهام = [] ؛
صحيح الحالات = [] ؛
صحيح العدد = 0 ؛
صحيح i = 0 ؛
صحيح j = 0 ؛
صحيح منجزة = 0 ؛

// ── إضافة 3 مهام ──
نص أ = "مراجعة الدروس" ؛
نص ب = "تمارين رياضة" ؛
نص ج = "قراءة كتاب" ؛
أضف(المهام, أ) ؛
أضف(الحالات, 0) ؛
أضف(المهام, ب) ؛
أضف(الحالات, 0) ؛
أضف(المهام, ج) ؛
أضف(الحالات, 0) ؛
العدد = 3 ؛
طباعة("تمت إضافة 3 مهام") ؛

// ── عرض الكل ──
طباعة("===== قائمة المهام =====") ؛
i = 0 ؛
طالما(i < العدد) {
    طباعة(i) ؛
    طباعة(" - ") ؛
    طباعة(المهام[i]) ؛
    إذا(الحالات[i] == 1) {
        طباعة(" [منجزة]") ؛
    }
    إذا(الحالات[i] == 0) {
        طباعة(" [جديدة]") ؛
    }
    i = i + 1 ؛
}

// ── إنجاز المهمة رقم 1 ──
الحالات[1] = 1 ؛
طباعة("أنجزت المهمة: ") ؛
طباعة(المهام[1]) ؛

// ── عرض بعد الإنجاز ──
طباعة("===== بعد الإنجاز =====") ؛
i = 0 ؛
طالما(i < العدد) {
    طباعة(i) ؛
    طباعة(" - ") ؛
    طباعة(المهام[i]) ؛
    إذا(الحالات[i] == 1) {
        طباعة(" [منجزة]") ؛
    }
    إذا(الحالات[i] == 0) {
        طباعة(" [جديدة]") ؛
    }
    i = i + 1 ؛
}

// ── حذف المهمة رقم 0 (إزاحة لليسار) ──
طباعة("حذفت المهمة: ") ؛
طباعة(المهام[0]) ؛
j = 0 ؛
طالما(j < العدد - 1) {
    المهام[j] = المهام[j + 1] ؛
    الحالات[j] = الحالات[j + 1] ؛
    j = j + 1 ؛
}
احذف_من(الحالات, العدد - 1) ؛
العدد = العدد - 1 ؛

// ── العرض الأخير + إحصائية ──
طباعة("===== القائمة النهائية =====") ؛
i = 0 ؛
طالما(i < العدد) {
    طباعة(i) ؛
    طباعة(" - ") ؛
    طباعة(المهام[i]) ؛
    إذا(الحالات[i] == 1) {
        طباعة(" [منجزة]") ؛
        منجزة = منجزة + 1 ؛
    }
    إذا(الحالات[i] == 0) {
        طباعة(" [جديدة]") ؛
    }
    i = i + 1 ؛
}
طباعة("المتبقي: ") ؛
طباعة(العدد) ؛
طباعة("المنجزة: ") ؛
طباعة(منجزة) ؛
