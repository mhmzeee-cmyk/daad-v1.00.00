// ═══════════════════════════════════════════════════════════════════════════════
// حاسبة (ض) — Scientific Calculator in Dhad Language
// ═══════════════════════════════════════════════════════════════════════════════

// ── 1. Functions for Basic Operations ─────────────────────────────────────────

دالة جمع( صحيح أ, صحيح ب ) -> صحيح {
    ارجع أ + ب ؛
}

دالة طرح( صحيح أ, صحيح ب ) -> صحيح {
    ارجع أ - ب ؛
}

دالة ضرب( صحيح أ, صحيح ب ) -> صحيح {
    ارجع أ * ب ؛
}

دالة قسمة( صحيح أ, صحيح ب ) -> صحيح {
    إذا ( ب == 0 ) {
        طباعة( "خطأ: القسمة على صفر!" ) ؛
        ارجع 0 ؛
    }
    ارجع أ / ب ؛
}

دالة باقي( صحيح أ, صحيح ب ) -> صحيح {
    إذا ( ب == 0 ) {
        طباعة( "خطأ: القسمة على صفر!" ) ؛
        ارجع 0 ؛
    }
    ارجع أ % ب ؛
}

// ── 2. Advanced Math Functions ────────────────────────────────────────────────

دالة قوة( صحيح أس, صحيح أ ) -> صحيح {
    صحيح نتيجة = 1 ؛
    صحيح ع = 0 ؛
    لكل ( ع = 0 ؛ ع < أس ؛ ع = ع + 1 ) {
        نتيجة = نتيجة * أ ؛
    }
    ارجع نتيجة ؛
}

دالة قيمة_مطلقة( صحيح أ ) -> صحيح {
    إذا ( أ < 0 ) {
        ارجع -أ ؛
    }
    ارجع أ ؛
}

دالة صفر_و_أكبر( صحيح أ, صحيح ب ) -> صحيح {
    إذا ( أ > ب ) {
        ارجع أ ؛
    }
    ارجع ب ؛
}

دالة أصغر_و_صفر( صحيح أ, صحيح ب ) -> صحيح {
    إذا ( أ < ب ) {
        ارجع أ ؛
    }
    ارجع ب ؛
}

// ── 3. Calculator Operations ──────────────────────────────────────────────────

طباعة( "═══ اختبارات الحاسبة ═══" ) ؛

// Basic Operations
صحيح س1 = 10 ؛
صحيح س2 = 5 ؛

طباعة( "العمليات الأساسية:" ) ؛
صحيح نتيجة1 = جمع( س1, س2 ) ؛
طباعة( "10 + 5 = ", نتيجة1 ) ؛

صحيح نتيجة2 = طرح( س1, س2 ) ؛
طباعة( "10 - 5 = ", نتيجة2 ) ؛

صحيح نتيجة3 = ضرب( س1, س2 ) ؛
طباعة( "10 * 5 = ", نتيجة3 ) ؛

صحيح نتيجة4 = قسمة( س1, س2 ) ؛
طباعة( "10 / 5 = ", نتيجة4 ) ؛

صحيح نتيجة5 = باقي( س1, س2 ) ؛
طباعة( "10 % 5 = ", نتيجة5 ) ؛

// Power
صحيح نتيجة6 = قوة( 3, 2 ) ؛
طباعة( "2^3 = ", نتيجة6 ) ؛

صحيح نتيجة7 = قوة( 4, 2 ) ؛
طباعة( "2^4 = ", نتيجة7 ) ؛

// Absolute Value
صحيح نتيجة8 = قيمة_مطلقة( -15 ) ؛
طباعة( "|-15| = ", نتيجة8 ) ؛

// Min/Max
صحيح نتيجة9 = صفر_و_أكبر( 7, 12 ) ؛
طباعة( "max(7, 12) = ", نتيجة9 ) ؛

صحيح نتيجة10 = أصغر_و_صفر( 7, 12 ) ؛
طباعة( "min(7, 12) = ", نتيجة10 ) ؛

// ── 4. Division by Zero Test ──────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "اختبار القسمة على صفر:" ) ؛
صحيح نتيجة11 = قسمة( 10, 0 ) ؛

// ── 5. Complex Expression Test ────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "تعبيرات معقدة:" ) ؛

صحيح أ = 2 ؛
صحيح ب = 3 ؛
صحيح ج = 4 ؛

صحيح نتيجة12 = ( أ + ب ) * ج ؛
طباعة( "(2 + 3) * 4 = ", نتيجة12 ) ؛

صحيح نتيجة13 = أ + ب * ج ؛
طباعة( "2 + 3 * 4 = ", نتيجة13 ) ؛

صحيح نتيجة14 = قوة( ب, أ ) + ج ؛
طباعة( "2^3 + 4 = ", نتيجة14 ) ؛

// ── 6. Loop Calculator - Multiplication Table ────────────────────────────────

طباعة( "" ) ؛
طباعة( "جدول الضرب:" ) ؛

صحيح جدول = 5 ؛
صحيح ع = 1 ؛
لكل ( ع = 1 ؛ ع <= 10 ؛ ع = ع + 1 ) {
    صحيح نتيجة = ضرب( جدول, ع ) ؛
    طباعة( جدول, " × ", ع, " = ", نتيجة ) ؛
}

// ── 7. Factorial (Using While Loop) ───────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "المضروب:" ) ؛

صحيح عدد = 5 ؛
صحيح مضروب = 1 ؛
صحيح ع = عدد ؛
طالما ( ع > 0 ) {
    مضروب = مضروب * ع ؛
    ع = ع - 1 ؛
}
طباعة( "5! = ", مضروب ) ؛

// ── 8. Fibonacci (Using For Loop) ─────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "تسلسل فيبوناتشي:" ) ؛

صحيح فيب1 = 0 ؛
صحيح فيب2 = 1 ؛
صحيح عدد_الحدود = 10 ؛
صحيح ع = 0 ؛
صحيح عداد = 0 ؛
لكل ( عداد = 0 ؛ عداد < عدد_الحدود ؛ عداد = عداد + 1 ) {
    إذا ( عداد == 0 ) {
        طباعة( فيب1 ) ؛
    } وإلا {
        إذا ( عداد == 1 ) {
            طباعة( فيب2 ) ؛
        } وإلا {
            صحيح فيب_جديد = فيب1 + فيب2 ؛
            طباعة( فيب_جديد ) ؛
            فيب1 = فيب2 ؛
            فيب2 = فيب_جديد ؛
        }
    }
}

// ── 9. GCD (Greatest Common Divisor) ─────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "القاسم المشترك الأكبر:" ) ؛

دالة قاسم_مشترك( صحيح أ, صحيح ب ) -> صحيح {
    طالما ( ب != 0 ) {
        صحيح مؤقت = ب ؛
        ب = أ % ب ؛
        أ = مؤقت ؛
    }
    ارجع أ ؛
}

صحيح نتيجة15 = قاسم_مشترك( 48, 18 ) ؛
طباعة( "GCD(48, 18) = ", نتيجة15 ) ؛

// ── 10. Switch Calculator ─────────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "الحاسبة باستخدام اختر:" ) ؛

صحيح عملية = 2 ؛
صحيح عامل1 = 10 ؛
صحيح عامل2 = 3 ؛
صحيح نتيجة = 0 ؛

اختر( عملية ) {
    حالة 1: {
        نتيجة = جمع( عامل1, عامل2 ) ؛
        طباعة( "10 + 3 = ", نتيجة ) ؛
        توقف ؛
    }
    حالة 2: {
        نتيجة = طرح( عامل1, عامل2 ) ؛
        طباعة( "10 - 3 = ", نتيجة ) ؛
        توقف ؛
    }
    حالة 3: {
        نتيجة = ضرب( عامل1, عامل2 ) ؛
        طباعة( "10 * 3 = ", نتيجة ) ؛
        توقف ؛
    }
    حالة 4: {
        نتيجة = قسمة( عامل1, عامل2 ) ؛
        طباعة( "10 / 3 = ", نتيجة ) ؛
        توقف ؛
    }
    افتراضي: {
        طباعة( "عملية غير معروفة" ) ؛
    }
}

// ── Final Summary ─────────────────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "═══ انتهت الاختبارات ═══" ) ؛
