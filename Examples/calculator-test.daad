// اختبارات الحاسبة — Calculator Test Cases
// ═══════════════════════════════════════════════════════════════════════════════

// ── Helper Functions ──────────────────────────────────────────────────────────

دالة مقارنة( صحيح أ, صحيح ب ) -> صحيح {
    إذا ( أ == ب ) {
        ارجع 1 ؛  // صواب
    }
    ارجع 0 ؛  // خطأ
}

// ── Test 1: Basic Addition ────────────────────────────────────────────────────

طباعة( "═══ اختبار 1: الجمع ═══" ) ؛
صحيح ن1 = مقارنة( 2 + 3, 5 ) ؛
طباعة( "2 + 3 == 5: ", ن1 ) ؛

صحيح ن2 = مقارنة( 10 + 20, 30 ) ؛
طباعة( "10 + 20 == 30: ", ن2 ) ؛

صحيح ن3 = مقارنة( 0 + 0, 0 ) ؛
طباعة( "0 + 0 == 0: ", ن3 ) ؛

// ── Test 2: Basic Subtraction ────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "═══ اختبار 2: الطرح ═══" ) ؛
صحيح ن4 = مقارنة( 10 - 3, 7 ) ؛
طباعة( "10 - 3 == 7: ", ن4 ) ؛

صحيح ن5 = مقارنة( 5 - 5, 0 ) ؛
طباعة( "5 - 5 == 0: ", ن5 ) ؛

// ── Test 3: Basic Multiplication ─────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "═══ اختبار 3: الضرب ═══" ) ؛
صحيح ن6 = مقارنة( 4 * 5, 20 ) ؛
طباعة( "4 * 5 == 20: ", ن6 ) ؛

صحيح ن7 = مقارنة( 7 * 0, 0 ) ؛
طباعة( "7 * 0 == 0: ", ن7 ) ؛

// ── Test 4: Basic Division ───────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "═══ اختبار 4: القسمة ═══" ) ؛
صحيح ن8 = مقارنة( 20 / 4, 5 ) ؛
طباعة( "20 / 4 == 5: ", ن8 ) ؛

صحيح ن9 = مقارنة( 15 / 3, 5 ) ؛
طباعة( "15 / 3 == 5: ", ن9 ) ؛

// ── Test 5: Modulo ───────────────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "═══ اختبار 5: باقي القسمة ═══" ) ؛
صحيح ن10 = مقارنة( 10 % 3, 1 ) ؛
طباعة( "10 % 3 == 1: ", ن10 ) ؛

صحيح ن11 = مقارنة( 10 % 2, 0 ) ؛
طباعة( "10 % 2 == 0: ", ن11 ) ؛

// ── Test 6: Power Function ───────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "═══ اختبار 6: الأس ═══" ) ؛

دالة قوة( صحيح أس, صحيح أ ) -> صحيح {
    صحيح نتيجة = 1 ؛
    صحيح ع = 0 ؛
    لكل ( ع = 0 ؛ ع < أس ؛ ع = ع + 1 ) {
        نتيجة = نتيجة * أ ؛
    }
    ارجع نتيجة ؛
}

صحيح ن12 = مقارنة( قوة( 3, 2 ), 8 ) ؛
طباعة( "2^3 == 8: ", ن12 ) ؛

صحيح ن13 = مقارنة( قوة( 0, 5 ), 1 ) ؛
طباعة( "5^0 == 1: ", ن13 ) ؛

صحيح ن14 = مقارنة( قوة( 1, 100 ), 100 ) ؛
طباعة( "100^1 == 100: ", ن14 ) ؛

// ── Test 7: Absolute Value ───────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "═══ اختبار 7: القيمة المطلقة ═══" ) ؛

دالة قيمة_مطلقة( صحيح أ ) -> صحيح {
    إذا ( أ < 0 ) {
        ارجع -أ ؛
    }
    ارجع أ ؛
}

صحيح ن15 = مقارنة( قيمة_مطلقة( -10 ), 10 ) ؛
طباعة( "|-10| == 10: ", ن15 ) ؛

صحيح ن16 = مقارنة( قيمة_مطلقة( 10 ), 10 ) ؛
طباعة( "|10| == 10: ", ن16 ) ؛

// ── Test 8: Min/Max ──────────────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "═══ اختبار 8: الأصغر/الأكبر ═══" ) ؛

دالة أصغر( صحيح أ, صحيح ب ) -> صحيح {
    إذا ( أ < ب ) {
        ارجع أ ؛
    }
    ارجع ب ؛
}

دالة أكبر( صحيح أ, صحيح ب ) -> صحيح {
    إذا ( أ > ب ) {
        ارجع أ ؛
    }
    ارجع ب ؛
}

صحيح ن17 = مقارنة( أصغر( 5, 10 ), 5 ) ؛
طباعة( "min(5, 10) == 5: ", ن17 ) ؛

صحيح ن18 = مقارنة( أكبر( 5, 10 ), 10 ) ؛
طباعة( "max(5, 10) == 10: ", ن18 ) ؛

// ── Test 9: Division by Zero ─────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "═══ اختبار 9: القسمة على صفر ═══" ) ؛

دالة قسمة_آمنة( صحيح أ, صحيح ب ) -> صحيح {
    إذا ( ب == 0 ) {
        ارجع -1 ؛  // رمز للخطأ
    }
    ارجع أ / ب ؛
}

صحيح ن19 = مقارنة( قسمة_آمنة( 10, 0 ), -1 ) ؛
طباعة( "10 / 0 == error: ", ن19 ) ؛

// ── Test 10: Complex Expressions ─────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "═══ اختبار 10: تعبيرات معقدة ═══" ) ؛

صحيح ن20 = مقارنة( ( 2 + 3 ) * 4, 20 ) ؛
طباعة( "(2 + 3) * 4 == 20: ", ن20 ) ؛

صحيح ن21 = مقارنة( 2 + 3 * 4, 14 ) ؛
طباعة( "2 + 3 * 4 == 14: ", ن21 ) ؛

صحيح ن22 = مقارنة( 10 - 2 * 3, 4 ) ؛
طباعة( "10 - 2 * 3 == 4: ", ن22 ) ؛

// ── Test 11: Loop - Factorial ────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "═══ اختبار 11: المضروب ═══" ) ؛

دالة مضروب( صحيح n ) -> صحيح {
    صحيح نتيجة = 1 ؛
    صحيح ع = n ؛
    طالما ( ع > 0 ) {
        نتيجة = نتيجة * ع ؛
        ع = ع - 1 ؛
    }
    ارجع نتيجة ؛
}

صحيح ن23 = مقارنة( مضروب( 5 ), 120 ) ؛
طباعة( "5! == 120: ", ن23 ) ؛

صحيح ن24 = مقارنة( مضروب( 0 ), 1 ) ؛
طباعة( "0! == 1: ", ن24 ) ؛

صحيح ن25 = مقارنة( مضروب( 1 ), 1 ) ؛
طباعة( "1! == 1: ", ن25 ) ؛

// ── Test 12: Loop - Fibonacci ────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "═══ اختبار 12: فيبوناتشي ═══" ) ؛

دالة فيبوناتشي( صحيح n ) -> صحيح {
    إذا ( n == 0 ) {
        ارجع 0 ؛
    }
    إذا ( n == 1 ) {
        ارجع 1 ؛
    }
    صحيح أ = 0 ؛
    صحيح ب = 1 ؛
    صحيح ع = 2 ؛
    صحيح ج = 0 ؛
    لكل ( ع = 2 ؛ ع <= n ؛ ع = ع + 1 ) {
        ج = أ + ب ؛
        أ = ب ؛
        ب = ج ؛
    }
    ارجع ج ؛
}

صحيح ن26 = مقارنة( فيبوناتشي( 0 ), 0 ) ؛
طباعة( "fib(0) == 0: ", ن26 ) ؛

صحيح ن27 = مقارنة( فيبوناتشي( 1 ), 1 ) ؛
طباعة( "fib(1) == 1: ", ن27 ) ؛

صحيح ن28 = مقارنة( فيبوناتشي( 10 ), 55 ) ؛
طباعة( "fib(10) == 55: ", ن28 ) ؛

// ── Test 13: GCD ─────────────────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "═══ اختبار 13: القاسم المشترك الأكبر ═══" ) ؛

دالة قاسم_مشترك( صحيح أ, صحيح ب ) -> صحيح {
    طالما ( ب != 0 ) {
        صحيح مؤقت = ب ؛
        ب = أ % ب ؛
        أ = مؤقت ؛
    }
    ارجع أ ؛
}

صحيح ن29 = مقارنة( قاسم_مشترك( 48, 18 ), 6 ) ؛
طباعة( "GCD(48, 18) == 6: ", ن29 ) ؛

صحيح ن30 = مقارنة( قاسم_مشترك( 100, 25 ), 25 ) ؛
طباعة( "GCD(100, 25) == 25: ", ن30 ) ؛

// ── Test 14: Switch Statement ────────────────────────────────────────────────

طباعة( "" ) ؛
طباعة( "═══ اختبار 14: اختر ═══" ) ؛

صحيح عملية = 3 ؛
صحيح نتيجة = 0 ؛
اختر( عملية ) {
    حالة 1: { نتيجة = 10 ؛ توقف ؛ }
    حالة 2: { نتيجة = 20 ؛ توقف ؛ }
    حالة 3: { نتيجة = 30 ؛ توقف ؛ }
    افتراضي: { نتيجة = 0 ؛ }
}

صحيح ن31 = مقارنة( نتيجة, 30 ) ؛
طباعة( "switch(3) == 30: ", ن31 ) ؛

