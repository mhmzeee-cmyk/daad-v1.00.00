// البرنامج 6: المضروب factorial
// حساب مضروب عدد باستخدام الدوال

دالة مضروب(صحيح ن) -> صحيح {
    صحيح نتيجة = 1 ؛
    لكل(صحيح i = 1; i <= ن; i = i + 1) {
        نتيجة *= i ؛
    }
    ارجع نتيجة ؛
}

دالة مجموع(صحيح ن) -> صحيح {
    صحيح م = 0 ؛
    لكل(صحيح i = 1; i <= ن; i = i + 1) {
        م += i ؛
    }
    ارجع م ؛
}

دالة قوة(صحيح أس, صحيح أصل) -> صحيح {
    صحيح نتيجة = 1 ؛
    لكل(صحيح i = 0; i < أس; i = i + 1) {
        نتيجة *= أصل ؛
    }
    ارجع نتيجة ؛
}

طباعة("مضروب 5 = ") ؛
طباعة(مضروب(5)) ؛
طباعة("المجموع من 1 إلى 10:") ؛
طباعة(مجموع(10)) ؛
طباعة("2 أس 10 = ") ؛
طباعة(قوة(10, 2)) ؛
