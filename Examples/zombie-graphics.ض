// ═══════════════════════════════════════════════════════════════
// لعبة زومبي بالرسومات — بلغة ض
// ═══════════════════════════════════════════════════════════════

__dhad.setCanvasSize(800, 600);

// ── المتغيرات ──────────────────────────────────────────────────
صحيح لاعب_صحة = 100;
صحيح لاعب_قوة = 25;
صحيح زومبي1_صحة = 60;
صحيح زومبي2_صحة = 40;
صحيح زومبي3_صحة = 80;
صحيح نقاط = 0;
صحيح موجة = 1;
صحيح ذخيرة = 15;

// ── رسم الخلفية ────────────────────────────────────────────────
دالة رسم_خلفية() {
    __dhad.background("#0a0a1a");
    // الأرض
    __dhad.setColor("#1a3a1a");
    __dhad.rectangle(0, 400, 800, 200);
    // السماء
    __dhad.setColor("#0a0a2a");
    __dhad.rectangle(0, 0, 800, 400);
    // نجوم
    __dhad.setColor("#ffffff");
    __dhad.rectangle(100, 50, 2, 2);
    __dhad.rectangle(250, 80, 2, 2);
    __dhad.rectangle(400, 30, 3, 3);
    __dhad.rectangle(550, 70, 2, 2);
    __dhad.rectangle(700, 40, 2, 2);
    __dhad.rectangle(150, 120, 2, 2);
    __dhad.rectangle(600, 100, 2, 2);
    // قمر
    __dhad.setColor("#ffffcc");
    __dhad.circle(700, 80, 30);
    __dhad.setColor("#0a0a2a");
    __dhad.circle(710, 75, 25);
}

// ── رسم اللاعب ─────────────────────────────────────────────────
دالة رسم_لاعب(صحيح س, صحيح ص) {
    // الجسم
    __dhad.setColor("#2d5a27");
    __dhad.rectangle(س - 15, ص, 30, 40);
    // الرأس
    __dhad.setColor("#ffcc99");
    __dhad.circle(س, ص - 10, 15);
    // العيون
    __dhad.setColor("#000000");
    __dhad.rectangle(س - 6, ص - 14, 3, 3);
    __dhad.rectangle(س + 3, ص - 14, 3, 3);
    // السلاح
    __dhad.setColor("#666666");
    __dhad.rectangle(س + 15, ص + 10, 25, 5);
    __dhad.setColor("#444444");
    __dhad.rectangle(س + 35, ص + 8, 8, 9);
}

// ── رسم الزومبي ────────────────────────────────────────────────
دالة رسم_زومبي(صحيح س, صحيح ص, صحيح صحة, صحيح قصوى) {
    إذا (صحة <= 0) { ارجع; }
    // الجسم
    __dhad.setColor("#4a6a3a");
    __dhad.rectangle(س - 12, ص, 24, 35);
    // الرأس
    __dhad.setColor("#88aa66");
    __dhad.circle(س, ص - 8, 12);
    // العيون الحمراء
    __dhad.setColor("#ff0000");
    __dhad.rectangle(س - 5, ص - 12, 4, 4);
    __dhad.rectangle(س + 2, ص - 12, 4, 4);
    // شريط الصحة
    __dhad.setColor("#333333");
    __dhad.rectangle(س - 15, ص - 30, 30, 5);
    __dhad.setColor("#ff4444");
    صحيح عرض = (صحة * 30) / قصوى;
    __dhad.rectangle(س - 15, ص - 30, عرض, 5);
}

// ── رسم شريط الصحة ─────────────────────────────────────────────
دالة رسم_صحة(صحيح صحة, صحيح قصوى, صحيح س, صحيح ص) {
    __dhad.setColor("#333333");
    __dhad.rectangle(س, ص, 200, 20);
    إذا (صحة > قصوى / 2) { __dhad.setColor("#44cc44"); }
    وإلا إذا (صحة > قصوى / 4) { __dhad.setColor("#cccc44"); }
    وإلا { __dhad.setColor("#cc4444"); }
    صحيح عرض = (صحة * 200) / قصوى;
    __dhad.rectangle(س, ص, عرض, 20);
    __dhad.setColor("#ffffff");
    __dhad.text(صحة + "/" + قصوى, س + 100, ص + 2, 12);
}

// ── رسم الواجهة ────────────────────────────────────────────────
دالة رسم_واجهة() {
    __dhad.setColor("#ffffff");
    __dhad.text("الמوجة: " + موجة, 700, 10, 16);
    __dhad.text("النقاط: " + نقاط, 700, 30, 16);
    __dhad.text("الذخيرة: " + ذخيرة, 700, 50, 16);
}

// ── رسم تأثير الضرب ────────────────────────────────────────────
دالة رسم_ضرب(صحيح س, صحيح ص) {
    __dhad.setColor("#ffff00");
    __dhad.line(س, ص, س + 20, ص - 20);
    __dhad.line(س + 20, ص, س, ص - 20);
    __dhad.setColor("#ff8800");
    __dhad.circle(س + 10, ص - 10, 15);
}

// ── رسم تأثير الموت ────────────────────────────────────────────
دالة رسم_موت(صحيح س, صحيح ص) {
    __dhad.setColor("#ff0000");
    __dhad.text("💀", س - 10, ص - 20, 20);
    __dhad.setColor("#880000");
    __dhad.rectangle(س - 5, ص + 10, 10, 15);
}

// ── المعركة ────────────────────────────────────────────────────
دالة معركة() {
    رسم_خلفية();
    رسم_لاعب(200, 350);
    رسم_زومبي(500, 350, زومبي1_صحة, 60);
    رسم_زومبي(600, 320, زومبي2_صحة, 40);
    رسم_زومبي(700, 350, زومبي3_صحة, 80);
    رسم_صحة(لاعب_صحة, 100, 20, 560);
    رسم_واجهة();
}

// ── هجوم اللاعب ────────────────────────────────────────────────
دالة هجوم_لاعب() {
    إذا (ذخيرة <= 0) {
        __dhad.background("#0a0a1a");
        __dhad.setColor("#ff4444");
        __dhad.text("لا ذخيرة!", 400, 280, 24);
        ارجع;
    }
    ذخيرة = ذخيرة - 1;
    صحيح ضربات = 0;
    إذا (زومبي1_صحة > 0) {
        زومبي1_صحة = زومبي1_صحة - لاعب_قوة;
        إذا (زومبي1_صحة <= 0) {
            زومبي1_صحة = 0;
            نقاط = نقاط + 20;
            ضربات = ضربات + 1;
        }
    }
    وإلا إذا (زومبي2_صحة > 0) {
        زومبي2_صحة = زومبي2_صحة - لاعب_قوة;
        إذا (زومبي2_صحة <= 0) {
            زومبي2_صحة = 0;
            نقاط = نقاط + 20;
            ضربات = ضربات + 1;
        }
    }
    وإلا إذا (زومبي3_صحة > 0) {
        زومبي3_صحة = زومبي3_صحة - لاعب_قوة;
        إذا (زومبي3_صحة <= 0) {
            زومبي3_صحة = 0;
            نقاط = نقاط + 20;
            ضربات = ضربات + 1;
        }
    }
    رسم_ضرب(450, 330);
}

// ── هجوم الزومبي ───────────────────────────────────────────────
دالة هجوم_زومبي() {
    صحيح ضرر = 0;
    إذا (زومبي1_صحة > 0) { ضرر = ضرر + 8; }
    إذا (زومبي2_صحة > 0) { ضرر = ضرر + 5; }
    إذا (زومبي3_صحة > 0) { ضرر = ضرر + 12; }
    لاعب_صحة = لاعب_صحة - ضرر;
    إذا (لاعب_صحة < 0) { لاعب_صحة = 0; }
}

// ── موجة جديدة ─────────────────────────────────────────────────
دالة موجة_جديدة() {
    موجة = موجة + 1;
    زومبي1_صحة = 40 + (موجة * 15);
    زومبي2_صحة = 30 + (موجة * 10);
    زومبي3_صحة = 60 + (موجة * 20);
    ذخيرة = 15;
    لاعب_صحة = 100;
}

// ═══════════════════════════════════════════════════════════════
// اللعبة الرئيسية
// ═══════════════════════════════════════════════════════════════

// الشاشة الرئيسية
رسم_خلفية();
__dhad.setColor("#ff4444");
__dhad.text("ZOMBIE SLAYER", 400, 100, 48);
__dhad.setColor("#ffffff");
__dhad.text("اضغط لبدء المعركة!", 400, 200, 20);

// الموجة 1
موجة = 1;
زومبي1_صحة = 60;
زومبي2_صحة = 40;
زومبي3_صحة = 80;
لاعب_صحة = 100;
ذخيرة = 15;

رسم_خلفية();
__dhad.setColor("#ffff00");
__dhad.text("الموجة 1", 400, 100, 32);
__dhad.setColor("#ffffff");
__dhad.text("زومبي1: 60 | زومبي2: 40 | زومبي3: 80", 400, 160, 16);

// معركة الموجة 1
هجوم_لاعب();
رسم_خلفية();
__dhad.setColor("#00ff00");
__dhad.text("ضربة! -25 لكل زومبي", 400, 100, 20);

هجوم_زومبي();
رسم_خلفية();
__dhad.setColor("#ff4444");
__dhad.text("الزومبي هاجموا!", 400, 100, 20);

// موجة 2
موجة_جديدة();
رسم_خلفية();
__dhad.setColor("#ffff00");
__dhad.text("الموجة 2", 400, 100, 32);
__dhad.setColor("#ffffff");
__dhad.text("زومبي1: " + زومبي1_صحة + " | زومبي2: " + زومبي2_صحة + " | زومبي3: " + زومبي3_صحة, 400, 160, 16);

هجوم_لاعب();
هجوم_زومبي();

// موجة 3
موجة_جديدة();
هجوم_لاعب();
هجوم_زومبي();

// النتيجة النهائية
رسم_خلفية();
إذا (لاعب_صحة > 0) {
    __dhad.setColor("#00ff00");
    __dhad.text("ننتصرت!", 400, 200, 48);
    __dhad.setColor("#ffffff");
    __dhad.text("النقاط: " + نقاط, 400, 280, 24);
    __dhad.text("الموجات: " + موجة, 400, 320, 20);
} وإلا {
    __dhad.setColor("#ff0000");
    __dhad.text("GAME OVER", 400, 200, 48);
    __dhad.setColor("#ffffff");
    __dhad.text("النقاط: " + نقاط, 400, 280, 24);
}
