// ═══════════════════════════════════════════════════════════
// ⚔️ لعبة معركة النرد — بلغة البرمجة العربية "ض"
// لاعب ضد الحاسوب على 5 جولات — نظام عشوائي مكتوب بض نفسها
// ═══════════════════════════════════════════════════════════

// ── مولّد أرقام شبه عشوائية (LCG) بلغة ض ──
دالة التالية(بذرة) -> صحيح {
    ارجع ((بذرة * 7919) + 13) % 99991 ؛
}

// ── رمية نرد: من 1 إلى 6 ──
دالة نرد(بذرة) -> صحيح {
    ارجع (بذرة % 6) + 1 ؛
}

// ── عرض وجه النرد برموز ──
دالة وجه(رقم) -> فراغ {
    اذا (رقم == 1) {
        طباعة("⚀ واحد") ؛
    }
    اذا (رقم == 2) {
        طباعة("⚁ اثنان") ؛
    }
    اذا (رقم == 3) {
        طباعة("⚂ ثلاثة") ؛
    }
    اذا (رقم == 4) {
        طباعة("⚃ أربعة") ؛
    }
    اذا (رقم == 5) {
        طباعة("⚄ خمسة") ؛
    }
    اذا (رقم == 6) {
        طباعة("⚅ ستة") ؛
    }
}

// ═══════════ البداية ═══════════
طباعة("⚔️⚔️⚔️ معركة النرد ⚔️⚔️⚔️") ؛
طباعة("أنت ضد الحاسوب — أفضل من 5 جولات") ؛
طباعة("") ؛

صحيح بذرة = 42 ؛
صحيح نقاطي = 0 ؛
صحيح نقاط_الحاسوب = 0 ؛
صحيح الجولة = 1 ؛

طالما (الجولة <= 5) {
    طباعة("═══ الجولة رقم:") ؛
    طباعة(الجولة) ؛
    طباعة("═══") ؛

    // رمية اللاعب
    بذرة = التالية(بذرة) ؛
    صحيح رميتي = نرد(بذرة) ؛
    طباعة("🎲 رميتك:") ؛
    وجه(رميتي) ؛

    // رمية الحاسوب
    بذرة = التالية(بذرة + 7) ؛
    صحيح رمية_الحاسوب = نرد(بذرة) ؛
    طباعة("🤖 الحاسوب:") ؛
    وجه(رمية_الحاسوب) ؛

    // حسم الجولة
    اذا (رميتي > رمية_الحاسوب) {
        نقاطي = نقاطي + 1 ؛
        طباعة("✅ كسبت الجولة!") ؛
    } وإلا {
        اذا (رمية_الحاسوب > رميتي) {
            نقاط_الحاسوب = نقاط_الحاسوب + 1 ؛
            طباعة("❌ الحاسوب كسب الجولة") ؛
        } وإلا {
            طباعة("🤝 تعادل") ؛
        }
    }

    طباعة("النتيجة: أنت") ؛
    طباعة(نقاطي) ؛
    طباعة("- الحاسوب") ؛
    طباعة(نقاط_الحاسوب) ؛
    طباعة("") ؛
    الجولة = الجولة + 1 ؛
}

// ── النتيجة النهائية ──
طباعة("🏆🏆🏆 النتيجة النهائية 🏆🏆🏆") ؛
طباعة("نقاطك:") ؛
طباعة(نقاطي) ؛
طباعة("نقاط الحاسوب:") ؛
طباعة(نقاط_الحاسوب) ؛

اذا (نقاطي > نقاط_الحاسوب) {
    طباعة("🎉 مبروك! أنت بطل المعركة!") ؛
} وإلا {
    اذا (نقاط_الحاسوب > نقاطي) {
        طباعة("💻 الحاسوب فاز هذه المرة... جرب حظك لاحقًا!") ؛
    } وإلا {
        طباعة("🤝 تعادل شريف!") ؛
    }
}
