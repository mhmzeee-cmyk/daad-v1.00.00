// 🎯 لعبة تخمين الرقم السري — لغة البرمجة العربية "ض"
// تفاعلية بالكامل: تقرأ من لوحة المفاتيح وترد على اللاعب
// اللغة المستخدمة: ض فقط — بدون أي لغة برمجة أخرى
// ═══════════════════════════════════════════════════════════

// ── مولّد أرقام شبه عشوائية (LCG) مكتوب بض ──
دالة التالية(بذرة) -> صحيح {
    ارجع ((بذرة * 7919) + 13) % 99991 ؛
}

// ── استخراج رقم سري في المدى [1، الحد] من البذرة ──
دالة سر(بذرة، الحد) -> صحيح {
    ارجع (بذرة % الحد) + 1 ؛
}

// ── قيمة مطلقة للفرق ──
دالة فرق(أ، ب) -> صحيح {
    اذا (أ > ب) {
        ارجع أ - ب ؛
    }
    ارجع ب - أ ؛
}

// ── تقييم قرب التخمين: تلميح ذكي ──
دالة تلميح(التخمين، السري) -> فراغ {
    اذا (التخمين > السري) {
        طباعة("⬇️ الرقم السري أصغر من تخمينك") ؛
    } وإلا {
        طباعة("⬆️ الرقم السري أكبر من تخمينك") ؛
    }

    // مدى القرب
    صحيح المسافة = فرق(التخمين، السري) ؛
    اذا (المسافة <= 5) {
        طباعة("🔥 حار جدًا! أنت على وشك الفوز") ؛
    } وإلا {
        اذا (المسافة <= 15) {
            طباعة("🌡️ دافئ — اقتربت") ؛
        } وإلا {
            طباعة("❄️ بارد — بعيد تمامًا") ؛
        }
    }
}

// ═══════════ بداية اللعبة ═══════════
طباعة("🎯🎯🎯 لعبة تخمين الرقم السري 🎯🎯🎯") ؛
طباعة("فكرتُ في رقم بين 1 و 100... هل تستطيع إيجاده؟") ؛
طباعة("") ؛

// البذرة العشوائية: أول إدخال من اللاعب يجعل كل جولة مختلفة!
طباعة("ادخل أي رقم لتشغيل العشوائية:") ؛
صحيح تشغيل = 0 ؛
ادخل(تشغيل) ؛

صحيح بذرة = التالية(تشغيل * 31 + 7) ؛
بذرة = التالية(بذرة) ؛
صحيح السري = سر(بذرة، 100) ؛

صحيح المحاولات = 0 ؛
صحيح فزت = 0 ؛
صحيح الحد_الأقصى = 10 ؛

// ── حلقة اللعب الرئيسية ──
طالما (فزت == 0 و المحاولات < الحد_الأقصى) {
    المحاولات = المحاولات + 1 ؛
    طباعة("") ؛
    طباعة("━━━ محاولة رقم:") ؛
    طباعة(المحاولات) ؛
    طباعة("من") ؛
    طباعة(الحد_الأقصى) ؛
    طباعة("━━━") ؛
    طباعة("ما هو تخمينك؟") ؛

    صحيح تخمين = 0 ؛
    ادخل(تخمين) ؛

    اذا (تخمين == السري) {
        فزت = 1 ؛
        طباعة("") ؛
        طباعة("🎉🎉🎉 أحسنت! الرقم السري هو:") ؛
        طباعة(السري) ؛
        طباعة("فزت في") ؛
        طباعة(المحاولات) ؛
        طباعة("محاولات!") ؛
    } وإلا {
        تلميح(تخمين، السري) ؛

        // نظام النقاط التقديري
        اذا (المحاولات >= الحد_الأقصى) {
            طباعة("") ؛
            طباعة("💔 انتهت المحاولات! الرقم السري كان:") ؛
            طباعة(السري) ؛
        }
    }
}

// ── التقييم النهائي ──
طباعة("") ؛
اذا (فزت == 1) {
    اذا (المحاولات <= 3) {
        طباعة("🏅 تقييمك: عبقري! عقل تحليلي مذهل") ؛
    } وإلا {
        اذا (المحاولات <= 6) {
            طباعة("🥈 تقييمك: ممتاز! بحث علمي منظّم") ؛
        } وإلا {
            طباعة("🥉 تقييمك: جيد — نجوت بالكاد!") ؛
        }
    }
} وإلا {
    طباعة("🎮 حظ أوفر في المرة القادمة!") ؛
}
طباعة("شكرًا للعب! 👋") ؛
