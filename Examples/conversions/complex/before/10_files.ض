// البرنامج 10: التعامل مع الملفات
// قراءة وكتابة الملفات

نص مسار = "test.txt" ؛
صحيح ملف = افتح(مسار, 1) ؛

إذا(ملف == 0) {
    اكتب_سطر(ملف, "مرحبا بالعالم") ؛
    أغلق(ملف) ؛
    طباعة("تم الكتابة بنجاح") ؛
}
وإلا {
    طباعة("خطأ في فتح الملف") ؛
}

صحيح ملف2 = افتح(مسار, 0) ؛
إذا(ملف2 == 0) {
    نص محتوى = اقرأ_سطر(ملف2) ؛
    طباعة("المحتوى المقروء:") ؛
    طباعة(المحتوى) ؛
    أغلق(ملف2) ؛
}
وإلا {
    طباعة("خطأ في قراءة الملف") ؛
}
