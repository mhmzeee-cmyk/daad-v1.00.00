// ═══════════════════════════════════════════════════════════════
// Flappy Bird — بلغة ض
// ═══════════════════════════════════════════════════════════════

__dhad.setCanvasSize(800, 600);

// ── المتغيرات ──────────────────────────────────────────────────
 صحيح طائرس = 150;
 صحيح طائرص = 300;
 صحيح طائروسريعاص = 0;
 صحيح طائرعرض = 30;
 صحيح طائرارتفاع = 20;

 صحيح أنابيب = [];
 صحيح عدادأنابيب = 0;
 صحيح فجوة = 160;
 صحيح سرعةلعبة = 3;

 صحيح نقاط = 0;
 صحيح نهايةلعبة = 0;
 صحيح بدأت = 0;
 صحيح مؤقت = 0;

 صحيح أنابيبعرض = 60;

// ── إضافة أنبوب جديدق ──────────────────────────────────────────
دالة إضافةأنبوب() {
    صحيح صأعلى = 50 + (مؤقت % 350);
    صحيح فهرس = عدادأنابيب * 5;
    أنابيب[فهرس] = 850;
    أنابيب[فهرس + 1] = 0;
    أنابيب[فهرس + 2] = أنابيبعرض;
    أنابيب[فهرس + 3] = صأعلى;
    أنابيب[فهرس + 4] = صأعلى + فجوة;
    عدادأنابيب = عدادأنابيب + 1;
}

// ── رسم الطائر ─────────────────────────────────────────────────
دالة رسمطائر() {
    __dhad.setColor("#ffdd44");
    __dhad.circle(طائرس, طائرص, 15);
    __dhad.setColor("#ffffff");
    __dhad.circle(طائرس + 8, طائرص - 5, 6);
    __dhad.setColor("#000000");
    __dhad.circle(طائرس + 10, طائرص - 5, 3);
    __dhad.setColor("#ff6600");
    __dhad.rectangle(طائرس + 12, طائرص + 2, 12, 6);
    __dhad.setColor("#eebb33");
    __dhad.rectangle(طائرس - 18, طائرص + 5, 15, 8);
}

// ── رسم الأنبوب ────────────────────────────────────────────────
دالة رسمأنبوب(صحيح فهرس) {
    صحيح س = أنابيب[فهرس];
    صحيح صفوق = أنابيب[فهرس + 3];
    صحيح صتحت = أنابيب[فهرس + 4];
    صحيح عرض = أنابيب[فهرس + 2];

    __dhad.setColor("#44aa44");
    __dhad.rectangle(س - عرض / 2, 0, عرض, صفوق);
    __dhad.setColor("#338833");
    __dhad.rectangle(س - عرض / 2 - 5, صفوق - 20, عرض + 10, 20);
    __dhad.setColor("#44aa44");
    __dhad.rectangle(س - عرض / 2, صتحت, عرض, 600 - صتحت);
    __dhad.setColor("#338833");
    __dhad.rectangle(س - عرض / 2 - 5, صتحت, عرض + 10, 20);
}

// ── رسم الخلفية ────────────────────────────────────────────────
دالة رسمخلفية() {
    __dhad.background("#87CEEB");
    __dhad.setColor("#ffffff");
    __dhad.circle(100, 80, 30);
    __dhad.circle(130, 70, 35);
    __dhad.circle(160, 85, 28);
    __dhad.circle(400, 60, 25);
    __dhad.circle(430, 50, 30);
    __dhad.circle(600, 90, 28);
    __dhad.circle(630, 80, 32);
    __dhad.setColor("#8B4513");
    __dhad.rectangle(0, 570, 800, 30);
    __dhad.setColor("#228B22");
    __dhad.rectangle(0, 560, 800, 15);
}

// ── رسم الواجهة ────────────────────────────────────────────────
دالة رسمواجهة() {
    __dhad.setColor("#ffffff");
    __dhad.text("النقاط: " + نقاط, 400, 20, 24);
}

// ── حركة الطائر ────────────────────────────────────────────────
دالة تحديثطائر() {
    إذا (بدأت == 0) {
        مؤقت = مؤقت + 1;
        إذا (مؤقت > 30) { مؤقت = 0; }
        إذا (مؤقت < 15) {
            طائرص = طائرص - 2;
        } وإلا {
            طائرص = طائرص + 2;
        }
        ارجع;
    }
    طائروسريعاص = طائروسريعاص + 0.5;
    طائرص = طائرص + طائروسريعاص;
    إذا (طائرص < 15) { طائرص = 15; طائروسريعاص = 0; }
    إذا (طائرص > 555) { طائرص = 555; طائروسريعاص = 0; نهايةلعبة = 1; }
}

// ── القفز ──────────────────────────────────────────────────────
دالة قفز() {
    إذا (بدأت == 0) {
        بدأت = 1;
        مؤقت = 0;
        إضافةأنبوب();
    }
    طائروسريعاص = -8;
}

// ── تحديث الأنابيب ────────────────────────────────────────────
دالة تحديثأنابيب() {
    إذا (بدأت == 0) { ارجع; }
    صحيح س = 0;
    طالما (س < عدادأنابيب) {
        صحيح فهرس = س * 5;
        أنابيب[فهرس] = أنابيب[فهرس] - سرعةلعبة;
        س = س + 1;
    }
    إذا (عدادأنابيب == 0) {
        إضافةأنبوب();
    }
    صحيح أخير = (عدادأنابيب - 1) * 5;
    إذا (أنابيب[أخير] < 600) {
        إضافةأنبوب();
    }
    إذا (عدادأنابيب > 0 && أنابيب[0] < -100) {
        صحيح جديدق = 0;
        س = 1;
        طالما (س < عدادأنابيب) {
            صحيح فهرس = س * 5;
            صحيح فهرسج = جديدق * 5;
            أنابيب[فهرسج] = أنابيب[فهرس];
            أنابيب[فهرسج + 1] = أنابيب[فهرس + 1];
            أنابيب[فهرسج + 2] = أنابيب[فهرس + 2];
            أنابيب[فهرسج + 3] = أنابيب[فهرس + 3];
            أنابيب[فهرسج + 4] = أنابيب[فهرس + 4];
            جديدق = جديدق + 1;
            س = س + 1;
        }
        عدادأنابيب = جديدق;
    }
}

// ── فحص الاصطدام ──────────────────────────────────────────────
دالة فحصاصطدام() {
    إذا (بدأت == 0) { ارجع; }
    صحيح س = 0;
    طالما (س < عدادأنابيب) {
        صحيح فهرس = س * 5;
        صحيح سأنبوب = أنابيب[فهرس];
        صحيح صفوق = أنابيب[فهرس + 3];
        صحيح صتحت = أنابيب[فهرس + 4];
        صحيح عرض = أنابيب[فهرس + 2];
        إذا (طائرس + 15 > سأنبوب - عرض / 2 && طائرس - 15 < سأنبوب + عرض / 2) {
            إذا (طائرص - 10 < صفوق || طائرص + 10 > صتحت) {
                نهايةلعبة = 1;
            }
        }
        إذا (سانبوب < طائرس && سأنبوب + سرعةلعبة >= طائرس) {
            نقاط = نقاط + 1;
        }
        س = س + 1;
    }
}

// ── اللعبة الرئيسية ────────────────────────────────────────────
طالما (نهايةلعبة == 0) {
    رسمخلفية();
    تحديثطائر();
    تحديثأنابيب();
    فحصاصطدام();
    صحيح س = 0;
    طالما (س < عدادأنابيب) {
        رسمأنبوب(س * 5);
        س = س + 1;
    }
    رسمطائر();
    رسمواجهة();
}

// نهاية اللعبة
__dhad.setColor("#ff0000");
__dhad.text("GAME OVER", 400, 200, 48);
__dhad.setColor("#ffffff");
__dhad.text("النقاط: " + نقاط, 400, 300, 24);
__dhad.text("اضغط لإعادة المحاولة", 400, 350, 18);
