// البرنامج 10: لعبة ألغاز حسابية
// ألغاز رياضية مع مستويات صعوبة

دالة لغز_الجمع(صحيح أ, صحيح ب) -> صحيح {
    ارجع أ + ب ؛
}

دالة لغز_الضرب(صحيح أ, صحيح ب) -> صحيح {
    ارجع أ * ب ؛
}

دالة لغز_النسبة(صحيح ن) -> صحيح {
    إذا(ن % 2 == 0) { ارجع 1 ؛ }
    ارجع 0 ؛
}

دالة لغز_العلاقة(صحيح أ, صحيح ب) -> صحيح {
    إذا(أ > ب) { ارجع أ - ب ؛ }
    ارجع ب - أ ؛
}

دالة تحديد_المستوى(صحيح نقطة) -> نص {
    إذا(نقطة >= 90) { ارجع "خبير" ؛ }
    إذا(نقطة >= 70) { ارجع "متوسط" ؛ }
    إذا(نقطة >= 50) { ارجع "مبتدئ" ؛ }
    ارجع "متدرب" ؛
}

// بيانات الألغاز
صحيح[] إجابات = 0 ؛
صحيح[] حلول = 0 ؛
صحيح عدد = 8 ؛

حلول[0] = 25 ؛
حلول[1] = 12 ؛
حلول[2] = 1 ؛
حلول[3] = 5 ؛
حلول[4] = 100 ؛
حلول[5] = 0 ؛
حلول[6] = 7 ؛
حلول[7] = 42 ؛

إجابات[0] = 25 ؛
إجابات[1] = 12 ؛
إجابات[2] = 1 ؛
إجابات[3] = 5 ؛
إجابات[4] = 100 ؛
إجابات[5] = 0 ؛
إجابات[6] = 7 ؛
إجابات[7] = 42 ؛

// حساب النقاط
صحيح نقاط = 0 ؛
لكل(صحيح i = 0; i < عدد; i = i + 1) {
    إذا(إجابات[i] == حلول[i]) {
        نقاط += 10 ؛
    }
}

طباعة("=== لعبة الألغاز الحسابية ===") ؛
طباعة("اللغز 1: 5 + 20 = ") ؛
طباعة(لغز_الجمع(5, 20)) ؛
طباعة("اللغز 2: 3 × 4 = ") ؛
طباعة(لغز_الضرب(3, 4)) ؛
طباعة("هل 8 عدد زوجي؟ ") ؛
طباعة(لغز_النسبة(8)) ؛
طباعة("الفرق بين 15 و 9 = ") ؛
طباعة(لغز_العلاقة(15, 9)) ؛

طباعة("النقاط: ") ؛
طباعة(نقاط) ؛
طباعة("المستوى: ") ؛
طباعة(تحديد_المستوى(نقاط)) ؛

// ألغاز إضافية
طباعة("=== ألغاز إضافية ===") ؛
صحيح مجموع = 0 ؛
لكل(صحيح i = 1; i <= 10; i = i + 1) {
    مجموع += i ؛
}
طباعة("مجموع الأعداد من 1 إلى 10: ") ؛
طباعة(مجموع) ؛

صحيح مضروب = 1 ؛
لكل(صحيح i = 1; i <= 6; i = i + 1) {
    مضروب *= i ؛
}
طباعة("مضروب 6: ") ؛
طباعة(مضروب) ؛
