// البرنامج 1: آلة حاسبة متقدمة
// دوال العمليات الحسابية الأساسية والمتقدمة

دالة جمع(صحيح أ, صحيح ب) -> صحيح {
    ارجع أ + ب ؛
}

دالة طرح(صحيح أ, صحيح ب) -> صحيح {
    ارجع أ - ب ؛
}

دالة ضرب(صحيح أ, صحيح ب) -> صحيح {
    ارجع أ * ب ؛
}

دالة قسمة(صحيح أ, صحيح ب) -> صحيح {
    إذا(ب == 0) {
        ارجع 0 ؛
    }
    ارجع أ / ب ؛
}

دالة باقي_القسمة(صحيح أ, صحيح ب) -> صحيح {
    إذا(ب == 0) { ارجع 0 ؛ }
    ارجع أ % ب ؛
}

دالة قوة(صحيح أس, صحيح أصل) -> صحيح {
    صحيح نتيجة = 1 ؛
    لكل(صحيح i = 0; i < أس; i = i + 1) {
        نتيجة *= أصل ؛
    }
    ارجع نتيجة ؛
}

دالة مضروب(صحيح ن) -> صحيح {
    صحيح نتيجة = 1 ؛
    لكل(صحيح i = 1; i <= ن; i = i + 1) {
        نتيجة *= i ؛
    }
    ارجع نتيجة ؛
}

دالة أكبر(صحيح أ, صحيح ب) -> صحيح {
    إذا(أ > ب) { ارجع أ ؛ }
    ارجع ب ؛
}

دالة أصغر(صحيح أ, صحيح ب) -> صحيح {
    إذا(أ < ب) { ارجع أ ؛ }
    ارجع ب ؛
}

دالة القيمة_المطلقة(صحيح ن) -> صحيح {
    إذا(ن < 0) { ارجع 0 - ن ؛ }
    ارجع ن ؛
}

// اختبار الدوال
طباعة("=== آلة حاسبة متقدمة ===") ؛
طباعة("5 + 3 = ") ؛
طباعة(جمع(5, 3)) ؛
طباعة("10 - 4 = ") ؛
طباعة(طرح(10, 4)) ؛
طباعة("6 × 7 = ") ؛
طباعة(ضرب(6, 7)) ؛
طباعة("20 ÷ 3 = ") ؛
طباعة(قسمة(20, 3)) ؛
طباعة("20 % 3 = ") ؛
طباعة(باقي_القسمة(20, 3)) ؛
طباعة("2 أس 10 = ") ؛
طباعة(قوة(10, 2)) ؛
طباعة("5! = ") ؛
طباعة(مضروب(5)) ؛
طباعة("الأكبر بين 15 و 20 = ") ؛
طباعة(أكبر(15, 20)) ؛
طباعة("القيمة المطلقة لـ -42 = ") ؛
طباعة(القيمة_المطلقة(-42)) ؛
