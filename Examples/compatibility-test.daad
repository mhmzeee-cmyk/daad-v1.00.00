// ═══════════════════════════════════════════════════════════════════════════════
// Dhad (ض) — Compatibility Test (Minimal)
// ═══════════════════════════════════════════════════════════════════════════════

صحيح س = 10 ؛
طباعة( س ) ؛
اطبع( "اختبار اطبع" ) ؛

إذا ( س > 5 ) { طباعة( "أكبر" ) ؛ }

طالما ( س > 0 ) { س = س - 1 ؛ }

صحيح ع = 0 ؛
لكل ( ع = 0 ؛ ع < 5 ؛ ع = ع + 1 ) { طباعة( ع ) ؛ }

صحيح ع2 = 0 ؛
كرر ( ع2 = 0 ؛ ع2 < 5 ؛ ع2 = ع2 + 1 ) { طباعة( ع2 ) ؛ }

دالة جمع( صحيح أ, صحيح ب ) -> صحيح { ارجع أ + ب ؛ }
طباعة( جمع( 5, 3 ) ) ؛

صحيح مسافة = 50 ؛
صحيح اسم = "مربع" ؛

صنف شكل {
    صحيح عرض ;
}

صحيح عداد = 0 ؛

حاول { طباعة( "محاولة" ) ؛ } امسك( خطأ ) { طباعة( "خطأ" ) ؛ }

صحيح خيار = 2 ؛
اختر( خيار ) {
    حالة 1: { طباعة( "واحد" ) ؛ توقف ؛ }
    افتراضي: { طباعة( "أخرى" ) ؛ }
}

س += 5 ؛
س -= 2 ؛

صحيح نتيجة = (س > 5) ? 1 : 0 ؛

إذا ( س > 5 و س < 20 ) { طباعة( "شرط" ) ؛ }
إذا ( س == 10 أو س == 5 ) { طباعة( "بديل" ) ؛ }

صحيح أول = 10 ؛

نص مؤشر = عدم ؛
إذا ( مؤشر == عدم ) { طباعة( "فارغ" ) ؛ }

صحيح قوة = 2 ^ 8 ؛

نطاق حسابات {
    دالة ضرب( صحيح أ, صحيح ب ) -> صحيح { ارجع أ * ب ؛ }
}

تعداد ألوان { أحمر, أزرق, أخضر }

استورد "مكتبة.ض" ؛

صحيح مؤشر2 = جديد صحيح( 42 ) ؛
احذف مؤشر2 ؛

حمّل_صورة( "test.png", صورة1 ) ؛
ارسم_صورة( صورة1, 0, 0, 100, 100 ) ؛
مستطيل( 10, 10, 50, 50 ) ؛
دائرة( 100, 100, 25 ) ؛
خط( 0, 0, 100, 100 ) ؛
مسح() ؛
