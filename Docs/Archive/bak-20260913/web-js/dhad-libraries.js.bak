# ═══════════════════════════════════════════════════════
# مكتبة التخزين - Storage
# ═══════════════════════════════════════════════════════

دالة احفظ(نص مفتاح، أي قيمة) {
    localStorage.setItem(مفتاح، JSON.stringify(قيمة))
}

دالة اقرأ(نص مفتاح) -> أي {
    var data = localStorage.getItem(مفتاح)
    اذا (data) { ارجع JSON.parse(data) }
    ارجع عدم
}

دالة احذف_تخزين(نص مفتاح) {
    localStorage.removeItem(مفتاح)
}

دالة امسح_الكل() {
    localStorage.clear()
}

دالة existe(نص مفتاح) -> صحيح {
    ارجع localStorage.getItem(مفتاح) !== null
}

دالة قائمة_المفاتيح() -> نص[] {
    ارجع Object.keys(localStorage)
}

# ═══════════════════════════════════════════════════════
# التخزين المؤقت (Cache)
# ═══════════════════════════════════════════════════════

ثابت _تخزين_مؤقت = {}
ثابت _أوقات_التخزين = {}

دالة إنشاء_تخزين(نص اسم) {
    _تخزين_مؤقت[اسم] = {}
    _أوقات_التخزين[اسم] = {}
}

دالة أضف_للتخزين(نص اسم، نص مفتاح، أي قيمة، صحيح مدة_ال life) {
    _تخزين_مؤقت[اسم][مفتاح] = قيمة
    اذا (مدة_الlife) {
        _أوقات_التخزين[اسم][مفتاح] = Date.now() + مدة_الlife
    }
}

دالة احصل_من_التخزين(نص اسم، نص مفتاح) -> أي {
    اذا (_أوقات_التخزين[اسم] && _أوقات_التخزين[اسم][مفتاح]) {
        اذا (Date.now() > _أوقات_التخزين[اسم][مفتاح]) {
            احذف_من_التخزين(اسم، مفتاح)
            ارجع عدم
        }
    }
    ارجع _تخزين_مؤقت[اسم] ? _تخزين_مؤقت[اسم][مفتاح] : عدم
}

دالة احذف_من_التخزين(نص اسم، نص مفتاح) {
    اذا (_تخزين_مؤقت[اسم]) {
        delete _تخزين_مؤقت[اسم][مفتاح]
    }
}
      `
