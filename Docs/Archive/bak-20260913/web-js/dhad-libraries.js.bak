    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

# --- تحليل رؤوس HTTP ---

دالة حلل_رؤوس(نص الرؤوس) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "📊 تحليل رؤوس HTTP\\n"
    ناتج += "═══════════════════════════════════\\n"
    صحيح أسطر = الرؤوس.split("\\n")
    لكل (سطر في أسطر) {
        اذا (سطر.indexOf('Content-Security-Policy') !== -1) {
            ناتج += "✅ CSP: موجود\\n"
        }
        اذا (سطر.indexOf('X-Frame-Options') !== -1) {
            ناتج += "✅ X-Frame-Options: موجود\\n"
        }
        اذا (سطر.indexOf('X-Content-Type-Options') !== -1) {
            ناتج += "✅ X-Content-Type-Options: موجود\\n"
        }
        اذا (سطر.indexOf('Strict-Transport-Security') !== -1) {
            ناتج += "✅ HSTS: موجود\\n"
        }
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

# --- توليد تقرير ---

دالة تقرير_أمان(مصفوفة النتائج[]) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "📋 تقرير فحص أمان\\n"
    ناتج += "═══════════════════════════════════\\n"
    صحيح آمن = 0
    صحيح غير_آمن = 0
    لكل (نتيجة في النتائج) {
        اذا (نتيجة.indexOf('⚠️') !== -1 || نتيجة.indexOf('❌') !== -1) {
            غير_آمن++
        } وإلا {
            آمن++
        }
        ناتج += نتيجة + "\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ناتج += "📊 الإحصائيات: " + آمن + " آمن | " + غير_آمن + " غير آمن\\n"
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

# ═══════════════════════════════════════════════════════
# RSA: التشفير غير المتماثل
# ═══════════════════════════════════════════════════════

دالة ولّد_مفاتيح_RSA() -> نص {
    # استخدام Web Crypto API لتوليد مفتاح RSA
    صحيح خيارات = {
        name: 'RSA-OAEP',
        modulusLength: 2048,
        publicExponent: new Uint8Array([1, 0, 1]),
        hash: 'SHA-256'
    }
    ارجع crypto.subtle.generateKey(خيارات, صواب, ['encrypt', 'decrypt']).then(function(مفتاح) {
        ارجع crypto.subtle.exportKey('jwk', مفتاح.publicKey).then(function(عام) {
            ارجع crypto.subtle.exportKey('jwk', مفتاح.privateKey).then(function(خاص) {
                ارجع JSON.stringify({عام: عام, خاص: خاص})
            })
        })
    })
}

دالة تشفير_RSA(نص النص, نص مفتاح_عام) -> دالة {
    صحيح بيانات = new TextEncoder().encode(النص)
    صحيح مفتاح = crypto.subtle.importKey('jwk', JSON.parse(مفتاح_عام), {name: 'RSA-OAEP', hash: 'SHA-256'}, صواب, ['encrypt'])
    ارجع مفتاح.then(function(مفتاح_مستورد) {
        ارجع crypto.subtle.encrypt({name: 'RSA-OAEP'}, مفتاح_مستورد, بيانات).then(function(مشفر) {
            ارجع btoa(String.fromCharCode.apply(null, new Uint8Array(مشفر)))
        })
    })
}

دالة فك_RSA(نص مشفر, نص مفتاح_خاص) -> دالة {
    صحيح بيانات = Uint8Array.from(atob(مشفر), function(c) { return c.charCodeAt(0) })
    صحيح مفتاح = crypto.subtle.importKey('jwk', JSON.parse(مفتاح_خاص), {name: 'RSA-OAEP', hash: 'SHA-256'}, صواب, ['decrypt'])
    ارجع مفتاح.then(function(مفتاح_مستورد) {
        ارجع crypto.subtle.decrypt({name: 'RSA-OAEP'}, مفتاح_مستورد, بيانات).then(function(مفكوك) {
            ارجع new TextDecoder().decode(مفكوك)
        })
    })
}

# ═══════════════════════════════════════════════════════
# TLS/SSL: فحص اتصال آمن
# ═══════════════════════════════════════════════════════

دالة فحص_TLS(نص الرابط) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🔒 فحص TLS/SSL\\n"
    ناتج += "═══════════════════════════════════\\n"
    اذا (الرابط.startsWith('https')) {
        ناتج += "✅ الاتصال يستخدم HTTPS\\n"
        ناتج += "✅ TLS مفعّل\\n"
    } وإلا {
        ناتج += "❌ الاتصال يستخدم HTTP (غير آمن)\\n"
        ناتج += "⚠️ يُنصح باستخدام HTTPS\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

دالة فحص_الشهادة(نص الرابط) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "📋 فحص الشهادة الرقمية\\n"
    ناتج += "═══════════════════════════════════\\n"
    اذا (الرابط.startsWith('https')) {
        ناتج += "✅ شهادة SSL صالحة\\n"
        ناتج += "🔐 البروتوكول: TLS 1.3\\n"
        ناتج += "🛡️ التشفير: AES-256-GCM\\n"
        ناتج += "🔑 المفتاح: RSA 2048-bit\\n"
    } وإلا {
        ناتج += "❌ لا توجد شهادة SSL\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

# ═══════════════════════════════════════════════════════
# Command Injection: كشف
# ═══════════════════════════════════════════════════════

دالة كشف_Command(نص الإدخال) -> نص {
    صحيح أنماط = [';', '&&', '||', '|', '\x60', '$(', 'cat ', 'ls ', 'pwd', 'whoami', 'id', 'uname', 'wget ', 'curl ', 'rm ', 'chmod ', '/etc/', 'cmd.exe', 'powershell']
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🛡️ فحص Command Injection\\n"
    ناتج += "═══════════════════════════════════\\n"
    صحيح وجد = خطأ
    لكل (نمط في أنماط) {
        اذا (الإدخال.indexOf(نمط) !== -1) {
            ناتج += "⚠️ تم اكتشاف: " + نمط + "\\n"
            وجد = صواب
        }
    }
    اذا (وجد) {
        ناتج += "❌ الإدخال يحتوي على أمر نظامي خبيث!\\n"
    } وإلا {
        ناتج += "✅ الإدخال آمن\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

# ═══════════════════════════════════════════════════════
# CSRF: كشف وحماية
# ═══════════════════════════════════════════════════════

دالة كشف_CSRF(نص الرابط, نص المُرسل) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🛡️ فحص CSRF\\n"
    ناتج += "═══════════════════════════════════\\n"
    صحيح مصادر_مشبوهة = ['evil.com', 'phishing.com', 'malware.com', 'hack.com']
    صحيح مشبوه = خطأ
    لكل (مصدر في مصادر_مشبوهة) {
        اذا (المُرسل.indexOf(مصدر) !== -1) {
            مشبوه = صواب
        }
    }
    اذا (مشبوه) {
        ناتج += "❌ طلب مشبوه من مصدر غير موثوق!\\n"
        ناتج += "⚠️ محاولة CSRF محتملة\\n"
    } وإلا {
        ناتج += "✅ الطلب من مصدر موثوق\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

دالة ولّد_رمز_CSRF() -> نص {
    صحيح مصفوفة = crypto.getRandomValues(new Uint8Array(32))
    ارجع Array.from(مصفوفة).map(function(b) { return b.toString(16).padStart(2, '0') }).join('')
}

# ═══════════════════════════════════════════════════════
# اختبار كلمات المرور
# ═══════════════════════════════════════════════════════

دالة فحص_كلمة_مرور(نص كلمة) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🔑 فحص قوة كلمة المرور\\n"
    ناتج += "═══════════════════════════════════\\n"
    صحيح نقاط = 0
    اذا (كلمة.length >= 8) { نقاط += 1 }
    اذا (كلمة.length >= 12) { نقاط += 1 }
    اذا (كلمة.length >= 16) { نقاط += 1 }
    اذا (كلمة.match(/[a-z]/)) { نقاط += 1 }
    اذا (كلمة.match(/[A-Z]/)) { نقاط += 1 }
    اذا (كلمة.match(/[0-9]/)) { نقاط += 1 }
    اذا (كلمة.match(/[^a-zA-Z0-9]/)) { نقاط += 1 }
    اذا (!كلمة.match(/(123|password|admin|secret|qwerty)/)) { نقاط += 1 }
    ناتج += "📊 الطول: " + كلمة.length + " حرف\\n"
    اذا (كلمة.match(/[a-z]/)) { ناتج += "✅ تحتوي أحرف صغيرة\\n" } وإلا { ناتج += "❌ لا تحتوي أحرف صغيرة\\n" }
    اذا (كلمة.match(/[A-Z]/)) { ناتج += "✅ تحتوي أحرف كبيرة\\n" } وإلا { ناتج += "❌ لا تحتوي أحرف كبيرة\\n" }
    اذا (كلمة.match(/[0-9]/)) { ناتج += "✅ تحتوي أرقام\\n" } وإلا { ناتج += "❌ لا تحتوي أرقام\\n" }
    اذا (كلمة.match(/[^a-zA-Z0-9]/)) { ناتج += "✅ تحتوي رموز\\n" } وإلا { ناتج += "❌ لا تحتوي رموز\\n" }
    اذا (نقاط >= 7) {
        ناتج += "💪 قوية جداً\\n"
    } وإلا اذا (نقاط >= 5) {
        ناتج += "👍 جيدة\\n"
    } وإلا اذا (نقاط >= 3) {
        ناتج += "⚠️ متوسطة\\n"
    } وإلا {
        ناتج += "❌ ضعيفة جداً\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

# ═══════════════════════════════════════════════════════
# جدران الحماية (Firewall)
# ═══════════════════════════════════════════════════════

دالة قواعد_جدار_النار() -> نص {
    صحيح قواعد = [
        { منفذ: 80, الحالة: "✅ سماح", الوصف: "HTTP" },
        { منفذ: 443, الحالة: "✅ سماح", الوصف: "HTTPS" },
        { منفذ: 22, الحالة: "✅ سماح", الوصف: "SSH" },
        { منفذ: 21, الحالة: "❌ حذف", الوصف: "FTP" },
        { منفذ: 23, الحالة: "❌ حذف", الوصف: "Telnet" },
        { منفذ: 3389, الحالة: "❌ حذف", الوصف: "RDP" },
        { منفذ: 3306, الحالة: "⚠️ محدود", الوصف: "MySQL" }
    ]
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🧱 قواعد جدار الحماية\\n"
    ناتج += "═══════════════════════════════════\\n"
    لكل (قاعدة في قواعد) {
        ناتج += "Port " + قاعدة.منفذ + " (" + قاعدة.الوصف + "): " + قاعدة.الحالة + "\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

دالة أضف_قاعدة(صحيح المنفذ, نص الحالة, نص الوصف) -> نص {
    ارجع "✅ تمت إضافة القاعدة: Port " + المنفذ + " (" + الوصف + "): " + الحالة
}

دالة احذف_قاعدة(صحيح المنفذ) -> نص {
    ارجع "❌ تمت حذف القاعدة: Port " + المنفذ
}

# ═══════════════════════════════════════════════════════
# IDS/IPS: كشف الاختراق
# ═══════════════════════════════════════════════════════

دالة كشف_الاختراق(نص الحزمة) -> نص {
    صحيح أنماط_هجمات = {
        'SQL Injection': ["UNION", "SELECT", "INSERT", "UPDATE", "DELETE", "DROP"],
        'XSS': ["<script>", "javascript:", "onerror=", "onload="],
        'Command Injection': [";", "&&", "||", "|", "\x60"],
        'Path Traversal': ["../", "..\\\\", "/etc/passwd"],
        'Port Scan': ["SYN", "ACK", "FIN"]
    }
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🔍 IDS/IPS: فحص الحزمة\\n"
    ناتج += "═══════════════════════════════════\\n"
    صحيح وجد = خطأ
    لكل (نوع في أنماط_هجمات) {
        لكل (نمط في أنماط_هجمات[نوع]) {
            اذا (الحزمة.toUpperCase().indexOf(نمط.toUpperCase()) !== -1) {
                ناتج += "🚨 تم رصد: " + نوع + " (نمط: " + نمط + ")\\n"
                وجد = صواب
            }
        }
    }
    اذا (!وجد) {
        ناتج += "✅ الحزمة آمنة - لا توجد هجمات مكتشفة\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

# ═══════════════════════════════════════════════════════
# VPN: الشبكات الافتراضية
# ═══════════════════════════════════════════════════════

دالة محاكاة_VPN(نص الخادم) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🔐 محاكاة اتصال VPN\\n"
    ناتج += "═══════════════════════════════════\\n"
    ناتج += "🌐 الخادم: " + الخادم + "\\n"
    ناتج += "📡 البروتوكول: WireGuard\\n"
    ناتج += "🔑 التشفير: ChaCha20-Poly1305\\n"
    ناتج += "📊 حالة الاتصال: متصل\\n"
    ناتج += "🛡️ IP الظاهر: 10.0.0." + Math.floor(Math.random() * 255) + "\\n"
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

# ═══════════════════════════════════════════════════════
# تأمين WiFi
# ═══════════════════════════════════════════════════════

دالة فحص_WiFi(نص اسم_الشبكة) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "📶 فحص أمان الشبكة اللاسلكية\\n"
    ناتج += "═══════════════════════════════════\\n"
    ناتج += "🌐 اسم الشبكة: " + اسم_الشبكة + "\\n"
    ناتج += "📊 البروتوكول: WPA3\\n"
    ناتج += "🔑 التشفير: AES-256\\n"
    ناتج += "✅ WPS: معطّل\\n"
    ناتج += "✅ المسمى: مخفي\\n"
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

# ═══════════════════════════════════════════════════════
# DNS وDHCP
# ═══════════════════════════════════════════════════════

دالة فحص_DNS(نص النطاق) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🌐 فحص DNS: " + النطاق + "\\n"
    ناتج += "═══════════════════════════════════\\n"
    ناتج += "📋 السجلات:\\n"
    ناتج += "  A: 192.168.1." + Math.floor(Math.random() * 255) + "\\n"
    ناتج += "  MX: mail." + النطاق + "\\n"
    ناتج += "  NS: ns1." + النطاق + "\\n"
    ناتج += "  TXT: v=spf1 include:" + النطاق + " ~all\\n"
    ناتج += "🛡️ DNSSEC: مفعّل\\n"
    ناتج += "🔒 DoH: مدعوم\\n"
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

دالة كشف_DNS_مشبوه(نص الرابط) -> نص {
    صحيح نطاقات_مشبوهة = ['bit.ly', 'tinyurl.com', 'goo.gl', 't.co', 'is.gd']
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🔍 فحص DNS مشبوه\\n"
    ناتج += "═══════════════════════════════════\\n"
    صحيح مشبوه = خطأ
    لكل (نطاق في نطاقات_مشبوهة) {
        اذا (الرابط.indexOf(نطاق) !== -1) {
            مشبوه = صواب
        }
    }
    اذا (مشبوه) {
        ناتج += "⚠️ الرابط يستخدم نطاق مختصر مشبوه!\\n"
        ناتج += "💡 يُنصح بالتحقق من الرابط الفعلي\\n"
    } وإلا {
        ناتج += "✅ النطاق يبدو طبيعياً\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

# ═══════════════════════════════════════════════════════
# بروتوكولات الشبكة
# ═══════════════════════════════════════════════════════

دالة حلل_بروتوكول(صحيح المنفذ) -> نص {
    صحيح بروتوكولات = {
        80: { اسم: "HTTP", الحالة: "⚠️ غير آمن" },
        443: { اسم: "HTTPS", الحالة: "✅ آمن (TLS)" },
        22: { اسم: "SSH", الحالة: "✅ آمن" },
        21: { اسم: "FTP", الحالة: "❌ غير آمن" },
        23: { اسم: "Telnet", الحالة: "❌ غير آمن" },
        25: { اسم: "SMTP", الحالة: "⚠️ قد يكون غير آمن" },
        53: { اسم: "DNS", الحالة: "⚠️ UDP غير آمن" },
        3306: { اسم: "MySQL", الحالة: "⚠️ يجب تأمينه" },
        5432: { اسم: "PostgreSQL", الحالة: "⚠️ يجب تأمينه" },
        8080: { اسم: "HTTP Proxy", الحالة: "⚠️ غير آمن" }
    }
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "📊 تحليل البروتوكول\\n"
    ناتج += "═══════════════════════════════════\\n"
    اذا (بروتوكولات[المنفذ]) {
        صحيح بروتوكول = بروتوكولات[المنفذ]
        ناتج += "🔌 المنفذ: " + المنفذ + "\\n"
        ناتج += "📡 البروتوكول: " + بروتوكول.اسم + "\\n"
        ناتج += "🛡️ الحالة: " + بروتوكول.الحالة + "\\n"
    } وإلا {
        ناتج += "🔌 المنفذ: " + المنفذ + "\\n"
        ناتج += "📡 البروتوكول: غير معروف\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

# ═══════════════════════════════════════════════════════
# مراقبة الشبكة (Network Monitoring)
# ═══════════════════════════════════════════════════════

دالة مراقبة_الشبكة(مصفوفة الحزم[]) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "📡 مراقبة الشبكة\\n"
    ناتج += "═══════════════════════════════════\\n"
    صحيح إجمالي = الحزم.length
    صحيح مشبوه = 0
    صحيح عادي = 0
    لكل (حزمة في الحزم) {
        اذا (حزمة.indexOf('SYN') !== -1 || حزمة.indexOf('ACK') !== -1 || حزمة.indexOf('FIN') !== -1) {
            مشبوه++
        } وإلا {
            عادي++
        }
    }
    ناتج += "📊 إجمالي الحزم: " + إجمالي + "\\n"
    ناتج += "✅ حزم عادية: " + عادي + "\\n"
    ناتج += "⚠️ حزم مشبوهة: " + مشبوه + "\\n"
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

دالة التقاط_حزم(صحيح العدد) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🔍 التقاط " + العدد + " حزمة\\n"
    ناتج += "═══════════════════════════════════\\n"
    لكل (صحيح i = 0; i < العدد; i++) {
        صحيح src = "192.168.1." + Math.floor(Math.random() * 255)
        صحيح dst = "10.0.0." + Math.floor(Math.random() * 255)
        صحيح بروتوكول = ["TCP", "UDP", "ICMP"][Math.floor(Math.random() * 3)]
        صحيح منفذ = [80, 443, 22, 53, 3306][Math.floor(Math.random() * 5)]
        ناتج += "[" + (i+1) + "] " + src + " → " + dst + " (" + بروتوكول + ":" + منفذ + ")\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

# ═══════════════════════════════════════════════════════
# استخراج البيانات (Data Extraction)
# ═══════════════════════════════════════════════════════

دالة استخراج_بيانات(نص المسار) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "💾 استخراج البيانات من: " + المسار + "\\n"
    ناتج += "═══════════════════════════════════\\n"
    صحيح توقيعات = {
        'FFD8FF': 'JPEG',
        '89504E47': 'PNG',
        '25504446': 'PDF',
        '504B0304': 'ZIP',
        '52617221': 'RAR',
        '4D5A': 'EXE',
        '7F454C46': 'ELF'
    }
    ناتج += "📋 التوقيعات المكتشفة:\\n"
    لكل (توقيع في توقيعات) {
        ناتج += "  " + توقيع + ": " + توقيعات[توقيع] + "\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

دالة استرجاع_محذوفات(نص القرص) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "♻️ استرجاع البيانات المحذوفة من: " + القرص + "\\n"
    ناتج += "═══════════════════════════════════\\n"
    ناتج += "🔍 جاري البحث في sectors غير المستخدمة...\\n"
    ناتج += "📁 تم اكتشاف 47 ملف محذوف\\n"
    ناتج += "  ├── 12 ملف JPEG\\n"
    ناتج += "  ├── 8 ملفات PDF\\n"
    ناتج += "  ├── 15 ملف نصي\\n"
    ناتج += "  └── 12 ملف آخر\\n"
    ناتج += "✅ تم استرجاع 43 من 47 ملف بنجاح\\n"
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

# ═══════════════════════════════════════════════════════
# تحليل الذاكرة (Memory Forensics)
# ═══════════════════════════════════════════════════════

دالة تحليل_الذاكرة(نص ملف_الذاكرة) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🧠 تحليل الذاكرة\\n"
    ناتج += "═══════════════════════════════════\\n"
    ناتج += "📄 الملف: " + ملف_الذاكرة + "\\n"
    ناتج += "📊 الحجم: " + Math.floor(Math.random() * 4096) + " MB\\n"
    ناتج += "═══════════════════════════════════\\n"
    ناتج += "🔍 العمليات الجارية:\\n"
    ناتج += "  PID 4: System (نظام)\\n"
    ناتج += "  PID 128: explorer.exe (مستخدم)\\n"
    ناتج += "  PID 3456: chrome.exe (متصفح)\\n"
    ناتج += "  PID 7890: suspicious.exe ⚠️\\n"
    ناتج += "═══════════════════════════════════\\n"
    ناتج += "🔑 كلمات المرور المكتشفة:\\n"
    ناتج += "  admin: *** (مشفرة)\\n"
    ناتج += "  root: *** (مشفرة)\\n"
    ناتج += "═══════════════════════════════════\\n"
    ناتج += "🌐 اتصالات الشبكة:\\n"
    ناتج += "  192.168.1.100:443 ← → 185.220.101.1:80 ⚠️\\n"
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

دالة كشف_عمليات_مشبوهة() -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🔍 كشف عمليات مشبوهة\\n"
    ناتج += "═══════════════════════════════════\\n"
    صحيح عمليات = [
        {اسم: "chrome.exe", PID: 3456, الحالة: "✅ عادي"},
        {اسم: "svchost.exe", PID: 892, الحالة: "✅ عادي"},
        {اسم: "cmd.exe", PID: 5678, الحالة: "⚠️ مشبوه"},
        {اسم: "powershell.exe", PID: 9012, الحالة: "⚠️ مشبوه"},
        {اسم: "mimikatz.exe", PID: 3456, الحالة: "🚨 خبيث"}
    ]
    لكل (عملية في عمليات) {
        ناتج += "  PID " + عملية.PID + ": " + عملية.اسم + " - " + عملية.الحالة + "\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

