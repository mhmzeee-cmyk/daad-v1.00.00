    ارجع مصفوفة
}

دالة ابحث_في(أي[] مصفوفة، أي عنصر) -> صحيح {
    ارجع مصفوفة.indexOf(عنصر)
}

دالة فرز(أي[] مصفوفة) -> أي[] {
    ارجع مصفوفة.slice().sort()
}

دالة عكس_مصفوفة(أي[] مصفوفة) -> أي[] {
    ارجع مصفوفة.slice().reverse()
}

دالة مسطح(أي[][] مصفوفة) -> أي[] {
    ارجع مصفوفة.flat()
}

دالة تصفية(أي[] مصفوفة، دالة فلتر) -> أي[] {
    ارجع مصفوفة.filter(فلتر)
}

دالة تحويل(أي[] مصفوفة، دالة محول) -> أي[] {
    ارجع مصفوفة.map(محول)
}

دالة مجموع(أي[] مصفوفة) -> صحيح {
    ارجع مصفوفة.reduce(function(a, b) { return a + b }, 0)
}

دالة يوجد(أي[] مصفوفة، دالة شرط) -> صحيح {
    ارجع مصفوفة.some(شرط)
}

دالة يوجد_الكل(أي[] مصفوفة، دالة شرط) -> صحيح {
    ارجع مصفوفة.every(شرط)
}

دالة طول_مصفوفة(أي[] مصفوفة) -> صحيح {
    ارجع مصفوفة.length
}

# ═══════════════════════════════════════════════════════
