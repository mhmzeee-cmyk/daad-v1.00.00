# ═══════════════════════════════════════════════════════
# مكتبة النصوص - Text Operations
# ═══════════════════════════════════════════════════════

دالة طول(نص s) -> صحيح {
    ارجع s.length
}

دالة استخرج(نص s، صحيح من، صحيح إلى) -> نص {
    ارجع s.substring(من، إلى)
}

دالة ابحث(نص s، نص استعلام) -> صحيح {
    ارجع s.indexOf(استعلام)
}

دالة استبدل(نص s، نص قديم، نص جديد) -> نص {
    ارجع s.replace(قديم، جديد)
}

دالة صغير(نص s) -> نص {
    ارجع s.toLowerCase()
}

دالة كبير(نص s) -> نص {
    ارجع s.toUpperCase()
}

دالة نظف(نص s) -> نص {
    ارجع s.trim()
}

دالة يبدأ_بـ(نص s، نص بادئ) -> صحيح {
    ارجع s.startsWith(بادئ)
}

دالة ينتهي_بـ(نص s، نص لاحق) -> صحيح {
    ارجع s.endsWith(لاحق)
}

دالة قسّم(نص s، نص فاصل) -> نص[] {
    ارجع s.split(فاصل)
}

دالة يحتوي(نص s، نص بحث) -> صحيح {
    ارجع s.includes(بحث)
}

دالة عكس(نص s) -> نص {
    ارجع s.split('').reverse().join('')
}

دالة كرر(نص s، صحيح عدد) -> نص {
    ارجع s.repeat(عدد)
}

دالة حرف_في(نص s، صحيح موقع) -> نص {
    ارجع s.charAt(موقع)
}
      `
