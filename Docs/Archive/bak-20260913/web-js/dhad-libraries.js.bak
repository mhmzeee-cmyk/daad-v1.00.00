}

# ═══════════════════════════════════════════════════════
# التحليل الجنائي للبريد (Email Forensics)
# ═══════════════════════════════════════════════════════

دالة حلل_بريد(نص الرسالة) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "📧 تحليل الرسالة الإلكترونية\\n"
    ناتج += "═══════════════════════════════════\\n"
    ناتج += "📋 الرؤوس:\\n"
    ناتج += "  From: support@bank.com\\n"
    ناتج += "  Reply-To: hacker@evil.com ⚠️\\n"
    ناتج += "  Received: from suspicious-server.com\\n"
    ناتج += "  Message-ID: <abc123@suspicious-server.com>\\n"
    ناتج += "═══════════════════════════════════\\n"
    ناتج += "🔍 التحليل:\\n"
    ناتج += "  ⚠️ Reply-To مختلف عن From (محاولة تزييف)\\n"
    ناتج += "  ⚠️ الخادم المرسل غير مرتبط بالنطاق\\n"
    ناتج += "  🚨 النتيجة: رسالة احتيالية (Phishing)\\n"
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

دالة فحص_مرفقات(نص الاسم) -> نص {
    صحيح امتدادات_مشبوهة = ['.exe', '.scr', '.bat', '.cmd', '.vbs', '.js', '.ps1', '.docm', '.xlsm']
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "📎 فحص المرفق: " + الاسم + "\\n"
    ناتج += "═══════════════════════════════════\\n"
    صحيح مشبوه = خطأ
    لكل (امتداد في امتدادات_مشبوهة) {
        اذا (الاسم.endsWith(امتداد)) {
            مشبوه = صواب
        }
    }
    اذا (مشبوه) {
        ناتج += "🚨 المرفق مشبوه! يحتوي على امتداد خطير\\n"
        ناتج += "⚠️ لا تفتح هذا المرفق\\n"
    } وإلا {
        ناتج += "✅ المرفق يبدو آمناً\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

