# ═══════════════════════════════════════════════════════
# مكتبة الشبكات - Networking
# ═══════════════════════════════════════════════════════

دالة GET(نص عنوان) -> موعود {
    ارجع fetch(عنوان).then(function(res) {
        اذا (res.ok) { ارجع res.json() }
        ارجع Promise.reject('خطأ: ' + res.status)
    })
}

دالة POST(نص عنوان، أي بيانات) -> موعود {
    ارجع fetch(عنوان، {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(بيانات)
    }).then(function(res) { ارجع res.json() })
}

دالة PUT(نص عنوان، أي بيانات) -> موعود {
    ارجع fetch(عنوان، {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(بيانات)
    }).then(function(res) { ارجع res.json() })
}

دالة DELETE(نص عنوان) -> موعود {
    ارجع fetch(عنوان، { method: 'DELETE' }).then(function(res) { ارجع res.json() })
}

دالة تحميل_ملف(نص عنوان) -> موعود {
    ارجع fetch(عنوان).then(function(res) { ارجع res.text() })
}

دالة تحميل_JSON(نص عنوان) -> موعود {
    ارجع fetch(عنوان).then(function(res) { ارجع res.json() })
}
      `
