    'الاختبارات': {
      name: 'الاختبارات',
      icon: '🧪',
      desc: 'كتابة وتشغيل الاختبارات',
      code: `
# ═══════════════════════════════════════════════════════
# مكتبة الاختبارات - Testing
# ═══════════════════════════════════════════════════════

ثابت _نتائج_الاختبار = []
ثابت _الاسم_الحالي = ""

دالة وصف(نص اسم، دالة دالة) {
    _الاسم_الحالي = اسم
    طباعة("📝 " + اسم)
    دالة()
}

دالة it(نص اسم، دالة دالة) {
    _نتائج_الاختبار.push({
        suite: _الاسم_الحالي,
        name: اسم,
        passed: false,
        error: null
    })
    حاول {
        دالة()
        _نتائج_الاختبار[_نتائج_الاختبار.length - 1].passed = true
        طباعة("  ✅ " + اسم)
    } امسك (خطأ) {
        _نتائج_الاختبار[_نتائج_الاختبار.length - 1].error = خطأ
        طباعة("  ❌ " + اسم + ": " + خطأ)
    }
}

دالة توقع(أي قيمة) -> أي {
    ارجع {
        toEqual: function(أي متوقع) {
            اذا (قيمة !== متوقع) {
                throw "متوقع " + متوقع + " لكن حصل " + قيمة
            }
        },
        toBeTruthy: function() {
            اذا (!قيمة) {
                throw "متوقع قيمة صحيحة لكن حصل " + قيمة
            }
        },
        toBeFalsy: function() {
            اذا (قيمة) {
                throw "متوقع قيمة خاطئة لكن حصل " + قيمة
            }
        },
        toBeGreaterThan: function(صحيح رقم) {
            اذا (قيمة <= رقم) {
                throw "متوقع أكبر من " + رقم + " لكن حصل " + قيمة
            }
        },
        toContain: function(أي عنصر) {
            اذا (قيمة.indexOf(عنصر) === -1) {
                throw "متوقع يحتوي على " + عنصر
            }
        }
    }
}

دالة تقرير() {
    طباعة("\\n═══════════════════════════════════════")
    طباعة("📊 تقرير الاختبارات")
    طباعة("═══════════════════════════════════════")
    صحيح عدد_الصحيحة = 0
    صحيح عدد_الخاطئة = 0
    لكل (نتيجة في _نتائج_الاختبار) {
        اذا (نتيجة.passed) {
            عدد_الصحيحة++
        } وإلا {
            عدد_الخاطئة++
        }
    }
    طباعة("✅ صحيح: " + عدد_الصحيحة)
    طباعة("❌ خاطئ: " + عدد_الخاطئة)
    طباعة("═══════════════════════════════════════")
    اذا (عدد_الخاطئة === 0) {
        طباعة("🎉 جميع الاختبارات نجحت!")
    } وإلا {
        طباعة("⚠️ بعض الاختبارات فشلت")
    }
}
      `
