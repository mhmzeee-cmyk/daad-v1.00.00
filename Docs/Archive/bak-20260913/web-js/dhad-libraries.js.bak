# ═══════════════════════════════════════════════════════
# أدوات HTML المتقدمة
# ═══════════════════════════════════════════════════════

دالة صفحة كاملة(نص العنوان, نص المحتوى) -> نص {
    ارجع '<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><title>' + العنوان + '</title><style>body{font-family:sans-serif;margin:40px;line-height:1.8}h1{color:#333}.container{max-width:800px;margin:0 auto}</style></head><body><div class="container">' + المحتوى + '</div></body></html>'
}

دالة ترويسة(نص العنوان, نص الوصف) -> نص {
    ارجع '<header style="background:#1a1a2e;color:white;padding:40px 20px;text-align:center;border-radius:12px;margin-bottom:24px"><h1 style="margin:0">' + العنوان + '</h1><p style="margin:10px 0 0;opacity:0.8">' + الوصف + '</p></header>'
}

دالة تذييل(نص النص) -> نص {
    ارجع '<footer style="background:#f5f5f5;padding:20px;text-align:center;border-radius:8px;margin-top:24px;color:#666">' + النص + '</footer>'
}

دالة شبكة(مصفوفة العناصر[]) -> نص {
    صحيح ناتج = '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px">'
    لكل (عنصر في العناصر) {
        ناتج += '<div style="border:1px solid #ddd;border-radius:8px;padding:16px">' + عنصر + '</div>'
    }
    ارجع ناتج + '</div>'
}

دالة شريط_تنقل(مصفوفة روابط[]) -> نص {
    صحيح ناتج = '<nav style="background:#333;padding:12px 20px;display:flex;gap:20px;border-radius:8px;margin-bottom:24px">'
    لكل (رابط في الروابط) {
        ناتج += '<a href="' + رابط[1] + '" style="color:white;text-decoration:none">' + رابط[0] + '</a>'
    }
    ارجع ناتج + '</nav>'
}

دالة زر(نص النص, نص الرابط) -> نص {
    ارجع '<a href="' + الرابط + '" style="display:inline-block;background:#007bff;color:white;padding:10px 20px;border-radius:6px;text-decoration:none;margin:4px">' + النص + '</a>'
}

دالة حقل_إدخال(نص التسمية, نص النوع, نص الاسم) -> نص {
    ارجع '<div style="margin-bottom:12px"><label style="display:block;margin-bottom:4px;font-weight:bold">' + التسمية + '</label><input type="' + النوع + '" name="' + الاسم + '" style="width:100%;padding:8px;border:1px solid #ccc;border-radius:4px"></div>'
}

# ═══════════════════════════════════════════════════════
# أدوات CSS المتقدمة (Flexbox + Grid)
# ═══════════════════════════════════════════════════════

دالة تخطيط_مرن(مصفوفة العناصر[], نص الاتجاه) -> نص {
    صحيح ناتج = '<div style="display:flex;flex-direction:' + (الاتجاه || 'row') + ';gap:16px;flex-wrap:wrap">'
    لكل (عنصر في العناصر) {
        ناتج += '<div style="flex:1;min-width:200px">' + عنصر + '</div>'
    }
    ارجع ناتج + '</div>'
}

دالة تخطيط_شبكة(صحيح الأعمدة, مصفوفة العناصر[]) -> نص {
    صحيح ناتج = '<div style="display:grid;grid-template-columns:repeat(' + الأعمدة + ',1fr);gap:16px">'
    لكل (عنصر في العناصر) {
        ناتج += '<div style="padding:16px;border:1px solid #ddd;border-radius:8px">' + عنصر + '</div>'
    }
    ارجع ناتج + '</div>'
}

دالة تخطيط_جانبي(نص المحتوى, نص الجانبي) -> نص {
    ارجع '<div style="display:grid;grid-template-columns:2fr 1fr;gap:24px"><div>' + المحتوى + '</div><aside style="background:#f5f5f5;padding:16px;border-radius:8px">' + الجانبي + '</aside></div>'
}

دالة بطاقة_متحركة(نص العنوان, نص المحتوى, نص اللون) -> نص {
    ارجع '<div style="background:' + (اللون || '#fff') + ';border:1px solid #ddd;border-radius:12px;padding:20px;transition:transform 0.2s,box-shadow 0.2s;cursor:pointer" onmouseover="this.style.transform=\'translateY(-4px)\';this.style.boxShadow=\'0 8px 24px rgba(0,0,0,0.15)\'" onmouseout="this.style.transform=\'none\';this.style.boxShadow=\'none\'"><h3 style="margin-top:0">' + العنوان + '</h3><p>' + المحتوى + '</p></div>'
}

دالة عمود_مرن(نص العنوان, مصفوفة العناصر[]) -> نص {
    صحيح ناتج = '<div style="display:flex;flex-direction:column;gap:12px"><h3>' + العنوان + '</h3>'
    لكل (عنصر في العناصر) {
        ناتج += '<div style="padding:12px;background:#f9f9f9;border-radius:6px">' + عنصر + '</div>'
    }
    ارجع ناتج + '</div>'
}

دالة مركز(نص المحتوى) -> نص {
    ارجع '<div style="display:flex;justify-content:center;align-items:center;min-height:200px">' + المحتوى + '</div>'
}

دالة فاصل() -> نص {
    ارجع '<hr style="border:none;border-top:1px solid #ddd;margin:24px 0">'
}
      `
    },

    'المحرك_الرسومي': {
      name: 'المحرك_الرسومي',
      icon: '🎮',
      desc: 'محرك رسومي ثنائي الأبعاد للألعاب والرسوم المتحركة',
      code: `
# ═══════════════════════════════════════════════════════
# محرك رسومي ثنائي الأبعاد - 2D Graphics Engine
# ═══════════════════════════════════════════════════════

# متغيرات مشتركة للمحرك
صحيح __محرك_العرض = 800
صحيح __محرك_الارتفاع = 600
أي __محرك_اللوحة = عدم
أي __محرك_السياق = عدم
صحيح __محرك_الإطار = 0
صحيح __محرك_السرعة = 60
منطقي __محرك_يعمل = خطأ
صحيح __محرك_الوقت = 0
نص __محرك_اللون = "#000000"

# كائنات المفاتيح
صحيح __مفاتيح = {}
صحيح __آخر_مفتاح = ""

# كائنات الفأرة (Mouse)
صحيح __نقر_حدث = خطأ
صحيح __نقر_x = 0
صحيح __نقر_y = 0
صحيح __فأرة_x = -1
صحيح __فأرة_y = -1

# ═══════════════════════════════════════════════════════
# إنشاء المحرك
# ═══════════════════════════════════════════════════════

دالة محرك_جديد(صحيح عرض، صحيح ارتفاع) -> أي {
    __محرك_العرض = عرض || 800
    __محرك_الارتفاع = ارتفاع || 600
    
    # البحث عن لوحة موجودة أو إنشاء جديدة
    __محرك_اللوحة = document.getElementById('previewCanvas') || document.getElementById('dhad-canvas')
    اذا (!__محرك_اللوحة) {
        __محرك_اللوحة = document.createElement('canvas')
        __محرك_اللوحة.id = 'dhad-canvas'
        __محرك_اللوحة.style.cssText = 'display:block;margin:0 auto;border:2px solid #333;border-radius:8px;background:#000'
        document.body.appendChild(__محرك_اللوحة)
    }
    __محرك_اللوحة.width = __محرك_العرض
    __محرك_اللوحة.height = __محرك_الارتفاع
    __محرك_السياق = __محرك_اللوحة.getContext('2d')
    
    # تهيئة المفاتيح
    __محرك_اللوحة.tabIndex = 1
    __محرك_اللوحة.focus()
    
    document.addEventListener('keydown', function(e) {
        __مفاتيح[e.key] = صواب
        __آخر_مفتاح = e.key
        if (['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].indexOf(e.key) !== -1) {
            e.preventDefault()
        }
        # Handle inline input field typing
        if (__input_focused >= 0 && __input_texts) {
            if (e.key === 'Backspace') {
                __input_texts[__input_focused] = __input_texts[__input_focused].slice(0, -1)
                e.preventDefault()
            } else if (e.key === 'Enter') {
                __input_focused = -1
                e.preventDefault()
            } else if (e.key.length === 1) {
                __input_texts[__input_focused] += e.key
                e.preventDefault()
            }
        }
    })
    document.addEventListener('keyup', function(e) {
        __مفاتيح[e.key] = خطأ
    })
    
    # تهيئة الفأرة
    __محرك_اللوحة.addEventListener('click', function(e) {
        var rect = __محرك_اللوحة.getBoundingClientRect();
        var scaleX = __محرك_العرض / rect.width;
        var scaleY = __محرك_الارتفاع / rect.height;
        __نقر_x = Math.round((e.clientX - rect.left) * scaleX);
        __نقر_y = Math.round((e.clientY - rect.top) * scaleY);
        __نقر_حدث = صواب
    })
    __محرك_اللوحة.addEventListener('mousemove', function(e) {
        var rect = __محرك_اللوحة.getBoundingClientRect();
        var scaleX = __محرك_العرض / rect.width;
        var scaleY = __محرك_الارتفاع / rect.height;
        __فأرة_x = Math.round((e.clientX - rect.left) * scaleX);
        __فأرة_y = Math.round((e.clientY - rect.top) * scaleY);
    })
    __محرك_اللوحة.addEventListener('mouseleave', function(e) {
        __فأرة_x = -1
        __فأرة_y = -1
    })
    
    طباعة("✓ تم إنشاء المحرك: " + __محرك_العرض + "x" + __محرك_الارتفاع)
    ارجع __محرك_السياق
}

# ═══════════════════════════════════════════════════════
# رسم basic shapes
# ═══════════════════════════════════════════════════════

دالة مسح_الشاشة(نص لون) {
    __محرك_السياق.fillStyle = لون || "#000000"
    __محرك_السياق.fillRect(0, 0, __محرك_العرض, __محرك_الارتفاع)
}

دالة ارسم_مستطيل(صحيح x، صحيح y، صحيح عرض، صحيح ارتفاع، نص لون) {
    __محرك_السياق.fillStyle = لون || "#ffffff"
    __محرك_السياق.fillRect(x, y, عرض، ارتفاع)
}

دالة ارسم_دائرة(صحيح x، صحيح y، صحيح نصف_القطر، نص لون) {
    __محرك_السياق.beginPath()
    __محرك_السياق.arc(x, y، نصف_القطر، 0، Math.PI * 2)
    __محرك_السياق.fillStyle = لون || "#ffffff"
    __محرك_السياق.fill()
}

دالة ارسم_خط(صحيح x1، صحيح y1، صحيح x2، صحيح y2، نص لون، صحيح عرض) {
    __محرك_السياق.beginPath()
    __محرك_السياق.moveTo(x1, y1)
    __محرك_السياق.lineTo(x2, y2)
    __محرك_السياق.strokeStyle = لون || "#ffffff"
    __محرك_السياق.lineWidth = عرض || 2
    __محرك_السياق.stroke()
}

دالة ارسم_نص(نص نص، صحيح x، صحيح y، نص لون، صحيح حجم) {
    __محرك_السياق.font = (حجم || 20) + 'px Arial'
    __محرك_السياق.fillStyle = لون || "#ffffff"
    __محرك_السياق.fillText(نص, x, y)
}

دالة ارسم_مستطيل_مفرغ(صحيح x، صحيح y، صحيح عرض، صحيح ارتفاع، نص لون، صحيح سمك) {
    __محرك_السياق.strokeStyle = لون || "#ffffff"
    __محرك_السياق.lineWidth = سمك || 2
    __محرك_السياق.strokeRect(x, y، عرض، ارتفاع)
}

دالة ارسم_دائرة_مفرغة(صحيح x، صحيح y، صحيح نصف_القطر، نص لون، صحيح سمك) {
    __محرك_السياق.beginPath()
    __محرك_السياق.arc(x, y، نصف_القطر، 0، Math.PI * 2)
    __محرك_السياق.strokeStyle = لون || "#ffffff"
    __محرك_السياق.lineWidth = سمك || 2
    __محرك_السياق.stroke()
}

# ═══════════════════════════════════════════════════════
# إدخال المفاتيح
# ═══════════════════════════════════════════════════════

دالة مفتاح_مضغوط(نص مفتاح) -> منطقي {
    اذا (__مفاتيح[مفتاح]) { ارجع صواب }
    ارجع خطأ
}

دالة احصل_على_مفتاح() -> نص {
    صحيح مفتاح = __آخر_مفتاح
    __آخر_مفتاح = ""
    ارجع مفتاح
}

# ═══════════════════════════════════════════════════════
# إدخال الفأرة (Mouse Input)
# ═══════════════════════════════════════════════════════

دالة نقر_في_نطاق(صحيح x، صحيح y، صحيح عرض، صحيح ارتفاع) -> منطقي {
    اذا (__نقر_x >= x && __نقر_x <= x + عرض && __نقر_y >= y && __نقر_y <= y + ارتفاع) {
        ارجع صواب
    }
    ارجع خطأ
}

دالة فأرة_في_نطاق(صحيح x، صحيح y، صحيح عرض، صحيح ارتفاع) -> منطقي {
    اذا (__فأرة_x >= x && __فأرة_x <= x + عرض && __فأرة_y >= y && __فأرة_y <= y + ارتفاع) {
        ارجع صواب
    }
    ارجع خطأ
}

دالة نقر_في_دائرة(صحيح مركز_x، صحيح مركز_y، صحيح نصف_القطر) -> منطقي {
    صحيح dx = __نقر_x - مركز_x
    صحيح dy = __نقر_y - مركز_y
    اذا (dx * dx + dy * dy <= نصف_القطر * نصف_القطر) {
        ارجع صواب
    }
    ارجع خطأ
}

دالة اضغط_زر(صحيح x، صحيح y، صحيح عرض، صحيح ارتفاع، نص نص، نص لون) -> منطقي {
    صحيح يمر = خطأ
    اذا (__فأرة_x >= x && __فأرة_x <= x + عرض && __فأرة_y >= y && __فأرة_y <= y + ارتفاع) {
        يمر = صواب
    }
    
    # تأثير الظل
    ارسم_مستطيل(x + 2, y + 2، عرض، ارتفاع، "rgba(0,0,0,0.3)")
    
    # رسم الزر مع تأثير التمرير
    اذا (يمر) {
        ارسم_مستطيل(x, y، عرض، ارتفاع، لون || "#3b82f6")
        ارسم_مستطيل_مفرغ(x, y، عرض، ارتفاع، "#93c5fd"، 3)
    } وإلا {
        ارسم_مستطيل(x, y، عرض، ارتفاع، لون || "#2563eb")
        ارسم_مستطيل_مفرغ(x, y، عرض، ارتفاع، "#60a5fa"، 2)
    }
    
    # رسم النص في المركز
    صحيح حجم = 18
    اذا (عرض < 80 || ارتفاع < 40) { حجم = 14 }
    صحيح عرض_الكتابة = __محرك_السياق.measureText(نص).width
    صحيح نقطة_x = x + (عرض - عرض_الكتابة) / 2
    صحيح نقطة_y = y + ارتفاع / 2 + حجم / 3
    ارسم_نص(نص، نقطة_x، نقطة_y، "#fff"، حجم)
    
    # فحص النقرة
    اذا (__نقر_حدث && __نقر_x >= x && __نقر_x <= x + عرض && __نقر_y >= y && __نقر_y <= y + ارتفاع) {
        ارجع صواب
    }
    ارجع خطأ
}

# ═══════════════════════════════════════════════════════
# الرسوم المتحركة
# ═══════════════════════════════════════════════════════

دالة ابدأ_التحريك(دالة معالج) {
    __محرك_يعمل = صواب
    __محرك_الوقت = Date.now()
    
    دالة حلقة() {
        اذا (!__محرك_يعمل) { ارجع }
        
        # Check if input is pending — pause animation loop
        اذا (window.__dhad_pendingInput) { ارجع }
        
        # Reset inline input counter for this frame
        __reset_inputs()
        
        صحيح الآن = Date.now()
        صحيح الفرق = الآن - __محرك_الوقت
        __محرك_الوقت = الآن
        __محرك_الإطار++
        
        # If input was just submitted, simulate Enter key press for the callback
        اذا (window.__dhad_inputReady) {
            window.__dhad_inputReady = خطأ
            __مفاتيح["Enter"] = صواب
        }
        
        # استدعاء المعالج مع الوقت المنصرم (مع معالجة خطأ الإدخال)
        حاول {
            معالج(الفرق)
        } أمسك (e) {
            # تجاهل خطأ الإدخال (يتم معالجته من قبل النظام)
        }
        
        # مسح النقرة بعد المعالجة
        __نقر_حدث = خطأ
        
        # طلب الإطار التالي
        requestAnimationFrame(حلقة)
    }
    
    # Store loop reference for resume after input
    window.__dhad_loopFn = حلقة
    window.__dhad_continue = دالة() {
        window.__dhad_pendingInput = خطأ
        __محرك_يعمل = صواب
        requestAnimationFrame(window.__dhad_loopFn)
    }
    
    requestAnimationFrame(حلقة)
    طباعة("✓ بدأ التحريك")
}

دالة أوقف_التحريك() {
    __محرك_يعمل = خطأ
    طباعة("✓ تم إيقاف التحريك")
}

# ═══════════════════════════════════════════════════════
# مساعدة
# ═══════════════════════════════════════════════════════

دالة عرض_الشاشة() -> صحيح {
    ارجع __محرك_العرض
}

دالة ارتفاع_الشاشة() -> صحيح {
    ارجع __محرك_الارتفاع
}

دالة لون_الخلفية(نص لون) {
    __محرك_اللون = لون
    مسح_الشاشة(لون)
}

دالة ارسم_صورة(أي صورة، صحيح x، صحيح y، صحيح عرض، صحيح ارتفاع) {
    اذا (صورة && صورة.complete) {
        اذا (عرض && ارتفاع) {
            __محرك_السياق.drawImage(صورة, x, y، عرض، ارتفاع)
        } وإلا {
            __محرك_السياق.drawImage(صورة, x, y)
        }
    }
}

دالة حمّل_صورة(نص مصدر) -> أي {
    صحيح صورة = new Image()
    صورة.src = مصدر
    ارجع صورة
}

دالة ارسم_منحنى(صف مصفوفة نقاط، نص لون، صحيح سمك) {
    اذا (طول_مصفوفة(نقاط) < 2) { ارجع }
    __محرك_السياق.beginPath()
    __محرك_السياق.moveTo(نقاط[0][0]، نقاط[0][1])
    صحيح عداد = 1
    طالما (عداد < طول_مصفوفة(نقاط)) {
        __محرك_السياق.lineTo(نقاط[عداد][0]، نقاط[عداد][1])
        عداد++
    }
    __محرك_السياق.strokeStyle = لون || "#ffffff"
    __محرك_السياق.lineWidth = سمك || 2
    __محرك_السياق.stroke()
}

دالة ارسم_متعدد(صف مصفوفة نقاط، نص لون، منطقي مغلق) {
    اذا (طول_مصفوفة(نقاط) < 3) { ارجع }
    __محرك_السياق.beginPath()
    __محرك_السياق.moveTo(نقاط[0][0]، نقاط[0][1])
    صحيح عداد = 1
    طالما (عداد < طول_مصفوفة(نقاط)) {
        __محرك_السياق.lineTo(نقاط[عداد][0]، نقاط[عداد][1])
        عداد++
    }
    اذا (مغلق) { __محرك_السياق.closePath() }
    __محرك_السياق.fillStyle = لون || "#ffffff"
    __محرك_السياق.fill()
}

دالة لون_عشري(صحيح احمر، صحيح أخضر، صحيح أزرق) -> نص {
    ارجع "rgb(" + احمر + "," + أخضر + "," + أزرق + ")"
}

دالة لون_بـ_ألفا(صحيح احمر، صحيح أخضر، صحيح أزرق، عشري ألفا) -> نص {
    ارجع "rgba(" + احمر + "," + أخضر + "," + أزرق + "," + ألفا + ")"
}

دالة تصادف_بين(صحيح حد_أدنى، صحيح حد_أعلى) -> صحيح {
    ارجع Math.floor(Math.random() * (حد_أعلى - حد_أدنى + 1)) + حد_أدنى
}

دالة المسافة(x1, y1, x2, y2) -> عشري {
    صحيح dx = x2 - x1
    صحيح dy = y2 - y1
    ارجع Math.sqrt(dx * dx + dy * dy)
}

دالة يتداخل(x1, y1, عرض1، ارتفاع1، x2، y2، عرض2، ارتفاع2) -> منطقي {
    اذا (x1 < x2 + عرض2 && x1 + عرض1 > x2 && y1 < y2 + ارتفاع2 && y1 + ارتفاع1 > y2) {
        ارجع صواب
    }
    ارجع خطأ
}

# ═══════════════════════════════════════════════════
# حقول الإدخال Inline
# ═══════════════════════════════════════════════════

صحيح __input_count = 0
نص[] __input_texts = ["", "", "", "", ""]
صحيح[] __input_active = [0, 0, 0, 0, 0]
صحيح __input_focused = -1

دالة __reset_inputs() {
    __input_count = 0
}

دالة حقل_إدخال(صحيح x، صحيح y، صحيح عرض، صحيح ارتفاع، نص افتراضي) -> نص {
    صحيح معرف = __input_count
    __input_count++
    اذا (معرف >= 5) { ارجع "" }
    
    
    اذا (__نقر_حدث && __نقر_x >= x && __نقر_x <= x + عرض && __نقر_y >= y && __نقر_y <= y + ارتفاع) {
        صحيح i = 0
        طالما (i < 5) { __input_active[i] = 0; i++ }
        __input_active[معرف] = 1
        __input_focused = معرف
        __محرك_اللوحة.focus()
    }
    
    صحيح نشط = (__input_active[معرف] == 1)
    
    __محرك_اللوحة.textAlign = "right"
    اذا (نشط) {
        ارسم_مستطيل(x, y، عرض، ارتفاع، "#0f172a")
        ارسم_مستطيل_مفرغ(x, y، عرض، ارتفاع، "#10b981"، 3)
        صحيح عرض_الكتابة = __input_texts[معرف]
        اذا (عرض_الكتابة == "") { عرض_الكتابة = "|" }
        وإلا { عرض_الكتابة = عرض_الكتابة + "|" }
        ارسم_نص(عرض_الكتابة, x + عرض - 10, y + ارتفاع / 2 + 5, "#ffffff", 16)
    } وإلا {
        ارسم_مستطيل(x, y، عرض، ارتفاع، "#1a2332")
        ارسم_مستطيل_مفرغ(x, y، عرض، ارتفاع، "#10b981"، 2)
        صحيح عرض_الكتابة = __input_texts[معرف]
        اذا (عرض_الكتابة == "") { عرض_الكتابة = افتراضي || "اكتب هنا..." }
        ارسم_نص(عرض_الكتابة, x + عرض - 10, y + ارتفاع / 2 + 5, "#10b981", 16)
    }
    __محرك_اللوحة.textAlign = "left"
    
    ارجع __input_texts[معرف]
}

دالة حقل_أرقام(صحيح x، صحيح y، صحيح عرض، صحيح ارتفاع) -> نص {
    صحيح معرف = __input_count
    __input_count++
    اذا (معرف >= 5) { ارجع "" }
    
    اذا (__نقر_حدث && __نقر_x >= x && __نقر_x <= x + عرض && __نقر_y >= y && __نقر_y <= y + ارتفاع) {
        صحيح i = 0
        طالما (i < 5) { __input_active[i] = 0; i++ }
        __input_active[معرف] = 1
        __input_focused = معرف
        __محرك_اللوحة.focus()
    }
    
    صحيح نشط = (__input_active[معرف] == 1)
    
    __محرك_اللوحة.textAlign = "right"
    اذا (نشط) {
        ارسم_مستطيل(x, y، عرض، ارتفاع، "#0f172a")
        ارسم_مستطيل_مفرغ(x, y، عرض، ارتفاع، "#f59e0b"، 3)
        صحيح عرض_الكتابة = __input_texts[معرف]
        اذا (عرض_الكتابة == "") { عرض_الكتابة = "|" }
        وإلا { عرض_الكتابة = عرض_الكتابة + "|" }
        ارسم_نص(عرض_الكتابة, x + عرض - 10, y + ارتفاع / 2 + 5, "#ffffff", 16)
    } وإلا {
        ارسم_مستطيل(x, y، عرض، ارتفاع، "#1a2332")
        ارسم_مستطيل_مفرغ(x, y، عرض، ارتفاع، "#f59e0b"، 2)
        صحيح عرض_الكتابة = __input_texts[معرف]
        اذا (عرض_الكتابة == "") { عرض_الكتابة = "0" }
        ارسم_نص(عرض_الكتابة, x + عرض - 10, y + ارتفاع / 2 + 5, "#f59e0b", 16)
    }
    __محرك_اللوحة.textAlign = "left"
    
    ارجع __input_texts[معرف]
}

دالة فعّل_حقل(صحيح معرف) {
    صحيح i = 0
    طالما (i < 5) { __input_active[i] = 0; i++ }
    __input_active[معرفة] = 1
    __input_focused = معرف
}

دالة تعطّل_الحقول() {
    صحيح i = 0
    طالما (i < 5) { __input_active[i] = 0; i++ }
    __input_focused = -1
}

دالة ضعّ_نص_حقل(صحيح معرف، نص نص_الإدخال) {
    اذا (معرفة >= 0 && معرف < 5) { __input_texts[معرفة] = نص_الإدخال }
}

دالة احصل_على_نص_حقل(صحيح معرف) -> نص {
    اذا (معرفة >= 0 && معرف < 5) { ارجع __input_texts[معرفة] }
    ارجع ""
}

دالة امسح_حقل(صحيح معرف) {
    اذا (معرفة >= 0 && معرف < 5) { __input_texts[معرفة] = "" }
}
      `
    }
  };

  function getAll() {
    var result = [];
    for (var name in libraries) {
      result.push({
        name: name,
        icon: libraries[name].icon,
        desc: libraries[name].desc
      });
    }
    return result;
  }

  function getCode(name) {
    return libraries[name] ? libraries[name].code : '';
  }

  function getImportCode(name) {
    var lib = libraries[name];
    if (!lib) return '';
    return '# استورد "' + name + '"\n' + lib.code;
  }

  function getNames() {
    return Object.keys(libraries);
  }

  function getCategory(name) {
    var categories = {
      'النصوص': 'نصوص',
      'الرياضيات': 'رياضيات',
      'المصفوفات': 'هياكل بيانات',
      'الرسوميات': 'رسوميات',
      'المحرك_الرسومي': 'محرك رسومي',
      'الشبكات': 'شبكات',
      'التخزين': 'تخزين',
      'الوقت': 'وقت',
      'الملفات': 'ملفات',
      'الأحداث': 'أحداث',
      'الواجهة': 'واجهة',
      'الأمان': 'أمان',
      'الاختبارات': 'اختبارات',
      'الويب': 'ويب',
      'الأدوات': 'أدوات أمنية'
    };
    return categories[name] || 'عام';
  }

  return {
    getAll: getAll,
    getCode: getCode,
    getImportCode: getImportCode,
    getNames: getNames,
    getCategory: getCategory
  };
})();
