# ═══════════════════════════════════════════════════════
# مكتبة الواجهة - DOM Operations
# ═══════════════════════════════════════════════════════

دالة احصل_على(نص معرّف) -> أي {
    ارجع document.getElementById(معرّف)
}

دالة احصل_على_كل(نص محدد) -> أي[] {
    ارجع Array.from(document.querySelectorAll(محدد))
}

دالة انشئ(نص نوع) -> أي {
    ارجع document.createElement(نوع)
}

دالة ادرج(أي أب، أي طفل) {
    أب.appendChild(طفل)
}

دالة احذف_من(أي أب، أي طفل) {
    أب.removeChild(طفل)
}

دالة نص_العنصر(أي عنصر، نص قيمة) -> نص {
    اذا (قيمة !== undefined) {
        عنصر.textContent = قيمة
    }
    ارجع عنصر.textContent
}

دالة html_العنصر(أي عنصر، نص قيمة) -> نص {
    اذا (قيمة !== undefined) {
        عنصر.innerHTML = قيمة
    }
    ارجع عنصر.innerHTML
}

دالة صنف_العنصر(أي عنصر) -> أي {
    ارجع عنصر.classList
}

دالة أضف_صنف(أي عنصر، نص صنف) {
    عنصر.classList.add(صنف)
}

دالة احذف_صنف(أي عنصر، نص صنف) {
    عنصر.classList.remove(صنف)
}

دالة بدل_صنف(أي عنصر، نص صنف) {
    عنصر.classList.toggle(صنف)
}

دالة نمط(أي عنصر، أي خصائص) {
    لكل (propriété في Object.keys(خصائص)) {
        عنصر.style[propriété] = خصائص[propriété]
    }
}

دالة مواقع(أي عنصر) -> أي {
    ارجع عنصر.getBoundingClientRect()
}
      `
    },

    'الأمان': {
      name: 'الأمان',
      icon: '🔒',
      desc: 'التشفير والمصادقة والأمان',
      code: `
# ═══════════════════════════════════════════════════════
# مكتبة الأمان - Security
# ═══════════════════════════════════════════════════════

دالة تشفير_base64(نص نص) -> نص {
    ارجع btoa(نص)
}

دالة فك_base64(نص مشفر) -> نص {
    ارجع atob(مشفر)
}

دالة تشفير_sha256(نص نص) -> موعود {
    # استخدم Web Crypto API
    ارجع crypto.subtle.digest('SHA-256', new TextEncoder().encode(نص))
        .then(function(buffer) {
            ارجع Array.from(new Uint8Array(buffer)).map(function(b) {
                return b.toString(16).padStart(2, '0')
            }).join('')
        })
}

دالة إنشاء_رمـز() -> نص {
    ارجع crypto.randomUUID()
}

دالة عشوائي_أمان(صحيح طول) -> نص {
    var أحرف = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'
    var نتيجة = ''
    لكل (صحيح i = 0; i < طول; i++) {
        نتيجة += أحرف.charAt(Math.floor(Math.random() * أحرف.length))
    }
    ارجع نتيجة
}

دالة تحقق_بريد(نص بريد) -> صحيح {
    var نمط = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/
    ارجع نمط.test(بريد)
}

دالة تحقق_رابط(نص رابط) -> صحيح {
    حاول {
        new URL(رابط)
        ارجع صواب
    } امسك {
        ارجع خطأ
    }
}

دالة تحقق_رقم(نص رقم) -> صحيح {
    ارجع /^\\d+$/.test(رقم)
}
      `
