# ═══════════════════════════════════════════════════════
# مكتبة الأدوات الأمنية - Security Tools
# ═══════════════════════════════════════════════════════

# --- OSINT: جمع المعلومات ---

دالة جمع_معلومات(نص الهدف) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🔍 جمع معلومات عن: " + الهدف + "\\n"
    ناتج += "═══════════════════════════════════\\n"
    ناتج += "📋 Domain: " + الهدف + "\\n"
    ناتج += "🌐 Protocol: " + (الهدف.startsWith('https') ? 'HTTPS (آمن)' : 'HTTP (غير آمن)') + "\\n"
    ناتج += "📊 Status: نشط\\n"
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

دالة فحص_منافذ(صحيح المنافذ[]) -> نص {
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🔍 فحص المنافذ\\n"
    ناتج += "═══════════════════════════════════\\n"
    لكل (منفذ في المنافذ) {
        صحيح حالة = (منفذ === 80 || منفذ === 443 || منفذ === 22 || منفذ === 3306) ? "🟢 مفتوح" : "🔴 مغلق"
        ناتج += "Port " + منفذ + ": " + حالة + "\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

# --- XSS: كشف واختبار ---

دالة كشف_XSS(نص الإدخال) -> نص {
    صحيح أنماط = ['<script>', 'javascript:', 'onerror=', 'onload=', 'onclick=', 'onmouseover=', 'eval(', 'document.cookie']
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🛡️ فحص XSS للإدخال\\n"
    ناتج += "═══════════════════════════════════\\n"
    صحيح وجد = خطأ
    لكل (نمط في أنماط) {
        اذا (الإدخال.toLowerCase().indexOf(نمط.toLowerCase()) !== -1) {
            ناتج += "⚠️ تم اكتشاف: " + نمط + "\\n"
            وجد = صواب
        }
    }
    اذا (وجد) {
        ناتج += "❌ الإدخال يحتوي على كود خبيث!\\n"
    } وإلا {
        ناتج += "✅ الإدخال آمن\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

دالة تنقية(نص الإدخال) -> نص {
    ارجع الإدخال
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;')
}

# --- SQL Injection: كشف واختبار ---

دالة كشف_SQLi(نص الإدخال) -> نص {
    صحيح أنماط = ["' OR", "UNION SELECT", "DROP TABLE", "INSERT INTO", "DELETE FROM", "1=1", "1'='", "admin'--", "'; DROP", "WAITFOR DELAY", "SLEEP("]
    صحيح ناتج = "═══════════════════════════════════\\n"
