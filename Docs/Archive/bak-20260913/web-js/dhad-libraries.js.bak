      code: `
# ═══════════════════════════════════════════════════════
# مكتبة الأمان والتشفير - Security & Cryptography
# ═══════════════════════════════════════════════════════

# --- تشفير الهاش (Hash) ---

دالة الهاش(نص النص) -> نص {
    # SHA-256 via SubtleCrypto (async wrapper)
    صحيح بايتات = new TextEncoder().encode(النص)
    صحيح هاش = crypto.subtle.digest('SHA-256', بايتات)
    صحيح مصفوفة = Array.from(new Uint8Array(هاش))
    ارجع مصفوفة.map(function(b) { return b.toString(16).padStart(2, '0') }).join('')
}

دالة الهاش_MD5(نص النص) -> نص {
    # MD5 بسيط
    صحيح دالة_MD5 = function(نص) {
        صحيح L = function(n, s) { return (n << s) | (n >>> (32 - s)) }
        صحيح M = function(x, y, z) { return (x & y) | (~x & z) }
        صحيح G = function(x, y, z) { return (x & z) | (y & ~z) }
        صحيح H = function(x, y, z) { return x ^ y ^ z }
        صحيح I = function(x, y, z) { return y ^ (x | ~z) }
        صحيح ff = function(a, b, c, d, x, s, t) { a = M(b, c, d); a = (a + x + t) | 0; a = L(a, s) + b; return a }
        صحيح gg = function(a, b, c, d, x, s, t) { a = G(b, c, d); a = (a + x + t) | 0; a = L(a, s) + b; return a }
        صحيح hh = function(a, b, c, d, x, s, t) { a = H(b, c, d); a = (a + x + t) | 0; a = L(a, s) + b; return a }
        صحيح ii = function(a, b, c, d, x, s, t) { a = I(b, c, d); a = (a + x + t) | 0; a = L(a, s) + b; return a }
        صحيح ConvertToWordArray = function(نص) {
            صحيح WordArrayLength = (((نص.length + 8) >>> 6) + 1) * 16
            صحيح WordArray = new Array(WordArrayLength - 1)
            صحيح WordCount = 0
            طالما (WordCount < نص.length) {
                WordArray[WordCount >> 2] |= نص.charCodeAt(WordCount) << ((WordCount % 4) << 3)
                WordCount++
            }
            WordArray[WordCount >> 2] |= 0x80 << ((WordCount % 4) << 3)
            WordArray[WordArrayLength - 2] = نص.length << 3
            ارجع WordArray
        }
        صحيح WordToHex = function(val) {
            صحيح WordToHexValue = "", WordToHexValueTemp = "", byte
            لكل (byte من 0 إلى 3) {
                WordToHexValueTemp = (val >>> (byte * 8 + 4)) & 0x0F
                WordToHexValue += WordToHexValueTemp.toString(16)
                WordToHexValueTemp = (val >>> (byte * 8)) & 0x0F
                WordToHexValue += WordToHexValueTemp.toString(16)
            }
            ارجع WordToHexValue
        }
        صحيح x = ConvertToWordArray(النص)
        صحيح a = 0x67452301, b = 0xEFCDAB89, c = 0x98BADCFE, d = 0x10325476
        صحيح S11 = 7, S12 = 12, S13 = 17, S14 = 22
        صحيح S21 = 5, S22 = 9, S23 = 14, S24 = 20
        صحيح S31 = 4, S32 = 11, S33 = 16, S34 = 23
        صحيح S41 = 6, S42 = 10, S43 = 15, S44 = 21
        لكل (k من 0 إلى x.length - 1 بنوع خطوة 16) {
            صحيح AA = a, BB = b, CC = c, DD = d
            a = ff(a, b, c, d, x[k], S11, 0xD76AA478)
            d = ff(d, a, b, c, x[k+1], S12, 0xE8C7B756)
            c = ff(c, d, a, b, x[k+2], S13, 0x242070DB)
            b = ff(b, c, d, a, x[k+3], S14, 0xC1BDCEEE)
            a = ff(a, b, c, d, x[k+4], S11, 0xF57C0FAF)
            d = ff(d, a, b, c, x[k+5], S12, 0x4787C62A)
            c = ff(c, d, a, b, x[k+6], S13, 0xA8304613)
            b = ff(b, c, d, a, x[k+7], S14, 0xFD469501)
            a = ff(a, b, c, d, x[k+8], S11, 0x698098D8)
            d = ff(d, a, b, c, x[k+9], S12, 0x8B44F7AF)
            c = ff(c, d, a, b, x[k+10], S13, 0xFFFF5BB1)
            b = ff(b, c, d, a, x[k+11], S14, 0x895CD7BE)
            a = ff(a, b, c, d, x[k+12], S11, 0x6B901122)
            d = ff(d, a, b, c, x[k+13], S12, 0xFD987193)
            c = ff(c, d, a, b, x[k+14], S13, 0xA679438E)
            b = ff(b, c, d, a, x[k+15], S14, 0x49B40821)
            a = gg(a, b, c, d, x[k+1], S21, 0xF61E2562)
            d = gg(d, a, b, c, x[k+6], S22, 0xC040B340)
            c = gg(c, d, a, b, x[k+11], S23, 0x265E5A51)
            b = gg(b, c, d, a, x[k], S24, 0xE9B6C7AA)
            a = gg(a, b, c, d, x[k+5], S21, 0xD62F105D)
            d = gg(d, a, b, c, x[k+10], S22, 0x2441453)
            c = gg(c, d, a, b, x[k+15], S23, 0xD8A1E681)
            b = gg(b, c, d, a, x[k+4], S24, 0xE7D3FBC8)
            a = gg(a, b, c, d, x[k+9], S21, 0x21E1CDE6)
            d = gg(d, a, b, c, x[k+14], S22, 0xC33707D6)
            c = gg(c, d, a, b, x[k+3], S23, 0xF4D50D87)
            b = gg(b, c, d, a, x[k+8], S24, 0x455A14ED)
            a = gg(a, b, c, d, x[k+13], S21, 0xA9E3E905)
            d = gg(d, a, b, c, x[k+2], S22, 0xFCEFA3F8)
            c = gg(c, d, a, b, x[k+7], S23, 0x676F02D9)
            b = gg(b, c, d, a, x[k+12], S24, 0x8D2A4C8A)
            a = hh(a, b, c, d, x[k+5], S31, 0xFFFA3942)
            d = hh(d, a, b, c, x[k+8], S32, 0x8771F681)
            c = hh(c, d, a, b, x[k+11], S33, 0x6D9D6122)
            b = hh(b, c, d, a, x[k+14], S34, 0xFDE5380C)
            a = hh(a, b, c, d, x[k+1], S31, 0xA4BEEA44)
            d = hh(d, a, b, c, x[k+4], S32, 0x4BDECFA9)
            c = hh(c, d, a, b, x[k+7], S33, 0xF6BB4B60)
            b = hh(b, c, d, a, x[k+10], S34, 0xBEBFBC70)
            a = hh(a, b, c, d, x[k+13], S31, 0x289B7EC6)
            d = hh(d, a, b, c, x[k], S32, 0xEAA127FA)
            c = hh(c, d, a, b, x[k+3], S33, 0xD4EF3085)
            b = hh(b, c, d, a, x[k+6], S34, 0x4881D05)
            a = hh(a, b, c, d, x[k+9], S31, 0xD9D4D039)
            d = hh(d, a, b, c, x[k+12], S32, 0xE6DB99E5)
            c = hh(c, d, a, b, x[k+15], S33, 0x1FA27CF8)
            b = hh(b, c, d, a, x[k+2], S34, 0xC4AC5665)
            a = ii(a, b, c, d, x[k], S41, 0xF4292244)
            d = ii(d, a, b, c, x[k+7], S42, 0x432AFF97)
            c = ii(c, d, a, b, x[k+14], S43, 0xAB9423A7)
            b = ii(b, c, d, a, x[k+5], S44, 0xFC93A039)
            a = ii(a, b, c, d, x[k+12], S41, 0x655B59C3)
            d = ii(d, a, b, c, x[k+3], S42, 0x8F0CCC92)
            c = ii(c, d, a, b, x[k+10], S43, 0xFFEFF47D)
            b = ii(b, c, d, a, x[k+1], S44, 0x85845DD1)
            a = ii(a, b, c, d, x[k+8], S41, 0x6FA87E4F)
            d = ii(d, a, b, c, x[k+15], S42, 0xFE2CE6E0)
            c = ii(c, d, a, b, x[k+6], S43, 0xA3014314)
            b = ii(b, c, d, a, x[k+13], S44, 0x4E0811A1)
            a = ii(a, b, c, d, x[k+4], S41, 0xF7537E82)
            d = ii(d, a, b, c, x[k+11], S42, 0xBD3AF235)
            c = ii(c, d, a, b, x[k+2], S43, 0x2AD7D2BB)
            b = ii(b, c, d, a, x[k+9], S44, 0xEB86D391)
            a = (a + AA) | 0
            b = (b + BB) | 0
            c = (c + CC) | 0
            d = (d + DD) | 0
        }
        ارجع WordToHex(a) + WordToHex(b) + WordToHex(c) + WordToHex(d)
    }
    ارجع دالة_MD5(النص)
}

# --- HMAC ---

دالة hmac(نص الرسالة, نص المفتاح) -> نص {
    صحيح مصفوفة_المفتاح = new TextEncoder().encode(المفتاح)
    صحيح مصفوفة_الرسالة = new TextEncoder().encode(الرسالة)
    صحيح مفتاح = crypto.subtle.importKey('raw', مصفوفة_المفتاح, {name: 'HMAC', hash: 'SHA-256'}, false, ['sign'])
    صحيح توقيع = crypto.subtle.sign('HMAC', مفتاح, مصفوفة_الرسالة)
    صحيح مصفوفة = Array.from(new Uint8Array(توقيع))
    ارجع مصفوفة.map(function(b) { return b.toString(16).padStart(2, '0') }).join('')
}

# --- تشفير Caesar Cipher ---

دالة تشفير_قيصر(نص النص, صحيح المزاحة) -> نص {
    صحيح نتيجة = ""
    لكل (صحيح i = 0; i < النص.length; i++) {
        صحيح كود = النص.charCodeAt(i)
        اذا (كود >= 0x0627 && كود <= 0x064A) {
            نتيجة += String.fromCharCode(((كود - 0x0627 + المزاحة) % 29) + 0x0627)
        } وإلا {
            نتيجة += النص.charAt(i)
        }
    }
    ارجع نتيجة
}

دالة فك_قيصر(نص النص, صحيح المزاحة) -> نص {
    ارجع تشفير_قيصر(النص, 29 - المزاحة)
}

# --- تشفير XOR ---

دالة تشفير_xor(نص النص, صحيح المفتاح) -> نص {
    صحيح نتيجة = ""
    لكل (صحيح i = 0; i < النص.length; i++) {
        نتيجة += String.fromCharCode(النص.charCodeAt(i) ^ المفتاح)
    }
    ارجع نتيجة
}

# --- تشفير AES (Web Crypto API) ---

دالة تشفير_AES(نص النص, نص المفتاح) -> دالة {
    صحيح مصفوفة_المفتاح = new TextEncoder().encode(المفتاح.padEnd(32, '0').substring(0, 32))
    صحيح مصفوفة_المدخلات = new TextEncoder().encode(النص)
    صحيح متجه_البداية = crypto.getRandomValues(new Uint8Array(12))
    ارجع crypto.subtle.importKey('raw', مصفوفة_المفتاح, 'AES-GCM', false, ['encrypt']).then(function(مفتاح) {
        ارجع crypto.subtle.encrypt({name: 'AES-GCM', iv: متجه_البداية}, مفتاح, مصفوفة_المدخلات).then(function(مشفر) {
            صحيح ناتج = new Uint8Array(12 + مشفر.byteLength)
            ناتج.set(متجه_البداية)
            ناتج.set(new Uint8Array(مشفر), 12)
            ارجع btoa(String.fromCharCode.apply(null, ناتج))
        })
    })
}

دالة فك_AES(نص مشفر, نص المفتاح) -> دالة {
    صحيح بيانات = Uint8Array.from(atob(مشفر), function(c) { return c.charCodeAt(0) })
    صحيح متجه_البداية = بيانات.slice(0, 12)
    صحيح البيانات_المشفرة = بيانات.slice(12)
    صحيح مصفوفة_المفتاح = new TextEncoder().encode(المفتاح.padEnd(32, '0').substring(0, 32))
    ارجع crypto.subtle.importKey('raw', مصفوفة_المفتاح, 'AES-GCM', false, ['decrypt']).then(function(مفتاح) {
        ارجع crypto.subtle.decrypt({name: 'AES-GCM', iv: متجه_البداية}, مفتاح, البيانات_المشفرة).then(function(مفكوك) {
            ارجع new TextDecoder().decode(مفكوك)
        })
    })
}

# --- توليد مفتاح آمن ---

دالة ولّد_مفتاح(صحيح الطول) -> نص {
    صحيح أحرف = "0123456789abcdef"
    صحيح مفتاح = ""
    لكل (صحيح i = 0; i < الطول; i++) {
        مفتاح += أحرف.charAt(Math.floor(Math.random() * 16))
    }
    ارجع مفتاح
}

دالة ولّد_ملح(صحيح الطول) -> نص {
    صحيح مصفوفة = crypto.getRandomValues(new Uint8Array(الطول))
    ارجع Array.from(مصفوفة).map(function(b) { return b.toString(16).padStart(2, '0') }).join('')
}

# --- تجزئة كلمة المرور ---

دالة تجزئة(نص كلمة_المرور, نص ملح) -> نص {
    صحيح ملح_محلل = ملح || ولّد_ملح(16)
    صحيح هاش = الهاش(كلمة_المرور + ملح_محلل)
    ارجع ملح_محلل + ":" + هاش
}

دالة تحقق_كلمة(نص كلمة_المرور, نص محفوظ) -> منطقي {
    صحيح أجزاء = محفوظ.split(":")
    صحيح ملح = أجزاء[0]
    صحيح هاش_محفوظ = أجزاء[1]
    ارجع الهاش(كلمة_المرور + ملح) === هاش_محفوظ
}
      `
    },

