# ═══════════════════════════════════════════════════════
# مكتبة الرسوميات - Graphics & Drawing
# ═══════════════════════════════════════════════════════

دالة إنشاء_لوحة(نص معرّف، صحيح عرض، صحيح ارتفاع) -> أي {
    var canvas = document.getElementById(معرّف)
    اذا (!canvas) {
        canvas = document.createElement('canvas')
        canvas.id = معرّف
        document.body.appendChild(canvas)
    }
    canvas.width = عرض || 400
    canvas.height = ارتفاع || 300
    ارجع canvas.getContext('2d')
}

دالة ملء(أي سياق، نص لون) {
    سياق.fillStyle = لون
    سياق.fillRect(0, 0, سياق.canvas.width, سياق.canvas.height)
}

دالة مستطيل(أي سياق، صحيح x، صحيح y، صحيح عرض، صحيح ارتفاع، نص لون) {
    سياق.fillStyle = لون
    سياق.fillRect(x, y, عرض, ارتفاع)
}

دالة دائرة(أي سياق، صحيح x، صحيح y، صحيح نصف_القطر، نص لون) {
    سياق.beginPath()
    سياق.arc(x, y, نصف_القطر, 0, Math.PI * 2)
    سياق.fillStyle = لون
    سياق.fill()
}

دالة خط(أي سياق، صحيح x1، صحيح y1، صحيح x2، صحيح y2، نص لون، صحيح عرض) {
    سياق.beginPath()
    سياق.moveTo(x1, y1)
    سياق.lineTo(x2, y2)
    سياق.strokeStyle = لون
    سياق.lineWidth = عرض || 2
    سياق.stroke()
}

دالة نص_على_لوحة(أي سياق، نص نص، صحيح x، صحيح y، نص لون، صحيح حجم) {
    سياق.font = (حجم || 16) + 'px Arial'
    سياق.fillStyle = لون || '#000'
    سياق.fillText(نص, x, y)
}

دالة مسح(أي سياق) {
    سياق.clearRect(0, 0, سياق.canvas.width, سياق.canvas.height)
}

# ═══════════════════════════════════════════════════════
# الألوان
# ═══════════════════════════════════════════════════════

دالة لون(صحيح احمر، صحيح أخضر، صحيح أزرق، صحيح شفاف) -> نص {
    ارجع 'rgba(' + احمر + ',' + أخضر + ',' + أزرق + ',' + (شفاف || 1) + ')'
}

دالة لون_عشري(نص hex) -> نص {
    ارجع hex
}

دالة خلط(نص لون1، نص لون2، عشري نسبة) -> نص {
    ارجع لون1
}

دالة تدرج(أي سياق، صحيح x1، صحيح y1، صحيح x2، صحيح y2، نص لون1، نص لون2) {
    var gradient = سياق.createLinearGradient(x1, y1, x2, y2)
    gradient.addColorStop(0, لون1)
    gradient.addColorStop(1, لون2)
    سياق.fillStyle = gradient
}
      `
