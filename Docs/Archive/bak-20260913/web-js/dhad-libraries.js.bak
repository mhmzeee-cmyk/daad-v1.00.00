ثابت _مكدسات = {}

دالة إنشاء_مكدس(نص اسم) {
    _مكدسات[اسم] = []
}

دالة ادفع(نص اسم، أي عنصر) {
    _مكدسات[اسم].push(عنصر)
}

دالة أخرج(نص اسم) -> أي {
    ارجع _مكدسات[اسم].pop()
}

دالة أعلى(نص اسم) -> أي {
    ارجع _مكدسات[اسم][_مكدسات[اسم].length - 1]
}

دالة حجم_مكدس(نص اسم) -> صحيح {
    ارجع _مكدسات[اسم].length
}

# ═══════════════════════════════════════════════════════
# طابور (Queue)
# ═══════════════════════════════════════════════════════

ثابت _طوابير = {}

دالة إنشاء_طابور(نص اسم) {
    _طوابير[اسم] = []
}

دالة أدخل(نص اسم، أي عنصر) {
    _طوابير[اسم].push(عنصر)
}

دالة اسحب(نص اسم) -> أي {
    ارجع _طوابير[اسم].shift()
}

دالة مقدمة(نص اسم) -> أي {
    ارجع _طوابير[اسم][0]
}

دالة حجم_طابور(نص اسم) -> صحيح {
    ارجع _طوابير[اسم].length
}
