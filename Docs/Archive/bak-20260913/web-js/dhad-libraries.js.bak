# ═══════════════════════════════════════════════════════
# مكتبة الرياضيات - Mathematics
# ═══════════════════════════════════════════════════════

دالة جمع(صحيح a، صحيح b) -> صحيح {
    ارجع a + b
}

دالة طرح(صحيح a، صحيح b) -> صحيح {
    ارجع a - b
}

دالة ضرب(صحيح a، صحيح b) -> صحيح {
    ارجع a * b
}

دالة قسمة(صحيح a، صحيح b) -> صحيح {
    اذا (b == 0) { ارجع 0 }
    ارجع a / b
}

دالة باقي(صحيح a، صحيح b) -> صحيح {
    اذا (b == 0) { ارجع 0 }
    ارجع a % b
}

دالة مطلق(صحيح a) -> صحيح {
    اذا (a < 0) { ارجع -a }
    ارجع a
}

دالة قوة(عشري أصل، صحيح أس) -> عشري {
    ارجع Math.pow(أصل، أس)
}

دالة جذر(عشري a) -> عشري {
    ارجع Math.sqrt(a)
}

دالة أقصى(صحيح a، صحيح b) -> صحيح {
    اذا (a > b) { ارجع a }
    ارجع b
}

دالة أدناه(صحيح a، صحيح b) -> صحيح {
    اذا (a < b) { ارجع a }
    ارجع b
}

دالة عشوائي() -> عشري {
    ارجع Math.random()
}

دالة عشوائي_بين(صحيح حد_أدنى، صحيح حد_أعلى) -> صحيح {
    ارجع Math.floor(Math.random() * (حد_أعلى - حد_أدنى + 1)) + حد_أدنى
}

دالة مضروب(صحيح n) -> صحيح {
    اذا (n <= 1) { ارجع 1 }
    ارجع n * مضروب(n - 1)
}

دالة لog(عشري a) -> عشري {
    ارجع Math.log(a)
}

دالة أس_الطبيعي(عشري a) -> عشري {
