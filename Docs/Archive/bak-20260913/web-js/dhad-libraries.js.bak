        اذا (الإدخال.toUpperCase().indexOf(نمط.toUpperCase()) !== -1) {
            ناتج += "⚠️ تم اكتشاف: " + نمط + "\\n"
            وجد = صواب
        }
    }
    اذا (وجد) {
        ناتج += "❌ الإدخال يحتوي على كود SQL خبيث!\\n"
    } وإلا {
        ناتج += "✅ الإدخال آمن\\n"
    }
    ناتج += "═══════════════════════════════════\\n"
    ارجع ناتج
}

دالة عدّل_SQL(نص الاستعلام) -> نص {
    # تحويل الاستعلام لإعادة محاكاة آمنة
    ارجع الاستعلام.replace(/'/g, "''")
}

# --- Path Traversal: كشف ---

دالة كشف_Path(نص المسار) -> نص {
    صحيح أنماط = ['../', '..\\\\', '%2e%2e', '%252e%252e', '....//', '/etc/passwd', '/etc/shadow', 'c:\\\\windows']
    صحيح ناتج = "═══════════════════════════════════\\n"
    ناتج += "🛡️ فحص Path Traversal\\n"
    ناتج += "═══════════════════════════════════\\n"
    صحيح وجد = خطأ
    لكل (نمط في أنماط) {
        اذا (المسار.toLowerCase().indexOf(نمط.toLowerCase()) !== -1) {
            ناتج += "⚠️ تم اكتشاف محاولة تجاوز مسار: " + نمط + "\\n"
            وجد = صواب
        }
    }
    اذا (وجد) {
        ناتج += "❌ محاولة Path Traversal!\\n"
    } وإلا {
