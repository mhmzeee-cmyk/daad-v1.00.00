 <Product Id="E0ACEE25-938F-52EC-ACD6-BF4598A3AFCD" Name="Dhad Studio" Language="1033" Version="1.0.0" Manufacturer="Dhad Studio" UpgradeCode="DD77F054-1B3E-59A5-BA93-214DDBD3ABF5">
  <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Description="Dhad Studio v1.0.0 - Arabic Programming Language (Windows 7 Interview Demo)" />
  <Media Id="1" Cabinet="dhad.cab" EmbedCab="yes" />
  <Property Id="ARPCOMMENTS" Value="Arabic programming language demo: compiler, programs, CPU simulator, examples and docs." />
  <Directory Id="TARGETDIR" Name="SourceDir">
   <Directory Id="ProgramFilesFolder">
