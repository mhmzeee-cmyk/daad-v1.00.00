    </Directory>
   </Directory>
   <Directory Id="ProgramMenuFolder"><Directory Id="MenuDhad" Name="Dhad Studio" /></Directory>
   <Directory Id="DesktopFolder" />
  </Directory>
  <Feature Id="MainFeature" Title="Dhad Studio" Level="1">































   <ComponentGroupRef Id="G_DIR_BIN" />
   <ComponentGroupRef Id="G_DIR_EXAMPLES" />
   <ComponentGroupRef Id="G_INSTALLDIR" />
  </Feature>
 </Product>
