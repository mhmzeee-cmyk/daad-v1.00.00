دالة: مجموع(أ: رقم، ب: رقم) -> رقم :-
    ارجع(أ + ب)
نهاية

دالة: طرح(أ: رقم، ب: رقم) -> رقم :-
    ارجع(أ - ب)
نهاية

دالة: نسبة(مكتملة: رقم، إجمالي: رقم) -> رقم :-
    متغير: ن: رقم = مكتملة * 100
    ارجع(ن / إجمالي)
نهاية

دالة: الرئيسية() -> رقم :-
    متغير: إجمالي: رقم = 10
    متغير: جديدة1: رقم = 3
    متغير: جديدة2: رقم = 2
    متغير: مكتملة1: رقم = 4
    متغير: مكتملة2: رقم = 1
    متغير: بعد_إضافة1: رقم = مجموع(إجمالي، جديدة1)
    متغير: بعد_إضافة2: رقم = مجموع(بعد_إضافة1، جديدة2)
    متغير: بعد_حذف1: رقم = طرح(بعد_إضافة2، مكتملة1)
    متغير: بعد_حذف2: رقم = طرح(بعد_حذف1، مكتملة2)
    متغير: المكتملة: رقم = مجموع(مكتملة1، مكتملة2)
    متغير: النسبة: رقم = نسبة(المكتملة، بعد_إضافة2)
    متغير: النتيجة: رقم = مجموع(بعد_حذف2، النسبة)
    ارجع(النتيجة)
نهاية
