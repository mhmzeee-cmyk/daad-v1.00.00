دالة: مجموع(أ: رقم، ب: رقم) -> رقم :-
    ارجع(أ + ب)
نهاية

دالة: طرح(أ: رقم، ب: رقم) -> رقم :-
    ارجع(أ - ب)
نهاية

دالة: ضرب(أ: رقم، ب: رقم) -> رقم :-
    ارجع(أ * ب)
نهاية

دالة: قسمة(أ: رقم، ب: رقم) -> رقم :-
    ارجع(أ / ب)
نهاية

دالة: الرئيسية() -> رقم :-
    متغير: ن1: رقم = 100
    متغير: ن2: رقم = 25
    متغير: مجموع_العددين: رقم = مجموع(ن1، ن2)
    متغير: فرق_العددين: رقم = طرح(ن1، ن2)
    متغير: حاصل_ضرب: رقم = ضرب(ن1، ن2)
    متغير: حاصل_قسمة: رقم = قسمة(ن1، ن2)
    متغير: نتيجة: رقم = مجموع_العددين + فرق_العددين + حاصل_ضرب + حاصل_قسمة
    ارجع(نتيجة)
نهاية
