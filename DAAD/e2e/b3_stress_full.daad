دالة: add(a: رقم، b: رقم) -> رقم :-
    ارجع(a + b)
نهاية

دالة: mul(a: رقم، b: رقم) -> رقم :-
    ارجع(a * b)
نهاية

دالة: compute(x: رقم، y: رقم، z: رقم) -> رقم :-
    متغير: t1: رقم = x + y
    متغير: t2: رقم = t1 * z
    إذا (t2 > 100) :-
        ارجع(add(t2، 1))
    وإلا :-
        ارجع(mul(t2، 2))
    نهاية
نهاية

دالة: الرئيسية() -> رقم :-
    ارجع(compute(3، 4، 5))
نهاية
