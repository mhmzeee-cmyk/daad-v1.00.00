# اختبار المصفوفات والهياكل

نوع: نقطة = {
    س: رقم،
    ص: رقم
}

نوع: مستطيل = {
    الزاوية: نقطة،
    العرض: رقم،
    الارتفاع: رقم
}

دالة: الرئيسية() -> فراغ :-
    # اختبار المصفوفة
    مصفوفة: أرقام[5]
    أرقام[0] = 1
    أرقام[1] = 2
    أرقام[2] = 3
    أرقام[3] = 4
    أرقام[4] = 5

    # اختبار الهيكل
    متغير: ن1: نقطة = { 10، 20 }
    ن1.س = 15
    ن1.ص = 25

    # اختبار الهيكل المركب
    متغير: م1: مستطيل = { { 0، 0 }، 100، 50 }

    اطبع("تم اختبار المصفوفات والهياكل بنجاح!")
    توقف
نهاية
