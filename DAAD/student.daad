دالة: مجموع(أ: رقم، ب: رقم) -> رقم :-
    ارجع(أ + ب)
نهاية

دالة: معدل(ن1: رقم، ن2: رقم، ن3: رقم) -> رقم :-
    متغير: م: رقم = ن1 + ن2 + ن3
    ارجع(م / 3)
نهاية

دالة: الرئيسية() -> رقم :-
    متغير: اسم_الطالب: رقم = 1
    متغير: درجة_الرياضيات: رقم = 90
    متغير: درجة_العلوم: رقم = 85
    متغير: درجة_التاريخ: رقم = 78

    متغير: مجموع_الدرجات: رقم = مجموع(درجة_الرياضيات، مجموع(درجة_العلوم، درجة_التاريخ))
    متغير: المعدل: رقم = معدل(درجة_الرياضيات، درجة_العلوم، درجة_التاريخ)

    ارجع(المعدل)
نهاية
