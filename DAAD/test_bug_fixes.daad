# اختبار جميع الإصلاحات الجديدة

# === BUG-1: OP_AND/OP_OR المنطقية ===
متغير: شرط1: منطق = صحيح
متغير: شرط2: منطق = خطأ
متغير: النتيجة1: منطق = شرط1 و شرط2
متغير: النتيجة2: منطق = شرط1 أو شرط2

# === BUG-2: String literals ===
اطبع("مرحباً من ض!")

# === BUG-3/4/5/6: اختبارات داخل الدالة ===
دالة: الرئيسية() -> فراغ :-
    # اختبار تعيين المصفوفة
    مصفوفة: أرقام[5]
    أرقام[0] = 10
    أرقام[1] = 20
    أرقام[2] = 30

    # اختبار تعيين الهيكل
    نوع: طالب = {
        الاسم: نص،
        العمر: رقم
    }
    متغير: طالب1: طالب = { "أحمد"، 20 }
    طالب1.العمر = 21

    # اختبار الشروط المنطقية
    متغير: أ: رقم = 5
    متغير: ب: رقم = 10
    إذا(أ < ب و ب > 0) :-
        اطبع("الشرط صحيحاً")
    نهاية

    توقف
نهاية
