# اختبار العمليات العشرية (Float ops)

دالة: الرئيسية() -> فراغ :-
    متغير: س1: رقم_عشري = 3.14
    متغير: س2: رقم_عشري = 2.0
    متغير: المجموع: رقم_عشري = س1 + س2
    متغير: الفرق: رقم_عشري = س1 - س2
    متغير: حاصل_الضرب: رقم_عشري = س1 * س2
    متغير: حاصل_القسمة: رقم_عشري = س1 / س2

    اطبع("المجموع:")
    اطبع(المجموع)

    إذا(س1 > س2) :-
        اطبع("س1 أكبر من س2")
    نهاية

    توقف
نهاية
