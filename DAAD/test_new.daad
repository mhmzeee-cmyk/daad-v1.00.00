دالة: اجمع(أ: رقم، ب: رقم) -> رقم :-
    ارجع(أ + ب)
نهاية

دالة: الرئيسية() -> رقم :-
    متغير: ن: رقم = 0

    إذا(ن > 10) :-
        اطبع("أكبر")
    وإلا إذا(ن == 0) :-
        اطبع("صفر")
    وإلا :-
        اطبع("أخرى")
    نهاية

    طالما(ن < 5) :-
        ن = ن + 1
    نهاية

    ارجع(ن)
نهاية
