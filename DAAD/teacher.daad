دالة: مجموع(أ: رقم، ب: رقم) -> رقم :-
    ارجع(أ + ب)
نهاية

دالة: معدل(ن1: رقم، ن2: رقم، ن3: رقم) -> رقم :-
    متغير: م: رقم = ن1 + ن2 + ن3
    ارجع(م / 3)
نهاية

دالة: الرئيسية() -> رقم :-
    متغير: عدد_الطلاب: رقم = 3

    متغير: طالب1_الرياضيات: رقم = 90
    متغير: طالب1_العلوم: رقم = 85
    متغير: طالب1_التاريخ: رقم = 78

    متغير: طالب2_الرياضيات: رقم = 75
    متغير: طالب2_العلوم: رقم = 80
    متغير: طالب2_التاريخ: رقم = 88

    متغير: طالب3_الرياضيات: رقم = 95
    متغير: طالب3_العلوم: رقم = 92
    متغير: طالب3_التاريخ: رقم = 89

    متغير: مجموع_المعدلات: رقم = مجموع(معدل(طالب1_الرياضيات، طالب1_العلوم، طالب1_التاريخ)، مجموع(معدل(طالب2_الرياضيات، طالب2_العلوم، طالب2_التاريخ)، معدل(طالب3_الرياضيات، طالب3_العلوم، طالب3_التاريخ)))

    متغير: المعدل_العام: رقم = مجموع_المعدلات / عدد_الطلاب

    ارجع(المعدل_العام)
نهاية
