# اختبار 004: الذاكرة الديناميكية
# الميزة: حجز وتغيير حجم وتحرير
# النتيجة المتوقعة: 10، 20

دالة: الرئيسية() -> رقم :-
    # حجز ذاكرة
    متغير: المؤشر: رقم = احجز(80)

    إذا(المؤشر != 0) :-
        # قراءة القيمة
        اطبع(10)

        # تغيير الحجم
        المؤشر = غيّر_حجم(المؤشر، 160)

        إذا(المؤشر != 0) :-
            # قراءة القيمة الجديدة
            اطبع(20)

            # تحرير الذاكرة
            حرر(المؤشر)
        نهاية
    نهاية
    ارجع(0)
نهاية
