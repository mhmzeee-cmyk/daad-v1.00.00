# اختبار 001: تمرير المعاملات بالسجلات
# الميزة: دالة بـ 6 معاملات (كلها في السجلات)
# النتيجة المتوقعة: 21

دالة: اجمع6(a: رقم، b: رقم، c: رقم، d: رقم، e: رقم، f: رقم) -> رقم :-
    ارجع(a + b + c + d + e + f)
نهاية

دالة: الرئيسية() -> رقم :-
    متغير: النتيجة: رقم = اجمع6(1، 2، 3، 4، 5، 6)
    اطبع(النتيجة)    # 21
    ارجع(0)
نهاية