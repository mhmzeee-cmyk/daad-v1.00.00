# اختبار 002: تمرير المعاملات بالمكدس
# الميزة: دالة بأكثر من 6 معاملات
# النتيجة المتوقعة: 28

دالة: اجمع7(a: رقم، b: رقم، c: رقم، d: رقم، e: رقم، f: رقم، g: رقم) -> رقم :-
    # المعامل 7 (g) على المكدس
    ارجع(a + b + c + d + e + f + g)
نهاية

دالة: الرئيسية() -> رقم :-
    متغير: النتيجة: رقم = اجمع7(1، 2، 3، 4، 5، 6، 7)
    اطبع(النتيجة)    # 28
    ارجع(0)
نهاية