// برنامج اختبار شامل 4: طباعة مع دوال + منطق عربي + كلمات جديدة
// ═══════════════════════════════════════════════════════════════

// ── BUG-01 Test: طباعة مع استدعاء دالة مباشرة ────────────────
صحيح مضروب( صحيح ن ) {
    إذا ( ن <= 1 ) {
        ارجع 1 ؛
    }
    ارجع ن * مضروب( ن - 1 ) ؛
}

صحيح مربع( صحيح س ) {
    ارجع س * س ؛
}

صحيح مجموع( صحيح أ ، صحيح ب ) {
    ارجع أ + ب ؛
}

طباعة( "═══ اختبار BUG-01: طباعة مع دوال ═══" ) ؛

// الاختبار الأهم: هل طباعة تطبع نتيجة الدالة مباشرة؟
طباعة( مضروب( 5 ) ) ؛     // يجب أن يطبع 120
طباعة( مضروب( 10 ) ) ؛    // يجب أن يطبع 3628800
طباعة( مربع( 7 ) ) ؛      // يجب أن يطبع 49
طباعة( مجموع( 100 ، 200 ) ) ؛  // يجب أن يطبع 300

// ── تداخل الدوال داخل طباعة ─────────────────────────────────
طباعة( مربع( مجموع( 2 ، 3 ) ) ) ؛   // 25
طباعة( مضروب( مربع( 3 ) ) ) ؛       // مضروب(9) = 362880

// ── طباعة مع تعبيرات ────────────────────────────────────────
صحيح س = 10 ؛
طباعة( س + 5 ) ؛        // 15
طباعة( س * 2 ) ؛        // 20
طباعة( س ^ 2 ) ؛        // 100
طباعة( س > 5 ) ؛        // صواب

// ── المنطق العربي (و/أو) ────────────────────────────────────
طباعة( "═══ اختبار المنطق العربي ═══" ) ؛

صحيح أ = 10 ؛
صحيح ب = 20 ؛

إذا ( أ > 5 و ب > 15 ) {
   طباعة( "كلا الشرطين صواب" ) ؛
}

إذا ( أ > 15 أو ب > 15 ) {
    طباعة( "على الأقل واحد صواب" ) ؛
}

إذا ( أ > 15 و ب > 15 ) {
    طباعة( "هذا لن يظهر" ) ؛
} وإلا {
    طباعة( "صحيح — ليس كلاهما أكبر" ) ؛
}

// ── استخدام و/أو في تعبيرات ─────────────────────────────────
منطقي شرط1 = (أ > 5) و (ب > 15) ؛
طباعة( شرط1 ) ؛   // صواب

منطقي شرط2 = (أ > 15) أو (ب > 15) ؛
طباعة( شرط2 ) ؛   // صواب

منطقي شرط3 = (أ > 15) و (ب > 15) ؛
طباعة( شرط3 ) ؛   // خطأ

// ── اختبار الكلمات الجديدة: زد/انقص ────────────────────────
طباعة( "═══ اختبار زد/انقص ═══" ) ؛
صحيح عداد = 0 ؛
زد عداد ؛
زد عداد ؛
زد عداد ؛
طباعة( عداد ) ؛   // 3

انقص عداد ؛
طباعة( عداد ) ؛   // 2

// ── اختبار ^= (تخصيص القوة) ────────────────────────────────
طباعة( "═══ اختبار ^= ═══" ) ؛
صحيح ق = 2 ؛
ق ^= 3 ؛         // 8
طباعة( ق ) ؛

ق ^= 2 ؛         // 64
طباعة( ق ) ؛

// ── اختبار while مع عربة ───────────────────────────────────
طباعة( "═══ اختبار بينما + انقص ═══" ) ؛
صحيح countdown = 5 ؛
بينما ( countdown > 0 ) {
    طباعة( countdown ) ؛
    انقص countdown ؛
}
طباعة( "انطلاق!" ) ؛

// ── اختبار for مع زد ────────────────────────────────────────
طباعة( "═══ اختبار لكل + زد ═══" ) ؛
لكل ( صحيح i = 0 ؛ i < 5 ؛ زد i ) {
    طباعة( i * i ) ؛
}

// ── اختبار مقارنة مع و/أو ──────────────────────────────────
طباعة( "═══ اختبار مقارنات مع منطق عربي ═══" ) ؛
صحيح درجة = 85 ؛
إذا ( درجة >= 90 أو درجة >= 80 ) {
    طباعة( "ممتاز أو جيد جداً" ) ؛
}

إذا ( درجة >= 90 و درجة <= 100 ) {
    طباعة( "نطاق سليم" ) ؛
}

طباعة( "═══ اكتمل اختبار طباعة والمنطق العربي ═══" ) ؛
