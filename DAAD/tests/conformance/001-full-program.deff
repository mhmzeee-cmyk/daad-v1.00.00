# اختبار توافق 001: برنامج شامل
# الميزة: اختبار جميع الميزات الأساسية في برنامج واحد
# النتيجة المتوقعة: 10، 30، صحيح

# تعريف ثابت
ثابت: النهاية = 10

# تعريف نوع
نوع: نقطة = {
    x: رقم،
    y: رقم
}

# تعريف دالة
دالة: اجمع(أ: رقم، ب: رقم) -> رقم :-
    ارجع(أ + ب)
نهاية

# الدالة الرئيسية
دالة: الرئيسية() -> رقم :-
    # تعريف متغير
    متغير: العدد: رقم = النهاية
    اطبع(العدد)    # 10

    # استدعاء دالة
    متغير: النتيجة: رقم = اجمع(10، 20)
    اطبع(النتيجة)    # 30

    # شرط
    إذا(العدد == 10) :-
        اطبع(صحيح)
    نهاية

    ارجع(0)
نهاية
