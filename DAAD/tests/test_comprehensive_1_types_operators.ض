// برنامج اختبار شامل 1: الأنواع والمتغيرات والعمليات الحسابية
// ═══════════════════════════════════════════════════════════════

// ── تعريف المتغيرات من جميع الأنواع ──────────────────────────
صحيح عددي = 42 ؛
عشري كسري = 3.14159 ؛
منطقي صحيح_أ = صواب ؛
منطقي خطأ_أ = خطأ ؛
صحيح حرف_أ = 65 ؛
نص رسالتي = "مرحبا بالعالم" ؛

// ── طباعة جميع القيم ────────────────────────────────────────
طباعة( "═══ اختبار الأنواع ═══" ) ؛
طباعة( عددي ) ؛
طباعة( كسري ) ؛
طباعة( صحيح_أ ) ؛
طباعة( خطأ_أ ) ؛
طباعة( حرف_أ ) ؛
طباعة( رسالتي ) ؛

// ── العمليات الحسابية الأساسية ──────────────────────────────
صحيح مجموع = 10 + 5 ؛
صحيح طرح = 10 - 3 ؛
صحيح ضرب = 4 * 7 ؛
صحيح قسمة = 20 / 4 ؛
صحيح باقي = 17 % 5 ؛

طباعة( "═══ العمليات الحسابية ═══" ) ؛
طباعة( مجموع ) ؛      // 15
طباعة( طرح ) ؛        // 7
طباعة( ضرب ) ؛        // 28
طباعة( قسمة ) ؛       // 5
طباعة( باقي ) ؛       // 2

// ── العمليات على الأعداد العشرية ────────────────────────────
عشري مجموع_عشري = 1.5 + 2.3 ؛
عشري ضرب_عشري = 2.5 * 4.0 ؛

طباعة( "═══ العمليات العشرية ═══" ) ؛
طباعة( مجموع_عشري ) ؛  // 3.8
طباعة( ضرب_عشري ) ؛    // 10

// ── عمليات المقارنة ─────────────────────────────────────────
صحيح أ = 10 ؛
صحيح ب = 20 ؛

منطقي أكبر = أ > ب ؛
منطقي أصغر = أ < ب ؛
منطقي يساوي = أ == 10 ؛
منطقي لا_يساوي = أ != ب ؛
منطقي أكبر_أو_يساوي = أ >= 10 ؛
منطقي أصغر_أو_يساوي = أ <= 5 ؛

طباعة( "═══ عمليات المقارنة ═══" ) ؛
طباعة( أكبر ) ؛        // خطأ
طباعة( أصغر ) ؛        // صواب
طباعة( يساوي ) ؛      // صواب
طباعة( لا_يساوي ) ؛   // صواب
طباعة( أكبر_أو_يساوي ) ؛  // صواب
طباعة( أصغر_أو_يساوي ) ؛  // خطأ

// ── عمليات التخصيص المركّبة ─────────────────────────────────
صحيح س = 100 ؛
س += 50 ؛      // س = 150
طباعة( س ) ؛

س -= 30 ؛      // س = 120
طباعة( س ) ؛

س *= 2 ؛       // س = 240
طباعة( س ) ؛

س /= 4 ؛       // س = 60
طباعة( س ) ؛

س %= 7 ؛       // س = 4
طباعة( س ) ؛

// ── عمليات زد وانقص ─────────────────────────────────────────
صحيح عداد = 10 ؛
زد عداد ؛      // عداد = 11
طباعة( عداد ) ؛

انقص عداد ؛    // عداد = 10
طباعة( عداد ) ؛

// ── القوة (^) ───────────────────────────────────────────────
صحيح أس_2 = 2 ^ 10 ؛
طباعة( "قوة 2 أس 10" ) ؛
طباعة( أس_2 ) ؛    // 1024

// ── تخصيص القوة (^=) ────────────────────────────────────────
صحيح قيمة = 3 ؛
قيمة ^= 2 ؛         // 9
طباعة( قيمة ) ؛

// ── العمليات المنطقية ───────────────────────────────────────
منطقي ص = صواب ؛
منطقي خ = خطأ ؛

منطقي و_المنطقي = ص && خ ؛     // خطأ
منطقي أو_المنطقي = ص || خ ؛    // صواب
منطقي ليس = !ص ؛               // خطأ

طباعة( "═══ العمليات المنطقية ═══" ) ؛
طباعة( و_المنطقي ) ؛
طباعة( أو_المنطقي ) ؛
طباعة( ليس ) ؛

// ── العمليات المنطقية العربية (و/أو) ────────────────────────
منطقي وعربي = ص و خ ؛        // خطأ
منطقي أوعربي = ص أو خ ؛      // صواب

طباعة( "═══ المنطق العربي ═══" ) ؛
طباعة( وعربي ) ؛
طباعة( أوعربي ) ؛

// ── العملية الشرطية الثلاثية (temple) ─────────────────────────
صحيح أكبر_قيمة = أ ؛
إذا ( ب > أكبر_قيمة ) { أكبر_قيمة = ب ؛ }
طباعة( "أكبر قيمة" ) ؛
طباعة( أكبر_قيمة ) ؛       // 20

طباعة( "═══ اكتمل اختبار الأنواع والعمليات ═══" ) ؛
