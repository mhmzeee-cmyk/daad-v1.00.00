# اختبار 005: التكرار الذاتي (Recursion)
# الميزة: حساب المضروب بالتكرار
# النتيجة المتوقعة: 120

دالة: مضروب(ن: رقم) -> رقم :-
    إذا(ن <= 1) :-
        ارجع(1)
    نهاية
    ارجع(ن * مضروب(ن - 1))
نهاية

دالة: الرئيسية() -> رقم :-
    متغير: النتيجة: رقم = مضروب(5)
    اطبع(النتيجة)    # 120
    ارجع(0)
نهاية
