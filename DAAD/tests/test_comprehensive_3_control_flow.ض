// برنامج اختبار شامل 3: جمل التحكم والحلقات
// ═══════════════════════════════════════════════════════════════

// ── إذا وإلا ─────────────────────────────────────────────────
صحيح عمر = 25 ؛

طباعة( "═══ اختبار إذا/وإلا ═══" ) ؛
إذا ( عمر >= 18 ) {
    طباعة( "بالغ" ) ؛
} وإلا {
    طباعة( "قاصر" ) ؛
}

// ── شرط متعدد ───────────────────────────────────────────────
صحيح درجة = 85 ؛
نص تقدير = "" ؛

إذا ( درجة >= 90 ) {
    تقدير = "ممتاز" ؛
} وإلا {
    إذا ( درجة >= 80 ) {
        تقدير = "جيد جداً" ؛
    } وإلا {
        إذا ( درجة >= 70 ) {
            تقدير = "جيد" ؛
        } وإلا {
            إذا ( درجة >= 60 ) {
                تقدير = "مقبول" ؛
            } وإلا {
                تقدير = "راسب" ؛
            }
        }
    }
}

طباعة( "التقدير" ) ؛
طباعة( تقدير ) ؛    // جيد جداً

// ── حلقةطالما ───────────────────────────────────────────────
طباعة( "═══ اختبار حلقةطالما ═══" ) ؛
صحيح عداد1 = 0 ؛
طالما ( عداد1 < 5 ) {
    طباعة( عداد1 ) ؛
    عداد1 += 1 ؛
}

// ── حلقةافعل/طالما ──────────────────────────────────────────
طباعة( "═══ اختبار افعل/طالما ═══" ) ؛
صحيح عداد2 = 0 ؛
افعل {
    طباعة( عداد2 ) ؛
    عداد2 += 1 ؛
} طالما ( عداد2 < 3 ) ؛

// ── حلقةلكل ──────────────────────────────────────────────────
طباعة( "═══ اختبار حلقةلكل ═══" ) ؛
لكل ( صحيح ا = 0 ؛ ا < 10 ؛ ا += 1 ) {
    إذا ( ا % 2 == 0 ) {
        طباعة( ا ) ؛
    }
}

// ── حلقة بينما (بديل) ───────────────────────────────────────
طباعة( "═══ اختبار حلقةبينما ═══" ) ؛
صحيح ع = 5 ؛
بينما ( ع > 0 ) {
    طباعة( ع ) ؛
    انقص ع ؛
}

// ── حلقةكرر (بديل) ──────────────────────────────────────────
طباعة( "═══ اختبار حلقةكرر ═══" ) ؛
صحيح عداد3 = 0 ؛
كرر ( عداد3 < 3 ) {
    طباعة( عداد3 ) ؛
    زد عداد3 ؛
}

// ── اختر (switch) ────────────────────────────────────────────
طباعة( "═══ اختبار اختر ═══" ) ؛
صحيح يوم = 3 ؛

اختر ( يوم ) {
    حالة 1: طباعة( "الإثنين" ) ؛ توقف ؛
    حالة 2: طباعة( "الثلاثاء" ) ؛ توقف ؛
    حالة 3: طباعة( "الأربعاء" ) ؛ توقف ؛
    حالة 4: طباعة( "الخميس" ) ؛ توقف ؛
    حالة 5: طباعة( "الجمعة" ) ؛ توقف ؛
    افتراضي: طباعة( "عطلة" ) ؛
}

// ── حلقة متداخلة ────────────────────────────────────────────
طباعة( "═══ اختبار حلقات متداخلة ═══" ) ؛
لكل ( صحيح ص = 0 ؛ ص < 3 ؛ ص += 1 ) {
    لكل ( صحيح س = 0 ؛ س < 3 ؛ س += 1 ) {
        صحيح نتيجة = ص * 3 + س + 1 ؛
        طباعة( نتيجة ) ؛
    }
}

// ── حلقة مع break وcontinue ─────────────────────────────────
طباعة( "═══ اختبار توقف واستمر ═══" ) ؛
لكل ( صحيح ا = 0 ؛ ا < 10 ؛ ا += 1 ) {
    إذا ( ا == 3 ) {
        استمر ؛
    }
    إذا ( ا == 7 ) {
        توقف ؛
    }
    طباعة( ا ) ؛
}

// ── فرز مصفوفة يدوياً ──────────────────────────────────────
طباعة( "═══ اختبار فرز ═══" ) ؛
صحيح مصفوفة_0 = 5 ؛
صحيح مصفوفة_1 = 3 ؛
صحيح مصفوفة_2 = 8 ؛
صحيح مصفوفة_3 = 1 ؛
صحيح مصفوفة_4 = 9 ؛

// فرز.selection sort يدوي
إذا ( مصفوفة_0 > مصفوفة_1 ) {
    صحيح مؤقت = مصفوفة_0 ؛
    مصفوفة_0 = مصفوفة_1 ؛
    مصفوفة_1 = مؤقت ؛
}
إذا ( مصفوفة_1 > مصفوفة_2 ) {
    صحيح مؤقت = مصفوفة_1 ؛
    مصفوفة_1 = مصفوفة_2 ؛
    مصفوفة_2 = مؤقت ؛
}
إذا ( مصفوفة_2 > مصفوفة_3 ) {
    صحيح مؤقت = مصفوفة_2 ؛
    مصفوفة_2 = مصفوفة_3 ؛
    مصفوفة_3 = مؤقت ؛
}
إذا ( مصفوفة_3 > مصفوفة_4 ) {
    صحيح مؤقت = مصفوفة_3 ؛
    مصفوفة_3 = مصفوفة_4 ؛
    مصفوفة_4 = مؤقت ؛
}

طباعة( مصفوفة_0 ) ؛  // 1
طباعة( مصفوفة_1 ) ؛  // 3
طباعة( مصفوفة_2 ) ؛  // 5
طباعة( مصفوفة_3 ) ؛  // 8
طباعة( مصفوفة_4 ) ؛  // 9

طباعة( "═══ اكتمل اختبار جمل التحكم ═══" ) ؛
