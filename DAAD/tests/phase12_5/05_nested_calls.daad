# Phase 12.5-F: Nested calls (A → B → C)
# Tests: frame independence across nested calls

دالة: add3(a: رقم، b: رقم، c: رقم) -> رقم :-
    ارجع(a + b + c)
نهاية

دالة: mul2(x: رقم، y: رقم) -> رقم :-
    ارجع(x * y)
نهاية

دالة: compute(a: رقم، b: رقم) -> رقم :-
    # Nested call: add3 calls mul2 indirectly
    متغير: product = mul2(a, b)
    متغير: sum = add3(a, b, product)
    ارجع(sum)
نهاية

دالة: الرئيسية() -> رقم :-
    متغير: result = compute(2, 3)
    # mul2(2,3)=6, add3(2,3,6)=11
    اطبع(result)
    ارجع(result)
نهاية
