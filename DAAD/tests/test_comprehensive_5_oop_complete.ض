// ── فئة محفظة (Banking) ──────────────────────────────────────
فئة محفظة {
    صحيح رصيد ;

    محفظة( صحيح رصيد_أولي ) {
        رصيد = رصيد_أولي ؛
    }

    صحيح إيداع( صحيح مبلغ ) {
        رصيد += مبلغ ؛
        ارجع رصيد ؛
    }

    صحيح سحب( صحيح مبلغ ) {
        إذا ( مبلغ > رصيد ) {
            طباعة( "خطأ: رصيد غير كافٍ" ) ؛
            ارجع رصيد ؛
        }
        رصيد -= مبلغ ؛
        ارجع رصيد ؛
    }
}

محفظة حسابي = محفظة( 1000 ) ؛
طباعة( "═══ اختبار فئة محفظة ═══" ) ؛
طباعة( حسابي.رصيد ) ؛     // 1000

حسابي.إيداع( 500 ) ؛
طباعة( حسابي.رصيد ) ؛     // 1500

حسابي.سحب( 200 ) ؛
طباعة( حسابي.رصيد ) ؛     // 1300

// ── فئة مصفوفة أرقام ────────────────────────────────────────
فئة قائمة_أرقام {
    صحيح عناصر_0 ;
    صحيح عناصر_1 ;
    صحيح عناصر_2 ;
    صحيح عناصر_3 ;
    صحيح عناصر_4 ;
    صحيح حجم ;
}

قائمة_أرقام قائمتي ;
قائمتي.حجم = 5 ؛
قائمتي.عناصر_0 = 10 ؛
قائمتي.عناصر_1 = 20 ؛
قائمتي.عناصر_2 = 30 ؛
قائمتي.عناصر_3 = 40 ؛
قائمتي.عناصر_4 = 50 ؛

// حساب المجموع يدوياً
صحيح المجموع = قائمتي.عناصر_0 + قائمتي.عناصر_1 + قائمتي.عناصر_2 + قائمتي.عناصر_3 + قائمتي.عناصر_4 ؛
طباعة( "═══ اختبار قائمة الأرقام ═══" ) ؛
طباعة( المجموع ) ؛  // 150

// ── حساب المعدل ─────────────────────────────────────────────
صحيح متوسط4( صحيح أ ، صحيح ب ، صحيح ج ، صحيح د ) {
    ارجع ( أ + ب + ج + د ) / 4 ؛
}

طباعة( "═══ اختبار المتوسط ═══" ) ؛
صحيح معدل = متوسط4( 80 ، 90 ، 70 ، 85 ) ؛
طباعة( معدل ) ؛   // 81

// ── أكبر من أربعة أرقام ─────────────────────────────────────
صحيح أكبر5( صحيح أ ، صحيح ب ، صحيح ج ، صحيح د ، صحيح ه ) {
    صحيح أكبر = أ ؛
    إذا ( ب > أكبر ) { أكبر = ب ؛ }
    إذا ( ج > أكبر ) { أكبر = ج ؛ }
    إذا ( د > أكبر ) { أكبر = د ؛ }
    إذا ( ه > أكبر ) { أكبر = ه ؛ }
    ارجع أكبر ؛
}

طباعة( "═══ اختبار أكبر5 ═══" ) ؛
صحيح أكبر = أكبر5( 3 ، 17 ، 8 ، 42 ، 25 ) ؛
طباعة( أكبر ) ؛  // 42

// ── اختبار try/catch ────────────────────────────────────────
طباعة( "═══ اختبار محاولة/امسك ═══" ) ؛
حاول {
    صحيح قيمة = 10 ؛
    إذا ( قيمة > 5 ) {
        طباعة( "قيمة كبيرة" ) ؛
    }
} امسك ( استثناء ) {
    طباعة( "حدث خطأ" ) ؛
}

// ── برنامج متكامل: حاسبة بسيطة ──────────────────────────────
طباعة( "═══ حاسبة بسيطة ═══" ) ؛
صحيح operands_a = 15 ؛
صحيح operands_b = 4 ؛

طباعة( "الجمع" ) ؛
طباعة( مجموع( operands_a ، operands_b ) ) ؛   // 19

طباعة( "الطرح" ) ؛
صحيح طرح = operands_a - operands_b ؛
طباعة( طرح ) ؛   // 11

طباعة( "الضرب" ) ؛
طباعة( ضرب( operands_a ، operands_b ) ) ؛   // 60

طباعة( "القسمة" ) ؛
صحيح قسمة = operands_a / operands_b ؛
طباعة( قسمة ) ؛   // 3

طباعة( "الباقي" ) ؛
صحيح باقي = operands_a % operands_b ؛
طباعة( باقي ) ؛   // 3

// ── برنامج متكامل: جدول الضرب ──────────────────────────────
طباعة( "═══ جدول الضرب ═══" ) ؛
لكل ( صحيح i = 1 ؛ i <= 5 ؛ i += 1 ) {
    لكل ( صحيح j = 1 ؛ j <= 5 ؛ j += 1 ) {
        صحيح نتيجة = ضرب( i ، j ) ؛
        طباعة( نتيجة ) ؛
    }
}

// ── برنامج متكامل: التحقق من النسبة المثلثية ───────────────
طباعة( "═══ اختبار منطقي معقد ═══" ) ؛
صحيحSide_a = 3 ؛
صحيحSide_b = 4 ؛
صحيحSide_c = 5 ؛

// فرضية فيثاغورس: a² + b² = c²
صحيحSide_a2 = مضروب( Side_a ) ؛
صحيحSide_b2 = مضروب( Side_b ) ؛
صحيحSide_c2 = مضروب( Side_c ) ؛

إذا ( Side_a2 + Side_b2 == Side_c2 ) {
    طباعة( "مثلث قائم الزاوية" ) ؛
} وإلا {
    طباعة( "ليس مثلث قائم الزاوية" ) ؛
}

