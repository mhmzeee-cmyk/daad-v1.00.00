// برنامج اختبار شامل 2: الدوال والتكرار
// ═══════════════════════════════════════════════════════════════

// ── الدوال الأساسية ──────────────────────────────────────────
صحيح مجموع( صحيح أ ، صحيح ب ) {
    ارجع أ + ب ؛
}

صحيح ضرب( صحيح أ ، صحيح ب ) {
    ارجع أ * ب ؛
}

صحيح مربع( صحيح س ) {
    ارجع س * س ؛
}

صحيح مكعب( صحيح س ) {
    ارجع س * س * س ؛
}

// ── اختبار الدوال ───────────────────────────────────────────
طباعة( "═══ اختبار الدوال الأساسية ═══" ) ؛
صحيح ن1 = مجموع( 10 ، 20 ) ؛
طباعة( ن1 ) ؛    // 30

صحيح ن2 = ضرب( 6 ، 7 ) ؛
طباعة( ن2 ) ؛    // 42

صحيح ن3 = مربع( 8 ) ؛
طباعة( ن3 ) ؛    // 64

صحيح ن4 = مكعب( 3 ) ؛
طباعة( ن4 ) ؛    // 27

// ── دالة مضروب (تكرارية) ────────────────────────────────────
صحيح مضروب( صحيح ن ) {
    إذا ( ن <= 1 ) {
        ارجع 1 ؛
    }
    ارجع ن * مضروب( ن - 1 ) ؛
}

طباعة( "═══ اختبار التكرار العودي ═══" ) ؛
صحيح ف5 = مضروب( 5 ) ؛
طباعة( ف5 ) ؛    // 120

// ── دالة فيبوناتشي ──────────────────────────────────────────
صحيح فيبوناتشي( صحيح ن ) {
    إذا ( ن <= 0 ) {
        ارجع 0 ؛
    }
    إذا ( ن == 1 ) {
        ارجع 1 ؛
    }
    ارجع فيبوناتشي( ن - 1 ) + فيبوناتشي( ن - 2 ) ؛
}

طباعة( "═══ اختبار فيبوناتشي ═══" ) ؛
صحيح فب1 = فيبوناتشي( 10 ) ؛
طباعة( فب1 ) ؛   // 55

// ── دالة تحقق من الأولية ────────────────────────────────────
منطقي أولي( صحيح ن ) {
    إذا ( ن < 2 ) {
        ارجع خطأ ؛
    }
    صحيح ا = 2 ؛
    طالما ( ا * ا <= ن ) {
        إذا ( ن % ا == 0 ) {
            ارجع خطأ ؛
        }
        ا += 1 ؛
    }
    ارجع صواب ؛
}

طباعة( "═══ اختبار الأعداد الأولية ═══" ) ؛
منطقي هل23أولي = أولي( 23 ) ؛
طباعة( هل23أولي ) ؛   // صواب

منطقي هل24أولي = أولي( 24 ) ؛
طباعة( هل24أولي ) ؛   // خطأ

// ── أكبر عامل ──────────────────────────────────────────────
صحيح أكبر_عامل( صحيح ن ) {
    صحيح largest = 1 ؛
    صحيح ا = 2 ؛
    طالما ( ا * ا <= ن ) {
        طالما ( ن % ا == 0 ) {
            largest = ا ؛
            ن = ن / ا ؛
        }
        ا += 1 ؛
    }
    إذا ( ن > 1 ) {
        largest = ن ؛
    }
    ارجع largest ؛
}

طباعة( "═══ اختبار أكبر عامل ═══" ) ؛
صحيح عامل100 = أكبر_عامل( 100 ) ؛
طباعة( عامل100 ) ؛   // 5

صحيح عامل1319 = أكبر_عامل( 1319 ) ؛
طباعة( عامل1319 ) ؛  // 1319 (أولي)

طباعة( "═══ اكتمل اختبار 2 ═══" ) ؛
