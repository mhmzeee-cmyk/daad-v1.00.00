# لعبة زومبي محسّنة
# الأسهم للتحرك | Space للركل | Z للإطلاق | 1-3 للسلاح | R لإعادة التشغيل

استورد "المحرك_الرسومي"

صحيح عرض = 800
صحيح ارتفاع = 500
صحيح لوح = محرك_جديد(عرض، ارتفاع)

صحيح لاعب_x = 400
صحيح لاعب_y = 250
صحيح حجم = 18
صحيح سرعة = 5
صحيح صحة = 100
صحيح صحة_قصوى = 100
صحيح اتجاه = 1
صحيح مدة_ركل = 0
صحيح ركل_active = 0
صحيح سلاح = 0
صحيح عداد_طلق = 0
صحيح مضي = 0
صحيح موجة = 1
صحيح قتل = 0
صحيح مطلوب = 5
صحيح نقاط = 0
صحيح انتهى = 0

صحيح[] ذخيرة = [50, 30, 15]
صحيح[] ضرر = [15, 25, 40]
صحيح[] سرعة_طلق = [8, 15, 25]

صحيح[] م_x = []
صحيح[] م_y = []
صحيح[] م_vx = []
صحيح[] م_vy = []
صحيح[] م_ضرر = []
صحيح[] م_نوع = []

صحيح عد_زومبي = 8
صحيح[] ز_x = []
صحيح[] ز_y = []
صحيح[] ز_s = []
صحيح[] ز_h = []
صحيح[] ز_n = []
صحيح[] ز_l = []
صحيح[] ز_hit = []

صحيح[] ف_x = []
صحيح[] ف_y = []
صحيح[] ف_عمر = []
صحيح[] ف_نوع = []

صحيح[] ص_x = []
صحيح[] ص_y = []
صحيح[] ص_قيمة = []

دالة ملء_زومبي() {
  صحيح k = 0
  طالما (k < عد_زومبي) {
    صحيح zx = تصادف_بين(50، عرض - 50)
    صحيح zy = تصادف_بين(50، ارتفاع - 50)
    صحيح zn = 0
    صحيح zs = 2
    صحيح zh = 30
    صحيح zl = "#dc2626"

    صحيح نسب = تصادف_بين(1، 100)
    اذا (موجة >= 2 && نسب <= 20) {
      zn = 1
      zs = 4
      zh = 20
      zl = "#f97316"
    }
    اذا (موجة >= 3 && نسب <= 8) {
      zn = 2
      zs = 1
      zh = 80
      zl = "#7c2d12"
    }

    أضف(ز_x، zx)
    أضف(ز_y، zy)
    أضف(ز_s، zs)
    أضف(ز_h، zh)
    أضف(ز_n، zn)
    أضف(ز_l، zl)
    أضف(ز_hit، 0)
    k += 1
  }
}

ملء_زومبي()

دالة اضف_مؤثر(fx، fy، ft) {
  أضف(ف_x، fx)
  أضف(ف_y، fy)
  أضف(ف_عمر، 20)
  أضف(ف_نوع، ft)
}

دالة تحديث(dt) {
  اذا (انتهى == 1) {
    اذا (مفتاح_مضغوط("r")) {
      صحة = صحة_قصوى
      نقاط = 0
      موجة = 1
      قتل = 0
      مطلوب = 5
      لاعب_x = 400
      لاعب_y = 250
      انتهى = 0
      ذخيرة[0] = 50
      ذخيرة[1] = 30
      ذخيرة[2] = 15
      سلاح = 0
      عد_زومبي = 8
      صحيح ci = 0
      طالما (ci < 30) {
        اذا (طول_مصفوفة(ز_x) > 0) {
          احذف_من(ز_x، 0)
          احذف_من(ز_y، 0)
          احذف_من(ز_s، 0)
          احذف_من(ز_h، 0)
          احذف_من(ز_n، 0)
          احذف_من(ز_l، 0)
          احذف_من(ز_hit، 0)
        }
        ci += 1
      }
      ci = 0
      طالما (ci < 20) {
        اذا (طول_مصفوفة(م_x) > 0) {
          احذف_من(م_x، 0)
          احذف_من(م_y، 0)
          احذف_من(م_vx، 0)
          احذف_من(م_vy، 0)
          احذف_من(م_ضرر، 0)
          احذف_من(م_نوع، 0)
        }
        ci += 1
      }
      ملء_زومبي()
    }
    ارجع
  }

  مضي += 1

  صحيح hx = 0
  صحيح hy = 0
  اذا (مفتاح_مضغوط("ArrowUp") || مفتاح_مضغوط("w")) { hy = -1 }
  اذا (مفتاح_مضغوط("ArrowDown") || مفتاح_مضغوط("s")) { hy = 1 }
  اذا (مفتاح_مضغوط("ArrowLeft") || مفتاح_مضغوط("a")) {
    hx = -1
    اتجاه = 0
  }
  اذا (مفتاح_مضغوط("ArrowRight") || مفتاح_مضغوط("d")) {
    hx = 1
    اتجاه = 1
  }

  لاعب_x = لاعب_x + hx * سرعة
  لاعب_y = لاعب_y + hy * سرعة

  اذا (لاعب_x < 15) { لاعب_x = 15 }
  اذا (لاعب_x > عرض - 15) { لاعب_x = عرض - 15 }
  اذا (لاعب_y < 15) { لاعب_y = 15 }
  اذا (لاعب_y > ارتفاع - 15) { لاعب_y = ارتفاع - 15 }

  اذا (مفتاح_مضغوط(" ") && مدة_ركل == 0) {
    مدة_ركل = 15
    ركل_active = 1
  }
  اذا (مدة_ركل > 0) { مدة_ركل = مدة_ركل - 1 }
  اذا (مدة_ركل == 0) { ركل_active = 0 }

  اذا (مفتاح_مضغوط("1")) { سلاح = 0 }
  اذا (مفتاح_مضغوط("2")) { سلاح = 1 }
  اذا (مفتاح_مضغوط("3")) { سلاح = 2 }

  اذا (عداد_طلق > 0) { عداد_طلق = عداد_طلق - 1 }
  اذا (مفتاح_مضغوط("z")) {
    اذا (عداد_طلق == 0 && ذخيرة[سلاح] > 0) {
      ذخيرة[سلاح] = ذخيرة[سلاح] - 1
      عداد_طلق = سرعة_طلق[سلاح]
      صحيح mx = اتجاه == 1 ? 1 : -1

      اذا (سلاح == 0) {
        أضف(م_x، لاعب_x + mx * 20)
        أضف(م_y، لاعب_y)
        أضف(م_vx، mx * 8)
        أضف(م_vy، 0)
        أضف(م_ضرر، 15)
        أضف(م_نوع، 0)
      }
      اذا (سلاح == 1) {
        أضف(م_x، لاعب_x + mx * 15)
        أضف(م_y، لاعب_y - 4)
        أضف(م_vx، mx * 10)
        أضف(م_vy، -1)
        أضف(م_ضرر، 25)
        أضف(م_نوع، 1)
        أضف(م_x، لاعب_x + mx * 15)
        أضف(م_y، لاعب_y + 4)
        أضف(م_vx، mx * 10)
        أضف(م_vy، 1)
        أضف(م_ضرر، 25)
        أضف(م_نوع، 1)
      }
      اذا (سلاح == 2) {
        صحيح ri = 0
        طالما (ri < 5) {
          صحيح za = (ri - 2) * 8
          أضف(م_x، لاعب_x + mx * 15)
          أضف(م_y، لاعب_y)
          أضف(م_vx، mx * 9)
          أضف(م_vy، za / 10)
          أضف(م_ضرر، 40)
          أضف(م_نوع، 2)
          ri += 1
        }
      }
    }
  }

  صحيح pi = 0
  صحيح عدد_م = طول_مصفوفة(م_x)
  طالما (pi < عدد_م) {
    م_x[pi] = م_x[pi] + م_vx[pi]
    م_y[pi] = م_y[pi] + م_vy[pi]
    صحيح خرج = 0
    اذا (م_x[pi] < -10 || م_x[pi] > عرض + 10) { خرج = 1 }
    اذا (م_y[pi] < -10 || م_y[pi] > ارتفاع + 10) { خرج = 1 }
    اذا (خرج == 1) {
      احذف_من(م_x، pi)
      احذف_من(م_y، pi)
      احذف_من(م_vx، pi)
      احذف_من(م_vy، pi)
      احذف_من(م_ضرر، pi)
      احذف_من(م_نوع، pi)
      عدد_م = عدد_م - 1
    } وإلا {
      pi += 1
    }
  }

  صحيح zi = 0
  طالما (zi < عد_زومبي) {
    اذا (ز_hit[zi] > 0) { ز_hit[zi] = ز_hit[zi] - 1 }

    صحيح pj = 0
    طالما (pj < طول_مصفوفة(م_x)) {
      اذا (يتداخل(م_x[pj] - 3، م_y[pj] - 3، 6، 6، ز_x[zi] - 10، ز_y[zi] - 10، 20، 20)) {
        ز_h[zi] = ز_h[zi] - م_ضرر[pj]
        ز_hit[zi] = 6
        اضف_مؤثر(م_x[pj]، م_y[pj]، 1)
        احذف_من(م_x، pj)
        احذف_من(م_y، pj)
        احذف_من(م_vx، pj)
        احذف_من(م_vy، pj)
        احذف_من(م_ضرر، pj)
        احذف_من(م_نوع، pj)
      } وإلا {
        pj += 1
      }
    }

    صحيح zx2 = ز_x[zi]
    صحيح zy2 = ز_y[zi]
    صحيح zs2 = ز_s[zi]
    صحيح ddx = لاعب_x - zx2
    صحيح ddy = لاعب_y - zy2
    صحيح dis = المسافة(zx2، zy2، لاعب_x، لاعب_y)
    اذا (dis > 1) {
      ز_x[zi] = zx2 + Math.floor(ddx / dis * zs2)
      ز_y[zi] = zy2 + Math.floor(ddy / dis * zs2)
    }

    اذا (يتداخل(ز_x[zi] - 10، ز_y[zi] - 10، 20، 20، لاعب_x - 12، لاعب_y - 12، 24، 24)) {
      اذا (ركل_active == 1) {
        ز_h[zi] = ز_h[zi] - 10
        اضف_مؤثر(ز_x[zi]، ز_y[zi]، 1)
        صحيح ddx2 = ز_x[zi] - لاعب_x
        صحيح ddy2 = ز_y[zi] - لاعب_y
        صحيح dis2 = المسافة(0، 0، ddx2، ddy2)
        اذا (dis2 > 0) {
          ز_x[zi] = ز_x[zi] + Math.floor(ddx2 / dis2 * 25)
          ز_y[zi] = ز_y[zi] + Math.floor(ddy2 / dis2 * 25)
        }
      } وإلا {
        صحة = صحة - 5
        اذا (ز_n[zi] == 2) { صحة = صحة - 10 }
        اضف_مؤثر(لاعب_x، لاعب_y، 0)
      }
    }

    zi += 1
  }

  zi = 0
  طالما (zi < عد_زومبي) {
    اذا (ز_h[zi] <= 0) {
      صحيح mm = 0
      طالما (mm < 3) {
        اضف_مؤثر(ز_x[zi] + تصادف_بين(-5، 5)، ز_y[zi] + تصادف_بين(-5، 5)، 0)
        mm += 1
      }
      نقاط = نقاط + (ز_n[zi] == 2 ? 30 : ز_n[zi] == 1 ? 20 : 10)
      قتل = قتل + 1
      اذا (تصادف_بين(1، 100) <= 15) {
        أضف(ص_x، ز_x[zi])
        أضف(ص_y، ز_y[zi])
        أضف(ص_قيمة، تصادف_بين(10، 25))
      }
      احذف_من(ز_x، zi)
      احذف_من(ز_y، zi)
      احذف_من(ز_s، zi)
      احذف_من(ز_h، zi)
      احذف_من(ز_n، zi)
      احذف_من(ز_l، zi)
      احذف_من(ز_hit، zi)
      عد_زومبي = عد_زومبي - 1
    } وإلا {
      zi += 1
    }
  }

  zi = 0
  طالما (zi < طول_مصفوفة(ص_x)) {
    اذا (يتداخل(ص_x[zi] - 8، ص_y[zi] - 8، 16، 16، لاعب_x - 12، لاعب_y - 12، 24، 24)) {
      صحة = صحة + ص_قيمة[zi]
      اذا (صحة > صحة_قصوى) { صحة = صحة_قصوى }
      اضف_مؤثر(ص_x[zi]، ص_y[zi]، 3)
      احذف_من(ص_x، zi)
      احذف_من(ص_y، zi)
      احذف_من(ص_قيمة، zi)
    } وإلا {
      zi += 1
    }
  }

  اذا (قتل >= مطلوب) {
    موجة = موجة + 1
    قتل = 0
    مطلوب = 5 + موجة * 2
    ذخيرة[0] = ذخيرة[0] + 10
    ذخيرة[1] = ذخيرة[1] + 5
    ذخيرة[2] = ذخيرة[2] + 3
    اذا (صحة < صحة_قصوى) { صحة = صحة + 20 }
    اذا (صحة > صحة_قصوى) { صحة = صحة_قصوى }
    صحيح nw = 0
    طالما (nw < 3) {
      صحيح nzn = 0
      صحيح nzs = 2
      صحيح nzh = 30 + موجة * 5
      صحيح nzl = "#dc2626"
      اذا (موجة >= 2 && تصادف_بين(1، 100) <= 25) {
        nzn = 1
        nzs = 4
        nzh = 20
        nzl = "#f97316"
      }
      اذا (موجة >= 3 && تصادف_بين(1، 100) <= 10) {
        nzn = 2
        nzs = 1
        nzh = 80 + موجة * 10
        nzl = "#7c2d12"
      }
      أضف(ز_x، تصادف_بين(50، عرض - 50))
      أضف(ز_y، تصادف_بين(50، ارتفاع - 50))
      أضف(ز_s، nzs)
      أضف(ز_h، nzh)
      أضف(ز_n، nzn)
      أضف(ز_l، nzl)
      أضف(ز_hit، 0)
      عد_زومبي = عد_زومبي + 1
      nw += 1
    }
  }

  zi = 0
  طالما (zi < طول_مصفوفة(ف_x)) {
    ف_عمر[zi] = ف_عمر[zi] - 1
    اذا (ف_عمر[zi] <= 0) {
      احذف_من(ف_x، zi)
      احذف_من(ف_y، zi)
      احذف_من(ف_عمر، zi)
      احذف_من(ف_نوع، zi)
    } وإلا {
      zi += 1
    }
  }

  اذا (صحة <= 0) { انتهى = 1 }

  # ══════ الرسم ══════
  مسح_الشاشة("#0f172a")

  صحيح gx = 0
  طالما (gx < عرض) {
    ارسم_خط(gx، 0، gx، ارتفاع، "#1e293b"، 1)
    gx += 40
  }
  صحيح gy = 0
  طالما (gy < ارتفاع) {
    ارسم_خط(0، gy، عرض، gy، "#1e293b"، 1)
    gy += 40
  }

  zi = 0
  طالما (zi < طول_مصفوفة(ص_x)) {
    ارسم_مستطيل(ص_x[zi] - 6، ص_y[zi] - 6، 12، 12، "#22c55e")
    ارسم_نص("+", ص_x[zi] - 3، ص_y[zi] + 3، "#fff"، 10)
    zi += 1
  }

  zi = 0
  طالما (zi < عد_زومبي) {
    صحيح zzx = ز_x[zi]
    صحيح zzy = ز_y[zi]
    صحيح zzn = ز_n[zi]
    صحيح zzl = ز_l[zi]
    صحيح zzs = zzn == 2 ? 14 : zzn == 1 ? 8 : 10
    صحيح zzlr = zzl
    اذا (ز_hit[zi] > 0) { zzlr = "#ffffff" }

    ارسم_دائرة(zzx + 2، zzy + 3، zzs - 2، "#00000044")
    اذا (zzn == 2) {
      ارسم_مستطيل(zzx - zzs، zzy - zzs، zzs * 2، zzs * 2، zzlr)
    } وإلا {
      ارسم_دائرة(zzx، zzy، zzs، zzlr)
    }
    ارسم_دائرة(zzx - 4، zzy - 3، 2، "#fbbf24")
    ارسم_دائرة(zzx + 4، zzy - 3، 2، "#fbbf24")
    اذا (zzn == 1) { ارسم_نص("!", zzx - 2، zzy + 3، "#fff"، 8) }
    اذا (zzn == 2) { ارسم_نص("X", zzx - 3، zzy + 4، "#fff"، 10) }

    صحيح zhp = ز_h[zi]
    اذا (zzn == 2) { zhp = zhp * 100 / (80 + موجة * 10) }
    اذا (zzn == 1) { zhp = zhp * 100 / 20 }
    اذا (zzn == 0) { zhp = zhp * 100 / (30 + موجة * 5) }
    اذا (zhp < 100) {
      ارسم_مستطيل(zzx - zzs، zzy - zzs - 6، zzs * 2، 3، "#333")
      صحيح lsc = zhp > 50 ? "#22c55e" : zhp > 25 ? "#fbbf24" : "#dc2626"
      ارسم_مستطيل(zzx - zzs، zzy - zzs - 6، Math.floor(zzs * 2 * zhp / 100)، 3، lsc)
    }
    zi += 1
  }

  ارسم_دائرة(لاعب_x + 2، لاعب_y + 4، حجم - 2، "#00000044")
  ارسم_دائرة(لاعب_x، لاعب_y، حجم، "#4ade80")
  صحيح pmx = اتجاه == 1 ? 1 : -1
  ارسم_دائرة(لاعب_x + pmx * 5، لاعب_y - 4، 3، "#fff")
  ارسم_دائرة(لاعب_x + pmx * 7، لاعب_y - 4، 1.5، "#1e293b")
  اذا (ركل_active == 1) {
    ارسم_دائرة_مفرغة(لاعب_x + pmx * 25، لاعب_y، 15، "#fbbf24"، 2)
  }

  zi = 0
  طالما (zi < طول_مصفوفة(م_x)) {
    صحيح ppx = م_x[zi]
    صحيح ppy = م_y[zi]
    اذا (م_نوع[zi] == 0) {
      ارسم_مستطيل(ppx - 4، ppy - 1، 8، 2، "#e2e8f0")
    } وإلا اذا (م_نوع[zi] == 1) {
      ارسم_دائرة(ppx، ppy، 2، "#fbbf24")
    } وإلا {
      ارسم_دائرة(ppx، ppy، 2.5، "#f97316")
    }
    zi += 1
  }

  zi = 0
  طالما (zi < طول_مصفوفة(ف_x)) {
    صحيح ffx = ف_x[zi]
    صحيح ffy = ف_y[zi]
    صحيح ffo = ف_عمر[zi]
    اذا (ف_نوع[zi] == 0) {
      ارسم_دائرة(ffx، ffy، Math.floor(ffo * 0.2)، "#dc2626")
    } وإلا اذا (ف_نوع[zi] == 1) {
      ارسم_دائرة(ffx، ffy، Math.floor(ffo * 0.25)، "#fbbf24")
    } وإلا {
      ارسم_نص("+", ffx - 3، ffy + 3، "#22c55e"، 12)
    }
    zi += 1
  }

  ارسم_مستطيل(10، 10، 154، 20، "#1e293b")
  صحيح lsc2 = صحة > 50 ? "#22c55e" : صحة > 25 ? "#fbbf24" : "#dc2626"
  ارسم_مستطيل(12، 12، Math.floor(صحة * 150 / صحة_قصوى)، 16، lsc2)
  ارسم_نص("HP " + صحة + "/" + صحة_قصوى، 15، 23، "#fff"، 10)

  ارسم_نص("Score: " + نقاط، عرض - 130، 15، "#fbbf24"، 16)
  ارسم_نص("Wave: " + موجة، عرض - 130، 35، "#a78bfa"، 14)
  ارسم_نص("Kills: " + قتل + "/" + مطلوب، عرض - 130، 55، "#94a3b8"، 12)

  صحيح[] sn = ["Knife", "Pistol", "Shotgun"]
  ارسم_نص("[" + (سلاح + 1) + "] " + sn[سلاح]، 10، ارتفاع - 35، "#e2e8f0"، 12)
  ارسم_نص("Ammo: " + ذخيرة[سلاح]، 10، ارتفاع - 18، "#94a3b8"، 10)

  اذا (انتهى == 1) {
    ارسم_مستطيل(0، 0، عرض، ارتفاع، "#000000aa")
    ارسم_نص("GAME OVER!", عرض / 2 - 70، ارتفاع / 2 - 40، "#dc2626"، 32)
    ارسم_نص("Score: " + نقاط، عرض / 2 - 40، ارتفاع / 2، "#fbbf24"، 18)
    ارسم_نص("Wave: " + موجة، عرض / 2 - 30، ارتفاع / 2 + 25، "#a78bfa"، 14)
    ارسم_نص("Press R to restart", عرض / 2 - 60، ارتفاع / 2 + 55، "#94a3b8"، 12)
  }
}

