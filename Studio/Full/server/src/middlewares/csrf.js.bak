const crypto = require('crypto');

// CSRF protection using Double Submit Cookie pattern
// Token stored in BOTH cookie (non-httpOnly) AND sent via X-CSRF-Token header
// Cross-origin sites cannot read cookies, so they can't forge the header

const CSRF_TOKEN_NAME = '_csrf_dhad';
// Derive CSRF key from JWT_SECRET (never the same as JWT itself)
const CSRF_SECRET = process.env.CSRF_SECRET
  || crypto.createHmac('sha256', process.env.JWT_SECRET || 'fallback-csrf').update('csrf-dhad-v1').digest('hex');

// In-memory token store (paired: cookie value -> header value)
const csrfTokens = new Map();
const CSRF_MAX_AGE = 3600000; // 1 hour

function generateCsrfToken() {
  const random = crypto.randomBytes(32).toString('hex');
  const signature = crypto.createHmac('sha256', CSRF_SECRET).update(random).digest('hex');
  return `${random}.${signature}`;
}

function verifyCsrfToken(token) {
  if (!token || !token.includes('.')) return false;
  const [random, signature] = token.split('.');
  const expected = crypto.createHmac('sha256', CSRF_SECRET).update(random).digest('hex');
  try {
    return crypto.timingSafeEqual(Buffer.from(signature, 'hex'), Buffer.from(expected, 'hex'));
  } catch {
    return false;
  }
}

function csrfProtection(req, res, next) {
  // Serve CSRF token via GET endpoint
  if (req.method === 'GET' && req.path === '/api/v1/csrf-token') {
    const token = generateCsrfToken();
    // Set cookie AND return token in body (dual delivery)
    res.cookie(CSRF_TOKEN_NAME, token, {
      httpOnly: false,
      secure: process.env.NODE_ENV === 'production' || process.env.COOKIE_SECURE === 'true',
      sameSite: 'lax',
      path: '/',
      maxAge: CSRF_MAX_AGE, // Express maxAge is in milliseconds
    });
    return res.json({ csrfToken: token });
  }

  // Skip verification for safe methods; issue a token cookie if absent
  if (req.method === 'GET' || req.method === 'HEAD' || req.method === 'OPTIONS') {
    const existing = req.cookies[CSRF_TOKEN_NAME];
    if (!existing || !verifyCsrfToken(existing)) {
      const token = generateCsrfToken();
      res.cookie(CSRF_TOKEN_NAME, token, {
        httpOnly: false,
        secure: process.env.NODE_ENV === 'production' || process.env.COOKIE_SECURE === 'true',
        sameSite: 'lax',
        path: '/',
        maxAge: CSRF_MAX_AGE, // Express maxAge is in milliseconds
      });
    }
    return next();
  }

  // Skip CSRF for native desktop apps (Bridge) — they use Bearer tokens, not cookies
  if (req.headers.authorization && req.headers.authorization.startsWith('Bearer ')) {
    return next();
  }

  // Skip CSRF for login/register — desktop apps have no token yet
  if (req.path === '/api/v1/auth/login' || req.path === '/api/v1/auth/register' ||
      req.path === '/api/v1/auth/request-otp' || req.path === '/api/v1/auth/verify-otp') {
    return next();
  }

  // For state-changing methods, verify CSRF token
  // SECURITY: Double-submit requires BOTH cookie AND header with identical values
  const cookieToken = req.cookies[CSRF_TOKEN_NAME];
  const headerToken = req.headers['x-csrf-token'];

  if (!cookieToken || !headerToken) {
    return res.status(403).json({
      error: 'CSRF_TOKEN_MISSING',
      message: 'CSRF token missing. Please refresh the page.',
    });
  }

  // Both tokens must be valid independently
  if (!verifyCsrfToken(cookieToken) || !verifyCsrfToken(headerToken)) {
    return res.status(403).json({
      error: 'CSRF_TOKEN_INVALID',
      message: 'CSRF token is invalid.',
    });
  }

  // Tokens must match (prevents cookie injection from different origin)
  const cookieBuf = Buffer.from(cookieToken, 'utf8');
  const headerBuf = Buffer.from(headerToken, 'utf8');
  if (cookieBuf.length !== headerBuf.length || !crypto.timingSafeEqual(cookieBuf, headerBuf)) {
    return res.status(403).json({
      error: 'CSRF_TOKEN_MISMATCH',
      message: 'CSRF token mismatch.',
    });
  }

  next();
}

module.exports = { csrfProtection, CSRF_TOKEN_NAME };
