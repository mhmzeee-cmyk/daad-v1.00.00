# ====================================================
# Dhad Studio - Environment Variables
# ====================================================
# Copy this file to .env and fill in real values

# ── Server ─────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# TCP backlog queue size for the listening socket (used in cluster mode)
# Required: No | Default: 2048
TCP_BACKLOG=2048

# Number of worker processes for cluster mode (defaults to CPU count)
# Required: No | Default: (auto = os.cpus().length)
WEB_CONCURRENCY=

# ── Database (Supabase PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Redis (Upstash / local) ───────────────────────────────────────────
REDIS_URL=redis://default:password@host:6379

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-random-64-char-string
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# Secret for signing refresh tokens (falls back to JWT_SECRET if not set)
# Required: No (falls back to JWT_SECRET) | Default: (uses JWT_SECRET)
JWT_REFRESH_SECRET=

# ── HMAC Telemetry ───────────────────────────────────────────────────
HMAC_SECRET=replace-with-a-random-64-char-string

# HMAC secret for challenge confirmation signatures (falls back to HMAC_SECRET)
# Required: No (falls back to HMAC_SECRET) | Default: (uses HMAC_SECRET)
HMAC_CONFIRM_SECRET=

# ── Bridge (Qt5 Desktop ↔ Server) ────────────────────────────────────
BRIDGE_SECRET=replace-with-a-random-32-char-string

# ── CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# Force cookies to use Secure flag even in non-production environments
# Required: No | Default: false (true in production)
COOKIE_SECURE=false

# HMAC secret for CSRF token generation and validation
# Required: No (auto-generated if insecure/default) | Default: auto-generated
CSRF_SECRET=

# Secret key for /health/detailed endpoint access (X-Health-Key header)
# Required: No | Default: (disabled — detailed health returns empty)
HEALTH_SECRET=

# ── Rate Limits (requests per minute) ─────────────────────────────────
RATE_LIMIT_PUBLIC=30
RATE_LIMIT_AUTHENTICATED=60
RATE_LIMIT_ADMIN=100
RATE_LIMIT_ONBOARD=5
RATE_LIMIT_SUBMISSION=10
RATE_LIMIT_OTP_REQUEST=3
RATE_LIMIT_OTP_VERIFY=5

# ── Encryption ───────────────────────────────────────────────────────
# IMPORTANT: Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ENCRYPTION_KEY=replace-with-a-random-128-char-hex-string

# ── AI Feedback (optional) ────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=info
