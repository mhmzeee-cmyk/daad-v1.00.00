generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── School ───────────────────────────────────────────────────────────────────

model School {
  id            String   @id @default(cuid())
  name          String
  code          String?
  email         String?
  phone         String?
  address       String?
  description   String?
  planType      String   @default("SCHOOL")
  totalLicenses Int      @default(0)
  usedLicenses  Int      @default(0)
  provisionedAt DateTime @default(now())

  users             User[]
  courses           Course[]
  students          Student[]
  lessons           Lesson[]
  challenges        Challenge[]
  attendanceRecords Attendance[]
  classrooms        Classroom[]
  securityAlerts    SecurityAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
}

// ── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  schoolId     String
  classroomId  String?
  role         String
  name         String
  email        String?
  nationalId   String?
  passwordHash String?
  isActive     Boolean @default(true)
  isVerified   Boolean @default(false)
  isApproved   Boolean @default(false)
  isOnboarded  Boolean @default(false)
  tokenVersion Int    @default(0)
  resetToken   String?
  resetTokenExpiry DateTime?

  school             School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroom          Classroom?  @relation("ClassroomStudents", fields: [classroomId], references: [id], onDelete: SetNull)
  teachingClassrooms Classroom[] @relation("ClassroomTeacher")

  challenges        Challenge[]
  submissions       Submission[]       @relation("UserSubmissions")
  loginLogs         LoginLog[]
  activityLogs      ActivityLog[]
  attendances       Attendance[]       @relation("UserAttendances")
  studentProfile    StudentProfile?
  userAchievements  UserAchievement[]
  cloudWorkspaces   CloudWorkspace[]
  assessmentResults StudentAssessmentResult[]
  projects          Project[]          @relation("UserProjects")
  invitation        Invitation?
  enrollments       StudentCourseEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, email])
  @@unique([schoolId, nationalId])
  @@index([schoolId])
  @@index([role])
  @@index([classroomId])
}

// ── Course ───────────────────────────────────────────────────────────────────

model Course {
  id            String  @id @default(cuid())
  schoolId      String
  title         String
  description   String  @default("")
  content       String  @default("")
  icon          String  @default("")
  category      String  @default("MAIN")
  order         Int     @default(0)
  unlockTier    Int     @default(0)
  published     Boolean @default(true)

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  enrollments StudentCourseEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([category])
}

// ── Student ───────────────────────────────────────────────────────────────────

model Student {
  id             String   @id @default(cuid())
  schoolId       String
  gradeLevel     String?
  enrollmentDate DateTime @default(now())
  status         String   @default("ACTIVE")
  gpa            Float?   @default(0.0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([status])
}

// ── Lesson ──────────────────────────────────────────────────────────────────

model Lesson {
  id            String   @id @default(cuid())
  schoolId      String
  courseId       String?
  title         String
  contentSlug   String
  content       String   @default("")
  order         Int
  duration      Int?
  prerequisites String @default("[]")
  objectives    String @default("[]")
  published     Boolean  @default(true)
  visibility    String   @default("PUBLIC")

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course   Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([courseId])
  @@index([order])
  @@index([published])
  @@index([visibility])
}

// ── Student Course Enrollment ────────────────────────────────────────────────

model StudentCourseEnrollment {
  id          String   @id @default(cuid())
  studentId   String
  courseId     String
  enrolledAt  DateTime @default(now())
  completedAt DateTime?

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

// ── Classroom ──────────────────────────────────────────────────────────────

model Classroom {
  id          String   @id @default(cuid())
  schoolId    String
  teacherId   String
  name        String
  description String?
  gradeLevel  String?
  subject     String?
  maxStudents Int      @default(40)
  isActive    Boolean  @default(true)
  inviteCode  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher     User         @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  students    User[]       @relation("ClassroomStudents")
  assessments Assessment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([teacherId])
  @@index([isActive])
}

// ── Challenge ────────────────────────────────────────────────────────────────

model Challenge {
  id             String  @id @default(cuid())
  authorId       String
  title          String
  description    String
  starterCode    String  @default("")
  expectedOutput String  @default("")
  dynamicOutput  String  @default("")
  requirements   String  @default("[]")
  difficulty     String  @default("BEGINNER")
  challengeType  String  @default("BUG_FIX")
  published      Boolean @default(false)
  dailyDate      String?
  tier           Int     @default(1)
  order          Int     @default(1)
  estimatedTime  Int?
  points         Int     @default(100)
  xpReward       Int     @default(0)
  isSystem       Boolean @default(false)
  popularity     Int     @default(0)

  author            User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  submissions       Submission[]
  challengesToTiers ChallengeTier[]
  cloudWorkspaces   CloudWorkspace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  School    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolId  String?
  courseId  String?

  @@index([authorId])
  @@index([published])
  @@index([difficulty])
  @@index([dailyDate])
  @@index([tier])
  @@index([isSystem])
  @@index([courseId])
}

// ── Submission ───────────────────────────────────────────────────────────────

model Submission {
  id               String  @id @default(cuid())
  challengeId      String
  studentId        String
  code             String
  language         String  @default("daad")
  passed           Boolean @default(false)
  output           String  @default("")
  executionTime    Int?
  memoryUsage      Int?
  syntaxScore      Int?
  performanceScore Int?
  compilationError String?
  timeout          Boolean @default(false)
  lineCount        Int?
  functionCount    Int?
  complexity       Int?
  suspicious       Boolean @default(false)
  suspiciousReason String?
  hmacValid        Boolean @default(true)
  aiFeedback       String?

  challenge          Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  student            User                @relation("UserSubmissions", fields: [studentId], references: [id])
  studentSubmissions StudentSubmission[]

  createdAt DateTime @default(now())

  @@index([challengeId])
  @@index([studentId])
  @@index([passed])
  @@index([createdAt])
  @@index([syntaxScore])
  @@index([suspicious])
}

// ── Project ──────────────────────────────────────────────────────────────────

model Project {
  id          String  @id @default(cuid())
  studentId   String
  lessonId    String
  title       String
  description String
  code        String  @default("")
  language    String  @default("daad")
  status      String  @default("IN_PROGRESS")
  score       Int?
  feedback    String? @default("")
  fileCount   Int     @default(0)
  totalSize   Int     @default(0)

  student User   @relation("UserProjects", fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([lessonId])
  @@index([status])
  @@index([createdAt])
}

// ── Attendance ─────────────────────────────────────────────────────────────

model Attendance {
  id         String  @id @default(cuid())
  studentId  String
  schoolId   String
  date       DateTime
  status     String  @default("PRESENT")
  notes      String? @default("")
  recordedBy String?

  student User   @relation("UserAttendances", fields: [studentId], references: [id], onDelete: Cascade)
  school  School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
  @@index([schoolId])
}

// ── ChallengeTier ───────────────────────────────────────────────────────────

model ChallengeTier {
  challengeId String
  tier        String

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([challengeId, tier])
  @@index([tier])
}

// ── Assessment ───────────────────────────────────────────────────────────

model Assessment {
  id             String   @id @default(cuid())
  classroomId    String
  title          String
  description    String   @default("")
  assessmentType String   @default("CODING")
  allowedTime    Int
  startTime      DateTime
  endTime        DateTime
  totalPoints    Int      @default(100)
  passingScore   Int      @default(60)
  isPublished    Boolean  @default(false)
  lockdownMode   Boolean  @default(true)
  challengeIds   String   @default("[]")
  questions      String   @default("[]")
  starterCode    String   @default("")
  expectedOutput String   @default("")
  instructions   String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classroom Classroom                 @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  results   StudentAssessmentResult[]

  @@index([classroomId])
  @@index([startTime])
  @@index([endTime])
  @@index([isPublished])
}

// ── Student Assessment Result ───────────────────────────────────────────────

model StudentAssessmentResult {
  id                  String   @id @default(cuid())
  assessmentId        String
  studentId           String
  score               Int      @default(0)
  totalPointsEarned   Int      @default(0)
  totalPointsPossible Int      @default(0)
  challengesAttempted Int      @default(0)
  challengesPassed    Int      @default(0)
  timeSpent           Int      @default(0)
  startedAt           DateTime @default(now())
  completedAt         DateTime?
  submissionIds       String   @default("[]")
  metadata            String?
  status              String   @default("IN_PROGRESS")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
  @@index([score])
  @@index([status])
}

// ── StudentSubmission ───────────────────────────────────────────────────────

model StudentSubmission {
  id             String @id @default(cuid())
  submissionId   String
  score          Int
  completionTime Int
  tokenCount     Int
  astNodesCount  Int
  errorCount     Int
  warningCount   Int
  metadata       String

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([score])
  @@index([completionTime])
}

// ── Login Log ───────────────────────────────────────────────────────────────
model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  ip        String   @default("")
  userAgent String   @default("")
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ── Student Profile ─────────────────────────────────────────────────────────

model StudentProfile {
  id               String   @id @default(cuid())
  studentId        String   @unique
  totalXP          Int      @default(0)
  currentLevel     Int      @default(1)
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastActive       DateTime @default(now())
  lastXPAwarded    DateTime @default(now())
  lastActivityDate String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student      User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievements UserAchievement[]
  dailyXP      DailyXP[]

  @@index([currentLevel])
}

// ── Daily XP ─────────────────────────────────────────────────────────────────

model DailyXP {
  id               String @id @default(cuid())
  studentId        String
  date             String
  totalXP          Int    @default(0)
  submissionsCount Int    @default(0)

  studentProfile StudentProfile @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([date])
}

// ── Achievement ──────────────────────────────────────────────────────────────

model Achievement {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String   @default("badge")
  criteria    String
  points      Int      @default(100)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]

  @@index([name])
}

// ── User Achievement ─────────────────────────────────────────────────────────

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  awardedAt     DateTime @default(now())
  metadata      String?

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement      Achievement     @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  StudentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id])
  studentProfileId String?

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([awardedAt])
}

// ── Activity Log ────────────────────────────────────────────────────────────
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ── Cloud Workspace ─────────────────────────────────────────────────────────

model CloudWorkspace {
  id          String   @id @default(cuid())
  studentId   String
  challengeId String
  savedCode   String   @default("")
  language    String   @default("daad")
  lastSavedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([studentId, challengeId])
  @@index([studentId])
  @@index([challengeId])
  @@index([lastSavedAt])
}

// ── Security Alert ──────────────────────────────────────────────────────────

model SecurityAlert {
  id         String    @id @default(cuid())
  studentId  String
  schoolId   String
  alertType  String
  severity   String    @default("MEDIUM")
  details    String
  resolved   Boolean   @default(false)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  School     School    @relation(fields: [schoolId], references: [id])

  @@index([studentId])
  @@index([schoolId])
  @@index([alertType])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
}

// ── Invitation ──────────────────────────────────────────────────────────────

model Invitation {
  id            String   @id @default(cuid())
  studentEmail  String
  studentName   String
  classroomId   String?
  schoolId      String
  schoolName    String
  token         String?
  tokenExpiry   DateTime?
  isActivated   Boolean  @default(false)
  userId        String?  @unique
  activatedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([schoolId, studentEmail])
  @@index([studentEmail])
  @@index([token])
  @@index([isActivated])
  @@index([schoolId])
}

// ── Challenge Verification ──────────────────────────────────────────────────

model ChallengeVerification {
  id          String   @id @default(cuid())
  studentId   String
  taskId      String
  timestamp   DateTime
  signature   String
  ip          String   @default("")
  userAgent   String   @default("")
  createdAt   DateTime @default(now())

  @@index([studentId])
  @@index([taskId])
  @@index([createdAt])
  @@index([studentId, taskId])
}
