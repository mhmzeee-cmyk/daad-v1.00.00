{
  "name": "dhad-studio",
  "version": "1.0.0",
  "description": "ض ستوديو - منصة تعليم البرمجة",
  "main": "main.js",
  "author": "ض ستوديو",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/prepare-build.js",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@msgpack/msgpack": "^3.1.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.dhad.studio",
    "productName": "ض ستوديو",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "server/**/*",
      "frontend-web/**/*",
      "prisma_client/**/*",
      "!**/node_modules/.cache",
      "!server/.env",
      "!server/prisma/dev.db",
      "!**/*.test.js",
      "!**/*.spec.js",
      "!server/tests/**",
      "!server/Dockerfile",
      "!server/docker-compose.yml",
      "!server/jest.config.js",
      "!server/.dockerignore",
      "!server/nginx.conf",
      "!server/render.yaml"
    ],
    "afterPack": "scripts/after-pack.js",
    "asarUnpack": [
      "node_modules/@prisma/client/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ض ستوديو"
    }
  }
}
