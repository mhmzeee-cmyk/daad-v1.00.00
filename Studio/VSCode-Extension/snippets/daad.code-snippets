{
  "طباعة": {
    "prefix": "طباعة",
    "body": ["طباعة(${1:النص}) ؛"],
    "description": "طباعة نص أو قيمة (01_hello.ض)"
  },
  "متغير صحيح": {
    "prefix": "صحيح",
    "body": ["صحيح ${1:اسم_المتغير} = ${2:القيمة} ؛"],
    "description": "تعريف متغير صحيح"
  },
  "دالة": {
    "prefix": "دالة",
    "body": ["دالة ${1:جمع}(صحيح ${2:أ}, صحيح ${3:ب}) -> صحيح {", "\t${4:ارجع ${2:أ} + ${3:ب} ؛}", "}"],
    "description": "تعريف دالة بصيغة ض الحقيقية (05_functions.ض)"
  },
  "حلقة لكل": {
    "prefix": "لكل",
    "body": ["لكل(صحيح ${1:i} = 1; ${1:i} <= ${2:10}; ${1:i} = ${1:i} + 1) {", "\t${3:طباعة(${1:i}) ؛}", "}"],
    "description": "حلقة لكل (04_loops.ض)"
  },
  "حلقة طالما": {
    "prefix": "طالما",
    "body": ["طالما(${1:الشرط}) {", "\t${2:// الجسم}", "}"],
    "description": "حلقة طالما (04_loops.ض)"
  },
  "حلقة كرر": {
    "prefix": "كرر",
    "body": ["كرر ( ${1:الشرط} ) {", "\t${2:// جسم الحلقة}", "}"],
    "description": "حلقة تكرار كرر"
  },
  "شرط إذا": {
    "prefix": "إذا",
    "body": ["إذا(${1:الشرط}) {", "\t${2:// الجسم}", "}"],
    "description": "جملة شرطية إذا (05_functions.ض)"
  },
  "فئة": {
    "prefix": "فئة",
    "body": ["فئة ${1:دائرة} {", "\tصحيح ${2:نصف_القطر} ؛", "", "\tصحيح ${3:مساحة}() {", "\t\tارجع ${4:0} ؛", "\t}", "}"],
    "description": "تعريف فئة بدوالها (classes.ض)"
  },
  "صنف": {
    "prefix": "صنف",
    "body": ["صنف ${1:شكل} {", "\tصحيح ${2:ن} ؛", "", "\tدالة جديد(صحيح ${2:ن}) {", "\t\t${3:// تهيئة}", "\t} ؛", "} ؛"],
    "description": "تعريف صنف مع بانٍ (دالة جديد)"
  },
  "قالب": {
    "prefix": "قالب",
    "body": ["قالب < ${1:نوع T} >", "فئة ${2:اسم_القالب} {", "\t// تطبيق القالب", "} ;"],
    "description": "تعريف قالب (Template)"
  },
  "حاول امسك": {
    "prefix": "حاول",
    "body": ["حاول {", "\t${1:// كود قد يفشل}", "} امسك (${2:خطأ}) {", "\t${3:// المعالجة}", "}"],
    "description": "معالجة الأخطاء حاول/امسك"
  },
  "برنامج كامل": {
    "prefix": "برنامج",
    "body": ["// ${1:وصف البرنامج}", "", "دالة الرئيسية() -> صحيح {", "\t${2:طباعة(\"مرحبا بالعالم!\") ؛}", "\tارجع 0 ؛", "}"],
    "description": "هيكل برنامج ض كامل"
  }
}
