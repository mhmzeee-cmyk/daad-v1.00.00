// برنامج حقيقي بلغة ض — دالة عودية + حلقة + شرط + طباعة
// يعمل على المحركين: daad-compiler (C++) ومحرك السحابة (JS)

دالة مضروب(صحيح ن) -> صحيح {
    إذا (ن <= 1) {
        ارجع 1 ؛
    }
    ارجع ن * مضروب(ن - 1) ؛
}

صحيح مجموع = 0 ؛
لكل (صحيح ا = 1 ؛ ا <= 10 ؛ ا = ا + 1) {
    مجموع = مجموع + ا ؛
}

طباعة(مضروب(5)) ؛
طباعة(مجموع) ؛
إذا (مجموع == 55) {
    طباعة("المجموع صحيح") ؛
}
احمد = ادخل("ادخل اسمك") ؛

