{
  "name": "dhad-studio",
  "version": "1.0.0",
  "description": "ض ستوديو - منصة تعليم البرمجة",
  "main": "main.js",
  "author": "ض ستوديو",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.dhad.studio",
    "productName": "ض ستوديو",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "icon.ico",
      "server/**/*",
      "frontend-web/**/*",
      "!**/node_modules/.cache"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ض ستوديو"
    }
  }
}
