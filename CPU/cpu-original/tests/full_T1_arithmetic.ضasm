# ═══════════════════════════════════════════════
# T1: اختبار تعليمات الحساب
# ADD / SUB / MUL / DIV / MOD / NEG
# ═══════════════════════════════════════════════

# --- ADD: جمع ---
حمّل مح، 10
حمّل س0، 20
جمع س0           # مح = 10 + 20 = 30
ادفع             # حفظ 30

# --- SUB: طرح ---
حمّل مح، 50
حمّل س1، 15
طرح س1           # مح = 50 - 15 = 35
ادفع

# --- MUL: ضرب ---
حمّل مح، 7
حمّل س2، 6
ضرب س2           # مح = 7 * 6 = 42
ادفع

# --- DIV: قسمة ---
حمّل مح، 100
حمّل س3، 8
قسمة س3          # مح = 100 / 8 = 12
ادفع

# --- MOD: باقي ---
حمّل مح، 100
حمّل س4، 8
باقي س4          # مح = 100 % 8 = 4
ادفع

# --- NEG: تبريد ---
حمّل مح، 42
تبريد            # مح = -42 = 214 (unsigned)
ادفع

# --- التحقق من النتائج ---
# pull all and check: should have 30,35,42,12,4,214
اسحب            # مح = 214 (NEG)
حمّل س5، 0      # م沦为 عدّاد

# التحقق: مح النهائي = 214 (NEG result)
توقف
