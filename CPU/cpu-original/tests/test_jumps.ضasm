# اختبار القفزات — 8-bit
# ═══════════════════════════════════════

# اختبار 1: JMP قفز دائم
حمّل مح، 11
قفز إلى_ب1
حمّل مح، 99     # يجب تخطيه
إلى_ب1:
اطبع            # يطبع 11
اطبع_حرف

# اختبار 2: JZ قفز إذا صفر
حمّل مح، 0
حمّل س0، 0
طرح س0          # مح = 0 → Z=1
قفز_إذا_صفر إلى_ب2
حمّل مح، 99     # يجب تخطيه
إلى_ب2:
اطبع            # يطبع 0
اطبع_حرف

# اختبار 3: JNZ قفز إذا غير صفر
حمّل مح، 5
حمّل س1، 3
طرح س1          # مح = 2 → Z=0
قفز_إذا_غيرصفر إلى_ب3
حمّل مح، 99     # يجب تخطيه
إلى_ب3:
اطبع            # يطبع 2
اطبع_حرف

# اختبار 4: JC قفز إذا حمل
حمّل مح، 200
حمّل س2، 100
جمع س2          # 200+100=300 → carry
قفز_إذا_حمل إلى_ب4
حمّل مح، 99     # يجب تخطيه
إلى_ب4:
اطبع            # يطبع 44
اطبع_حرف

# اختبار 5: JN قفز إذا سالب
حمّل مح، 10
حمّل س3، 30
طرح س3          # 10-30=-20 → N=1
قفز_إذا_سالب إلى_ب5
حمّل مح، 99     # يجب تخطيه
إلى_ب5:
اطبع            # يطبع 236
اطبع_حرف

توقف
