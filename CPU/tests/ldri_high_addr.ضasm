# ══════════════════════════════════════════════════════════════
#  T26b: LDRI high address — cross 0x00FF boundary
#  Address: 0x0100 (s0=0x01, s1=0x00)
#  Store 99 to 0x0100, load it back
#  Expected: ACC = 99
# ══════════════════════════════════════════════════════════════

    حمّل s0, 0x01     # addr_hi = 0x01
    حمّل s1, 0x00     # addr_lo = 0x00 (address = 0x0100)
    حمّل s7, 99       # value to store
    خزن_غيرمباشر s7, s0, s1   # mem[0x0100] = 99
    اقرأ_غيرمباشر s6, s0, s1  # s6 = mem[0x0100]
    نقل مح, s6        # ACC = s6
    توقف
