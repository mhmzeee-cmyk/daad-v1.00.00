# ═══════════════════════════════════════
# اختبار النقل والتخزين والتحميل — 8-bit
# ═══════════════════════════════════════

# ── اختبار 1: نقل س0 → س1 (الوجه، المصدر) ──
حمّل س0، 42
نقل س1، س0       # س1 = س0 = 42
حمّل مح، 0
جمع س1          # مح = 0 + 42 = 42
اطبع
اطبع_حرف

# ── اختبار 2: تخزين في الذاكرة ──
حمّل س2، 77
خزن س2، 0x80    # الذاكرة[0x80] = 77

# ── اختبار 3: تحميل من الذاكرة ──
اقرأ س3، 0x80   # س3 = الذاكرة[0x80] = 77
حمّل مح، 0
جمع س3          # مح = 77
اطبع
اطبع_حرف

# ── اختبار 4: تخزين وتحميل المح ──
حمّل مح، 99
خزن مح، 0x90    # الذاكرة[0x90] = 99
حمّل مح، 0
اقرأ مح، 0x90   # مح = الذاكرة[0x90] = 99
اطبع
اطبع_حرف

توقف
