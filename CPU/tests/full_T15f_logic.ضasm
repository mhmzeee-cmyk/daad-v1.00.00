# T15f: All logic+shift — جميع عمليات المنطق
load acc, 0xFF
load s0, 0x0F
# AND: 0xFF & 0x0F = 0x0F = 15
and s0
#现在 مح = 15
load acc, 0xF0
# OR: 0xF0 | 0x0F = 0xFF = 255
or s0
# XOR: 0xFF ^ 0x0F = 0xF0 = 240
xor s0
# NOT: ~0xF0 = 0x0F = 15
not
# SHL: 5 << 1 = 10
load acc, 5
shl
# SHR: 20 >> 1 = 10
load acc, 20
shr
halt
