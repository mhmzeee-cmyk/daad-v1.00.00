#!/bin/bash
# ============================================================
#  dhad — unified build orchestration for Dhad Studio (NOT a compiler)
#  Thin layer over the existing tools; reads Docs/Reference/targets.json.
#  Usage:
#    ./dhad targets
#    ./dhad build <program.ض|.daad> --target=<id> [-o output]
#    ./dhad run   <program.ض|.daad> --target=<id>   (linux-x64 | dhad-cpu only)
#  Supported combos (anything else fails with a clear reason):
#    .ض   + linux-x64   → daad-compiler → g++ → ELF
#    .ض   + windows-x64 → daad-compiler → MinGW → PE32+ EXE
#    .daad + linux-x64  → daad → gcc -nostartfiles → ELF
#    .daad + dhad-cpu   → daad --target=dhad → dhad_asm → .bin (+run on dhad_cpu)
# ============================================================
set -u
ROOT="$(cd "$(dirname "$0")" && pwd)"
REG="$ROOT/Docs/Reference/targets.json"

cmd="${1:-}"; shift 2>/dev/null || true
TARGET=""; OUT=""; SRC=""

for a in "$@"; do
  case "$a" in
    --target=*) TARGET="${a#--target=}" ;;
    -o) OUTNEXT=1 ;;
    *) if [ "${OUTNEXT:-0}" = "1" ]; then OUT="$a"; OUTNEXT=0; elif [ -z "$SRC" ]; then SRC="$a"; else echo "unknown arg: $a"; exit 2; fi ;;
  esac
done

need() { command -v "$1" >/dev/null 2>&1 || { echo "FATAL: missing tool: $1"; exit 2; }; }
tstatus() { python3 -c "import json,sys; d=json.load(open('$REG')); print([t for t in d['targets'] if t['id']=='$1'][0]['status'])" 2>/dev/null || echo UNKNOWN; }

if [ "$cmd" = "targets" ]; then
  python3 -c "
import json
d = json.load(open('$REG'))
for t in d['targets']:
    print('%-14s %-15s %s' % (t['id'], t['status'], t.get('note','')[:60]))
"; exit 0
fi

[ "$cmd" = "build" ] || [ "$cmd" = "run" ] || { echo "Usage: ./dhad {targets|build|run} ..."; exit 2; }
[ -n "$SRC" ] || { echo "FATAL: no source file"; exit 2; }
[ -f "$SRC" ] || SRC="$ROOT/$SRC"
[ -f "$SRC" ] || { echo "FATAL: source not found"; exit 2; }
[ -n "$TARGET" ] || { echo "FATAL: --target required (see ./dhad targets)"; exit 2; }
ST=$(tstatus "$TARGET")
[ "$ST" = "AVAILABLE" ] || { echo "FATAL: target '$TARGET' is $ST — not available (see Docs/Reference/targets.json)"; exit 3; }

EXT="${SRC##*.}"
TMPD="$(mktemp -d /tmp/dhad_build.XXXXXX)"; trap 'rm -rf "$TMPD"' EXIT

# ---------- Track A (.ض) ----------
if [ "$EXT" = "ض" ]; then
  DC="$ROOT/Compiler/build/bin/daad-compiler"
  [ -x "$DC" ] || { echo "BUILD: compiling daad-compiler..."; cmake -B "$ROOT/Compiler/build" -S "$ROOT/Compiler" -DCMAKE_BUILD_TYPE=Release -DDAAD_BUILD_TESTS=OFF >/dev/null 2>&1 && cmake --build "$ROOT/Compiler/build" -j"$(nproc)" >/dev/null 2>&1 || { echo "FATAL: compiler build failed"; exit 2; }; }
  [ -z "$OUT" ] && OUT="${SRC%.ض}$([ "$TARGET" = "windows-x64" ] && echo ".exe" || echo ".out")"
  case "$TARGET" in
    linux-x64)   need g++; "$DC" "$SRC" -o "$TMPD/out.cpp" >/dev/null 2>&1 || { echo "FATAL: compile failed"; exit 2; }; g++ -std=c++20 -O2 "$TMPD/out.cpp" -o "$OUT" -I "$ROOT/Compiler/include" -I "$ROOT/Compiler" || exit 2 ;;
    windows-x64) need x86_64-w64-mingw32-g++; "$DC" "$SRC" -o "$TMPD/out.cpp" >/dev/null 2>&1 || { echo "FATAL: compile failed"; exit 2; }; x86_64-w64-mingw32-g++ -std=c++20 -O2 -static -static-libgcc -static-libstdc++ "$TMPD/out.cpp" -o "$OUT" -I "$ROOT/Compiler/include" -I "$ROOT/Compiler" || exit 2 ;;
    *) echo "FATAL: target '$TARGET' does not accept .ض sources (Track A dialect mismatch)"; exit 3 ;;
  esac
  echo "OK: $OUT"
  if [ "$cmd" = "run" ]; then
    [ "$TARGET" = "linux-x64" ] || { echo "FATAL: cannot run '$TARGET' binaries on this machine"; exit 3; }
    exec "$OUT"
  fi
  exit 0
fi

# ---------- Track B (.daad) ----------
if [ "$EXT" = "daad" ]; then
  DA="$ROOT/DAAD/build/daad"
  [ -x "$DA" ] || { echo "BUILD: compiling daad..."; cmake -B "$ROOT/DAAD/build" -S "$ROOT/DAAD" -DCMAKE_BUILD_TYPE=Release >/dev/null 2>&1 && cmake --build "$ROOT/DAAD/build" -j"$(nproc)" >/dev/null 2>&1 || { echo "FATAL: daad build failed"; exit 2; }; }
  case "$TARGET" in
    linux-x64)
      [ -z "$OUT" ] && OUT="${SRC%.daad}.out"; need gcc
      "$DA" "$SRC" -o "$TMPD/out.s" 2>/dev/null || { echo "FATAL: compile failed"; exit 2; }
      gcc -nostartfiles "$TMPD/out.s" -o "$OUT" || exit 2
      echo "OK: $OUT"
      [ "$cmd" = "run" ] && exec "$OUT"
      ;;
    dhad-cpu)
      [ -z "$OUT" ] && OUT="${SRC%.daad}.bin"
      DHASM="$ROOT/CPU/dhad_asm"
      [ -x "$DHASM" ] || { make -C "$ROOT/CPU" dhad_asm >/dev/null 2>&1 || { echo "FATAL: assembler build failed"; exit 2; }; }
      "$DA" "$SRC" --target=dhad -o "$TMPD/out.ضasm" 2>/dev/null || { echo "FATAL: compile failed"; exit 2; }
      "$DHASM" "$TMPD/out.ضasm" "$OUT" || exit 2
      echo "OK: $OUT"
      if [ "$cmd" = "run" ]; then
        [ -x "$ROOT/CPU/dhad_cpu" ] || { make -C "$ROOT/CPU" dhad_cpu >/dev/null 2>&1; }
        exec "$ROOT/CPU/dhad_cpu" "$OUT"
      fi
      ;;
    *) echo "FATAL: target '$TARGET' does not accept .daad sources (Track B x86 output is Linux-SysV-only)"; exit 3 ;;
  esac
  exit 0
fi

echo "FATAL: unknown source extension '.$EXT' (want .ض or .daad)"; exit 2
