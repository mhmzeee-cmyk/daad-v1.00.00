// البرنامج 2: العمليات الحسابية
// جمع وطرح وضرب وقسمة

صحيح ص1 = 10 ؛
صحيح ص2 = 5 ؛

صحيح مجموع = ص1 + ص2 ؛
صحيح فرق = ص1 - ص2 ؛
صحيح حاصل_الضرب = ص1 * ص2 ؛
صحيح حاصل_القسمة = ص1 / ص2 ؛

طباعة("المجموع: ") ؛
طباعة(مجموع) ؛
طباعة("الفرق: ") ؛
طباعة(فرق) ؛
طباعة("حاصل الضرب: ") ؛
طباعة(حاصل_الضرب) ؛
طباعة("حاصل القسمة: ") ؛
طباعة(حاصل_القسمة) ؛
