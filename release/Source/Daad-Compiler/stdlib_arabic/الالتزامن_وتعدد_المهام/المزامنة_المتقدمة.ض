// إنشاء حالة
دالة إنشاء_حالة() -> صحيح {
    صحيح حالة=0;
    حالة=إنشاء_حالة();
    ارجع حالة;
}

// انتظار
دالة انتظر_الحالة(حالة صحيح) {
    انتظر_الحالة(حالة);
}

// إبلاغ
دالة أبلغ_الحالة(حالة صحيح) {
    أبلغ_الحالة(حالة);
}

// إنشاء عقدة
دالة إنشاء_عقدة() -> صحيح {
    صحيح عقدة=0;
    عقدة=إنشاء_عقدة();
    ارجع عقدة;
}

// قراءة
دالة اقرأ_عقدة(عقدة صحيح) {
    اقرأ_عقدة(عقدة);
}

// كتابة
دالة اكتب_عقدة(عقدة صحيح) {
    اكتب_عقدة(عقدة);
}

// إنشاء محلل
دالة إنشاء_محلل() -> صحيح {
    صحيح محلل=0;
    محلل=إنشاء_محلل();
    ارجع محلل;
}

// قراءة
دالة اقرأ_محلل(محلل صحيح) {
    اقرأ_محلل(محلل);
}

// كتابة
دالة اكتب_محلل(محلل صحيح) {
    اكتب_محلل(محلل);
}

// إنشاء مزرعة
دالة إنشاء_مزرعة(صحيح عدد) -> صحيح {
    صحيح مزرعة=0;
    مزرعة=إنشاء_مزرعة(عدد);
    ارجع مزرعة;
}


