// ض مكتبة: مزامنة_المجموعات
// الفئة: الالتزامن_وتعدد_المهام
// الوصف: مزامنة المجموعات

// إنشاء
دالة إنشاء_مجموعة_متزامنة() -> صحيح {
    صحيح مجموعة=0;
    مجموعة=إنشاء_مجموعة_متزامنة();
    ارجع مجموعة;
}

// إضافة آمنة
دالة أضف_بآمان(مجموعة صحيح,قيمة صحيح) -> صحيح {
    أضف_بآمان(مجموعة,قيمة);
    ارجع صحيحاً;
}

// حذف آمن
دالة احذف_بآمان(مجموعة صحيح,قيمة صحيح) -> صحيح {
    احذف_بآمان(مجموعة,قيمة);
    ارجع صحيحاً;
}

// يحتوي؟
دالة يحتوي_بآمان(مجموعة صحيح,قيمة صحيح) -> صحيح {
    صحيح يحتوي=0;
    إذا(يحتوي_بآمان(مجموعة,قيمة)==1){ يحتوي=1; }
    ارجع يحتوي;
}

// الحجم
دالة حجم_بآمان(مجموعة صحيح) -> صحيح {
    صحيح حجم=0;
    حجم=حجم_بآمان(مجموعة);
    ارجع حجم;
}

// تفريغ
دالة تفريغ_بآمان(مجموعة صحيح) {
    تفريغ_بآمان(مجموعة);
}

// الإحصائيات
دالة إحصائيات_المجموعات() -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_مجموعات();
    ارجع إحصائيات;
}

// دمج آمن
دالة دمج_بآمان(مجموعة a,مجموعة b) -> صحيح {
    دمج_بآمان(a,b);
    ارجع صحيحاً;
}

// نسخ آمن
دالة نسخ_بآمان(مجموعة صحيح) -> صحيح {
    صحيح نسخة=0;
    نسخة=نسخ_بآمان(مجموعة);
    ارجع نسخة;
}

// الذراعية
دالة عملية_ذراعية(مجموعة صحيح,دالة نص) -> صحيح {
    صحيح نتيجة=0;
    نتيجة=عملية_ذراعية(مجموعة,دالة);
    ارجع نتيجة;
}


