// ض مكتبة: الخيوط
// الفئة: الالتزامن_وتعدد_المهام
// الوصف: تعدد الخيوط

// إنشاء خيط
دالة إنشاء_خيط(دالة نص) -> صحيح {
    صحيح خيط=0;
    خيط=إنشاء_خيط(دالة);
    ارجع خيط;
}

// بدء
دالة بدء_الخيط(خيط صحيح) -> صحيح {
    بدء_خيط(خيط);
    ارجع صحيحاً;
}

// انتظار
دالة انتظر_الخيط(خيط صحيح) {
    انتظر_خيط(خيط);
}

// إنهاء
دالة إنهاء_الخيط(خيط صحيح) {
    إنهاء_خيط(خيط);
}

// الحالة
دالة حالة_الخيط(خيط صحيح) -> صحيح {
    صحيح حالة=0;
    حالة=حالة_خيط(خيط);
    ارجع حالة;
}

// الخيط الرئيسي
دالة خيط_الرئيسي() -> صحيح {
    صحيح رئيسي=0;
    رئيسي=خيط_الرئيسي();
    ارجع رئيسي;
}

// الخيط الحالي
دالة خيط_الحالي() -> صحيح {
    صحيح حالي=0;
    حالي=خيط_الحالي();
    ارجع حالي;
}

// عدد الخيوط
دالة عدد_الخيوط() -> صحيح {
    صحيح عدد=0;
    عدد=عدّ_خيوط();
    ارجع عدد;
}

// إيقاف
دالة إيقاف_الخيط(خيط صحيح) {
    إيقاف_خيط(خيط);
}

// معلّق؟
دالة خيط_معلّق(خيط صحيح) -> صحيح {
    صحيح معلّق=0;
    إذا(هل_معلّق(خيط)==1){ معلّق=1; }
    ارجع معلّق;
}


