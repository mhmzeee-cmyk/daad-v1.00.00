// الفئة: الالتزامن_وتعدد_المهام
// الوصف: الأقفال

// إنشاء قفل
دالة إنشاء_قفل() -> صحيح {
    صحيح قفل=0;
    قفل=إنشاء_قفل();
    ارجع قفل;
}

// قفل
دالة أقفل(قفل صحيح) {
    أقفل(قفل);
}

// فتح
دالة افتح_القفل(قفل صحيح) {
    افتح_قفل(قفل);
}

// محاولة
دالة حاول_القفل(قفل صحيح) -> صحيح {
    صحيح نجاح=0;
    نجاح=حاول_قفل(قفل);
    ارجع نجاح;
}

// إنشاء mutex
دالة إنشاء_mutex() -> صحيح {
    صحيح mutex=0;
    mutex=إنشاء_mutex();
    ارجع mutex;
}

// قفل
دالة أقفل_mutex(mutex صحيح) {
    أقفل_mutex(mutex);
}

// فتح
دالة افتح_mutex(mutex صحيح) {
    افتح_mutex(mutex);
}

// إنشاء rwlock
دالة إنشاء_rwlock() -> صحيح {
    صحيح rwlock=0;
    rwlock=إنشاء_rwlock();
    ارجع rwlock;
}

// قراءة
دالة اقرأ_rwlock(rwlock صحيح) {
    اقرأ_rwlock(rwlock);
}

// فتح قراءة
دالة افتح_rwlock(rwlock صحيح) {
    افتح_rwlock(rwlock);
}


