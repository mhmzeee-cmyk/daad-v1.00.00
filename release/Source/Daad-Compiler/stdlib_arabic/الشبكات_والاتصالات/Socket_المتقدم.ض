// الفئة: الشبكات_والاتصالات
// الوصف: Socket متقدم

// إنشاء raw socket
دالة إنشاء_raw() -> صحيح {
    صحيح raw=0;
    raw=إنشاء_raw();
    ارجع raw;
}

// إرسال
دالة أرسل_raw(raw صحيح,بيانات صحيح[]) -> صحيح {
    أرسل_raw(raw,بيانات);
    ارجع صحيحاً;
}

// استقبال
دالة استقبل_raw(raw صحيح,صحيح حجم) -> صحيح {
    صحيح[] بيانات=[];
    بيانات=استقبل_raw(raw,حجم);
    ارجع بيانات;
}

// إنشاء multicast
دالة إنشاء_ملحق() -> صحيح {
    صحيح multicast=0;
    multicast=إنشاء_ملحق();
    ارجع multicast;
}

// ربط
دالة اربط_ملحق(multicast صحيح,عنوان نص) -> صحيح {
    اربط_ملحق(multicast,عنوان);
    ارجع صحيحاً;
}

// إرسال
دالة أرسل_ملحق(multicast صحيح,بيانات نص) -> صحيح {
    أرسل_ملحق(multicast,بيانات);
    ارجع صحيحاً;
}

// إنشاء broadcast
دالة إنشاء_بث() -> صحيح {
    صحيح broadcast=0;
    broadcast=إنشاء_بث();
    ارجع broadcast;
}

// إرسال
دالة أرسل_بث(broadcast صحيح,بيانات نص) -> صحيح {
    أرسل_بث(broadcast,بيانات);
    ارجع صحيحاً;
}

// إنشاء SCTP
دالة SCTP_إنشاء() -> صحيح {
    صحيح sctp=0;
    sctp=إنشاء_sctp();
    ارجع sctp;
}

// إرسال
دالة SCTP_أرسل(sctp صحيح,بيانات نص) -> صحيح {
    SCTP_أرسل(sctp,بيانات);
    ارجع صحيحاً;
}


