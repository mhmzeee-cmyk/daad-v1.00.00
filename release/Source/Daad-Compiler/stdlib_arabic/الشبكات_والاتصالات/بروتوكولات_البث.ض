// ض مكتبة: بروتوكولات_البث
// الفئة: الشبكات_والاتصالات
// الوصف: البث والبث

// بث UDP
دالة بث_UDP(عنوان نص,منفذ صحيح,بيانات نص) -> صحيح {
    بث_UDP(عنوان,منفذ,بيانات);
    ارجع صحيحاً;
}

// بث multicast
دالة بث_multicast(عنوان نص,بيانات نص) -> صحيح {
    بث_multicast(عنوان,بيانات);
    ارجع صحيحاً;
}

// استقبال
دالة استقبال_البث(منفذ صحيح,صحيح حجم) -> صحيح {
    نص بيانات="";
    بيانات=استقبال_بث(منفذ,حجم);
    ارجع بيانات;
}

// إنشاء خادم
دالة إنشاء_خادم_بث(منفذ صحيح) -> صحيح {
    صحيح خادم=0;
    خادم=إنشاء_خادم_بث(منفذ);
    ارجع خادم;
}

// إرسال
دالة أرسل_لخادم(خادم صحيح,بيانات نص) -> صحيح {
    أرسل_خادم(خادم,بيانات);
    ارجع صحيحاً;
}

// إحصائيات
دالة إحصائيات_البث(خادم صحيح) -> صحيح {
    صحيح إحصائيات=0;
    إحصائيات=إحصائيات_بث(خادم);
    ارجع إحصائيات;
}

// تعيين الصيغة
دالة صيغة_البث(صحيح صيغة) -> صحيح {
    تعيين_صيغة(صيغة);
    ارجع صحيحاً;
}

// بدء
دالة بدء_البث(خادم صحيح) -> صحيح {
    بدء_بث(خادم);
    ارجع صحيحاً;
}

// إيقاف
دالة إيقاف_البث(خادم صحيح) {
    إيقاف_بث(خادم);
}

// المستمعين
دالة قائمة_المستمعين(خادم صحيح) -> صحيح[] {
    صحيح[] مستمعين=[];
    مستمعين=مستمعين(خادم);
    ارجع مستمعين;
}


