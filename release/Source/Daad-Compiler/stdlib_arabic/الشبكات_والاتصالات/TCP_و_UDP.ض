// الوصف: TCP و UDP

// إنشاء TCP
دالة إنشاء_tcp() -> صحيح {
    صحيح tcp=0;
    tcp=إنشاء_tcp();
    ارجع tcp;
}

// ربط
دالة اربط_tcp(tcp صحيح,عنوان نص,منفذ صحيح) -> صحيح {
    اربط_tcp(tcp,عنوان,منفذ);
    ارجع صحيحاً;
}

// اتصال
دالة اتصل_tcp(tcp صحيح,عنوان نص,منفذ صحيح) -> صحيح {
    اتصل_tcp(tcp,عنوان,منفذ);
    ارجع صحيحاً;
}

// إرسال
دالة أرسل_tcp(tcp صحيح,بيانات نص) -> صحيح {
    أرسل_tcp(tcp,بيانات);
    ارجع صحيحاً;
}

// استقبال
دالة استقبل_tcp(tcp صحيح,صحيح حجم) -> صحيح {
    نص بيانات="";
    بيانات=استقبل_tcp(tcp,حجم);
    ارجع بيانات;
}

// إغلاق
دالة اغلق_tcp(tcp صحيح) {
    اغلق_tcp(tcp);
}

// إنشاء UDP
دالة إنشاء_udp() -> صحيح {
    صحيح udp=0;
    udp=إنشاء_udp();
    ارجع udp;
}

// إرسال
دالة أرسل_udp(udp صحيح,بيانات نص,عنوان نص,منفذ صحيح) -> صحيح {
    أرسل_udp(udp,بيانات,عنوان,منفذ);
    ارجع صحيحاً;
}

