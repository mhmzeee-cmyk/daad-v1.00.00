// ض مكتبة: المقابض_الشبكية
// الفئة: الشبكات_والاتصالات
// الوصف: المقابض

// إنشاء مقابض
دالة إنشاء_مقابض() -> صحيح {
    صحيح مقابض=0;
    مقابض=إنشاء_مقابض();
    ارجع مقابض;
}

// ربط
دالة اربط_مقابض(مقابض صحيح,عنوان نص,منفذ صحيح) -> صحيح {
    اربط(مقابض,عنوان,منفذ);
    ارجع صحيحاً;
}

// استماع
دالة استمع_مقابض(مقابض صحيح,صحيح عدد) -> صحيح {
    استمع(مقابض,عدد);
    ارجع صحيحاً;
}

// قبول
دالة اقبل_اتصال(مقابض صحيح) -> صحيح {
    صحيح عميل=0;
    عميل=اقبل(مقابض);
    ارجع عميل;
}

// إرسال
دالة أرسل_مقابض(مقابض صحيح,بيانات صحيح[]) -> صحيح {
    صحيح عدد=0;
    عدد=أرسل(مقابض,بيانات);
    ارجع عدد;
}

// استقبال
دالة استقبل_مقابض(مقابض صحيح,صحيح حجم) -> صحيح {
    صحيح[] بيانات=[];
    بيانات=استقبل(مقابض,حجم);
    ارجع بيانات;
}

// إغلاق
دالة اغلق_مقابض(مقابض صحيح) {
    اغلق(مقابض);
}

// الحالة
دالة حالة_المقابض(مقابض صحيح) -> صحيح {
    صحيح حالة=0;
    حالة=حالة(مقابض);
    ارجع حالة;
}

// غير محجوب
دالة مقابض_غير_ blocking(مقابض صحيح) -> صحيح {
    غير_ blocking(مقابض);
    ارجع صحيحاً;
}

// خطأ
دالة خطأ_المقابض(مقابض صحيح) -> صحيح {
    صحيح خطأ=0;
    خطأ=خطأ_مقابض(مقابض);
    ارجع خطأ;
}


