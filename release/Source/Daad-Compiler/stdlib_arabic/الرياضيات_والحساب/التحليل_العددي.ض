// حل ax+b=0
دالة حل_خطي(عشري a,عشري b) -> عشري {
    إذا(a==0.0){ ارجع 0.0; }
    ارجع -b/a;
}

// حل تربيعي
دالة حل_تربيعي(عشري a,عشري b,عشري c) -> عشري[] {
    عشري[] جذور=[];
    عشري delta=b*b-4*a*c;
    إذا(delta>=0.0){ جذور=أضف(جذور,(-b+جذر(delta))/(2*a)); جذور=أضف(جذور,(-b-جذر(delta))/(2*a)); }
    ارجع جذور;
}

// مетод نيوتن
دالة نيوتن(عشري ف,عشري x0) -> عشري {
    عشري x=x0;
    لكل(صحيح i=0;i<100;i+=1){عشري fx=ف(x);عشري dfx=مشتق(ف,x);إذا(مطلق(dfx)<0.0001){ توقف; }x=x-fx/dfx; }
    ارجع x;
}

// تقريب تايلور
دالة تايلور(عشري ف,عشري x,صحيح حدود) -> عشري {
    عشري نتيجة=0.0;
    لكل(صحيح n=0;n<حدود;n+=1){ نتيجة+=(قوة(x,n)/مضروب(n))*ف(0); }
    ارجع نتيجة;
}

// حل نظام
دالة حل_نظام(عشري[][] A,عشري[] b) -> عشري[] {
    عشري[] حل=غاوس(A,b);
    ارجع حل;
}

// تحليل فورييه
دالة فورييه(عشري[] قيم) -> عشري[] {
    عشري[] نتيجة=تحويل_فورييه(قيم);
    ارجع نتيجة;
}

// المشتق العددي
دالة مشتق_عددي(عشري ف,عشري x) -> عشري {
    عشري h=0.0001;
    ارجع (ف(x+h)-ف(x-h))/(2*h);
}

// التكامل العددي
دالة تكامل_عددي(عشري ف,عشري a,عشري b) -> عشري {
    عشري مجموع=0.0;عشري h=(b-a)/100;
    لكل(صحيح i=0;i<100;i+=1){ مجموع+=ف(a+i*h)*h; }
    ارجع مجموع;
}

// تقريب الكثافة
دالة تقريب_كثافة(عشري[] قيم) -> عشري {
    ارجع متوسط(قيم);
}

// أدنى المربعات
دالة أدنى_مربعات(عشري[] x,عشري[] y) -> عشري[] {
    عشري[] نتيجة=أدنى_مربعات(x,y);
    ارجع نتيجة;
}


