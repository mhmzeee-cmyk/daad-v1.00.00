// ض مكتبة: البحث_والاستبدال
// الفئة: النصوص_والترميز
// الوصف: البحث والاستبدال

// بحث واعث
دالة ابحث_عميق(نص s,استعلام نص) -> صحيح[] {
    صحيح[] مواقع=بحث_كل(s,استعلام);
    ارجع مواقع;
}

// بحث من الخلف
دالة ابحث_خلف(نص s,استعلام نص) -> صحيح {
    صحيح موقع=بحث_خلف(s,استعلام);
    ارجع موقع;
}

// استبدال الكل
دالة استبدل_الكل(نص s,قديم نص,جديد نص) -> صحيح {
    صحيح نتيجة=استبدل_كل(s,قديم,جديد);
    ارجع نتيجة;
}

// عدد التكرارات
دالة عدّ(نص s,استعلام نص) -> صحيح {
    صحيح عدد=عدّ_تكرار(s,استعلام);
    ارجع عدد;
}

// استخراج بين
دالة استخرج_بين(نص s,بادئ نص,لاحق نص) -> صحيح {
    صحيح ناتج=اقتطاع(s,بادئ,لاحق);
    ارجع ناتج;
}

// بحث متعدد
دالة بحث_متعدد(نص s,استعلامات نص[]) -> صحيح {
    صحيح وُجد=0;
    لكل(صحيح i=0;i<طول(استعلامات);i+=1){ إذا(ابحث(s,استعلامات[i])>=0){ وُجد=1; } }
    ارجع وُجد;
}

// استبدال بنمط
دالة استبدل_نمط(نص s,نمط نص,بـ نص) -> صحيح {
    صحيح نتيجة=استبدل_نمط(s,نمط,بـ);
    ارجع نتيجة;
}

// استخراج متكرر
دالة استخرج_متكرر(نص s,نمط نص) -> صحيح[] {
    صحيح[] نتائج=جميع(s,نمط);
    ارجع نتائج;
}

// السياق
دالة احصل_على_السياق(نص s,موقع صحيح) -> صحيح {
    صحيح سياق=اقتطع(s,موقع-10,موقع+10);
    ارجع سياق;
}

// استبدال ذكي
دالة استبدل_ذكي(نص s,قواعد نص[][]) -> صحيح {
    صحيح نتيجة=s;
    لكل(صحيح i=0;i<طول(قواعد);i+=1){ نتيجة=استبدل(نتيجة,قواعد[i][0],قواعد[i][1]); }
    ارجع نتيجة;
}


