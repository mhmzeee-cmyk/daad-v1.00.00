// ض مكتبة: التحليل_والتقسيم
// الفئة: النصوص_والترميز
// الوصف: تحليل النصوص

// تحليل JSON
دالة حلل_json(نص s) -> صحيح {
    صحيح نجاح=0;
    نجاح=تحليل_json(s);
    ارجع نجاح;
}

// تحليل CSV
دالة حلل_csv(نص s) -> صحيح[] {
    صحيح[] نتائج=فصل_csv(s);
    ارجع نتائج;
}

// تقسيم للسطور
دالة قسّم_السطور(نص s) -> صحيح[] {
    صحيح[] سطور=فصل(s,"\n");
    ارجع سطور;
}

// تقسيم للكلمات
دالة قسّم_الكلمات(نص s) -> صحيح[] {
    صحيح[] كلمات=فصل(s," ");
    ارجع كلمات;
}

// استخراج الروابط
دالة استخرج_روابط(نص s) -> صحيح[] {
    صحيح[] روابط=بحث_نمط(s,"http");
    ارجع روابط;
}

// استخراج الأرقام
دالة استخرج_أرقام(نص s) -> صحيح[] {
    صحيح[] أرقام=أرقام_من(s);
    ارجع أرقام;
}

// استخراج البريد
دالة استخرج_بريد(نص s) -> صحيح[] {
    صحيح[] رسائل=بحث_نمط(s,"@");
    ارجع رسائل;
}

// تطابق بنمط
دالة حلل_نمط(نص s,نمط نص) -> صحيح {
    صحيح طابق=تطابق(s,نمط);
    ارجع طابق;
}

// جميع المطابقات
دالة استخرج_مطابقات(نص s,نمط نص) -> صحيح[] {
    صحيح[] مطابقات=بحث_جميع(s,نمط);
    ارجع مطابقات;
}

// الإشارات @
دالة استخرج_إشارات(نص s) -> صحيح[] {
    صحيح[] إشارات=بحث_نمط(s,"@");
    ارجع إشارات;
}


