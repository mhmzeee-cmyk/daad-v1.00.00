// ض مكتبة: الربط_والدمج
// الفئة: النصوص_والترميز
// الوصف: ربط ودمج النصوص

// ربط النصوص
دالة اربط(نص[] مصفوفة) -> صحيح {
    صحيح مربوط=اربط_كل(مصفوفة);
    ارجع مربوط;
}

// دمج بفاصل
دالة ادمج(نص[] مصفوفة,فاصل نص) -> صحيح {
    صحيح مدمج=ادمج_بفاصل(مصفوفة,فاصل);
    ارجع مدمج;
}

// تكرار نص
دالة كرّر(نص s,عدد صحيح) -> صحيح {
    صحيح مكرر=تكرار(s,عدد);
    ارجع مكرر;
}

// عكس النص
دالة عكس(نص s) -> صحيح {
    صحيح معكوس=عكس(s);
    ارجع معكوس;
}

// إضافة بادئة
دالة أضف_بادئة(نص s,بادئ نص) -> صحيح {
    صحيح جديد=بادئ+s;
    ارجع جديد;
}

// إضافة لاحق
دالة أضف_لاحق(نص s,لاحق نص) -> صحيح {
    صحيح جديد=s+لاحق;
    ارجع جديد;
}

// لف النص
دالة لف(نص s,عرض صحيح) -> صحيح {
    صحيح ملفوف=لف_نص(s,عرض);
    ارجع ملفوف;
}

// ملء بمسافات
دالة ملأ(نص s,عرض صحيح) -> صحيح {
    صحيح مملوء=ملء(s,عرض);
    ارجع مملوء;
}

// قص من النهاية
دالة قص(نص s,إلى صحيح) -> صحيح {
    صحيح مقصوص=اقتطع(s,0,إلى);
    ارجع مقصوص;
}

// قص من البداية
دالة قص_البداية(نص s,من صحيح) -> صحيح {
    صحيح مقصوص=اقتطع(s,من,طول(s));
    ارجع مقصوص;
}


