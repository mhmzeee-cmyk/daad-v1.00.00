// إنشاء قاعدة
دالة إنشاء_قاعدة(اسم نص) -> صحيح {
    إنشاء_قاعدة(اسم);
    ارجع صحيحاً;
}

// فتح قاعدة
دالة افتح_قاعدة(اسم نص) -> صحيح {
    صحيح قاعدة=0;
    قاعدة=افتح_قاعدة(اسم);
    ارجع قاعدة;
}

// إغلاق
دالة أغلق_قاعدة(قاعدة صحيح) {
    أغلق_قاعدة(قاعدة);
}

// تنفيذ
دالة نفّذ_استعلام(قاعدة صحيح,استعلام نص) -> صحيح {
    صحيح نتيجة=0;
    نتيجة=نفّذ(قاعدة,استعلام);
    ارجع نتيجة;
}

// إنشاء جدول
دالة إنشاء_جدول_SQL(قاعدة صحيح,اسم نص,أعمدة نص) -> صحيح {
    إنشاء_جدول_sql(قاعدة,اسم,أعمدة);
    ارجع صحيحاً;
}

// حذف جدول
دالة حذف_جدول_SQL(قاعدة صحيح,اسم نص) -> صحيح {
    حذف_جدول_sql(قاعدة,اسم);
    ارجع صحيحاً;
}

// إدراج
دالة إدراج_صف(قاعدة صحيح,جدول نص,قيم نص[]) -> صحيح {
    إدراج_صف_sql(قاعدة,جدول,قيم);
    ارجع صحيحاً;
}

// تحديث
دالة تحديث_صف(قاعدة صحيح,جدول نص,شرط نص,قيم نص[]) -> صحيح {
    تحديث_صف_sql(قاعدة,جدول,شرط,قيم);
    ارجع صحيحاً;
}

// حذف
دالة حذف_صف(قاعدة صحيح,جدول نص,شرط نص) -> صحيح {
    حذف_صف_sql(قاعدة,جدول,شرط);
    ارجع صحيحاً;
}

// SELECT
دالة استعلام_ SELECT(قاعدة صحيح,استعلام نص) -> صحيح {
    صحيح[] نتائج=[];
    نتائج=select_sql(قاعدة,استعلام);
    ارجع نتائج;
}


