// الفئة: قواعد_البيانات
// الوصف: اتصالات

// إنشاء اتصال
دالة إنشاء_اتصال(خادم نص,مستخدم نص,كلمة نص) -> صحيح {
    صحيح اتصال=0;
    اتصال=إنشاء_اتصال(خادم,مستخدم,كلمة);
    ارجع اتصال;
}

// إغلاق
دالة إغلاق_الاتصال(اتصال صحيح) {
    إغلاق_اتصال(اتصال);
}

// الحالة
دالة حالة_الاتصال(اتصال صحيح) -> صحيح {
    صحيح حالة=0;
    حالة=حالة_اتصال(اتصال);
    ارجع حالة;
}

// إنشاء pool
دالة إنشاء_تجمع(حجم صحيح) -> صحيح {
    صحيح تجمع=0;
    تجمع=إنشاء_تجمع(حجم);
    ارجع تجمع;
}

// جلب
دالة احصل_من_التجمع(تجمع صحيح) -> صحيح {
    صحيح اتصال=0;
    اتصال=احصل_تجمع(تجمع);
    ارجع اتصال;
}

// إعادة
دالة أعد_للتجمع(تجمع صحيح,اتصال صحيح) {
    أعد_تجمع(تجمع,اتصال);
}

// الحجم
دالة حجم_التجمع(تجمع صحيح) -> صحيح {
    صحيح حجم=0;
    حجم=حجم_تجمع(تجمع);
    ارجع حجم;
}

// المتاح
دالة تجمع_متاح(تجمع صحيح) -> صحيح {
    صحيح متاح=0;
    متاح=تجمع_متاح(تجمع);
    ارجع متاح;
}

// إحصائيات
دالة إحصائيات_التجمع(تجمع صحيح) -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_تجمع(تجمع);
    ارجع إحصائيات;
}

// إغلاق
دالة إغلاق_التجمع(تجمع صحيح) {
    إغلاق_تجمع(تجمع);
}


