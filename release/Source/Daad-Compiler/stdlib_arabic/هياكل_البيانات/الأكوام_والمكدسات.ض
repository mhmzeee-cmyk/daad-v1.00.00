// إنشاء مكدس
دالة إنشاء_مكدس() -> صحيح {
    صحيح مكدس=0;
    مكدس=إنشاء_مكدس();
    ارجع مكدس;
}

// دفع
دالة ادفع_المكدس(مكدس صحيح,قيمة صحيح) -> صحيح {
    ادفع(مكدس,قيمة);
    ارجع صحيحاً;
}

// إخراج
دالة أخرج_المكدس(مكدس صحيح) -> صحيح {
    صحيح قيمة=0;
    قيمة=أخرج(مكدس);
    ارجع قيمة;
}

// الاطلاع
دالة .peek_المكدس(مكدس صحيح) -> صحيح {
    صحيح قيمة=0;
    قيمة=peek(مكدس);
    ارجع قيمة;
}

// هل فارغ؟
دالة فارغ_المكدس(مكدس صحيح) -> صحيح {
    صحيح فارغ=0;
    إذا(مكدس_فارغ(مكدس)==1){ فارغ=1; }
    ارجع فارغ;
}

// الحجم
دالة حجم_المكدس(مكدس صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=حجم_مكدس(مكدس);
    ارجع عدد;
}

// مسح
دالة مسح_المكدس(مكدس صحيح) {
    مسح(مكدس);
}

// إنشاء كوّة
دالة إنشاء_كوّة() -> صحيح {
    صحيح كوّة=0;
    كوّة=إنشاء_كوّة();
    ارجع كوّة;
}

// إدخال
دالة أدخل_الكوّة(كوّة صحيح,قيمة صحيح) -> صحيح {
    أدخل(كوّة,قيمة);
    ارجع صحيحاً;
}

// إخراج
دالة أخرج_الكوّة(كوّة صحيح) -> صحيح {
    صحيح قيمة=0;
    قيمة=أخرج_كوّة(كوّة);
    ارجع قيمة;
}


