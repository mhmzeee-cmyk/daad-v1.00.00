// ض مكتبة: الهياكل_المتهمة
// الفئة: هياكل_البيانات
// الوصف: هياكل hashing

// إنشاء
دالة إنشاء_ hash() -> صحيح {
    صحيح hash=0;
    hash=إنشاء_hash();
    ارجع hash;
}

// إضافة
دالة أضف_hash(hash صحيح,مفتاح نص,قيمة صحيح) -> صحيح {
    أضف_hash(hash,مفتاح,قيمة);
    ارجع صحيحاً;
}

// جلب
دالة احصل_hash(hash صحيح,مفتاح نص) -> صحيح {
    صحيح قيمة=0;
    قيمة=جلب_hash(hash,مفتاح);
    ارجع قيمة;
}

// حذف
دالة احذف_hash(hash صحيح,مفتاح نص) -> صحيح {
    حذف_hash(hash,مفتاح);
    ارجع صحيحاً;
}

// هل يوجد؟
دالة مفتاح_ موجود(hash صحيح,مفتاح نص) -> صحيح {
    صحيح موجود=0;
    إذا(يوجد_hash(hash,مفتاح)==1){ موجود=1; }
    ارجع موجود;
}

// الحجم
دالة حجم_hash(hash صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=حجم_hash(hash);
    ارجع عدد;
}

// مسح
دالة مسح_hash(hash صحيح) {
    مسح_hash(hash);
}

// جميع المفاتيح
دالة المفاتيح(hash صحيح) -> صحيح[] {
    صحيح[] مفاتيح=[];
    مفاتيح=مفاتيح_hash(hash);
    ارجع مفاتيح;
}

// جميع القيم
دالة القيم(hash صحيح) -> صحيح[] {
    صحيح[] قيم=[];
    قيم=قيم_hash(hash);
    ارجع قيم;
}

// نسخ
دالة انسخ_hash(hash صحيح) -> صحيح {
    صحيح نسخة=0;
    نسخة=نسخ_hash(hash);
    ارجع نسخة;
}


