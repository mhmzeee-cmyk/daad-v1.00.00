// ض مكتبة: الترجمة_والأخطاء
// الفئة: المدخلات_والمخرجات
// الوصف: معالجة الأخطاء

// رمي خطأ
دالة رمي_خطأ(رسالة نص,كود صحيح) {
    طباعة_خطأ("خطأ["+تحويل_نص(كود)+"]: "+رسالة);
}

// الإمساك
دالة امسك_خطأ() -> صحيح {
    صحيح كود=0;
    إذا(عدد_أخطاء()>0){ كود=آخر_خطأ(); }
    ارجع كود;
}

// طباعة خطأ
دالة طباعة_خطأ(رسالة نص) {
    اكتب_stderr(رسالة);
}

// هل نجحت؟
دالة تحقق_من_النجاح(نتيجة صحيح) -> صحيح {
    إذا(نتيجة==1){ ارجع صحيحاً; }
    ارجع خاطئاً;
}

// عدد الأخطاء
دالة عدد_الأخطاء() -> صحيح {
    صحيح عدد=0;
    عدد=عدّ_أخطاء();
    ارجع عدد;
}

// كود آخر خطأ
دالة آخر_خطأ() -> صحيح {
    صحيح كود=0;
    كود=جلب_خطأ();
    ارجع كود;
}

// تسجيل خطأ
دالة سجّل_خطأ(رسالة نص) {
    سجّل_سجل("خطأ: "+رسالة);
}

// مسح السجلات
دالة مسح_السجلات() {
    امسح_سجل();
}

// إعادة تعيين
دالة إعادة_تعيين() {
    إعادة_عداد();
}

// تصدير لملف
دالة تصدير_الأخطاء(مسار نص) -> صحيح {
    صحيح ملف=افتح(مسار,1);
    إذا(ملف>0){ اكتب_ملف(ملف,جلب_سجل()); أغلق(ملف); ارجع صحيحاً; }
    ارجع خاطئاً;
}


