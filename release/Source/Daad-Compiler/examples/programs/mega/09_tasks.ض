// البرنامج 9: نظام إدارة مهام
// قائمة مهام مع أولويات وحالات

دالة تحديد_الأولوية(صحيح أولوية) -> نص {
    إذا(أولوية == 1) { ارجع "عالية" ؛ }
    إذا(أولوية == 2) { ارجع "متوسطة" ؛ }
    إذا(أولوية == 3) { ارجع "منخفضة" ؛ }
    ارجع "غير محددة" ؛
}

دالة تحديد_الحالة_رقم(صحيح رقم) -> نص {
    إذا(رقم == 0) { ارجع "قيد التنفيذ" ؛ }
    إذا(رقم == 1) { ارجع "مكتملة" ؛ }
    إذا(رقم == 2) { ارجع "متأخرة" ؛ }
    ارجع "غير محددة" ؛
}

// بيانات المهام
صحيح[] مهام_الأولوية = 1 ؛
صحيح[] مهام_الحالة = 0 ؛
صحيح عدد_الهام = 5 ؛

مهام_الأولوية[0] = 1 ؛
مهام_الأولوية[1] = 2 ؛
مهام_الأولوية[2] = 1 ؛
مهام_الأولوية[3] = 3 ؛
مهام_الأولوية[4] = 2 ؛

مهام_الحالة[0] = 1 ؛
مهام_الحالة[1] = 0 ؛
مهام_الحالة[2] = 0 ؛
مهام_الحالة[3] = 2 ؛
مهام_الحالة[4] = 1 ؛

// الإحصائيات
صحيح مكتملة = 0 ؛
صحيح قيد_التنفيذ = 0 ؛
صحيح متأخرة = 0 ؛
لكل(صحيح i = 0; i < عدد_الهام; i = i + 1) {
    إذا(مهام_الحالة[i] == 1) { مكتملة += 1 ؛ }
    إذا(مهام_الحالة[i] == 0) { قيد_التنفيذ += 1 ؛ }
    إذا(مهام_الحالة[i] == 2) { متأخرة += 1 ؛ }
}

طباعة("=== نظام إدارة المهام ===") ؛
طباعة("عدد المهام: ") ؛
طباعة(عدد_الهام) ؛
طباعة("مكتملة: ") ؛
طباعة(مكتملة) ؛
طباعة("قيد التنفيذ: ") ؛
طباعة(قيد_التنفيذ) ؛
طباعة("متأخرة: ") ؛
طباعة(متأخرة) ؛

// نسبة الإنجاز
صحيح نسبة = مكتملة * 100 / عدد_الهام ؛
طباعة("نسبة الإنجاز: ") ؛
طباعة(نسبة) ؛
طباعة("%") ؛

// المهام عالية الأولوية
طباعة("=== المهام عالية الأولوية ===") ؛
لكل(صحيح i = 0; i < عدد_الهام; i = i + 1) {
    إذا(مهام_الأولوية[i] == 1) {
        طباعة("مهمة ") ؛
        طباعة(i + 1) ؛
        طباعة(" - الحالة: ") ؛
        طباعة(تحديد_الحالة_رقم(مهام_الحالة[i])) ؛
    }
}
