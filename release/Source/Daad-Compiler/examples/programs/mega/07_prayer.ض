// البرنامج 7: تنبيه لصلاة مع أوقات مختلفة
// نظام تذكير بأوقات الصلاة الخمس

دالة تحديد_الصلاة(صحيح ساعة, صحيح دقيقة) -> نص {
    صحيح وقت = ساعة * 60 + دقيقة ؛

    إذا(وقت >= 300) {
        إذا(وقت < 360) { ارجع "الفجر" ؛ }
    }
    إذا(وقت >= 720) {
        إذا(وقت < 780) { ارجع "الظهر" ؛ }
    }
    إذا(وقت >= 870) {
        إذا(وقت < 930) { ارجع "العصر" ؛ }
    }
    إذا(وقت >= 1080) {
        إذا(وقت < 1140) { ارجع "المغرب" ؛ }
    }
    إذا(وقت >= 1200) {
        إذا(وقت < 1260) { ارجع "العشاء" ؛ }
    }
    ارجع "خارج وقت الصلاة" ؛
}

دالة طباعة_أوقات_الصلاة() {
    طباعة("=== أوقات الصلاة اليومية ===") ؛
    طباعة("الفجر: 05:00") ؛
    طباعة("الظهر: 12:00") ؛
    طباعة("العصر: 14:30") ؛
    طباعة("المغرب: 18:00") ؛
    طباعة("العشاء: 20:00") ؛
}

دالة معرفة_الوقت_التالي(صحيح ساعة) -> صحيح {
    إذا(ساعة < 5) { ارجع 5 ؛ }
    إذا(ساعة < 12) { ارجع 12 ؛ }
    إذا(ساعة < 14) { ارجع 14 ؛ }
    إذا(ساعة < 18) { ارجع 18 ؛ }
    إذا(ساعة < 20) { ارجع 20 ؛ }
    ارجع 5 ؛
}

دالة عدّ_الصلاة(صحيح ساعة) -> صحيح {
    إذا(ساعة < 5) { ارجع 0 ؛ }
    إذا(ساعة < 12) { ارجع 1 ؛ }
    إذا(ساعة < 14) { ارجع 2 ؛ }
    إذا(ساعة < 18) { ارجع 3 ؛ }
    إذا(ساعة < 20) { ارجع 4 ؛ }
    ارجع 5 ؛
}

// البيانات
صحيح الساعة = 15 ؛
صحيح الدقيقة = 30 ؛

طباعة("=== نظام تنبيه الصلاة ===") ؛
طباعة("الوقت الحالي: ") ؛
طباعة(الساعة) ؛
طباعة(":") ؛
إذا(الدقيقة < 10) { طباعة("0") ؛ }
طباعة(الدقيقة) ؛

نص صلاة_الآن = تحديد_الصلاة(الساعة, الدقيقة) ؛
طباعة("الصلاة الحالية: ") ؛
طباعة(صلاة_الآن) ؛

صحيح صلوات_اليوم = عدّ_الصلاة(الساعة) ؛
صحيح صلوات_متبقية = 5 - صلوات_اليوم ؛
طباعة("الصلوات المصلية اليوم: ") ؛
طباعة(صلوات_اليوم) ؛
طباعة("الصلوات المتبقية: ") ؛
طباعة(صلوات_متبقية) ؛

صحيح وقت_التالي = معرفة_الوقت_التالي(الساعة) ؛
طباعة("أقرب صلاة: ") ؛
طباعة( وقت_التالي) ؛
طباعة(":00") ؛

// عرض كل الأوقات
طباعة_أوقات_الصلاة() ؛
