// ═══════════════════════════════════════════════════════════════
// لعبة الثعبان — بلغة ض
// ═══════════════════════════════════════════════════════════════

__dhad.setCanvasSize(800, 600);
__dhad.background("#111111");

// ── المتغيرات ──────────────────────────────────────────────────
 صحيح حجم_الشبكة = 20;
 صحيح عدد_الخلايا_س = 40;
 صحيح عدد_الخلايا_ص = 30;

 صحيح الثعبان = [];
 صحيح طول_الثعبان = 5;
 صحيح اتجاه_س = 1;
 صحيح اتجاه_ص = 0;

 صحيح طعام_س = 20;
 صحيح طعام_ص = 15;
 صحيح نقاط = 0;
 صحيح لعبة_نهاية = 0;
 صحيح مؤقت = 0;
 صحيح سرعة = 5;

// ── تهيئة الثعبان ──────────────────────────────────────────────
دالة تهيئة() {
    صحيح س = 0;
    طالما (س < 200) {
        الثعبان[س] = 0;
        س = س + 1;
    }
    // البداية من المركز
    الثعبان[0] = 20;
    الثعبان[1] = 15;
    الثعبان[2] = 19;
    الثعبان[3] = 15;
    الثعبان[4] = 18;
    الثعبان[5] = 15;
    الثعبان[6] = 17;
    الثعبان[7] = 15;
    الثعبان[8] = 16;
    الثعبان[9] = 15;
    طول_الثعبان = 5;
    اتجاه_س = 1;
    اتجاه_ص = 0;
    نقاط = 0;
    لعبة_نهاية = 0;
    مؤقت = 0;
}

// ── رسم الشبكة ─────────────────────────────────────────────────
دالة رسم_شبكة() {
    __dhad.setColor("#222222");
    صحيح س = 0;
    طالما (س < عدد_الخلايا_س) {
        __dhad.line(س * حجم_الشبكة, 0, س * حجم_الشبكة, 600);
        س = س + 1;
    }
    صحيح ص = 0;
    طالما (ص < عدد_الخلايا_ص) {
        __dhad.line(0, ص * حجم_الشبكة, 800, ص * حجم_الشبكة);
        ص = ص + 1;
    }
}

// ── رسم الثعبان ────────────────────────────────────────────────
دالة رسم_ثعبان() {
    صحيح س = 0;
    طالما (س < طول_الثعبان) {
        صحيح مؤشر = س * 2;
        صحيح خلية_س = الثعبان[مؤشر];
        صحيح خلية_ص = الثعبان[مؤشر + 1];
        إذا (س == 0) {
            // الرأس
            __dhad.setColor("#00ff00");
            __dhad.rectangle(خلية_س * حجم_الشبكة, خلية_ص * حجم_الشبكة, حجم_الشبكة, حجم_الشبكة);
            // العيون
            __dhad.setColor("#ffffff");
            __dhad.rectangle(خلية_س * حجم_الشبكة + 4, خلية_ص * حجم_الشبكة + 4, 5, 5);
            __dhad.rectangle(خلية_س * حجم_الشبكة + 11, خلية_ص * حجم_الشبكة + 4, 5, 5);
        } وإلا {
            // الجسم
            __dhad.setColor("#00cc00");
            __dhad.rectangle(خلية_س * حجم_الشبكة + 1, خلية_ص * حجم_الشبكة + 1, حجم_الشبكة - 2, حجم_الشبكة - 2);
        }
        س = س + 1;
    }
}

// ── رسم الطعام ─────────────────────────────────────────────────
دالة رسم_طعام() {
    __dhad.setColor("#ff0000");
    __dhad.circle(طعام_س * حجم_الشبكة + حجم_الشبكة / 2, طعام_ص * حجم_الشبكة + حجم_الشبكة / 2, 8);
    __dhad.setColor("#ff4444");
    __dhad.circle(طعام_س * حجم_الشبكة + حجم_الشبكة / 2, طعام_ص * حجم_الشبكة + حجم_الشبكة / 2, 4);
}

// ── رسم الواجهة ────────────────────────────────────────────────
دالة رسم_واجهة() {
    __dhad.setColor("#ffffff");
    __dhad.text("النقاط: " + نقاط, 100, 10, 16);
    __dhad.text("الطول: " + طول_الثعبان, 400, 10, 16);
}

// ── حركة الثعبان ──────────────────────────────────────────────
دالة حركة() {
    // حفظ الموضع الحالي
    صحيح رأس_س = الثعبان[0];
    صحيح رأس_ص = الثعبان[1];

    // حساب الموضع الجديد
    رأس_س = رأس_س + اتجاه_س;
    رأس_ص = رأس_ص + اتجاه_ص;

    // فحص الاصطدام بالجدران
    إذا (رأس_س < 0 || رأس_س >= عدد_الخلايا_س || رأس_ص < 0 || رأس_ص >= عدد_الخلايا_ص) {
        لعبة_نهاية = 1;
        ارجع;
    }

    // فحص الاصطدام بالذيل
    صحيح س = 0;
    طالما (س < طول_الثعبان - 1) {
        صحيح مؤشر = س * 2;
        إذا (الثعبان[مؤشر] == رأس_س && الثعبان[مؤشر + 1] == رأس_ص) {
            لعبة_نهاية = 1;
            ارجع;
        }
        س = س + 1;
    }

    // فحص أكل الطعام
    إذا (رأس_س == طعام_س && رأس_ص == طعام_ص) {
        نقاط = نقاط + 10;
        طول_الثعبان = طول_الثعبان + 1;
        // وضع طعام جديد
        طعام_س = مؤقت % عدد_الخلايا_س;
        طعام_ص = (مؤقت * 3) % عدد_الخلايا_ص;
    }

    // تحريك الجسم
    س = طول_الثعبان - 1;
    طالما (س > 0) {
        صحيح مؤشر = س * 2;
        صحيح مؤشر_قبل = (س - 1) * 2;
        الثعبان[مؤشر] = الثعبان[مؤشر_قبل];
        الثعبان[مؤشر + 1] = الثعبان[مؤشر + 1];
        س = س - 1;
    }

    // تحريك الرأس
    الثعبان[0] = رأس_س;
    الثعبان[1] = رأس_ص;
}

// ── تغيير الاتجاه ──────────────────────────────────────────────
دالة تغيير_اتجاه(صحيح جديد_س, صحيح جديد_ص) {
    // منع الانعكاس
    إذا (جديد_س == -اتجاه_س && جديد_ص == -اتجاه_ص) {
        ارجع;
    }
    اتجاه_س = جديد_س;
    اتجاه_ص = جديد_ص;
}

// ── الحلقة الرئيسية ────────────────────────────────────────────
تهيئة();

طالما (لعبة_نهاية == 0) {
    __dhad.background("#111111");
    رسم_شبكة();
    رسم_طعام();
    رسم_ثعبان();
    رسم_واجهة();

    // تحديث كل عدة إطارات
    مؤقت = مؤقت + 1;
    إذا (مؤقت % سرعة == 0) {
        حركة();
    }
}

// نهاية اللعبة
__dhad.background("#000000");
__dhad.setColor("#ff0000");
__dhad.text("GAME OVER", 400, 200, 48);
__dhad.setColor("#ffffff");
__dhad.text("النقاط: " + نقاط, 400, 300, 24);
__dhad.text("الطول: " + طول_الثعبان, 400, 350, 20);
