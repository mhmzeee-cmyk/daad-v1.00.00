// البرنامج 5: العمليات الشرطية المتقدمة
// استخدام اختر (switch)

صحيح اختيار = 2 ؛

اختر(اختيار) {
    حالة 1:
        طباعة("اخترت الحرف أ") ؛
    حالة 2:
        طباعة("اخترت الحرف ب") ؛
    حالة 3:
        طباعة("اخترت الحرف ج") ؛
    افتراضي:
        طباعة("اختيار غير صحيح") ؛
}

// التحقق من الأرقام الزوجية والفردية
صحيح رقم = 7 ؛
صحيح ناتج = رقم / 2 ؛
صحيح باقي = رقم - (ناتج * 2) ؛

إذا(باقي == 0) {
    طباعة("الرقم زوجي") ؛
}
وإلا {
    طباعة("الرقم فردي") ؛
}

// حساب القيمة المطلقة
صحيح س = 5 ؛
إذا(س < 0) {
    س = 0 - س ؛
}
طباعة("القيمة المطلقة: ") ؛
طباعة(س) ؛
