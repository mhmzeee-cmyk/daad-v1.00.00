// البرنامج 5: الدوال البسيطة
// تعريف واستدعاء دوال

دالة جمع(صحيح أ, صحيح ب) -> صحيح {
    ارجع أ + ب ؛
}

دالة طرح(صحيح أ, صحيح ب) -> صحيح {
    ارجع أ - ب ؛
}

دالة ضرب(صحيح أ, صحيح ب) -> صحيح {
    ارجع أ * ب ؛
}

دالة قسمة(صحيح أ, صحيح ب) -> صحيح {
    إذا(ب == 0) {
        ارجع 0 ؛
    }
    ارجع أ / ب ؛
}

دالة باقي_القسمة(صحيح أ, صحيح ب) -> صحيح {
    إذا(ب == 0) {
        ارجع 0 ؛
    }
    ارجع أ % ب ؛
}

صحيح س1 = 20 ؛
صحيح س2 = 6 ؛

طباعة("المجموع: ") ؛
طباعة(جمع(س1, س2)) ؛
طباعة("الفرق: ") ؛
طباعة(طرح(س1, س2)) ؛
طباعة("الحاصل: ") ؛
طباعة(ضرب(س1, س2)) ؛
طباعة("الناتج: ") ؛
طباعة(قسمة(س1, س2)) ؛
طباعة("الباقي: ") ؛
طباعة(باقي_القسمة(س1, س2)) ؛
