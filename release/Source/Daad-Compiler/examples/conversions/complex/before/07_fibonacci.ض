// البرنامج 7: سلسلة فيبوناتشي
// حساب فيبوناتشي باستخدام الدوال

دالة فيبوناتشي(صحيح ن) -> صحيح {
    إذا(ن <= 0) {
        ارجع 0 ؛
    }
    إذا(ن == 1) {
        ارجع 1 ؛
    }
    صحيح أ = 0 ؛
    صحيح ب = 1 ؛
    صحيح مؤقت = 0 ؛
    لكل(صحيح i = 2; i <= ن; i = i + 1) {
        مؤقت = أ + ب ؛
        أ = ب ؛
        ب = مؤقت ؛
    }
    ارجع ب ؛
}

طباعة("أول 15 عدد فيبوناتشي:") ؛
لكل(صحيح i = 0; i < 15; i = i + 1) {
    طباعة(فيبوناتشي(i)) ؛
}

صحيح مجموع = 0 ؛
لكل(صحيح i = 0; i < 10; i = i + 1) {
    مجموع += فيبوناتشي(i) ؛
}
طباعة("مجموع أول 10 أعداد فيبوناتشي:") ؛
طباعة(مجموع) ؛
