// البرنامج 8: الفرز والبحث
// خوارزميات الفرز والبحث

// فرز الفقاعات Bubble Sort
دالة فرز_فقاعات(صحيح مصفوفة[], صحيح حجم) {
    لكل(صحيح i = 0; i < حجم - 1; i += 1) {
        لكل(صحيح j = 0; j < حجم - i - 1; j += 1) {
            إذا(مصفوفة[j] > مصفوفة[j + 1]) {
                صحيح مؤقت = مصفوفة[j] ؛
                مصفوفة[j] = مصفوفة[j + 1] ؛
                مصفوفة[j + 1] = مؤقت ؛
            }
        }
    }
}

// البحث الخطي
دالة بحث_خطي(صحيح مصفوفة[], صحيح حجم, صحيح قيمة) -> صحيح {
    لكل(صحيح i = 0; i < حجم; i += 1) {
        إذا(مصفوفة[i] == قيمة) {
            ارجع i ؛
        }
    }
    ارجع -1 ؛
}

// البحث الثنائي (يتطلب مصفوفة مرتبة)
دالة بحث_ثنائي(صحيح مصفوفة[], صحيح حجم, صحيح قيمة) -> صحيح {
    صحيح بداية = 0 ؛
    صحيح نهاية = حجم - 1 ؛
   طالما(بداية <= نهاية) {
        صحيح منتصف = (بداية + نهاية) / 2 ؛
        إذا(مصفوفة[منتصف] == قيمة) {
            ارجع منتصف ؛
        }
        إذا(مصفوفة[منتصف] < قيمة) {
            بداية = منتصف + 1 ؛
        }
        وإلا {
            نهاية = منتصف - 1 ؛
        }
    }
    ارجع -1 ؛
}

// اختبار الدوال
صحيح بيانات[] = {64, 34, 25, 12, 22, 11, 90} ؛
صحيح حجم = 7 ؛

طباعة("البيانات قبل الفرز:") ؛
لكل(صحيح i = 0; i < حجم; i += 1) {
    طباعة(بيانات[i]) ؛
}

فرز_فقاعات(بيانات, حجم) ؛

طباعة("البيانات بعد الفرز:") ؛
لكل(صحيح i = 0; i < حجم; i += 1) {
    طباعة(بيانات[i]) ؛
}

صحيح نتيجة = بحث_ثنائي(بيانات, حجم, 22) ؛
طباعة("الموقع: ") ؛
طباعة(نتيجة) ؛
