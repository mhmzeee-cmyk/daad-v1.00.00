// الساعة المنزلية
دالة ساعة_منزلية() -> صحيح {
    صحيح ساعة=0;
    ساعة=ساعة_منزلية();
    ارجع ساعة;
}

// الدقائق
دالة دقائق_مضت(ساعة صحيح) -> صحيح {
    صحيح دقائق=0;
    دقائق=دقائق_مضت(ساعة);
    ارجع دقائق;
}

// الساعات
دالة ساعات_مضت(ساعة صحيح) -> صحيح {
    صحيح ساعات=0;
    ساعات=ساعات_مضت(ساعة);
    ارجع ساعات;
}

// تهيئة
دالة تهيئة_ساعة(ساعة صحيح,ساعة_جديدة صحيح,دقائق صحيح) -> صحيح {
    تهيئة_ساعة(ساعة,ساعة_جديدة,دقائق);
    ارجع صحيحاً;
}

// بدء
دالة بدء_الساعة(ساعة صحيح) -> صحيح {
    بدء_ساعة(ساعة);
    ارجع صحيحاً;
}

// إيقاف
دالة إيقاف_الساعة(ساعة صحيح) {
    إيقاف_ساعة(ساعة);
}

// إعادة
دالة إعادة_ضبط(ساعة صحيح) {
    إعادة_ضبط(ساعة);
}

// النبض
دالة نبض(ساعة صحيح) -> صحيح {
    صحيح نبضة=0;
    نبضة=نبض(ساعة);
    ارجع نبضة;
}

// إحصائيات
دالة إحصائيات_الساعة(ساعة صحيح) -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_ساعة(ساعة);
    ارجع إحصائيات;
}

// تثبيت
دالة تثبيت_الساعة(ساعة صحيح) {
    تثبيت_ساعة(ساعة);
}


