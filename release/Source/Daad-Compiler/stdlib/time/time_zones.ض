// Category: time
// الوصف: المناطق الزمنية

// المنطقة الحالية
دالة المنطقة_الزمانية() -> نص {
    نص منطقة="";
    منطقة=احصل_منطقة();
    ارجع منطقة;
}

// تحويل
دالة تحويل_المنطقة(وقت صحيح,من نص,إلى نص) -> صحيح {
    صحيح محول=تحويل_منطقة(وقت,من,إلى);
    ارجع محول;
}

// UTC الآن
دالة UTC_الآن() -> صحيح {
    صحيح utc=0;
    utc=احصل_utc();
    ارجع utc;
}

// الفرق بالثاني
دالة فرق_المنطقة(منطقة نص) -> صحيح {
    صحيح فرق=0;
    فرق=فرق_منطقة(منطقة);
    ارجع فرق;
}

// المناطق
دالة المناطق_المتوفرة() -> صحيح[] {
    صحيح[] مناطق=[];
    مناطق=مناطق_متوفرة();
    ارجع مناطق;
}

// هل صحيحة؟
دالة منطقة_صحيحة(نص s) -> صحيح {
    صحيح صحيح=0;
    إذا(تحقق_منطقة(s)==1){ صحيح=1; }
    ارجع صحيح;
}

// هل صيفي؟
دالة توقيت_الصيفي(منطقة نص) -> صحيح {
    صحيح صيفي=0;
    إذا(هل_صيفي(منطقة)==1){ صيفي=1; }
    ارجع صيفي;
}

// تعيين
دالة إعادة_ضبط_المنطقة(منطقة نص) {
    عيّن_منطقة(منطقة);
}

// تحويل UTC
دالة UTC_لـالطابع(الطابع_الزمني صحيح) -> صحيح {
    صحيح utc=0;
    utc=timestamp_إلى_UTC(الطابع_الزمني);
    ارجع utc;
}

// أوقات عالمية
دالة الوقت_العالمي() -> صحيح[] {
    صحيح[] أوقات=[];
    أوقات=أوقات_عالمية();
    ارجع أوقات;
}


