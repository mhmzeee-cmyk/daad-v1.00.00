// إنشاء
دالة إنشاء_مصفوفة() -> صحيح {
    صحيح مصفوفة=0;
    مصفوفة=إنشاء_ديناميكي();
    ارجع مصفوفة;
}
// إضافة
دالة أضف_لمصفوفة(مصفوفة صحيح,قيمة صحيح) -> صحيح {
    أضف_ديناميكي(مصفوفة,قيمة);
    ارجع صحيحاً;
}
// جلب
دالة احصل_من_مصفوفة(مصفوفة صحيح,فهرس صحيح) -> صحيح {
    صحيح قيمة=0;
    قيمة=جلب_ديناميكي(مصفوفة,فهرس);
    ارجع قيمة;
}
// تعيين
دالة عّين_في_مصفوفة(مصفوفة صحيح,فهرس صحيح,قيمة صحيح) -> صحيح {
    عيّن_ديناميكي(مصفوفة,فهرس,قيمة);
    ارجع صحيحاً;
}
// حذف
دالة احذف_من_مصفوفة(مصفوفة صحيح,فهرس صحيح) -> صحيح {
    حذف_ديناميكي(مصفوفة,فهرس);
    ارجع صحيحاً;
}
// حجم
دالة حجم_المصفوفة(مصفوفة صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=حجم_ديناميكي(مصفوفة);
    ارجع عدد;
}
// قلب
دالة قلب_المصفوفة(مصفوفة صحيح) -> صحيح {
    قلب_ديناميكي(مصفوفة);
    ارجع صحيحاً;
}
// تفريغ
دالة فرّغ_المصفوفة(مصفوفة صحيح) {
    فرّغ_ديناميكي(مصفوفة);
}
// نسخ
دالة انسخ_مصفوفة(مصفوفة صحيح) -> صحيح {
    صحيح نسخة=0;
    نسخة=نسخ_ديناميكي(مصفوفة);
    ارجع نسخة;
}
// دمج
دالة ادمج_مصفوفتين(a صحيح,b صحيح) -> صحيح {
    دمج_ديناميكي(a,b);
    ارجع صحيحاً;
}


