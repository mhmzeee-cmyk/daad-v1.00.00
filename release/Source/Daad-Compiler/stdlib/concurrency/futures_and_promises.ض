// ض مكتبة: المستقبلات_والموعودات
// Category: concurrency
// الوصف: المستقبلات

// إنشاء
دالة إنشاء_مستقبل() -> صحيح {
    صحيح مستقبل=0;
    مستقبل=إنشاء_مستقبل();
    ارجع مستقبل;
}

// جاهز؟
دالة جاهز_المستقبل(مستقبل صحيح) -> صحيح {
    صحيح جاهز=0;
    إذا(هل_جاهز(مستقبل)==1){ جاهز=1; }
    ارجع جاهز;
}

// القيمة
دالة قيمة_المستقبل(مستقبل صحيح) -> صحيح {
    صحيح قيمة=0;
    قيمة=قيمة_مستقبل(مستقبل);
    ارجع قيمة;
}

// انتظار
دالة انتظر_المستقبل(مستقبل صحيح) {
    انتظر_مستقبل(مستقبل);
}

// إنشاء
دالة إنشاء_موعود() -> صحيح {
    صحيح موعود=0;
    موعود=إنشاء_موعود();
    ارجع موعود;
}

// اكتمال
دالة أكمل_موعود(موعود صحيح,صحيح قيمة) {
    أكمل_موعود(موعود,قيمة);
}

// فشل
دالة فشل_موعود(موعود صحيح,خطأ صحيح) {
    فشل_موعود(موعود,خطأ);
}

// then
دالة _then(موعود صحيح,دالة نص) -> صحيح {
    صحيح نتائج=0;
    نتائج= then(موعود,دالة);
    ارجع نتائج;
}

// catch
دالة  catches(موعود صحيح,دالة نص) -> صحيح {
    صحيح نتيجة=0;
    نتيجة= catches(موعود,دالة);
    ارجع نتيجة;
}

// الحالة
دالة حال_الموعود(موعود صحيح) -> صحيح {
    صحيح حالة=0;
    حالة=حال_موعود(موعود);
    ارجع حالة;
}


