// استعلام معقد
دالة استعلام_معقد(قاعدة صحيح,استعلام نص) -> صحيح {
    صحيح نتيجة=0;
    نتيجة=استعلام_معقد(قاعدة,استعلام);
    ارجع نتيجة;
}

// دمج
دالة JOIN(قاعدة صحيح,جدول1 نص,جدول2 نص,شرط نص) -> صحيح[] {
    صحيح[] نتائج=[];
    نتائج=join_sql(قاعدة,جدول1,جدول2,شرط);
    ارجع نتائج;
}

// تجميع
دالة GROUP BY(قاعدة صحيح,جدول نص,عمود نص) -> صحيح[] {
    صحيح[] نتائج=[];
    نتائج=GROUP_BY(قاعدة,جدول,عمود);
    ارجع نتائج;
}

// فرز
دالة ORDER BY(قاعدة صحيح,جدول نص,عمود نص,اتجاه نص) -> صحيح[] {
    صحيح[] نتائج=[];
    نتائج=ORDER_BY(قاعدة,جدول,عمود,اتجاه);
    ارجع نتائج;
}

// تصفية
دالة HAVING(قاعدة صحيح,استعلام نص,شرط نص) -> صحيح[] {
    صحيح[] نتائج=[];
    نتائج=HAVING(قاعدة,استعلام,شرط);
    ارجع نتائج;
}

// المجموع
دالة SUM(قاعدة صحيح,جدول نص,عمود نص) -> صحيح {
    صحيح مجموع=0;
    مجموع=sum_sql(قاعدة,جدول,عمود);
    ارجع مجموع;
}

// المتوسط
دالة AVG(قاعدة صحيح,جدول نص,عمود نص) -> عشري {
    عشري متوسط=0.0;
    متوسط=avg_sql(قاعدة,جدول,عمود);
    ارجع متوسط;
}

// الأقصى
دالة MAX(قاعدة صحيح,جدول نص,عمود نص) -> صحيح {
    صحيح أقصى=0;
    أقصى=max_sql(قاعدة,جدول,عمود);
    ارجع أقصى;
}

// الأدنى
دالة MIN(قاعدة صحيح,جدول نص,عمود نص) -> صحيح {
    صحيح أدنى=0;
    أدنى=min_sql(قاعدة,جدول,عمود);
    ارجع أدنى;
}

// العد
دالة COUNT(قاعدة صحيح,جدول نص,عمود نص) -> صحيح {
    صحيح عدد=0;
    عدد=count_sql(قاعدة,جدول,عمود);
    ارجع عدد;
}


