// إنشاء
دالة إنشاء_سجل(قاعدة صحيح,جدول نص,بيانات نص) -> صحيح {
    صحيح id=0;
    id=إنشاء_سجل(قاعدة,جدول,بيانات);
    ارجع id;
}

// قراءة
دالة قراءة_سجل(قاعدة صحيح,جدول نص,id صحيح) -> نص {
نص سجل="";
    سجل=قراءة_سجل(قاعدة,جدول,id);
    ارجع سجل;
}

// تحديث
دالة تحديث_سجل(قاعدة صحيح,جدول نص,id صحيح,بيانات نص) -> صحيح {
    تحديث_سجل(قاعدة,جدول,id,بيانات);
    ارجع صحيحاً;
}

// حذف
دالة حذف_سجل(قاعدة صحيح,جدول نص,id صحيح) -> صحيح {
    حذف_سجل(قاعدة,جدول,id);
    ارجع صحيحاً;
}

// بحث
دالة بحث_سجلات(قاعدة صحيح,جدول نص,شرط نص) -> صحيح[] {
    صحيح[] سجلات=[];
    سجلات=بحث_سجلات(قاعدة,جدول,شرط);
    ارجع سجلات;
}

// العدد
دالة عدّ_السجلات(قاعدة صحيح,جدول نص) -> صحيح {
    صحيح عدد=0;
    عدد=عدّ_سجلات(قاعدة,جدول);
    ارجع عدد;
}

// الأول
دالة أول_سجل(قاعدة صحيح,جدول نص) -> صحيح {
    صحيح سجل=0;
    سجل=أول_سجل(قاعدة,جدول);
    ارجع سجل;
}

// الأخير
دالة آخر_سجل(قاعدة صحيح,جدول نص) -> صحيح {
    صحيح سجل=0;
    سجل=آخر_سجل(قاعدة,جدول);
    ارجع سجل;
}

// عشوائي
دالة صف_عشوائي(قاعدة صحيح,جدول نص) -> صحيح {
    صحيح سجل=0;
    سجل=صف_عشوائي(قاعدة,جدول);
    ارجع سجل;
}

// تصدير
دالة تصدير_الجدول(قاعدة صحيح,جدول نص,مسار نص) -> صحيح {
