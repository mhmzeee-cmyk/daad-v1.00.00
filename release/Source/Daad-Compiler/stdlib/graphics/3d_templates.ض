// إنشاء مشهد
دالة إنشاء_مشهد() -> صحيح {
    صحيح مشهد=0;
    مشهد=إنشاء_مشهد();
    ارجع مشهد;
}

// إضافة كائن
دالة إضافة_كائن(مشهد صحيح,مسار نص) -> صحيح {
    صحيح كائن=0;
    كائن=إضافة_كائن(مشهد,مسار);
    ارجع كائن;
}

// تحريك
دالة تحريك_الكائن(كائن صحيح,x صحيح,y صحيح,z صحيح) -> صحيح {
    تحريك_كائن(كائن,x,y,z);
    ارجع صحيحاً;
}

// تدوير
دالة تدوير_الكائن(كائن صحيح,x صحيح,y صحيح,z صحيح) -> صحيح {
    تدوير_كائن(كائن,x,y,z);
    ارجع صحيحاً;
}

// تكبير
دالة تكبير_الكائن(كائن صحيح,x صحيح,y صحيح,z صحيح) -> صحيح {
    تكبير_كائن(كائن,x,y,z);
    ارجع صحيحاً;
}

// إضاءة
دالة إضافة_إضاءة(مشهد صحيح,نوع نص,x صحيح,y صحيح,z صحيح) -> صحيح {
    إضافة_إضاءة(مشهد,نوع,x,y,z);
    ارجع صحيحاً;
}

// الكاميرا
دالة تعيين_الكاميرا(مشهد صحيح,x صحيح,y صحيح,z صحيح) -> صحيح {
    تعيين_كاميرا(مشهد,x,y,z);
    ارجع صحيحاً;
}

// العرض
دالة عرض_المشهد(مشهد صحيح,مسار نص) -> صحيح {
    عرض_مشهد(مشهد,مسار);
    ارجع صحيحاً;
}

// تحريك الكاميرا
دالة تحريك_الكاميرا(مشهد صحيح,x صحيح,y صحيح,z صحيح) -> صحيح {
    تحريك_كاميرا(مشهد,x,y,z);
    ارجع صحيحاً;
}

// إحصائيات
دالة إحصائيات_المشهد(مشهد صحيح) -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_مشهد(مشهد);
    ارجع إحصائيات;
}


