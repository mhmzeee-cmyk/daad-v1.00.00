// نافذة
دالة إنشاء_نافذة(صحيح عرض,صحيح ارتفاع,نص عنوان) -> صحيح {
    صحيح نافذة=0;
    نافذة=إنشاء_نافذة(عرض,ارتفاع,عنوان);
    ارجع نافذة;
}

// زر
دالة إضافة_زر(نافذة صحيح,نص نص,x صحيح,y صحيح,عرض صحيح,ارتفاع صحيح) -> صحيح {
    صحيح زر=0;
    زر=إضافة_زر(نافذة,نص,x,y,عرض,ارتفاع);
    ارجع زر;
}

// نص
دالة إضافة_نص(نافذة صحيح,نص نص,x صحيح,y صحيح) -> صحيح {
    إضافة_نص(نافذة,نص,x,y);
    ارجع صحيحاً;
}

// إدخال
دالة إضافة_إدخال(نافذة صحيح,x صحيح,y صحيح,عرض صحيح) -> صحيح {
    صحيح إدخال=0;
    إدخال=إضافة_إدخال(نافذة,x,y,عرض);
    ارجع إدخال;
}

// قائمة منسدلة
دالة إضافة_قائمة(نافذة صحيح,نص[] خيارات,x صحيح,y صحيح) -> صحيح {
    صحيح قائمة=0;
    قائمة=إضافة_قائمة(نافذة,خيارات,x,y);
    ارجع قائمة;
}

// حدث الزر
دالة حدث_زر(زر صحيح,دالة نص) -> صحيح {
    حدث_زر(زر,دالة);
    ارجع صحيحاً;
}

// نص الإدخال
دالة نص_إدخال(إدخال صحيح) -> نص {
نص نص="";
    نص=نص_إدخال(إدخال);
    ارجع نص;
}

// عرض
دالة عرض_النافذة(نافذة صحيح) {
    عرض_نافذة(نافذة);
}

// إغلاق
دالة إغلاق_النافذة(نافذة صحيح) {
    إغلاق_نافذة(نافذة);
}

// تحديث
دالة تحديث_النافذة(نافذة صحيح) {
    تحديث_نافذة(نافذة);
}


