دالة طول_نص(نص s) -> صحيح {
    صحيح عدد = طول(s);
    ارجع عدد;
}

دالة بحث_موضع(نص s, نص نمط) -> صحيح {
    صحيح موقع = ابحث(s, نمط);
    ارجع موقع;
}

دالة هل_يحتوي(نص s, نص نمط) -> صحيح {
    صحيح ع = يحتوي(s, نمط);
    ارجع ع;
}

دالة استبدال_نمط(نص s, نص قديم, نص جديد) -> نص {
    نص نتيجة = استبدل(s, قديم, جديد);
    ارجع نتيجة;
}

دالة فتح_ملف(نص مسار, نص وضع) -> صحيح {
    صحيح م = افتح(مسار, وضع);
    ارجع م;
}

دالة سجل_سطر(صحيح م, نص سطر) -> صحيح {
    صحيح ع = سجّل(م, سطر);
    ارجع ع;
}

دالة افتح_لقراءة(نص مسار) -> صحيح {
    صحيح م = افتح(مسار, "r");
    ارجع م;
}

دالة افتح_للكتابة(نص مسار) -> صحيح {
    صحيح م = افتح(مسار, "w");
    ارجع م;
}

دالة هل_يحتوي2(نص s, نص نمط) -> صحيح {
    صحيح ع = يحتوي(s, نمط);
    ارجع ع;
}

دالة طول2(نص s) -> صحيح {
    صحيح عدد = طول(s);
    ارجع عدد;
}
