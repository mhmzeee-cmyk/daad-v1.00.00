// الوصف: القوالب

// إنشاء قالب
دالة إنشاء_قالب(id نص) -> صحيح {
    صحيح قالب=0;
    قالب=إنشاء_قالب(id);
    ارجع قالب;
}

// صياغة
دالة صيغ_القالب(قالب صحيح,بيانات نص) -> صحيح {
    صحيح مصاغ=0;
    مصاغ=صياغة(قالب,بيانات);
    ارجع مصاغ;
}

// إدراج
دالة إدراج_قالب(أب صحيح,قالب صحيح,بيانات نص) -> صحيح {
    إدراج_قالب(أب,قالب,بيانات);
    ارجع صحيحاً;
}

// إنشاء قائمة
دالة إنشاء_قائمة(عنصر صحيح,بيانات نص[]) -> صحيح {
    إنشاء_list(عنصر,بيانات);
    ارجع صحيحاً;
}

// إنشاء جدول
دالة إنشاء_جدول(عنصر صحيح,بيانات نص[][]) -> صحيح {
    إنشاء_table(عنصر,بيانات);
    ارجع صحيحاً;
}

// تحديث
دالة تحديث_قالب(قالب صحيح,بيانات نص) -> صحيح {
    تحديث_قالب(قالب,بيانات);
    ارجع صحيحاً;
}

// إضافة
دالة إضافة_عنصر(أب صحيح,نوع نص,بيانات نص) -> صحيح {
    إضافة_عنصر(أب,نوع,بيانات);
    ارجع صحيحاً;
}

// حذف
دالة حذف_قالب(قالب صحيح) {
    حذف_قالب(قالب);
}

// نسخ
دالة نسخ_قالب(قالب صحيح) -> صحيح {
    صحيح نسخة=0;
    نسخة=نسخ_قالب(قالب);
    ارجع نسخة;
}

// عرض
دالة عرض_القالب(قالب صحيح) -> صحيح {
    عرض_قالب(قالب);
    ارجع صحيحاً;
}


