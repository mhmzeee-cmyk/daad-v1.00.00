// الوصف: النماذج

// قيمة الإدخال
دالة قيمة_النموذج(id نص) -> نص {
نص قيمة="";
    قيمة=قيمة_input(id);
    ارجع قيمة;
}

// تعيين القيمة
دالة عيّن_قيمة(id نص,قيمة نص) {
    عيّن_input(id,قيمة);
}

// التحقق
دالة تحقق_من_النموذج(id نص) -> صحيح {
    صحيح صحيح=0;
    إذا(تحقق_input(id)==1){ صحيح=1; }
    ارجع صحيح;
}

// إرسال
دالة إرسال_النموذج(id نص) -> صحيح {
    إرسال_form(id);
    ارجع صحيحاً;
}

// إعادة تعيين
دالة إعادة_تعيين(id نص) {
    إعادة_تعيين_form(id);
}

// إضافة حدث
دالة إضافة_مُرسل(id نص,دالة نص) -> صحيح {
    إضافة_حدث(id,"submit",دالة);
    ارجع صحيحاً;
}

// إضافة نمط
دالة إضافة_تحقق(id نص,نمط نص) -> صحيح {
    إضافة_نمط(id,نمط);
    ارجع صحيحاً;
}

// رسالة خطأ
دالة  رسالة_خطأ(id نص,رسالة نص) {
    رسالة_خطأ(id,رسالة);
}

// إخفاء
دالة إخفاء_الخطأ(id نص) {
    إخفاء_خطأ(id);
}

// الحالة
دالة حالة_النموذج(id نص) -> صحيح {
    صحيح حالة=0;
    حالة=حالة_form(id);
    ارجع حالة;
}


