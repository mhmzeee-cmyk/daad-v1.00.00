// Category: web
// الوصف: الأحداث

// إضافة
دالة إضافة_حدث(عنصر صحيح,نوع نص,دالة نص) -> صحيح {
    addEventListener(عنصر,نوع,دالة);
    ارجع صحيحاً;
}

// حذف
دالة حذف_حدث(عنصر صحيح,نوع نص,دالة نص) -> صحيح {
    removeEventListener(عنصر,نوع,دالة);
    ارجع صحيحاً;
}

// إطلاق
دالة إطلاق_حدث(عنصر صحيح,حدث صحيح) -> صحيح {
    dispatchEvent(عنصر,حدث);
    ارجع صحيحاً;
}

// إنشاء
دالة إنشاء_حدث(نوع نص) -> صحيح {
    صحيح حدث=0;
    حدث=createEvent(نوع);
    ارجع حدث;
}

// اللوحة
دالة حدث_لوحة(دالة نص) -> صحيح {
    addEventListener("keydown",دالة);
    ارجع صحيحاً;
}

// النقر
دالة حدث_نقر(عنصر صحيح,دالة نص) -> صحيح {
    addEventListener(عنصر,"click",دالة);
    ارجع صحيحاً;
}

// التمرير
دالة حدث_تمرير(دالة نص) -> صحيح {
    addEventListener("scroll",دالة);
    ارجع صحيحاً;
}

// التحميل
دالة حدث_تحميل(دالة نص) -> صحيح {
    addEventListener("load",دالة);
    ارجع صحيحاً;
}

// إيقاف
دالة إيقاف_انتشار(حدث صحيح) {
    stopPropagation(حدث);
}

// إلغاء
دالة إلغاء_افتراضي(حدث صحيح) {
    preventDefault(حدث);
}


