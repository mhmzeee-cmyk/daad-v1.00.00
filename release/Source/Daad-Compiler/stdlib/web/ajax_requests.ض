// ض مكتبة: AJAX_والطلبات
// Category: web
// الوصف: AJAX

// إنشاء طلب
دالة XMLHttpRequest() -> صحيح {
    صحيح طلب=0;
    طلب=XMLHttpRequest();
    ارجع طلب;
}

// فتح
دالة open_request(طلب صحيح,طريقة نص,url نص) {
    open(طلب,طريقة,url);
}

// إرسال
دالة send_request(طلب صحيح,بيانات نص) -> صحيح {
    send(طلب,بيانات);
    ارجع صحيحاً;
}

// حدث
دالة onreadystatechange(طلب صحيح,دالة نص) {
    onreadystatechange(طلب,دالة);
}

// الحالة
دالة status_request(طلب صحيح) -> صحيح {
    صحيح حالة=0;
    حالة=status(طلب);
    ارجع حالة;
}

// الجواب
دالة response_request(طلب صحيح) -> نص {
نص جواب="";
    جواب=response(طلب);
    ارجع جواب;
}

// fetch
دالة fetch(url نص) -> صحيح {
    صحيح وعد=0;
    وعد=fetch(url);
    ارجع وعد;
}

// POST
دالة post_data(url نص,بيانات نص) -> صحيح {
    صحيح وعد=0;
    وعد=fetch_post(url,بيانات);
    ارجع وعد;
}

// JSON POST
دالة أرسل_JSON(url نص,بيانات نص) -> صحيح {
    صحيح وعد=0;
    وعد=fetch_json(url,بيانات);
    ارجع وعد;
}

// إلغاء
دالة إلغاء_الطلب(طلب صحيح) {
    إلغاء_طلب(طلب);
}


