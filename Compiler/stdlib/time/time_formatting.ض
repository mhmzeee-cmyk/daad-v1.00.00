// تنسيق
دالة نسّق_الوقت(وقت صحيح,قالب نص) -> صحيح {
    صحيح منسق=تنسيق_وقت(وقت,قالب);
    ارجع منسق;
}

// تحليل
دالة تحليل_التاريخ(نص s) -> صحيح {
    صحيح تحليل=تحليل_تاريخ(s);
    ارجع تحليل;
}

// تنسيق تاريخ
دالة نسّق_التاريخ(سنة صحيح,شهر صحيح,يوم صحيح) -> صحيح {
    صحيح منسق=تنسيق_تاريخ(سنة,شهر,يوم);
    ارجع منسق;
}

// تنسيق
دالة نسّق_الوقت_والثانية(ساعة صحيح,دقيقة صحيح,ثانية صحيح) -> صحيح {
    صحيح منسق=تنسيق_ساعة(ساعة,دقيقة,ثانية);
    ارجع منسق;
}

// تنسيق مدة
دالة نسّق_المدة(ثانية صحيح) -> صحيح {
    صحيح منسق=تنسيق_مدة(ثانية);
    ارجع منسق;
}

// اسم اليوم
دالة اسم_اليوم(يوم صحيح) -> صحيح {
    صحيح اسم=اسم_يوم(يوم);
    ارجع اسم;
}

// اسم الشهر
دالة اسم_الشهر(شهر صحيح) -> صحيح {
    صحيح اسم=اسم_شهر(شهر);
    ارجع اسم;
}

// أيام الشهر
دالة عدد_أيام_الشهر(شهر صحيح,سنة صحيح) -> صحيح {
    صحيح عدد=عدّ_أيام(شهر,سنة);
    ارجع عدد;
}

// أيام الأسبوع
دالة أيام_الأسبوع() -> صحيح[] {
    صحيح[] أيام=[];
    أيام=أيام_أسبوع();
    ارجع أيام;
}

// تنسيق ISO
دالة تنسيق_ISO(وقت صحيح) -> صحيح {
    صحيح منسق=تنسيق_ISO(وقت);
    ارجع منسق;
}


