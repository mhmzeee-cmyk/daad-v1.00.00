// التقويم الهجري
دالة التقويم_الهجري() -> صحيح {
    صحيح هجري=0;
    هجري=تقويم_هجري();
    ارجع هجري;
}

// التقويم الميلادي
دالة التقويم_الميلادي() -> صحيح {
    صحيح ميلادي=0;
    ميلادي=تقويم_ميلادي();
    ارجع ميلادي;
}

// التقويم الشمسي
دالة التقويم_الشمس() -> صحيح {
    صحيح شمسي=0;
    شمسي=تقويم_شمسي();
    ارجع شمسي;
}

// تحويل
دالة تحويل_التقويم(من نص,إلى نص,قيمة صحيح) -> صحيح {
    صحيح محول=تحويل_تقويم(من,إلى,قيمة);
    ارجع محول;
}

// أيام بين
دالة أيام_بين(ت1 صحيح,ت2 صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=أيام_بين(ت1,ت2);
    ارجع عدد;
}

// أشهر بين
دالة شهر_بين(ت1 صحيح,ت2 صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=شهر_بين(ت1,ت2);
    ارجع عدد;
}

// سنوات بين
دالة سنة_بين(ت1 صحيح,ت2 صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=سنة_بين(ت1,ت2);
    ارجع عدد;
}

// هل صحيح؟
دالة تاريخ_صحيح(نص s) -> صحيح {
    صحيح صحيح=0;
    إذا(تحقق_تاريخ(s)==1){ صحيح=1; }
    ارجع صحيح;
}

// أيام الأسبوع
دالة تاريخ_الأسبوع(تاريخ صحيح) -> صحيح {
    صحيح يوم=0;
    يوم=أسبوع_تاريخ(تاريخ);
    ارجع يوم;
}

// في النطاق؟
دالة في_نطاق(تاريخ صحيح,من صحيح,إلى صحيح) -> صحيح {
    صحيح نعم=0;
    إذا(تاريخ>=من و تاريخ<=إلى){ نعم=1; }
    ارجع نعم;
}


