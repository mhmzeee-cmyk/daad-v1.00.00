// إنشاء
دالة إنشاء_مكون(اسم نص,دالة نص) -> صحيح {
    صحيح مكون=0;
    مكون=إنشاء_مكون(اسم,دالة);
    ارجع مكون;
}

// تجميع
دالة تجميع_المكون(مكون صحيح,بيانات نص) -> صحيح {
    صحيح مصاغ=0;
    مصاغ=تجميع(مكون,بيانات);
    ارجع مصاغ;
}

// إدراج
دالة إدراج_مكون(أب صحيح,مكون صحيح,بيانات نص) -> صحيح {
    إدراج_مكون(أب,مكون,بيانات);
    ارجع صحيحاً;
}

// تحديث
دالة تحديث_المكون(مكون صحيح,بيانات نص) -> صحيح {
    تحديث_مكون(مكون,بيانات);
    ارجع صحيحاً;
}

// حذف
دالة حذف_المكون(مكون صحيح) {
    حذف_مكون(مكون);
}

// المكونات
دالة قائمة_المكونات() -> صحيح[] {
    صحيح[] مكونات=[];
    مكونات=مكونات_مسجلة();
    ارجع مكونات;
}

// إضافة خاصية
دالة إضافة_ خاصية(مكون صحيح,اسم نص,نوع نص) -> صحيح {
    إضافة_ خاصية(مكون,اسم,نوع);
    ارجع صحيحاً;
}

// حدث
دالة حدث_المكون(مكون صحيح,نوع نص,دالة نص) -> صحيح {
    حدث_مكون(مكون,نوع,دالة);
    ارجع صحيحاً;
}

// نسخ
دالة نسخ_المكون(مكون صحيح) -> صحيح {
    صحيح نسخة=0;
    نسخة=نسخ_مكون(مكون);
    ارجع نسخة;
}

// الحالة
دالة حالة_المكون(مكون صحيح) -> صحيح {
    صحيح حالة=0;
    حالة=حالة_مكون(مكون);
    ارجع حالة;
}


