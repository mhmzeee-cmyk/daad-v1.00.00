// بدء
دالة بدء_معاملة(قاعدة صحيح) -> صحيح {
    بدء_معاملة(قاعدة);
    ارجع صحيحاً;
}

// التزام
دالة التزام_معاملة(قاعدة صحيح) -> صحيح {
    التزام_معاملة(قاعدة);
    ارجع صحيحاً;
}

// إلغاء
دالة إلغاء_معاملة(قاعدة صحيح) -> صحيح {
    إلغاء_معاملة(قاعدة);
    ارجع صحيحاً;
}

// نقطة حفظ
دالة Savepoint(قاعدة صحيح,اسم نص) -> صحيح {
    Savepoint(قاعدة,اسم);
    ارجع صحيحاً;
}

// عودة
دالة العودة_لـ Savepoint(قاعدة صحيح,اسم نص) -> صحيح {
    العودة_لـsavepoint(قاعدة,اسم);
    ارجع صحيحاً;
}

// الحالة
دالة حالة_المعاملة(قاعدة صحيح) -> صحيح {
    صحيح حالة=0;
    حالة=حالة_معاملة(قاعدة);
    ارجع حالة;
}

// العزل
دالة مستوى_العزل(قاعدة صحيح,مستوى نص) -> صحيح {
    مستوى_عزل(قاعدة,مستوى);
    ارجع صحيحاً;
}

// قفل
دالة قفل_الجدول(قاعدة صحيح,جدول نص) -> صحيح {
    قفل_جدول(قاعدة,جدول);
    ارجع صحيحاً;
}

// فتح قفل
دالة فتح_قفل_الجدول(قاعدة صحيح,جدول نص) {
    فتح_قفل_جدول(قاعدة,جدول);
}

// إحصائيات
دالة إحصائيات_المعاملات(قاعدة صحيح) -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_معاملات(قاعدة);
    ارجع إحصائيات;
}


