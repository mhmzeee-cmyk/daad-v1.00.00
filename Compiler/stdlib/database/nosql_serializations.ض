// إنشاء مجموعة
دالة إنشاء_مجموعة(قاعدة صحيح,اسم نص) -> صحيح {
    إنشاء_nosql(قاعدة,اسم);
    ارجع صحيحاً;
}

// إدراج
دالة إدراج_مستند(قاعدة صحيح,مجموعة نص,بيانات نص) -> صحيح {
    صحيح id=0;
    id=إدراج_مستند(قاعدة,مجموعة,بيانات);
    ارجع id;
}

// قراءة
دالة قراءة_مستند(قاعدة صحيح,مجموعة نص,id صحيح) -> نص {
نص مستند="";
    مستند=قراءة_مستند(قاعدة,مجموعة,id);
    ارجع مستند;
}

// تحديث
دالة تحديث_مستند(قاعدة صحيح,مجموعة نص,id صحيح,بيانات نص) -> صحيح {
    تحديث_مستند(قاعدة,مجموعة,id,بيانات);
    ارجع صحيحاً;
}

// حذف
دالة حذف_مستند(قاعدة صحيح,مجموعة نص,id صحيح) -> صحيح {
    حذف_مستند(قاعدة,مجموعة,id);
    ارجع صحيحاً;
}

// بحث
دالة بحث_مستندات(قاعدة صحيح,مجموعة نص,شرط نص) -> صحيح[] {
    صحيح[] مستندات=[];
    مستندات=بحث_مستندات(قاعدة,مجموعة,شرط);
    ارجع مستندات;
}

// العدد
دالة عدّ_المستندات(قاعدة صحيح,مجموعة نص) -> صحيح {
    صحيح عدد=0;
    عدد=عدّ_مستندات(قاعدة,مجموعة);
    ارجع عدد;
}

// فرز
دالة فرز_المستندات(قاعدة صحيح,مجموعة نص,عمود نص,اتجاه نص) -> صحيح[] {
    صحيح[] نتائج=[];
    نتائج=فرز_مستندات(قاعدة,مجموعة,عمود,اتجاه);
    ارجع نتائج;
}

// إحصائيات
دالة إحصائيات_المجموعة(قاعدة صحيح,مجموعة نص) -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_مجموعة(قاعدة,مجموعة);
    ارجع إحصائيات;
}

// تصدير
دالة تصدير_المجموعة(قاعدة صحيح,مجموعة نص,مسار نص) -> صحيح {
    تصدير_مجموعة(قاعدة,مجموعة,مسار);
    ارجع صحيحاً;
}


