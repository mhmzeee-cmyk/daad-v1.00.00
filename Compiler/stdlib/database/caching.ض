// إنشاء cache
دالة إنشاء_تخزين(حجم صحيح) -> صحيح {
    صحيح تخزين=0;
    تخزين=إنشاء_تخزين(حجم);
    ارجع تخزين;
}

// إضافة
دالة أضف_للتخزين(تخزين صحيح,مفتاح نص,قيمة نص,مدة صحيح) -> صحيح {
    أضف_تخزين(تخزين,مفتاح,قيمة,مدة);
    ارجع صحيحاً;
}

// جلب
دالة احصل_من_التخزين(تخزين صحيح,مفتاح نص) -> نص {
نص قيمة="";
    قيمة=احصل_تخزين(تخزين,مفتاح);
    ارجع قيمة;
}

// حذف
دالة حذف_من_التخزين(تخزين صحيح,مفتاح نص) -> صحيح {
    حذف_تخزين(تخزين,مفتاح);
    ارجع صحيحاً;
}

// مسح
دالة مسح_التخزين(تخزين صحيح) {
    مسح_تخزين(تخزين);
}

// الحجم
دالة حجم_التخزين(تخزين صحيح) -> صحيح {
    صحيح حجم=0;
    حجم=حجم_تخزين(تخزين);
    ارجع حجم;
}

// إحصائيات
دالة إحصائيات_التخزين(تخزين صحيح) -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_تخزين(تخزين);
    ارجع إحصائيات;
}

// انتهت؟
دالة انتهاء_الصلاحية(تخزين صحيح,مفتاح نص) -> صحيح {
    صحيح انتهت=0;
    إذا(انتهت_صلاحية(تخزين,مفتاح)==1){ انتهت=1; }
    ارجع انتهت;
}

// تصدير
دالة تصدير_التخزين(تخزين صحيح,مسار نص) -> صحيح {
    تصدير_تخزين(تخزين,مسار);
    ارجع صحيحاً;
}

// استيراد
دالة استيراد_التخزين(تخزين صحيح,مسار نص) -> صحيح {
    استيراد_التخزين(تخزين,مسار);
    ارجع صحيحاً;
}


