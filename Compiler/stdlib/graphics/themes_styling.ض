// تطبيق
دالة تطبيق_ثيم(اسم نص) -> صحيح {
    تطبيق_ثيم(اسم);
    ارجع صحيحاً;
}

// إنشاء
دالة إنشاء_ثيم(اسم نص,بيانات نص) -> صحيح {
    إنشاء_ثيم(اسم,بيانات);
    ارجع صحيحاً;
}

// الحالي
دالة الثيم_الحالي() -> نص {
نص ثيم="";
    ثيم=الثيم_الحالي();
    ارجع ثيم;
}

// الثيمات
دالة ثيمات_متوفرة() -> صحيح[] {
    صحيح[] ثيمات=[];
    ثيمات=ثيمات_متوفرة();
    ارجع ثيمات;
}

// تخصيص لون
دالة تخصيص_لون(عنصر نص,لون صحيح) -> صحيح {
    تخصيص_لون(عنصر,لون);
    ارجع صحيحاً;
}

// تخصيص خط
دالة تخصيص_خط(عنصر نص,حجم صحيح,نوع نص) -> صحيح {
    تخصيص_خط(عنصر,حجم,نوع);
    ارجع صحيحاً;
}

// تصدير
دالة تصدير_الثيم(اسم نص,مسار نص) -> صحيح {
    تصدير_ثيم(اسم,مسار);
    ارجع صحيحاً;
}

// استيراد
دالة استيراد_الثيم(مسار نص) -> صحيح {
    استيراد_ثيم(مسار);
    ارجع صحيحاً;
}

// مسح
دالة مسح_الثيم() {
    مسح_ثيم();
}

// إعادة
دالة إعادة_الثيم() {
    إعادة_ثيم();
}


