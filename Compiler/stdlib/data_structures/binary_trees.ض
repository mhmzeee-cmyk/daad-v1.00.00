// إنشاء شجرة
دالة إنشاء_شجرة() -> صحيح {
    صحيح شجرة=0;
    شجرة=إنشاء_شجرة();
    ارجع شجرة;
}

// إدراج
دالة أدرج_في_الشجرة(شجرة صحيح,قيمة صحيح) -> صحيح {
    أدرج(شجرة,قيمة);
    ارجع صحيحاً;
}

// البحث
دالة ابحث_في_الشجرة(شجرة صحيح,قيمة صحيح) -> صحيح {
    صحيح وُجد=0;
    إذا(ابحث_شجرة(شجرة,قيمة)==1){ وُجد=1; }
    ارجع وُجد;
}

// حذف
دالة احذف_من_الشجرة(شجرة صحيح,قيمة صحيح) -> صحيح {
    حذف_شجرة(شجرة,قيمة);
    ارجع صحيحاً;
}

// عرض
دالة اطبع_الأشجار(شجرة صحيح) {
    توسط(شجرة);
}

// عرض الشجرة
دالة العرض(شجرة صحيح) -> صحيح {
    صحيح عرض=0;
    عرض=عرض_شجرة(شجرة);
    ارجع عرض;
}

// عمق الشجرة
دالة العمق(شجرة صحيح) -> صحيح {
    صحيح عمق=0;
    عمق=عمق_شجرة(شجرة);
    ارجع عمق;
}

// عدد العناصر
دالة عدد_العناصر(شجرة صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=عدّ_شجرة(شجرة);
    ارجع عدد;
}

// هل متوازنة؟
دالة شجرة_متوازنة(شجرة صحيح) -> صحيح {
    صحيح متوازنة=0;
    إذا(توازن(شجرة)==1){ متوازنة=1; }
    ارجع متوازنة;
}

// الأصغر
دالة أصغر(شجرة صحيح) -> صحيح {
    صحيح أصغر=0;
    أصغر=أصغر_شجرة(شجرة);
    ارجع أصغر;
}


