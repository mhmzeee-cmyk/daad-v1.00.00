// مساحة المربع
دالة مساحة_مربع(عشري ضلع) -> عشري {
    ارجع ضلع*ضلع;
}

// مساحة المستطيل
دالة مساحة_مستطيل(عشري طول,عشري عرض) -> عشري {
    ارجع طول*عرض;
}

// مساحة الدائرة
دالة مساحة_دائرة(عشري نصف_قطر) -> عشري {
    ارجع 3.14159*نصف_قطر*نصف_قطر;
}

// مساحة المثلث
دالة مساحة_مثلث(عشري قاعدة,عشري ارتفاع) -> عشري {
    ارجع 0.5*قاعدة*ارتفاع;
}

// محيط المربع
دالة محيط_مربع(عشري ضلع) -> عشري {
    ارجع 4*ضلع;
}

// محيط المستطيل
دالة محيط_مستطيل(عشري طول,عشري عرض) -> عشري {
    ارجع 2*(طول+عرض);
}

// محيط الدائرة
دالة محيط_دائرة(عشري نصف_قطر) -> عشري {
    ارجع 2*3.14159*نصف_قطر;
}

// المسافة
دالة مسافة(عشري x1,عشري y1,عشري x2,عشري y2) -> عشري {
    عشري dx=x2-x1;عشري dy=y2-y1;
    ارجع جذر(dx*dx+dy*dy);
}

// الزاوية
دالة زاوية(عشري x1,عشري y1,عشري x2,عشري y2) -> عشري {
    ارجع atan2(y2-y1,x2-x1);
}

// مساحة مضلع
دالة مساحة_مضلع(عشري[][] نقاط) -> عشري {
    عشري نتيجة=0.0;
    لكل(صحيح i=0;i<طول(نقاط);i+=1){صحيح j=(i+1)%طول(نقاط);نتيجة+=نقاط[i][0]*نقاط[j][1];نتيجة-=نقاط[j][0]*نقاط[i][1]; }
    ارجع مطلق(نتيجة)/2.0;
}


