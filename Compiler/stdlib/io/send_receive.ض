// ض مكتبة: الإرسال_واستقبال
// Category: io
// الوصف: الإرسال والاستقبال

// إرسال بيانات
دالة أرسل(بيانات نص) -> صحيح {
    إرسال_شبكي(بيانات);
    ارجع صحيحاً;
}

// استقبال بيانات
دالة استقبل() -> نص {
    نص بيانات="";
    بيانات=استقبال_شبكي();
    ارجع بيانات;
}

// إرسال ملف
دالة أرسل_ملف(مسار نص) -> صحيح {
    إرسال_ملف(مسار);
    ارجع صحيحاً;
}

// استقبال ملف
دالة استقبل_ملف(مسار نص) -> صحيح {
    استقبال_ملف(مسار);
    ارجع صحيحاً;
}

// هل متصل؟
دالة حالة_الاتصال() -> صحيح {
    صحيح نشط=0;
    إذا(هل_متصل()){ نشط=1; }
    ارجع نشط;
}

// قطع الاتصال
دالة قطع() {
    قطع_اتصال();
}

// حجم المستلم
دالة حجم_البيانات() -> صحيح {
    صحيح حجم=0;
    حجم=احصل_حجم();
    ارجع حجم;
}

// إحصائيات
دالة إحصائيات() -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=جلب_إحصائيات();
    ارجع إحصائيات;
}

// هل وصلت؟
دالة تحقق_من_الوصول() -> صحيح {
    صحيح وصل=0;
    إذا(البيانات_جاهزة()){ وصل=1; }
    ارجع وصل;
}

// مسح المؤقت
دالة امسح_المؤقت() {
    امسح_مخزن();
}


