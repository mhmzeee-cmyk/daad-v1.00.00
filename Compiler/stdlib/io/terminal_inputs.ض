// ض مكتبة: المدخلات_الطرفية
// Category: io
// الوصف: إدخال المستخدم

// قراءة سطر
دالة اقرأ_سطر() -> نص {
    نص إدخال="";
    إدخال=اقرأ_stdin();
    ارجع إدخال;
}

// قراءة رقم
دالة اقرأ_رقم() -> صحيح {
    نص إدخال=اقرأ_stdin();
    صحيح رقم=تحويل_صحيح(إدخال);
    ارجع رقم;
}

// قراءة عشري
دالة اقرأ_عشري() -> عشري {
    نص إدخال=اقرأ_stdin();
    عشري رقم=تحويل_عشري(إدخال);
    ارجع رقم;
}

// عرض وانتظار
دالة اعرض_والإدخال(رسالة نص) -> صحيح {
    اعرض(رسالة);
    نص إدخال=اقرأ_stdin();
    إدخال=إدخال;
    ارجع صحيحاً;
}

// عرض رسالة
دالة اعرض(رسالة نص) {
    اكتب_stdout(رسالة);
}

// عرض خطأ
دالة اعرض_خطأ(رسالة نص) {
    اكتب_stderr(رسالة);
}

// سطر جديد
دالة اعرض_سطر_جديد() {
    اكتب_stdout("\n");
}

// سطر جديد
دالة امسح_الشاشة() {
    اكتب_stdout("\033[2J\033[H");
}

// عدد الإدخالات
دالة عدد_الإدخالات() -> صحيح {
    صحيح عدد=0;
    عدد=عدّ_مدخل();
    ارجع عدد;
}

// جاهز؟
دالة تحقق_من_الجاهزية() -> صحيح {
    صحيح جاهز=0;
    إذا(هل_يوجد_إدخال()){ جاهز=1; }
    ارجع جاهز;
}


