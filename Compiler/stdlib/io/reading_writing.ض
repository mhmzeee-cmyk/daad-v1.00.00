// ض مكتبة: الجذر_والمدخلات
// Category: io
// الوصف: تحليل المعاملات

// جميع المعاملات
دالة احصل_على_المعاملات() -> صحيح[] {
    صحيح[] معاملات=[];
    معاملات=تحليل_معاملات();
    ارجع معاملات;
}

// معامل بالفهرس
دالة احصل_على_معامل(index صحيح) -> نص {
    نص معامل="";
    معامل=تحويل_نص(معاملات[index]);
    ارجع معامل;
}

// هل يوجد؟
دالة معامل_موجود(اسم نص) -> صحيح {
    صحيح موجود=0;
    إذا(ابحث_معاملات(اسم)>=0){ موجود=1; }
    ارجع موجود;
}

// اسم البرنامج
دالة اسم_البرنامج() -> صحيح {
    ارجع اسم_برنامج();
}

// مسار البرنامج
دالة مسار_البرنامج() -> صحيح {
    ارجع مسار_برنامج();
}

// عدد المعاملات
دالة عدد_المعاملات() -> صحيح {
    صحيح عدد=0;
    عدد=طول(المعاملات);
    ارجع عدد;
}

// تعيين بيئي
دالة عيّن_البيئة(اسم نص,قيمة نص) {
    عيّن_بيئة(اسم,قيمة);
}

// قراءة بيئي
دالة احصل_على_البيئة(اسم نص) -> نص {
    نص قيمة="";
    قيمة=اقرأ_بيئة(اسم);
    ارجع قيمة;
}

// مسار العمل
دالة مسار_العمل() -> صحيح {
    ارجع مسار_عمل();
}

// عدد المتغيرات
دالة عدد_البيئة() -> صحيح {
    صحيح عدد=0;
    عدد=عدّ_بيئة();
    ارجع عدد;
}


