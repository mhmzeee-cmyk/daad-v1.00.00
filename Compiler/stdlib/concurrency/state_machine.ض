// ض مكتبة: آلة_الحالة
// Category: concurrency
// الوصف: المAutomata

// إنشاء
دالة إنشاء_حالة_آلة(عدد حالات صحيح) -> صحيح {
    صحيح آلة=0;
    آلة=إنشاء_آلة(عدد_حالات);
    ارجع آلة;
}

// إضافة
دالة إضافة_انتقال(آلة صحيح,من صحيح,إلى صحيح,شرط نص) -> صحيح {
    إضافة_انتقال(آلة,من,إلى,شرط);
    ارجع صحيحاً;
}

// البداية
دالة تعيين_البداية(آلة صحيح,حالة صحيح) {
    تعيين_بداية(آلة,حالة);
}

// إضافة نهاية
دالة إضافة_نهاية(آلة صحيح,حالة صحيح) {
    إضافة_نهاية(آلة,حالة);
}

// تشغيل
دالة تشغيل_الآلة(آلة صحيح,مدخل نص) -> صحيح {
    صحيح نتيجة=0;
    نتيجة=تشغيل_آلة(آلة,مدخل);
    ارجع نتيجة;
}

// إعادة
دالة إعادة_تعيين(آلة صحيح) {
    إعادة_تعيين_آلة(آلة);
}

// الحالية
دالة الحالة_الحالية(آلة صحيح) -> صحيح {
    صحيح حالة=0;
    حالة=الحالة_الحالية(آلة);
    ارجع حالة;
}

// مقبول؟
دالة مقبول_الآلة(آلة صحيح) -> صحيح {
    صحيح مقبول=0;
    إذا(هل_مقبول(آلة)==1){ مقبول=1; }
    ارجع مقبول;
}

// الرسم
دالة رسم_الآلة(آلة صحيح) -> نص {
نص رسم="";
    رسم=رسم_آلة(آلة);
    ارجع رسم;
}

// إحصائيات
دالة إحصائيات_الآلة(آلة صحيح) -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_آلة(آلة);
    ارجع إحصائيات;
}


