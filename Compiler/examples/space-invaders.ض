// ═══════════════════════════════════════════════════════════════
// Space Invaders — بلغة ض
// ═══════════════════════════════════════════════════════════════

__dhad.setCanvasSize(800, 600);
__dhad.background("#000011");

// ── المتغيرات ──────────────────────────────────────────────────
 صحيح لاعب_س = 400;
 صحيح لاعب_ص = 540;
 صحيح لاعب_عرض = 60;
 صحيح لاعب_ارتفاع = 20;

 صحيح صواريخ_صفوف = 4;
 صحيح صواريخ_اعمدة = 8;
 صحيح صواريخ_عرض = 30;
 صحيح صواريخ_ارتفاع = 20;
 صحيح صواريخ_سرعة = 1;
 صحيح صواريخ_اتجاه = 1;
 صحيح صواريخ_نزول = 15;

 صحيح ذخيرة_س = -100;
 صحيح ذخيرة_ص = -100;
 صحيح ذخيرة_نشطة = 0;
 صحيح ذخيرة_سرعة = 8;

 صحيح نقاط = 0;
 صحيح صحة = 3;
 صحيح موجة = 1;
 صحيح لعبة_نهاية = 0;
 صحيح مؤقت = 0;

 // مؤشرات الزومبي (0=حي, 1=ميت)
 صحيح زومبي = [];

// ── تهيئة الزومبي ──────────────────────────────────────────────
دالة تهيئة() {
    صحيح س = 0;
    طالما (س < صواريخ_صفوف) {
        صحيح ص = 0;
        طالما (ص < صواريخ_اعمدة) {
            صحيح مؤشر = (س * صواريخ_اعمدة) + ص;
            إذا (مؤشر < 32) {
                زومبي[مؤشر] = 1;
            } وإلا {
                زومبي[مؤشر] = 0;
            }
            ص = ص + 1;
        }
        س = س + 1;
    }
    لاعب_س = 400;
    صحة = 3;
    نقاط = 0;
    موجة = 1;
    صواريخ_سرعة = 1;
}

// ── رسم اللاعب ─────────────────────────────────────────────────
دالة رسم_لاعب() {
    __dhad.setColor("#00ff88");
    __dhad.rectangle(لاعب_س - لاعب_عرض / 2, لاعب_ص, لاعب_عرض, لاعب_ارتفاع);
    __dhad.rectangle(لاعب_س - 5, لاعب_ص - 10, 10, 10);
    __dhad.rectangle(لاعب_س - 2, لاعب_ص - 15, 4, 8);
}

// ── رسم الزومبي ────────────────────────────────────────────────
دالة رسم_زومبي() {
    صحيح س = 0;
    طالما (س < صواريخ_صفوف) {
        صحيح ص = 0;
        طالما (ص < صواريخ_اعمدة) {
            صحيح مؤشر = (س * صواريخ_اعمدة) + ص;
            إذا (زومبي[مؤشر] == 1) {
                صحيح ز_س = 80 + (ص * 80);
                صحيح ز_ص = 60 + (س * 50);
                // الرسم
                __dhad.setColor("#ff4444");
                __dhad.rectangle(ز_س - 12, ز_ص, 24, 16);
                __dhad.setColor("#ff0000");
                __dhad.rectangle(ز_س - 8, ز_ص - 5, 6, 6);
                __dhad.rectangle(ز_س + 2, ز_ص - 5, 6, 6);
                __dhad.setColor("#cc0000");
                __dhad.rectangle(ز_س - 3, ز_ص + 16, 6, 4);
            }
            ص = ص + 1;
        }
        س = س + 1;
    }
}

// ── رسم الذخيرة ────────────────────────────────────────────────
دالة رسم_ذخيرة() {
    إذا (ذخيرة_نشطة == 1) {
        __dhad.setColor("#ffff00");
        __dhad.rectangle(ذخيرة_س - 2, ذخيرة_ص, 4, 12);
    }
}

// ── حركة الزومبي ──────────────────────────────────────────────
دالة حركة_زومبي() {
    صحيح س = 0;
    صحيح أقصى = 0;
    طالما (س < 32) {
        إذا (زومبي[س] == 1) {
            صحيح صف = س / صواريخ_اعمدة;
            صحيح عمود = س - (صف * صواريخ_اعمدة);
            صحيح موقع = 80 + (عمود * 80);
            إذا (موقع > أقصى) {
                أقصى = موقع;
            }
        }
        س = س + 1;
    }
    // حركة جانبية
    صحيح حركة = صواريخ_سرعة * صواريخ_اتجاه;
    س = 0;
    طالما (س < 32) {
        إذا (زومبي[س] == 1) {
            صحيح صف = س / صواريخ_اعمدة;
            صحيح عمود = س - (صف * صواريخ_اعمدة);
            صحيح موقع = 80 + (عمود * 80);
            موقع = موقع + حركة;
        }
        س = س + 1;
    }
    // تغيير الاتجاه
    إذا (أقصى > 700) {
        صواريخ_اتجاه = -1;
        س = 0;
        طالما (س < 32) {
            إذا (زومبي[س] == 1) {
                صحيح صف = س / صواريخ_اعمدة;
                صحيح عمود = س - (صف * صواريخ_اعمدة);
                صحيح موقع = 80 + (عمود * 80);
                موقع = موقع + (صواريخ_اتجاه * صواريخ_سرعة);
            }
            س = س + 1;
        }
    }
    إذا (أقصى < 120) {
        صواريخ_اتجاه = 1;
        س = 0;
        طالما (س < 32) {
            إذا (زومبي[س] == 1) {
                صحيح صف = س / صواريخ_اعمدة;
                صحيح عمود = س - (صف * صواريخ_اعمدة);
                صحيح موقع = 80 + (عمود * 80);
                موقع = موقع + (صواريخ_اتجاه * صواريخ_سرعة);
            }
            س = س + 1;
        }
    }
}

// ── إطلاق النار ────────────────────────────────────────────────
دالة إطلاق() {
    إذا (ذخيرة_نشطة == 0) {
        ذخيرة_س = لاعب_س;
        ذخيرة_ص = لاعب_ص - 20;
        ذخيرة_نشطة = 1;
    }
}

// ── تحديث الذخيرة ──────────────────────────────────────────────
دالة تحديث_ذخيرة() {
    إذا (ذخيرة_نشطة == 1) {
        ذخيرة_ص = ذخيرة_ص - ذخيرة_سرعة;
        إذا (ذخيرة_ص < -20) {
            ذخيرة_نشطة = 0;
        }
        // فحص الاصطدام
        صحيح س = 0;
        طالما (س < 32) {
            إذا (زومبي[س] == 1) {
                صحيح صف = س / صواريخ_اعمدة;
                صحيح عمود = س - (صف * صواريخ_اعمدة);
                صحيح ز_س = 80 + (عمود * 80);
                صحيح ز_ص = 60 + (صف * 50);
                إذا (ذخيرة_س > ز_س - 15 && ذخيرة_س < ز_س + 15 && ذخيرة_ص > ز_ص - 10 && ذخيرة_ص < ز_ص + 20) {
                    زومبي[س] = 0;
                    ذخيرة_نشطة = 0;
                    نقاط = نقاط + 10;
                }
            }
            س = س + 1;
        }
    }
}

// ── رسم الواجهة ────────────────────────────────────────────────
دالة رسم_واجهة() {
    __dhad.setColor("#ffffff");
    __dhad.text("النقاط: " + نقاط, 100, 10, 16);
    __dhad.text("الموجة: " + موجة, 400, 10, 16);
    __dhad.text("الصحة: " + صحة, 700, 10, 16);
    // أشرطة الصحة
    صحيح س = 0;
    طالما (س < صحة) {
        __dhad.setColor("#00ff00");
        __dhad.rectangle(10 + (س * 30), 30, 25, 10);
        س = س + 1;
    }
}

// ── فحص نهاية اللعبة ──────────────────────────────────────────
دالة فحص_نهاية() {
    إذا (صحة <= 0) {
        لعبة_نهاية = 1;
    }
    // فحص وصول الزومبي للأسفل
    صحيح س = 0;
    طالما (س < 32) {
        إذا (زومبي[س] == 1) {
            صحيح صف = س / صواريخ_اعمدة;
            صحيح ز_ص = 60 + (صف * 50);
            إذا (ز_ص > 500) {
                لعبة_نهاية = 1;
            }
        }
        س = س + 1;
    }
}

// ── اللعبة الرئيسية ────────────────────────────────────────────
تهيئة();

طالما (لعبة_نهاية == 0) {
    // الخلفية
    __dhad.background("#000011");

    // نجوم
    __dhad.setColor("#ffffff");
    __dhad.rectangle(100, 100, 1, 1);
    __dhad.rectangle(200, 50, 1, 1);
    __dhad.rectangle(350, 120, 1, 1);
    __dhad.rectangle(500, 80, 1, 1);
    __dhad.rectangle(650, 110, 1, 1);
    __dhad.rectangle(750, 40, 1, 1);

    // تحديث
    حركة_زومبي();
    تحديث_ذخيرة();

    // رسم
    رسم_زومبي();
    رسم_لاعب();
    رسم_ذخيرة();
    رسم_واجهة();
    فحص_نهاية();

    مؤقت = مؤقت + 1;
    إذا (مؤقت > 100) {
        مؤقت = 0;
    }
}

// نهاية اللعبة
__dhad.background("#000000");
إذا (لعبة_نهاية == 1) {
    __dhad.setColor("#ff0000");
    __dhad.text("GAME OVER", 400, 200, 48);
    __dhad.setColor("#ffffff");
    __dhad.text("النقاط: " + نقاط, 400, 300, 24);
    __dhad.text("الموجة: " + موجة, 400, 350, 20);
}
