// ═══════════════════════════════════════════════════════════════
// تأثيرات جسيمات — بلغة ض
// عرض تأثيرات بصرية متنوعة
// ═══════════════════════════════════════════════════════════════

__dhad.setCanvasSize(800, 600);
__dhad.background("#000011");

// ── المتغيرات ──────────────────────────────────────────────────
 صحيح عدد_جسيمات = 50;
 صحيح جسيمات = [];

 // كل جسيم: [س, ص, سرعة_س, سرعة_ص, حجم, لون, عمر]
 صحيح مؤقت = 0;

// ── تهيئة الجسيمات ────────────────────────────────────────────
دالة تهيئة() {
    صحيح س = 0;
    طالما (س < عدد_جسيمات) {
        صحيح مؤشر = س * 7;
        جسيمات[مؤشر] = 400 + (س * 8 - عدد_جسيمات * 4);
        جسيمات[مؤشر + 1] = 300 + (س * 6 - عدد_جسيمات * 3);
        جسيمات[مؤشر + 2] = (س * 3) - (عدد_جسيمات * 1.5);
        جسيمات[مؤشر + 3] = (س * 2) - (عدد_جسيمات);
        جسيمات[مؤشر + 4] = 2 + (س % 5);
        جسيمات[مؤشر + 5] = س % 7;
        جسيمات[مؤشر + 6] = 100 + (س * 2);
        س = س + 1;
    }
}

// ── رسم جسيم ───────────────────────────────────────────────────
دالة رسم_جسيم(صحيح مؤشر) {
    صحيح س = جسيمات[مؤشر];
    صحيح ص = جسيمات[مؤشر + 1];
    صحيح حجم = جسيمات[مؤشر + 4];
    صحيح لون = جسيمات[مؤشر + 5];

    // اختيار اللون
    إذا (لون == 0) { __dhad.setColor("#ff4444"); }
    وإلا إذا (لون == 1) { __dhad.setColor("#44ff44"); }
    وإلا إذا (لون == 2) { __dhad.setColor("#4444ff"); }
    وإلا إذا (لون == 3) { __dhad.setColor("#ffff44"); }
    وإلا إذا (لون == 4) { __dhad.setColor("#ff44ff"); }
    وإلا إذا (لون == 5) { __dhad.setColor("#44ffff"); }
    وإلا { __dhad.setColor("#ffffff"); }

    __dhad.circle(س, ص, حجم);

    // توهج
    __dhad.setColor("#ffffff");
    __dhad.circle(س, ص, حجم / 2);
}

// ── تحديث الجسيمات ────────────────────────────────────────────
دالة تحديث() {
    صحيح س = 0;
    طالما (س < عدد_جسيمات) {
        صحيح مؤشر = س * 7;
        // الحركة
        جسيمات[مؤشر] = جسيمات[مؤشر] + جسيمات[مؤشر + 2];
        جسيمات[مؤشر + 1] = جسيمات[مؤشر + 1] + جسيمات[مؤشر + 3];
        // الجاذبية
        جسيمات[مؤشر + 3] = جسيمات[مؤشر + 3] + 0.1;
        // الانعكاس
        إذا (جسيمات[مؤشر] < 0 || جسيمات[مؤشر] > 800) {
            جسيمات[مؤشر + 2] = -جسيمات[مؤشر + 2];
        }
        إذا (جسيمات[مؤشر + 1] < 0 || جسيمات[مؤشر + 1] > 600) {
            جسيمات[مؤشر + 3] = -جسيمات[مؤشر + 3] * 0.8;
            جسيمات[مؤشر + 1] = 590;
        }
        // تقليل العمر
        جسيمات[مؤشر + 6] = جسيمات[مؤشر + 6] - 1;
        إذا (جسيمات[مؤشر + 6] <= 0) {
            // إعادة تهيئة
            جسيمات[مؤشر] = 400;
            جسيمات[مؤشر + 1] = 300;
            جسيمات[مؤشر + 2] = (س * 3) - (عدد_جسيمات * 1.5);
            جسيمات[مؤشر + 3] = (س * 2) - (عدد_جسيمات);
            جسيمات[مؤشر + 6] = 100 + (س * 2);
        }
        س = س + 1;
    }
}

// ── رسم الأثر ──────────────────────────────────────────────────
دالة رسم_أثر() {
    __dhad.setColor("#ffffff");
    __dhad.circle(400, 300, 20 + (مؤقت % 30));
    __dhad.setColor("#4444ff");
    __dhad.circle(400, 300, 15 + (مؤقت % 25));
    __dhad.setColor("#ff4444");
    __dhad.circle(400, 300, 10 + (مؤقت % 20));
    __dhad.setColor("#ffff44");
    __dhad.circle(400, 300, 5 + (مؤقت % 15));
}

// ── العنوان ────────────────────────────────────────────────────
دالة رسم_عنوان() {
    __dhad.setColor("#ffffff");
    __dhad.text("تأثيرات جسيمات — بلغة ض", 400, 10, 18);
    __dhad.setColor("#aaaaaa");
    __dhad.text("Particle Effects Demo", 400, 35, 12);
}

// ── الحلقة الرئيسية ────────────────────────────────────────────
تهيئة();

طالما (مؤقت < 500) {
    __dhad.background("#000011");

    // رسم الأثر المركزي
    رسم_أثر();

    // تحديث ورسم الجسيمات
    تحديث();
    صحيح س = 0;
    طالما (س < عدد_جسيمات) {
        رسم_جسيم(س * 7);
        س = س + 1;
    }

    رسم_عنوان();

    مؤقت = مؤقت + 1;
}

// النتيجة النهائية
__dhad.background("#000011");
__dhad.setColor("#ffffff");
__dhad.text("انتهى العرض!", 400, 280, 36);
__dhad.setColor("#aaaaaa");
__dhad.text("تم عرض " + عدد_جسيمات + " جسيم", 400, 340, 18);
__dhad.setColor("#44ff44");
__dhad.text("بلغة ض — Dhad Language", 400, 400, 14);
