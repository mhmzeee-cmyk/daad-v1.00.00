// ── الرسم ───────────────────────────────────────────────────

دالة شريط(صحيح صحة, صحيح قصوى) {
    نص ش = "[";
    صحيح ن = (صحة * 10) / قصوى;
    إذا (ن > 10) { ن = 10; }
    صحيح i = 0;
    طالما (i < 10) {
        إذا (i < ن) {
            ش = ش + "#";
        } وإلا {
            ش = ش + "-";
        }
        i = i + 1;
    }
    ش = ش + "]";
    ارجع ش;
}

