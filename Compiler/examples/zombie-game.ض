دالة اللعبة() {
    شاشة_العنوان();
    اختيار_شخصية();

    طباعة("  >>> اخترت: أحمد المقاتل");
    طباعة("  HP:100 | DMG:25 | AMMO:20");
    طباعة("");

    اختيار_سلاح();
    طباعة("  >>> اخترت: المسدس DMG:20 AMMO:20");
    طباعة("");

    طباعة("  ============================================");
    طباعة("  >>>>>  ابدأ المعركة!  <<<<<");
    طباعة("  ============================================");

    صحيح نقاط = 0;
    صحيح موجة = 1;

    طالما (موجة <= 5) {
        نقاط = نقاط + معركة(100, 25, 20, موجة);
        طباعة("  >>>  النقاط الإجمالية: " + نقاط);
        طباعة("  +++ تم إعادة شحن الصحة والذخيرة!");
        طباعة("");
        موجة = موجة + 1;
    }

    طباعة("");
    طباعة("  +==============================================+");
    طباعة("  |            >>>  انتصرت!  <<<                |");
    طباعة("  +==============================================+");
    طباعة("");
    طباعة("  البطل: أحمد المقاتل");
    طباعة("  النقاط: " + نقاط);
    طباعة("  الرتبة: " + رتبة(نقاط));
    طباعة("");
}

