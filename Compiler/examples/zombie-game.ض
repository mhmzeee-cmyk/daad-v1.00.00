// ── الخريطة ─────────────────────────────────────────────────

دالة خريطة(صحيح لx, صحيح لy, صحيح عدد) {
    طباعة("  +--------------+");
    صحيح y = 0;
    طالما (y < 6) {
        نص س = "  | ";
        صحيح x = 0;
        طالما (x < 10) {
            إذا (x == لx && y == لy) {
                س = س + "@";
            } وإلا {
                صحيح ز = y * 10 + x;
                إذا (ز < عدد) {
                    إذا (ز % 3 == 0) { س = س + "z"; }
                    وإلا إذا (ز % 3 == 1) { س = س + "f"; }
                    وإلا { س = س + "T"; }
                } وإلا {
                    س = س + ".";
                }
            }
            x = x + 1;
        }
        س = س + " |";
        طباعة(س);
        y = y + 1;
    }
    طباعة("  +--------------+");
    طباعة("  @=أنت z=عادي f=سريع T=دبابة");
}

// ── تهيئة الزومبي ───────────────────────────────────────────

دالة تهيئة(صحيح عدد) {
    صحيح i = 0;
    طالما (i < عدد) {
        صحيح ص = 30 + (i * 5);
        إذا (i == 0) { صحة1 = ص; }
        إذا (i == 1) { صحة2 = ص; }
        إذا (i == 2) { صحة3 = ص; }
        إذا (i == 3) { صحة4 = ص; }
        إذا (i == 4) { صحة5 = ص; }
        إذا (i == 5) { صحة6 = ص; }
        إذا (i == 6) { صحة7 = ص; }
        إذا (i == 7) { صحة8 = ص; }
        إذا (i == 8) { صحة9 = ص; }
        إذا (i == 9) { صحة10 = ص; }
        i = i + 1;
    }
}

// ── ضرب زومبي ───────────────────────────────────────────────

دالة ضرب(صحيح رقم, صحيح ضرر) {
    إذا (رقم == 0) { صحة1 = صحة1 - ضرر; }
    إذا (رقم == 1) { صحة2 = صحة2 - ضرر; }
    إذا (رقم == 2) { صحة3 = صحة3 - ضرر; }
    إذا (رقم == 3) { صحة4 = صحة4 - ضرر; }
    إذا (رقم == 4) { صحة5 = صحة5 - ضرر; }
    إذا (رقم == 5) { صحة6 = صحة6 - ضرر; }
    إذا (رقم == 6) { صحة7 = صحة7 - ضرر; }
    إذا (رقم == 7) { صحة8 = صحة8 - ضرر; }
    إذا (رقم == 8) { صحة9 = صحة9 - ضرر; }
    إذا (رقم == 9) { صحة10 = صحة10 - ضرر; }
}

// ── قراءة صحة زومبي ─────────────────────────────────────────

دالة قراءة_صحة(صحيح رقم) {
    إذا (رقم == 0) { ارجع صحة1; }
    إذا (رقم == 1) { ارجع صحة2; }
    إذا (رقم == 2) { ارجع صحة3; }
    إذا (رقم == 3) { ارجع صحة4; }
    إذا (رقم == 4) { ارجع صحة5; }
    إذا (رقم == 5) { ارجع صحة6; }
    إذا (رقم == 6) { ارجع صحة7; }
    إذا (رقم == 7) { ارجع صحة8; }
    إذا (رقم == 8) { ارجع صحة9; }
    إذا (رقم == 9) { ارجع صحة10; }
    ارجع 0;
}

// ── ضرر زومبي ───────────────────────────────────────────────

دالة ضرر_ز(صحيح رقم) {
    إذا (رقم % 3 == 0) { ارجع 5; }
    إذا (رقم % 3 == 1) { ارجع 3; }
    ارجع 12;
}

// ── عدد أحياء ───────────────────────────────────────────────

دالة عد_أحياء(صحيح عدد) {
    صحيح ع = 0;
    صحيح i = 0;
    طالما (i < عدد) {
        إذا (قراءة_صحة(i) > 0) {
            ع = ع + 1;
        }
        i = i + 1;
    }
    ارجع ع;
}

// ── المعركة ─────────────────────────────────────────────────

دالة معركة(صحيح hp, صحيح dmg, صحيح ammo, صحيح رقم_موجة) {
    صحيح عدد = 3 + (رقم_موجة * 2);
    إذا (عدد > 10) { عدد = 10; }
    تهيئة(عدد);

    صحيح ذ = ammo;
    صحيح نقاط = 0;
    صحيح ج = 0;

    طباعة("");
    طباعة("  >>>>>  الموجة " + رقم_موجة + "  <<<<<");
    طباعة("  زومبي قادمون: " + عدد);

    طالما (hp > 0 && عد_أحياء(عدد) > 0) {
        ج = ج + 1;

        طباعة("  +------------------------------------------+");
        طباعة("  |  HP: " + شريط(hp, 100) + " " + hp + "/100");
        طباعة("  |  الموجة: " + رقم_موجة + "  |  الجولة: " + ج);
        طباعة("  |  الذخيرة: " + ذ + "  |  النقاط: " + نقاط);
        طباعة("  |  أحياء: " + عد_أحياء(عدد) + "/" + عدد);
        طباعة("  +------------------------------------------+");

        صحيح لx = (ج * 2 + 1) % 10;
        صحيح لy = (ج * 3 + 1) % 6;
        خريطة(لx, لy, عدد);

        طباعة("  ------------------------------------------");

        // اللاعب يضرب أولاً — يقتل الزومبي واحد واحد
        إذا (ذ > 0) {
            ذ = ذ - 1;
            صحيح ضربات = 0;
            صحيح i = 0;
            طالما (i < عدد) {
                إذا (قراءة_صحة(i) > 0) {
                    ضرب(i, dmg);
                    إذا (قراءة_صحة(i) <= 0) {
                        نقاط = نقاط + 10;
                        ضربات = ضربات + 1;
                    }
                }
                i = i + 1;
            }
            طباعة("  >>> هاجمت! DMG: " + dmg);
            إذا (ضربات > 0) {
                طباعة("  +++ قتلت " + ضربات + " زومبي! +" + (ضربات * 10) + " نقطة");
            }
        } وإلا {
            ذ = ammo;
            طباعة("  +++ أعدت التعبئة!");
        }

        // الزومبي يهاجمون — كل زومبي حي يضرب
        إذا (hp > 0) {
            صحيح ضرر_م = 0;
            صحيح i = 0;
            طالما (i < عدد) {
                إذا (قراءة_صحة(i) > 0) {
                    ضرر_م = ضرر_م + ضرر_ز(i);
                }
                i = i + 1;
            }
            hp = hp - ضرر_م;
            إذا (hp < 0) { hp = 0; }
            إذا (ضرر_م > 0) {
                طباعة("  <<< هجمك الزومبي! -" + ضرر_م + " صحة");
            }
        }

        طباعة("");
    }

    طباعة("  >>>  هزمك الزومبي!  النقاط: " + نقاط);
    طباعة("");
    ارجع نقاط;
}

// ── الرتبة ──────────────────────────────────────────────────

دالة رتبة(صحيح نقاط) {
    إذا (نقاط >= 500) { ارجع "أسطورة الزومبي"; }
    إذا (نقاط >= 300) { ارجع "محارب مخضرم"; }
    إذا (نقاط >= 150) { ارجع "جندي شجاع"; }
    إذا (نقاط >= 50) { ارجع "مبتدئ ناجح"; }
    ارجع "غذاء للزومبي";
}

