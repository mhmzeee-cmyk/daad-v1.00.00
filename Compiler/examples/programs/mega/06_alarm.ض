// البرنامج 6: منبه مع رنات مختلفة

دالة رنين_عادي() {
    طباعة("بيب... بيب... بيب...") ؛
}

دالة رنين_سريع() {
    طباعة("بيب بيب بيب بيب بيب!") ؛
}

دالة رنين_هادئ() {
    طباعة("همس... همس... همس...") ؛
}

دالة رنين_مفاجئ() {
    طباعة("وام! وام! وام!") ؛
}

دالة اختيار_الرنين(صحيح اختيار) -> نص {
    إذا(اختيار == 1) { ارجع "عادي" ؛ }
    إذا(اختيار == 2) { ارجع "سريع" ؛ }
    إذا(اختيار == 3) { ارجع "هادئ" ؛ }
    إذا(اختيار == 4) { ارجع "مفاجئ" ؛ }
    ارجع "عادي" ؛
}

دالة تشغيل_المنبه(صحيح ساعة, صحيح دقيقة, صحيح نوع) {
    طباعة("=== المنبه ===") ؛
    طباعة("الوقت: ") ؛
    طباعة(ساعة) ؛
    طباعة(":") ؛
    إذا(دقيقة < 10) { طباعة("0") ؛ }
    طباعة(دقيقة) ؛
    طباعة("الرنين: ") ؛
    طباعة(اختيار_الرنين(نوع)) ؛

    إذا(نوع == 1) { رنين_عادي() ؛ }
    إذا(نوع == 2) { رنين_سريع() ؛ }
    إذا(نوع == 3) { رنين_هادئ() ؛ }
    إذا(نوع == 4) { رنين_مفاجئ() ؛ }
}

دالة تحديد_الحالة(صحيح ساعة) -> نص {
    إذا(ساعة >= 5) {
        إذا(ساعة < 12) { ارجع "صباحاً" ؛ }
    }
    إذا(ساعة >= 12) {
        إذا(ساعة < 17) { ارجع "ظهراً" ؛ }
    }
    إذا(ساعة >= 17) {
        إذا(ساعة < 21) { ارجع "مساءً" ؛ }
    }
    ارجع "ليلاً" ؛
}

// تشغيل المنبه
تشغيل_المنبه(7, 30, 1) ؛
طباعة("الحالة: ") ؛
طباعة(تحديد_الحالة(7)) ؛

تشغيل_المنبه(14, 0, 2) ؛
طباعة("الحالة: ") ؛
طباعة(تحديد_الحالة(14)) ؛

تشغيل_المنبه(22, 45, 3) ؛
طباعة("الحالة: ") ؛
طباعة(تحديد_الحالة(22)) ؛

// عد تنازلي
طباعة("=== عد تنازلي ===") ؛
لكل(صحيح i = 5; i >= 1; i = i - 1) {
    طباعة(i) ؛
}
طباعة("وقت!") ؛
