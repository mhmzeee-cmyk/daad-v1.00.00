// البرنامج 4: محوسب الأعداد الأولية
// إيجاد الأعداد الأولية حتى رقم معين

دالة هل_أولي(صحيح ن) -> صحيح {
    إذا(ن <= 1) { ارجع 0 ؛ }
    إذا(ن <= 3) { ارجع 1 ؛ }
    إذا(ن % 2 == 0) { ارجع 0 ؛ }

    صحيح i = 3 ؛
   طالما(i * i <= ن) {
        إذا(ن % i == 0) { ارجع 0 ؛ }
        i += 2 ؛
    }
    ارجع 1 ؛
}

دالة عدّ_الأولوية(صحيح حد) -> صحيح {
    صحيح عدّ = 0 ؛
    لكل(صحيح i = 2; i <= حد; i = i + 1) {
        إذا(هل_أولي(i) == 1) {
            عدّ += 1 ؛
        }
    }
    ارجع عدّ ؛
}

طباعة("=== الأعداد الأولية حتى 50 ===") ؛
صحيح عدد = 0 ؛
لكل(صحيح i = 2; i <= 50; i = i + 1) {
    إذا(هل_أولي(i) == 1) {
        طباعة(i) ؛
        عدد += 1 ؛
    }
}
طباعة("عدد الأعداد الأولية حتى 50:") ؛
طباعة(عدد) ؛

طباعة("عدد الأعداد الأولية حتى 100:") ؛
طباعة(عدّ_الأولوية(100)) ؛
