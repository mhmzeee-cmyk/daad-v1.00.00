// البرنامج 2: لعبة تخمين الأرقام
// لعبة تخمين رقم سري بين 1 و 100

دالة مقارنة(صحيح تخمين, صحيح سري) -> صحيح {
    إذا(تخمين == سري) {
        ارجع 0 ؛
    }
    إذا(تخمين < سري) {
        ارجع 1 ؛
    }
    ارجع 2 ؛
}

// الرقم السري هو 42
صحيح الرقم_السري = 42 ؛
صحيح محاولات = 0 ؛
صحيح فاز = 0 ؛
صحيح[] تخمينات = 0 ؛

طباعة("=== لعبة تخمين الأرقام ===") ؛
طباعة("خمن رقم بين 1 و 100") ؛

// محاكاة 5 محاولات
تخمينات[0] = 50 ؛
تخمينات[1] = 25 ؛
تخمينات[2] = 37 ؛
تخمينات[3] = 42 ؛

لكل(صحيح i = 0; i < 4; i = i + 1) {
    محاولات += 1 ؛
    صحيح نتيجة = مقارنة(تخمينات[i], الرقم_السري) ؛
    طباعة("محاولة ") ؛
    طباعة(محاولات) ؛
    طباعة(": ") ؛
    طباعة(تخمينات[i]) ؛

    إذا(نتيجة == 0) {
        طباعة("✓ فزت!") ؛
        فاز = 1 ؛
    }
    وإلا {
        إذا(نتيجة == 1) {
            طباعة("↑ أعلى!") ؛
        }
        وإلا {
            طباعة("↓ أدنى!") ؛
        }
    }
}

إذا(فاز == 1) {
    طباعة("تهانينا! فزت في ") ؛
    طباعة(محاولات) ؛
    طباعة(" محاولات") ؛
}
وإلا {
    طباعة("خسرت! الرقم كان ") ؛
    طباعة(الرقم_السري) ؛
}
