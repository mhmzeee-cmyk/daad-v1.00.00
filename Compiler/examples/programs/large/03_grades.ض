// البرنامج 3: محوسب درجات الطلاب
// حساب المعدل وتصنيف الدرجات

دالة تحديد_المعدل(صحيح مجموع, صحيح عدد) -> صحيح {
    إذا(عدد == 0) { ارجع 0 ؛ }
    ارجع مجموع / عدد ؛
}

دالة تحديد_التقدير(صحيح درجة) -> نص {
    إذا(درجة >= 90) { ارجع "ممتاز" ؛ }
    إذا(درجة >= 80) { ارجع "جيد جداً" ؛ }
    إذا(درجة >= 70) { ارجع "جيد" ؛ }
    إذا(درجة >= 60) { ارجع "مقبول" ؛ }
    ارجع "راسب" ؛
}

// بيانات الطلاب
صحيح طالب1 = 95 ؛
صحيح طالب2 = 82 ؛
صحيح طالب3 = 67 ؛
صحيح طالب4 = 78 ؛
صحيح طالب5 = 91 ؛

صحيح مجموع = طالب1 + طالب2 + طالب3 + طالب4 + طالب5 ؛
صحيح عدد = 5 ؛
صحيح معدّل = تحديد_المجموع(مجموع, عدد) ؛

طباعة("=== محوسب درجات الطلاب ===") ؛
طباعة("الطالب 1: ") ؛
طباعة(طالب1) ؛
طباعة("الطالب 2: ") ؛
طباعة(طالب2) ؛
طباعة("الطالب 3: ") ؛
طباعة(طالب3) ؛
طباعة("الطالب 4: ") ؛
طباعة(طالب4) ؛
طباعة("الطالب 5: ") ؛
طباعة(طالب5) ؛
طباعة("المجموع: ") ؛
طباعة(مجموع) ؛
طباعة("المعدّل: ") ؛
طباعة(معدّل) ؛

// أعلى وأدنى درجة
صحيح أعلى = طالب1 ؛
إذا(طالب2 > أعلى) { أعلى = طالب2 ؛ }
إذا(طالب3 > أعلى) { أعلى = طالب3 ؛ }
إذا(طالب4 > أعلى) { أعلى = طالب4 ؛ }
إذا(طالب5 > أعلى) { أعلى = طالب5 ؛ }

صحيح أدنى = طالب1 ؛
إذا(طالب2 < أدنى) { أدنى = طالب2 ؛ }
إذا(طالب3 < أدنى) { أدنى = طالب3 ؛ }
إذا(طالب4 < أدنى) { أدنى = طالب4 ؛ }
إذا(طالب5 < أدنى) { أدنى = طالب5 ؛ }

طباعة("أعلى درجة: ") ؛
طباعة(أعلى) ؛
طباعة("أدنى درجة: ") ؛
طباعة(أدنى) ؛
