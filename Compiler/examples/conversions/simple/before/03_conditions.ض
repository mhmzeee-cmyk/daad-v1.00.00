// البرنامج 3: الشروط والقرارات
// استخدام اذا وإلا

صحيح العمر = 20 ؛

إذا(العمر >= 18) {
    طباعة("أنت بالغ") ؛
}
وإلا {
    طباعة("أنت قاصر") ؛
}

صحيح الدرجة = 85 ؛

إذا(الدرجة >= 90) {
    طباعة("ممتاز") ؛
}
وإلا {
    إذا(الدرجة >= 80) {
        طباعة("جيد جداً") ؛
    }
    وإلا {
        إذا(الدرجة >= 70) {
            طباعة("جيد") ؛
        }
        وإلا {
            طباعة("مقبول") ؛
        }
    }
}
