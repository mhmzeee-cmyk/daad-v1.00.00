// البرنامج 4: الحلقات التكرارية
// استخدام لكل وطالما

// طباعة الأعداد من 1 إلى 10 باستخدام لكل
طباعة("الأعداد من 1 إلى 10:") ؛
لكل(صحيح i = 1; i <= 10; i = i + 1) {
    طباعة(i) ؛
}

// طباعة جدول الضرب باستخدام لكل
طباعة("جدول ضرب 7:") ؛
لكل(صحيح i = 1; i <= 10; i = i + 1) {
    طباعة("7 × ") ؛
    طباعة(i) ؛
    طباعة(" = ") ؛
    طباعة(7 * i) ؛
}

// استخدام طالما لحساب المجموع
صحيح ع = 1 ؛
صحيح مجموع = 0 ؛
طالما(ع <= 100) {
    مجموع = مجموع + ع ؛
    ع = ع + 1 ؛
}
طباعة("مجموع الأعداد من 1 إلى 100:") ؛
طباعة(مجموع) ؛
