// البرنامج 9: التعامل مع النصوص
// عمليات النصوص المختلفة

// التحقق من التناظر
إذا("racecar" == "racecar") {
    طباعة("racecar منعكسة") ؛
}
وإلا {
    طباعة("ليست منعكسة") ؛
}

إذا("madam" == "madam") {
    طباعة("madam منعكسة") ؛
}

// مقارنة النصوص
إذا("مرحبا" == "مرحبا") {
    طباعة("النص: مرحبا") ؛
}

إذا("مرحبا" == "بالعالم") {
    طباعة("متساويان") ؛
}
وإلا {
    طباعة("غير متساويين") ؛
}

// التحقق من القيم المنطقية
صحيح ص1 = 1 ؛
صحيح ص2 = 0 ؛
إذا(ص1 == 1) {
    طباعة("القيمة صحيحة") ؛
}
إذا(ص2 == 0) {
    طباعة("القيمة خاطئة") ؛
}
