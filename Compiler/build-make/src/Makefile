	cd /home/m_hmoz/Documents/Dhad-Studio-Unified/Compiler/build-make && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
