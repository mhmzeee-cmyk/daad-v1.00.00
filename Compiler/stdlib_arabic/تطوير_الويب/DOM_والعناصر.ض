// ض مكتبة: DOM_والعناصر
// الفئة: تطوير_الويب
// الوصف: DOM والعناصر

// البحث بالمعرف
دالة بحث_بالمعرف(id نص) -> صحيح {
    صحيح عنصر=0;
    عنصر=getElementById(id);
    ارجع عنصر;
}

// بالاسم
دالة getElementsByClassName(cls نص) -> صحيح[] {
    صحيح[] عناصر=[];
    عناصر=getElementsByClassName(cls);
    ارجع عناصر;
}

// بالوسم
دالة getElementsByTagName(tag نص) -> صحيح[] {
    صحيح[] عناصر=[];
    عناصر=getElementsByTagName(tag);
    ارجع عناصر;
}

// Selector
دالة querySelector(selector نص) -> صحيح {
    صحيح عنصر=0;
    عنصر=querySelector(selector);
    ارجع عنصر;
}

// الكل
دالة querySelectorAll(selector نص) -> صحيح[] {
    صحيح[] عناصر=[];
    عناصر=querySelectorAll(selector);
    ارجع عناصر;
}

// إنشاء عنصر
دالة createElement(tag نص) -> صحيح {
    صحيح عنصر=0;
    عنصر=createElement(tag);
    ارجع عنصر;
}

// إضافة اب
دالة appendChild(أب صحيح,طفل صحيح) -> صحيح {
    appendChild(أب,طفل);
    ارجع صحيحاً;
}

// حذف اب
دالة removeChild(أب صحيح,طفل صحيح) -> صحيح {
    removeChild(أب,طفل);
    ارجع صحيحاً;
}

// تعيين
دالة setAttribute(عنصر صحيح,اسم نص,قيمة نص) -> صحيح {
    setAttribute(عنصر,اسم,قيمة);
    ارجع صحيحاً;
}

// جلب
دالة getAttribute(عنصر صحيح,اسم نص) -> صحيح {
    نص قيمة="";
    قيمة=getAttribute(عنصر,اسم);
    ارجع قيمة;
}


