// إنشاء
دالة إنشاء_حالة(قيمة أولية نص) -> صحيح {
    صحيح حالة=0;
    حالة=إنشاء_حالة(قيمة أولية);
    ارجع حالة;
}

// القيمة
دالة قيمة_الحالة(حالة صحيح) -> صحيح {
    نص قيمة="";
    قيمة=قيمة_حالة(حالة);
    ارجع قيمة;
}

// تعيين
دالة عيّن_الحالة(حالة صحيح,قيمة نص) {
    عيّن_حالة(حالة,قيمة);
}

// مراقبة
دالة إضافة_مراقب(حالة صحيح,دالة نص) -> صحيح {
    إضافة_مراقب(حالة,دالة);
    ارجع صحيحاً;
}

// حذف مراقب
دالة حذف_مراقب(حالة صحيح,دالة نص) -> صحيح {
    حذف_مراقب(حالة,دالة);
    ارجع صحيحاً;
}

// ملخص
دالة ملخص_الحالة(حالة صحيح) -> صحيح {
    نص ملخص="";
    ملخص=ملخص_حالة(حالة);
    ارجع ملخص;
}

// إعادة
دالة إعادة_تعيين(حالة صحيح,قيمة نص) {
    إعادة_تعيين_حالة(حالة,قيمة);
}

// التتبع
دالة تتبع_الحالة(حالة صحيح) -> صحيح[] {
    صحيح[] تتبع=[];
    تتبع=تتبع_حالة(حالة);
    ارجع تتبع;
}

// تصدير
دالة تصدير_الحالة(حالة صحيح) -> صحيح {
    نص تصدير="";
    تصدير=تصدير_حالة(حالة);
    ارجع تصدير;
}

// استيراد
دالة استيراد_الحالة(حالة صحيح,بيانات نص) -> صحيح {
    استيراد_حالة(حالة,بيانات);
    ارجع صحيحاً;
}


