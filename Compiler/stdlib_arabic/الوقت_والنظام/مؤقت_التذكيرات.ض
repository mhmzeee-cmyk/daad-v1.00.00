// ض مكتبة: مؤقت_التذكيرات
// الفئة: الوقت_والنظام
// الوصف: مؤقت التذكيرات

// إنشاء
دالة إنشاء_تذكير(رسالة نص,تأخير صحيح) -> صحيح {
    صحيح تذكير=0;
    تذكير=إنشاء_تذكير(رسالة,تأخير);
    ارجع تذكير;
}

// إلغاء
دالة إلغاء_تذكير(تذكير صحيح) -> صحيح {
    إلغاء_تذكير(تذكير);
    ارجع صحيحاً;
}

// النشطة
دالة تذكيرات_نشطة() -> صحيح[] {
    صحيح[] تذكيرات=[];
    تذكيرات=تذكيرات_نشطة();
    ارجع تذكيرات;
}

// إعادة
دالة إعادة_تذكير(تذكير صحيح,تأخير جديد) {
    إعادة_تذكير(تذكير,تأخير_جديد);
}

// الحالة
دالة حالة_التذكير(تذكير صحيح) -> صحيح {
    صحيح حالة=0;
    حالة=حالة_تذكير(تذكير);
    ارجع حالة;
}

// تكرار
دالة تكرار_التذكير(تذكير صحيح,فترة صحيح) -> صحيح {
    تكرار_تذكير(تذكير,فترة);
    ارجع صحيحاً;
}

// إيقاف
دالة إيقاف_التكرار(تذكير صحيح) {
    إيقاف_تكرار_تذكير(تذكير);
}

// العدد
دالة عدد_التذكيرات() -> صحيح {
    صحيح عدد=0;
    عدد=عدد_تذكيرات();
    ارجع عدد;
}

// تصدير
دالة تصدير_التذكيرات(مسار نص) -> صحيح {
    تصدير_تذكيرات(مسار);
    ارجع صحيحاً;
}

// استيراد
دالة استيراد_التذكيرات(مسار نص) -> صحيح {
    استيراد_تذكيرات(مسار);
    ارجع صحيحاً;
}


