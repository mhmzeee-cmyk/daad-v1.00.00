// ض مكتبة: الوقت_والتوقيت
// الفئة: الوقت_والنظام
// الوصف: الوقت والتويقيت

// الوقت الحالي
دالة الوقت_الحالي() -> صحيح {
    صحيح الآن=0;
    الآن=احصل_وقت();
    ارجع الآن;
}

//  الطابع الزمني
دالة الطابع_الزمني() -> صحيح {
    صحيح طابع=0;
    طابع=احصل_timestamp();
    ارجع طابع;
}

// التاريخ
دالة تاريخ_اليوم() -> صحيح {
    صحيح تاريخ=0;
    تاريخ=احصل_تاريخ();
    ارجع تاريخ;
}

// وقت منفصل
دالة وقت_الآن([]) -> صحيح[] {
    صحيح[] وقت=[];
    وقت=احصل_وقت_منفصل();
    ارجع وقت;
}

//  UNIX
دالة الوقت_الـunix() -> صحيح {
    صحيح unix=0;
    unix=احصل_unix();
    ارجع unix;
}

// بالميلي ثانية
دالة الوقت_بـms() -> صحيح {
    صحيح ms=0;
    ms=احصل_ms();
    ارجع ms;
}

// بالنا نو ثانية
دالة الوقت_بـns() -> صحيح {
    صحيح ns=0;
    ns=احصل_ns();
    ارجع ns;
}

// انتظار
دالة انتظار(انتظار صحيح) -> صحيح {
    انتظار(انتظار);
    ارجع صحيحاً;
}

// إيقاظ
دالة ايقاظ(قاط صحيح) {
    ايقاظ(قاط);
}

// وقت التشغيل
دالة وقت_التشغيل() -> صحيح {
    صحيح تشغيل=0;
    تشغيل=وقت_تشغيل();
    ارجع تشغيل;
}


