// ض مكتبة: الجدولة_والمهام
// الفئة: الوقت_والنظام
// الوصف: جدولة المهام

// جدولة
دالة جدولة_مهمة(دالة نص,تأخير صحيح) -> صحيح {
    صحيح مؤقت=0;
    مؤقت=جدولة(دالة,تأخير);
    ارجع مؤقت;
}

// إلغاء
دالة إلغاء_الجدولة(مؤقت صحيح) -> صحيح {
    إلغاء(مؤقت);
    ارجع صحيحاً;
}

// الحالة
دالة دورة_حياة(مؤقت صحيح) -> صحيح {
    صحيح حالة=0;
    حالة=حالة_مؤقت(مؤقت);
    ارجع حالة;
}

// المهام
دالة مهام_معلّقة() -> صحيح[] {
    صحيح[] مهام=[];
    مهام=مهام_معلّقة();
    ارجع مهام;
}

// إعادة
دالة أعد_الجدولة(مؤقت صحيح) {
    أعد_الجدولة(مؤقت);
}

// المتبقي
دالة الوقت_المتبقي(مؤقت صحيح) -> صحيح {
    صحيح متبقي=0;
    متبقي=متبقي(مؤقت);
    ارجع متبقي;
}

// تكرار
دالة تكرار_المهمة(دالة نص,فترة صحيح) -> صحيح {
    صحيح مؤقت=0;
    مؤقت=تكرار(دالة,فترة);
    ارجع مؤقت;
}

// إيقاف
دالة إيقاف_التكرار(مؤقت صحيح) {
    إيقاف_تكرار(مؤقت);
}

// إحصائيات
دالة إحصائيات_الجدولة() -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_جدولة();
    ارجع إحصائيات;
}

// إيقاف الكل
دالة أوقف_الكل() {
    أوقف_الكل();
}


