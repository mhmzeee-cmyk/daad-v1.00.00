// ض مكتبة: العمليات_والنظام
// الفئة: الوقت_والنظام
// الوصف: إدارة العمليات

// تشغيل
دالة أطلق_عملية(برنامج نص) -> صحيح {
    صحيح pid=0;
    pid=إطلاق(برنامج);
    ارجع pid;
}

// انتهت؟
دالة انتهت_العملية(pid صحيح) -> صحيح {
    صحيح انتهت=0;
    إذا(انتهت(pid)==1){ انتهت=1; }
    ارجع انتهت;
}

// إنهاء
دالة إنهاء(pid صحيح) {
    إنهاء(pid);
}

// انتظار
دالة انتظر_العملية(pid صحيح) -> صحيح {
    انتظر(pid);
    ارجع صحيحاً;
}

// العمليات
دالة عمليات_نشطة([]) -> صحيح[] {
    صحيح[] عمليات=[];
    عمليات=عمليات_نشطة();
    ارجع عمليات;
}

// إنهاء قسري
دالة إنهاء_قسري(pid صحيح) {
    إنهاء_عملية(pid);
}

// إعادة توجيه
دالة إعادة_توجيه(pid صحيح, stdout صحيح) {
    إعادة_توجيه(pid,stdout);
}

// إنشاء أنبوب
دالة إنشاء_أنبوب() -> صحيح {
    صحيح أنبوب=0;
    أنبوب=أنبوب();
    ارجع أنبوب;
}

// المتغيرات
دالة متغيرات_النظام() -> صحيح[] {
    صحيح[] بيئة=[];
    بيئة=بيئة_نظام();
    ارجع بيئة;
}

// إنهاء الكل
دالة إنهاء_الكل() {
    إنهاء_الكل();
}


