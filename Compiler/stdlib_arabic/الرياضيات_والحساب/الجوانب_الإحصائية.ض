// المتوسط
دالة متوسط(عشري[] قيم) -> عشري {
    عشري مجموع=0.0;
    لكل(صحيح i=0;i<طول(قيم);i+=1){ مجموع+=قيم[i]; }
    إذا(طول(قيم)>0){ ارجع مجموع/طول(قيم); }
    ارجع 0.0;
}

// الوسيط
دالة وسيط(عشري[] قيم) -> عشري {
    عشري نتيجة=0.0;
    نتيجة=وسيط(قيم);
    ارجع نتيجة;
}

// التباين
دالة تباين(عشري[] قيم) -> عشري {
    عشري م=متوسط(قيم);
    عشري مجموع=0.0;
    لكل(صحيح i=0;i<طول(قيم);i+=1){ مجموع+=(قيم[i]-م)*(قيم[i]-م); }
    إذا(طول(قيم)>0){ ارجع مجموع/طول(قيم); }
    ارجع 0.0;
}

// الانحراف المعياري
دالة انحراف_معياري(عشري[] قيم) -> عشري {
    ارجع جذر(تباين(قيم));
}

// المدى
دالة مدى(عشري[] قيم) -> عشري {
    عشري أدنى=قيم[0];
    عشري أقصى=قيم[0];
    لكل(صحيح i=1;i<طول(قيم);i+=1){ إذا(قيم[i]<أدنى){ أدنى=قيم[i]; } إذا(قيم[i]>أقصى){ أقصى=قيم[i]; } }
    ارجع أقصى-أدنى;
}

// النسبة المئوية
دالة نسبة_المئوية(عشري جزء,عشري كله) -> عشري {
    إذا(كله==0.0){ ارجع 0.0; }
    ارجع (جزء/كله)*100.0;
}

// الزيادة النسبية
دالة زيادة_نسبية(عشري قديم,عشري جديد) -> عشري {
    إذا(قديم==0.0){ ارجع 0.0; }
    ارجع ((جديد-قديم)/قديم)*100.0;
}

// معامل الارتباط
دالة ارتباط(عشري[] x,عشري[] y) -> عشري {
    عشري نتيجة=0.0;
    نتيجة=معامل_ارتباط(x,y);
    ارجع نتيجة;
}

// الانحدار الخطي
دالة انحدار(عشري[] x,عشري[] y) -> عشري[] {
    عشري[] نتيجة=انحدار_خطي(x,y);
    ارجع نتيجة;
}

// المتوسط المتحرك
دالة متوسط_متحرك(عشري[] قيم,صحيح نافذة) -> عشري[] {
    عشري[] نتيجة=متحرك(قيم,نافذة);
    ارجع نتيجة;
}


