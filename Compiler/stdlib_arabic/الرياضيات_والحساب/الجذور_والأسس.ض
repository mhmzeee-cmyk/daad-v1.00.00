// الوصف: الجذور والأسس

// الجذر التربيعي
دالة جذر_تربيعي(عشري a) -> عشري {
    ارجع جذر(a);
}

// الجذر المكعب
دالة جذر_مكعب(عشري a) -> عشري {
    ارجع a^(1.0/3.0);
}

// أُس تربيعي
دالة أس_تربيعي(عشري a) -> عشري {
    ارجع a*a;
}

// أُس مكعب
دالة أس_مكعب(عشري a) -> عشري {
    ارجع a*a*a;
}

// حساب الأُس
دالة أس(عشري أصل,صحيح أس) -> عشري {
    عشري نتيجة=1.0;
    لكل(صحيح i=0;i<أس;i+=1){ نتيجة*=أصل; }
    ارجع نتيجة;
}

// الأسس العشرية
دالة أسس_عشرية(صحيح أس) -> عشري {
    عشري نتيجة=1.0;
    لكل(صحيح i=0;i<أس;i+=1){ نتيجة*=10.0; }
    ارجع نتيجة;
}

// اللوغاريتم
دالة لوغاريتم(عشري a) -> عشري {
    ارجع لn(a);
}

// لوغاريتم بأساس
دالة لوغاريتم_أساسي(عشري a,عشري أساس) -> عشري {
    ارجع لn(a)/لn(أساس);
}

// أُس E
دالة أس_e(صحيح أس) -> عشري {
    عشري نتيجة=1.0;
    لكل(صحيح i=0;i<أس;i+=1){ نتيجة*=2.71828; }
    ارجع نتيجة;
}

// الجذر nth
دالة جذر_nth(عشري a,صحيح n) -> عشري {
    ارجع a^(1.0/n);
}


