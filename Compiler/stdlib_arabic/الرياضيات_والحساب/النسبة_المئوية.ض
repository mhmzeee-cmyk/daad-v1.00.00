// ض مكتبة: النسبة_المئوية
// الفئة: الرياضيات_والحساب
// الوصف: حساب النسب

// النسبة المئوية
دالة نسبة(عشري جزء,عشري كله) -> عشري {
    إذا(كله==0.0){ ارجع 0.0; }
    ارجع (جزء/كله)*100.0;
}

// جزء من نسبة
دالة جزء(عشري نسبة,عشري كله) -> عشري {
    ارجع (نسبة/100.0)*كله;
}

// حساب الخصم
دالة خصم(عشري مبلغ,عشري نسبة_خصم) -> عشري {
    ارجع مبلغ-(مبلغ*نسبة_خصم/100.0);
}

// حساب الضريبة
دالة ضريبة(عشري مبلغ,عشري نسبة) -> عشري {
    ارجع مبلغ*نسبة/100.0;
}

// حساب الربح
دالة ربح(عشري كلفة,عشري سعر) -> عشري {
    ارجع سعر-كلفة;
}

// هامش الربح
دالة هامش_الربح(عشري كلفة,عشري سعر) -> عشري {
    إذا(كلفة==0.0){ ارجع 0.0; }
    ارجع ((سعر-كلفة)/كلفة)*100.0;
}

// مقارنة نسبتين
دالة مقارنة_نسبتين(عشري p1,عشري p2) -> صحيح {
    إذا(p1>p2){ ارجع 1; }وإلا إذا(p1<p2){ ارجع -1; }
    ارجع 0;
}

// إضافة نسبة
دالة إضافة_نسبة(عشري قيمة,عشري نسبة) -> عشري {
    ارجع قيمة+(قيمة*نسبة/100.0);
}

// النسبة التراكمية
دالة نسبة_تراكمية(عشري[] قيم) -> عشري[] {
    عشري[] نتيجة=[];
    عشري مجموع=0.0;
    لكل(صحيح i=0;i<طول(قيم);i+=1){ مجموع+=قيم[i]; نتيجة=أضف(نتيجة,مجموع); }
    ارجع نتيجة;
}

// تحويل إلى نسبة
دالة حوّل_إلى_نسبة(عشري قيمة,عشري أقصى) -> عشري {
    إذا(أقصى==0.0){ ارجع 0.0; }
    ارجع (قيمة/أقصى)*100.0;
}


