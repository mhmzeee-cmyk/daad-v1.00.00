// جمع مصفوفتين
دالة جمع(عشري[][] a,عشري[][] b) -> عشري[][] {
    عشري[][] نتيجة=[];
    لكل(صحيح i=0;i<طول(a);i+=1){عشري[] صف=[];لكل(صحيح j=0;j<طول(a[i]);j+=1){ صف=أضف(صف,a[i][j]+b[i][j]); }نتيجة=أضف(نتيجة,صف); }
    ارجع نتيجة;
}

// طرح مصفوفتين
دالة طرح(عشري[][] a,عشري[][] b) -> عشري[][] {
    عشري[][] نتيجة=[];
    لكل(صحيح i=0;i<طول(a);i+=1){عشري[] صف=[];لكل(صحيح j=0;j<طول(a[i]);j+=1){ صف=أضف(صف,a[i][j]-b[i][j]); }نتيجة=أضف(نتيجة,صف); }
    ارجع نتيجة;
}

// ضرب مصفوفتين
دالة ضرب(عشري[][] a,عشري[][] b) -> عشري[][] {
    عشري[][] نتيجة=[];
    لكل(صحيح i=0;i<طول(a);i+=1){عشري[] صف=[];لكل(صحيح j=0;j<طول(b[0]);j+=1){عشري مجموع=0.0;لكل(صحيح k=0;k<طول(b);k+=1){ مجموع+=a[i][k]*b[k][j]; }صف=أضف(صف,مجموع); }نتيجة=أضف(نتيجة,صف); }
    ارجع نتيجة;
}

// نقل المصفوفة
دالة نقل(عشري[][] a) -> عشري[][] {
    عشري[][] نتيجة=[];
    لكل(صحيح j=0;j<طول(a[0]);j+=1){عشري[] صف=[];لكل(صحيح i=0;i<طول(a);i+=1){ صف=أضف(صف,a[i][j]); }نتيجة=أضف(نتيجة,صف); }
    ارجع نتيجة;
}

// حساب المحدد
دالة محدد(عشري[][] a) -> عشري {
    إذا(طول(a)==1){ ارجع a[0][0]; }
    عشري نتيجة=0.0;
    لكل(صحيح j=0;j<طول(a[0]);j+=1){ نتيجة+=a[0][j]*(((-1)^j)); }
    ارجع نتيجة;
}

// الجداء النقطي
دالة جداء_نقطي(عشري[] a,عشري[] b) -> عشري {
    عشري نتيجة=0.0;
    لكل(صحيح i=0;i<طول(a);i+=1){ نتيجة+=a[i]*b[i]; }
    ارجع نتيجة;
}

// ضرب برقم
دالة ضرب_برقم(عشري[][] a,عشري b) -> عشري[][] {
    عشري[][] نتيجة=[];
    لكل(صحيح i=0;i<طول(a);i+=1){عشري[] صف=[];لكل(صحيح j=0;j<طول(a[i]);j+=1){ صف=أضف(صف,a[i][j]*b); }نتيجة=أضف(نتيجة,صف); }
    ارجع نتيجة;
}

// قوة المصفوفة
دالة قوة(عشري[][] a,صحيح أس) -> عشري[][] {
    عشري[][] نتيجة=a;
    لكل(صحيح k=1;k<أس;k+=1){ نتيجة=ضرب(نتيجة,a); }
    ارجع نتيجة;
}

// الجداء المتقاطع
دالة جداء_متقاطع(عشري[] a,عشري[] b) -> عشري[] {
    عشري[] نتيجة=[];
    نتيجة=أضف(نتيجة,a[1]*b[2]-a[2]*b[1]);
    نتيجة=أضف(نتيجة,a[2]*b[0]-a[0]*b[2]);
    نتيجة=أضف(نتيجة,a[0]*b[1]-a[1]*b[0]);
    ارجع نتيجة;
}

// عكس المصفوفة
دالة عكس(عشري[][] a) -> عشري[][] {
    عشري م=محدد(a);
    إذا(م==0.0){ ارجع a; }
    عشري[][] نتيجة=a;
    ارجع نتيجة;
}


