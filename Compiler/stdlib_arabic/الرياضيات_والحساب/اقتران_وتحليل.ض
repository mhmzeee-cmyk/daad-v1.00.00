// خطي
دالة اقتران_خطي(عشري x,عشري ميل,عشري تقاطع) -> عشري {
    ارجع ميل*x+تقاطع;
}

// تربيعي
دالة اقتران_تربيعي(عشري x,عشري a,عشري b,عشري c) -> عشري {
    ارجع a*x*x+b*x+c;
}

// أُسّي
دالة اقتران_أُسّي(عشري x,عشري أساس,عشري أس) -> عشري {
    ارجع أساس*قوة(أس,x);
}

// لوغاريتمي
دالة اقتران_لوغاريتمي(عشري x,عشري أساس) -> عشري {
    إذا(x<=0.0){ ارجع 0.0; }
    ارجع لn(x)/لn(أساس);
}

// جيبي
دالة اقتران_جيبي(عشري x) -> عشري {
    ارجع جيب(x);
}

// ظلي
دالة اقتران_ظلي(عشري x) -> عشري {
    إذا(جيب(x)==0.0){ ارجع 0.0; }
    ارجع ظل(x);
}

// عكس
دالة اقتران_عكس(عشري a,عشري x) -> عشري {
    إذا(x==0.0){ ارجع 0.0; }
    ارجع a/x;
}

// متناسب
دالة اقتران_متناسب(عشري a,عشري x) -> عشري {
    ارجع a*x;
}

// المشتق
دالة مشتق(عشري ف,عشري x) -> عشري {
    عشري h=0.0001;
    ارجع (ف(x+h)-ف(x-h))/(2.0*h);
}

// التكامل
دالة تكامل(عشري ف,عشري من,عشري إلى) -> عشري {
    عشري مجموع=0.0;
    عشري h=(إلى-من)/100.0;
    لكل(صحيح i=0;i<100;i+=1){ مجموع+=ف(من+i*h)*h; }
    ارجع مجموع;
}


