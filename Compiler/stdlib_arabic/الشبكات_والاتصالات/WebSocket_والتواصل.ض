// ض مكتبة: WebSocket_والتواصل
// الفئة: الشبكات_والاتصالات
// الوصف: WebSocket

// إنشاء
دالة إنشاء_WebSocket(عنوان نص) -> صحيح {
    صحيح ws=0;
    ws=إنشاء_WebSocket(عنوان);
    ارجع ws;
}

// اتصال
دالة اتصال_WebSocket(ws صحيح) -> صحيح {
    اتصال_WebSocket(ws);
    ارجع صحيحاً;
}

// إرسال
دالة أرسل_WebSocket(ws صحيح,بيانات نص) -> صحيح {
    أرسل_WebSocket(ws,بيانات);
    ارجع صحيحاً;
}

// استقبال
دالة استقبل_WebSocket(ws صحيح) -> صحيح {
    نص بيانات="";
    بيانات=استقبل_WebSocket(ws);
    ارجع بيانات;
}

// إغلاق
دالة اغلق_WebSocket(ws صحيح) {
    اغلق_WebSocket(ws);
}

// الحالة
دالة حالة_WebSocket(ws صحيح) -> صحيح {
    صحيح حالة=0;
    حالة=حالة_WebSocket(ws);
    ارجع حالة;
}

// إرسال ثنائي
دالة أرسل_ثنائي(ws صحيح,بيانات صحيح[]) -> صحيح {
    أرسل_ثنائي(ws,بيانات);
    ارجع صحيحاً;
}

// حدث
دالة حدث_WebSocket(ws صحيح,نوع نص,دالة نص) -> صحيح {
    حدث_WebSocket(ws,نوع,دالة);
    ارجع صحيحاً;
}

// ping
دالة ping_WebSocket(ws صحيح) -> صحيح {
    ping_WebSocket(ws);
    ارجع صحيحاً;
}

// إحصائيات
دالة إحصائيات_WebSocket(ws صحيح) -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_WebSocket(ws);
    ارجع إحصائيات;
}


