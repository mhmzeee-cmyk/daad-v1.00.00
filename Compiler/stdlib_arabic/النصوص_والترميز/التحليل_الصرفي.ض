// ض مكتبة: التحليل_الصرفي
// الفئة: النصوص_والترميز
// الوصف: التحليل اللغوي

// عدد الكلمات
دالة عدّ_الكلمات(نص s) -> صحيح {
    صحيح عدد=عدّ(فصل(s," "));
    ارجع عدد;
}

// عدد الحروف
دالة عدّ_الحروف(نص s) -> صحيح {
    صحيح عدد=طول(s);
    ارجع عدد;
}

// عدد السطور
دالة عدّ_السطور(نص s) -> صحيح {
    صحيح عدد=عدّ(فصل(s,"\n"));
    ارجع عدد;
}

// الكلمات
دالة احصل_على_الكلمات(نص s) -> صحيح[] {
    صحيح[] كلمات=فصل(s," ");
    ارجع كلمات;
}

// الأحرف الفريدة
دالة احصل_على_الأحرف(نص s) -> صحيح[] {
    صحيح[] أحرف=فريدة(fصل(s,""));
    ارجع أحرف;
}

// التحقق من الإملاء
دالة تحقق_من_الإملاء(صحيح s) -> صحيح {
    صحيح صحيح=1;
    إذا(طول(s)==0){ صحيح=0; }
    ارجع صحيح;
}

// اقتراح تصحيح
دالة اقترح_تصحيح(صحيح s) -> صحيح {
    صحيح اقتراح=تصحيح(s);
    ارجع اقتراح;
}

// تحليل النحو
دالة تحليل_النحو(صحيح s) -> صحيح[] {
    صحيح[] تحليل=تحديد(s);
    ارجع تحليل;
}

// الجذور اللغوية
دالة استخرج_الجذور(صحيح s) -> صحيح[] {
    صحيح[] جذور=جذور(s);
    ارجع جذور;
}

// إحصائيات
دالة احصل_على_إحصائيات(صحيح s) -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=أضف(إحصائيات,عدّ_الكلمات(s));
    إحصائيات=أضف(إحصائيات,عدّ_الحروف(s));
    إحصائيات=أضف(إحصائيات,عدّ_السطور(s));
    ارجع إحصائيات;
}


