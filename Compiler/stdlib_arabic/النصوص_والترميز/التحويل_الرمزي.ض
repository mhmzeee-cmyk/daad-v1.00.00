// ض مكتبة: التحويل_الرمزي
// الفئة: النصوص_والترميز
// الوصف: تحويل الترميزات

// لـ UTF-8
دالة تحويل_utf8(بيانات صحيح[]) -> صحيح {
    صحيح ناتج=تحويل(بيانات,"utf-8");
    ارجع ناتج;
}

// لـ UTF-16
دالة تحويل_utf16(بيانات صحيح[]) -> صحيح {
    صحيح ناتج=تحويل(بيانات,"utf-16");
    ارجع ناتج;
}

// لـ ASCII
دالة تحويل_ascii(نص s) -> صحيح[] {
    صحيح[] بيانات=إلى_ascii(s);
    ارجع بيانات;
}

// لـ Unicode
دالة تحويل_unicode(نص s) -> صحيح[] {
    صحيح[] بيانات=إلى_unicode(s);
    ارجع بيانات;
}

// اكتشاف الترميز
دالة احصل_على_ترميز(نص s) -> صحيح {
    صحيح ترميز=تحديد_ترميز(s);
    ارجع ترميز;
}

// بين الترميزات
دالة حوّل_الترميز(نص s,من نص,إلى نص) -> صحيح {
    صحيح محول=تحويل(s,من,إلى);
    ارجع محول;
}

// تحليل البايتات
دالة حلل_البايت(صحيح[] بيانات) -> صحيح[] {
    صحيح[] نتائج=تحليل_بايت(بيانات);
    ارجع نتائج;
}

// دمج البايتات
دالة ادمج_البايت(صحيح[] أجزاء) -> صحيح[] {
    صحيح[] مدمج=دمج(أجزاء);
    ارجع مدمج;
}

// فصل البايتات
دالة فصل_البايت(صحيح بيانات,حجم صحيح) -> صحيح[] {
    صحيح[] مقسّم=فصل_بايت(بيانات,حجم);
    ارجع مقسّم;
}

// هل صحيح؟
دالة تحقق_من_الترميز(نص s) -> صحيح {
    صحيح صحيح=صالح(s);
    ارجع صحيح;
}


