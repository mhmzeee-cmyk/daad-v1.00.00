// ض مكتبة: التشفير_والترميز
// الفئة: النصوص_والترميز
// الوصف: التشفير والترميز

// تشفير base64
دالة تشفير_64(نص s) -> صحيح {
    صحيح مشفر=تشفير_base64(s);
    ارجع مشفر;
}

// فك base64
دالة فك_تشفير_64(نص s) -> صحيح {
    صحيح أصلي=فك_base64(s);
    ارجع أصلي;
}

// تشفير MD5
دالة تشفير_md5(نص s) -> صحيح {
    صحيح مشفر=تشفير_md5(s);
    ارجع مشفر;
}

// تشفير SHA256
دالة تشفير_sha256(نص s) -> صحيح {
    صحيح مشفر=تشفير_sha256(s);
    ارجع مشفر;
}

// تشفير بإزاحة
دالة تشفير_بسيط(نص s,مفتاح صحيح) -> صحيح {
    صحيح مشفر=إزاحة(s,مفتاح);
    ارجع مشفر;
}

// فك بإزاحة
دالة فك_تشفير_بسيط(نص s,مفتاح صحيح) -> صحيح {
    صحيح أصلي=عكس_إزاحة(s,مفتاح);
    ارجع أصلي;
}

// توليد مفتاح
دالة توليد_مفتاح(طول صحيح) -> صحيح {
    صحيح مفتاح=عشوائي(0,255);
    ارجع مفتاح;
}

// تشفير AES
دالة تشفير_aes(نص s,مفتاح نص) -> صحيح {
    صحيح مشفر=تشفير_aes(s,مفتاح);
    ارجع مشفر;
}

// فك AES
دالة فك_تشفير_aes(نص s,مفتاح نص) -> صحيح {
    صحيح أصلي=فك_aes(s,مفتاح);
    ارجع أصلي;
}

// تشفير SHA1
دالة تشفير_sha1(نص s) -> صحيح {
    صحيح مشفر=تشفير_sha1(s);
    ارجع مشفر;
}


