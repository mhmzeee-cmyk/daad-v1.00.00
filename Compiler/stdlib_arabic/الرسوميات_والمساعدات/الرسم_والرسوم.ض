// الوصف: الرسم

// إنشاء لوحة
دالة إنشاء_لوحة(صحيح عرض,صحيح ارتفاع) -> صحيح {
    صحيح لوحة=0;
    لوحة=إنشاء_لوحة(عرض,ارتفاع);
    ارجع لوحة;
}

// خط
دالة ارسم_خط(لوحة صحيح,x1 صحيح,y1 صحيح,x2 صحيح,y2 صحيح,لون صحيح) -> صحيح {
    ارسم_خط(لوحة,x1,y1,x2,y2,لون);
    ارجع صحيحاً;
}

// مستطيل
دالة ارسم_مستطيل(لوحة صحيح,x صحيح,y صحيح,عرض صحيح,ارتفاع صحيح,لون صحيح) -> صحيح {
    ارسم_مستطيل(لوحة,x,y,عرض,ارتفاع,لون);
    ارجع صحيحاً;
}

// دائرة
دالة ارسم_دائرة(لوحة صحيح,x صحيح,y صحيح,نصف_قطر صحيح,لون صحيح) -> صحيح {
    ارسم_دائرة(لوحة,x,y,نصف_قطر,لون);
    ارجع صحيحاً;
}

// نص
دالة ارسم_نص(لوحة صحيح,x صحيح,y صحيح,نص نص,حجم صحيح,لون صحيح) -> صحيح {
    ارسم_نص(لوحة,x,y,نص,حجم,لون);
    ارجع صحيحاً;
}

// ملء
دالة ملء_لوحة(لوحة صحيح,لون صحيح) {
    ملء(لوحة,لون);
}

// حفظ
دالة احفظ_لوحة(لوحة صحيح,مسار نص) -> صحيح {
    احفظ(لوحة,مسار);
    ارجع صحيحاً;
}

// تحميل
دالة تحميل_صورة(مسار نص) -> صحيح {
    صحيح صورة=0;
    صورة=تحميل(مسار);
    ارجع صورة;
}

// عرض
دالة عرض_اللوحة(لوحة صحيح) {
    عرض(لوحة);
}

// مسح
دالة مسح_اللوحة(لوحة صحيح) {
    مسح(لوحة);
}


