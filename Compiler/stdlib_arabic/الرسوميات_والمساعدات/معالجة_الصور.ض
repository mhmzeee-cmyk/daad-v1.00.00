// تصغير
دالة تصغير(صورة صحيح,صحيح عرض,صحيح ارتفاع) -> صحيح {
    صحيح صورة2=0;
    صورة2=تصغير(صورة,عرض,ارتفاع);
    ارجع صورة2;
}

// تكبير
دالة تكبير(صورة صحيح,صحيح عرض,صحيح ارتفاع) -> صحيح {
    صحيح صورة2=0;
    صورة2=تكبير(صورة,عرض,ارتفاع);
    ارجع صورة2;
}

// دوران
دالة دوران(صورة صحيح,عشري زاوية) -> صحيح {
    صحيح صورة2=0;
    صورة2=دوران(صورة,زاوية);
    ارجع صورة2;
}

// قص
دالة قص(صورة صحيح,x صحيح,y صحيح,عرض صحيح,ارتفاع صحيح) -> صحيح {
    صحيح صورة2=0;
    صورة2=قص(صورة,x,y,عرض,ارتفاع);
    ارجع صورة2;
}

// فلتر
دالة  filtre(صورة صحيح,نوع نص) -> صحيح {
    صحيح صورة2=0;
    صورة2= filtre(صورة,نوع);
    ارجع صورة2;
}

// تعديل
دالة  تعديل_اللون(صورة صحيح,تشبع صحيح,سطوع صحيح) -> صحيح {
    صحيح صورة2=0;
    صورة2=تعديل_اللون(صورة,تشبع,سطوع);
    ارجع صورة2;
}

// طمس
دالة طمس(صورة صحيح,صحيح حجم) -> صحيح {
    صحيح صورة2=0;
    صورة2=طمس(صورة,حجم);
    ارجع صورة2;
}

// كشف الحواف
دالة كشف_الحواف(صورة صحيح) -> صحيح {
    صحيح صورة2=0;
    صورة2=كشف_الحواف(صورة);
    ارجع صورة2;
}

// تحويل
دالة تحويل_الصيغة(صورة صحيح,صيغة نص) -> صحيح {
    تحويل_صيغة(صورة,صيغة);
    ارجع صحيحاً;
}

// المعلومات
دالة معلومات_الصورة(صورة صحيح) -> صحيح[] {
    صحيح[] معلومات=[];
    معلومات=معلومات_صورة(صورة);
    ارجع معلومات;
}


