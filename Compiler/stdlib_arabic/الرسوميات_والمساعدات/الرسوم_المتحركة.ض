// إنشاء
دالة إنشاء_رسوم(دالة نص) -> صحيح {
    صحيح رسوم=0;
    رسوم=إنشاء_رسوم(دالة);
    ارجع رسوم;
}

// بدء
دالة بدء_الرسوم(رسوم صحيح) {
    بدء_رسوم(رسوم);
}

// إيقاف
دالة إيقاف_الرسوم(رسوم صحيح) {
    إيقاف_رسوم(رسوم);
}

// السرعة
دالة  سرعة_الرسوم(رسوم صحيح,صحيح fps) -> صحيح {
    سرعة_رسوم(رسوم,fps);
    ارجع صحيحاً;
}

// الإطار
دالة إطار_الرسوم(رسوم صحيح) -> صحيح {
    صحيح إطار=0;
    إطار=إطار_رسوم(رسوم);
    ارجع إطار;
}

// إضافة مفتاح
دالة إضافة_مفتاح(رسوم صحيح,صحيح مفتاح,دالة نص) -> صحيح {
    إضافة_مفتاح_رسوم(رسوم,مفتاح,دالة);
    ارجع صحيحاً;
}

// التتبع
دالة تتبع_الرسوم(رسوم صحيح) -> صحيح {
    صحيح تتبع=0;
    تتبع=تتبع_رسوم(رسوم);
    ارجع تتبع;
}

// الحالة
دالة  حالة_الرسوم(رسوم صحيح) -> صحيح {
    صحيح حالة=0;
    حالة=حالة_رسوم(رسوم);
    ارجع حالة;
}

// ثابت
دالة إطار_رسوم_ثابت(رسوم صحيح,صحيح fps) -> صحيح {
    إطار_ثابت(رسوم,fps);
