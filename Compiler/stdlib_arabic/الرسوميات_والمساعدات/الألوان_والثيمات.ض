// إنشاء لون
دالة إنشاء_لون(صحيح r,صحيح g,صحيح b,صحيح a) -> صحيح {
    صحيح لون=0;
    لون=إنشاء_لون(r,g,b,a);
    ارجع لون;
}

// من HEX
دالة من_نص(نص s) -> صحيح {
    صحيح لون=0;
    لون=من_hex(s);
    ارجع لون;
}

// إلى HEX
دالة إلى_hex(لون صحيح) -> صحيح {
    نص hex="";
    hex=إلى_hex(لون);
    ارجع hex;
}

// خلط
دالة خلط(لون a,لون b,عشري نسبة) -> صحيح {
    صحيح لون=0;
    لون=خلط(a,b,نسبة);
    ارجع لون;
}

// تدرّج
دالة تدرّج(لون من,لون إلى,صحيح عدد) -> صحيح[] {
    صحيح[] تدرج=[];
    تدرج=تدرّج(من,إلى,عدد);
    ارجع تدرج;
}

// إضاءة
دالة إضاءة(لون صحيح,عشري نسبة) -> صحيح {
    صحيح لون=0;
    لون=إضاءة(لون,نسبة);
    ارجع لون;
}

// تعتيم
دالة ت_عتام(لون صحيح,عشري نسبة) -> صحيح {
    صحيح لون=0;
    لون=ت_عتام(لون,نسبة);
    ارجع لون;
}

// تشبع
دالة تغيير_التشبع(لون صحيح,عشري نسبة) -> صحيح {
    صحيح لون=0;
    لون=تغيير_التشبع(لون,نسبة);
    ارجع لون;
}

// عشوائي
دالة عشوائي_لون() -> صحيح {
    صحيح لون=0;
    لون=عشوائي_لون();
    ارجع لون;
}

// مقارنة
دالة مقارنة_اللون(لون a,لون b) -> صحيح {
    صحيح نتيجة=0;
    نتيجة=مقارنة_ألوان(a,b);
    ارجع نتيجة;
}


