// الوصف: الهجرة

// إنشاء هجرة
دالة إنشاء_هجرة(اسم نص,استعلام نص) -> صحيح {
    صحيح هجرة=0;
    هجرة=إنشاء_هجرة(اسم,استعلام);
    ارجع هجرة;
}

// تنفيذ
دالة نفّذ_هجرة(قاعدة صحيح,هجرة صحيح) -> صحيح {
    نفّذ_هجرة(قاعدة,هجرة);
    ارجع صحيحاً;
}

// إلغاء
دالة إلغاء_هجرة(قاعدة صحيح,هجرة صحيح) -> صحيح {
    إلغاء_هجرة(قاعدة,هجرة);
    ارجع صحيحاً;
}

// المعلّقة
دالة هجرات_معلّقة(قاعدة صحيح) -> صحيح[] {
    صحيح[] معلّقة=[];
    معلّقة=هجرات_معلّقة(قاعدة);
    ارجع معلّقة;
}

// السجل
دالة سجل_الهجرات(قاعدة صحيح) -> صحيح[] {
    صحيح[] سجل=[];
    سجل=سجل_هجرات(قاعدة);
    ارجع سجل;
}

// إحصائيات
دالة إحصائيات_الهجرات(قاعدة صحيح) -> صحيح {
    صحيح إحصائيات=0;
    إحصائيات=إحصائيات_هجرات(قاعدة);
    ارجع إحصائيات;
}

// تلقائي
دالة هجرة_تلقائية(قاعدة صحيح) -> صحيح {
    هجرة_تلقائية(قاعدة);
    ارجع صحيحاً;
}

// التحقق
دالة تحقق_من_الهجرات(قاعدة صحيح) -> صحيح {
    صحيح سليمة=0;
    إذا(تحقق_هجرات(قاعدة)==1){ سليمة=1; }
    ارجع سليمة;
}

// نسخ
دالة نسخ_البيانات(قاعدة صحيح,جدول نص,مسار نص) -> صحيح {
    نسخ_بيانات(قاعدة,جدول,مسار);
    ارجع صحيحاً;
}

// استعادة
دالة استعادة_البيانات(قاعدة صحيح,جدول نص,مسار نص) -> صحيح {
    استعادة_بيانات(قاعدة,جدول,مسار);
    ارجع صحيحاً;
}


