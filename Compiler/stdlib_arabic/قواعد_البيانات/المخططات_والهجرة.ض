// الوصف: المخططات

// إنشاء مخطط
دالة إنشاء_مخطط(اسم نص) -> صحيح {
    صحيح مخطط=0;
    مخطط=إنشاء_مخطط(اسم);
    ارجع مخطط;
}

// إضافة جدول
دالة إضافة_جدول_للمخطط(مخطط صحيح,جدول نص,أعمدة نص) -> صحيح {
    إضافة_جدول_مخطط(مخطط,جدول,أعمدة);
    ارجع صحيحاً;
}

// حذف جدول
دالة حذف_جدول_من_المخطط(مخطط صحيح,جدول نص) -> صحيح {
    حذف_جدول_مخطط(مخطط,جدول);
    ارجع صحيحاً;
}

// تطبيق
دالة تطبيق_المخطط(قاعدة صحيح,مخطط صحيح) -> صحيح {
    تطبيق_مخطط(قاعدة,مخطط);
    ارجع صحيحاً;
}

// إلغاء
دالة إلغاء_المخطط(قاعدة صحيح,مخطط صحيح) -> صحيح {
    إلغاء_مخطط(قاعدة,مخطط);
    ارجع صحيحاً;
}

// مقارنة
دالة مقارنة_المخطط(قاعدة صحيح,مخطط صحيح) -> صحيح {
    صحيح مطابق=0;
    إذا(مقارنة_مخطط(قاعدة,مخطط)==1){ مطابق=1; }
    ارجع مطابق;
}

// تصدير
دالة تصدير_المخطط(مخطط صحيح,مسار نص) -> صحيح {
    تصدير_مخطط(مخطط,مسار);
    ارجع صحيحاً;
}

// استيراد
دالة استيراد_المخطط(مسار نص) -> صحيح {
    صحيح مخطط=0;
    مخطط=استيراد_مخطط(مسار);
    ارجع مخطط;
}

// إحصائيات
دالة إحصائيات_المخطط(مخطط صحيح) -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_مخطط(مخطط);
    ارجع إحصائيات;
}

// رقم الإصدار
دالة الإصدار(قاعدة صحيح) -> صحيح {
    صحيح إصدار=0;
    إصدار=إصدار_المخطط(قاعدة);
    ارجع إصدار;
}


