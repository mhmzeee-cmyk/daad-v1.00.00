// ض مكتبة: الـ Semaphores
// الفئة: الالتزامن_وتعدد_المهام
// الوصف: المؤشرات

// إنشاء
دالة إنشاء_semaphore(صحيح قيمة) -> صحيح {
    صحيح semaphore=0;
    semaphore=إنشاء_semaphore(قيمة);
    ارجع semaphore;
}

// انتظار
دالة انتظار(semaphore صحيح) {
    انتظر_semaphore(semaphore);
}

// إشارة
دالة إشارة(semaphore صحيح) {
    إشارة_semaphore(semaphore);
}

// محاولة
دالة محاولة_semaphore(semaphore صحيح) -> صحيح {
    صحيح نجاح=0;
    نجاح=حاول_semaphore(semaphore);
    ارجع نجاح;
}

// القيمة
دالة قيمة_semaphore(semaphore صحيح) -> صحيح {
    صحيح قيمة=0;
    قيمة=قيمة_semaphore(semaphore);
    ارجع قيمة;
}

// إعادة
دالة إعادة_تعيين_semaphore(semaphore صحيح,صحيح قيمة) {
    إعادة_تعيين_semaphore(semaphore,قيمة);
}

// إنشاء barrier
دالة إنشاء_bar(صحيح عدد) -> صحيح {
    صحيح bar=0;
    bar=إنشاء_bar(عدد);
    ارجع bar;
}

// انتظار
دالة انتظر_bar(bar صحيح) {
    انتظر_bar(bar);
}

// إعادة
دالة إعادة_تعيين_bar(bar صحيح) {
    إعادة_تعيين_bar(bar);
}

// الإجمالي
دالة إجمالي_bar(bar صحيح) -> صحيح {
    صحيح إجمالي=0;
    إجمالي=إجمالي_bar(bar);
    ارجع إجمالي;
}


