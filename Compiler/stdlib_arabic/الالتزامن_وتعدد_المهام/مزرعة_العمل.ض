    ارجع حجم;
}

// النشطة
دالة مهام_نشطة(مزرعة صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=مهام_نشطة(مزرعة);
    ارجع عدد;
}

// إحصائيات
دالة إحصائيات_المزرعة(مزرعة صحيح) -> صحيح[] {
    صحيح[] إحصائيات=[];
