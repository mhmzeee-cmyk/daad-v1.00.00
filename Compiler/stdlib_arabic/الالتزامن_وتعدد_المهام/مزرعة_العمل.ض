// إرسال
دالة إرسال_للمزرعة(مزرعة صحيح,دالة نص,بيانات نص) -> صحيح {
    صحيح مهمة=0;
    مهمة=إرسال_مزرعة(مزرعة,دالة,بيانات);
    ارجع مهمة;
}

// انتظار
دالة انتظار_المزرعة(مزرعة صحيح,مهمة صحيح) -> صحيح {
    صحيح نتيجة=0;
    نتيجة=انتظار_مزرعة(مزرعة,مهمة);
    ارجع نتيجة;
}

// إلغاء
دالة إلغاء_المهمة(مزرعة صحيح,مهمة صحيح) -> صحيح {
    إلغاء_مهمة(مزرعة,مهمة);
    ارجع صحيحاً;
}

// الحجم
