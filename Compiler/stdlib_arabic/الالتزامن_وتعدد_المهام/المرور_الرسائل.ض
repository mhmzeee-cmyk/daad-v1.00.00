// إنشاء قناة
دالة إنشاء_قناة(صحيح حجم) -> صحيح {
    صحيح قناة=0;
    قناة=إنشاء_قناة(حجم);
    ارجع قناة;
}

// إرسال
دالة أرسل_لقناة(قناة صحيح,رسالة نص) -> صحيح {
    أرسل_قناة(قناة,رسالة);
    ارجع صحيحاً;
}

// استقبال
دالة استقبل_من_القناة(قناة صحيح) -> صحيح {
    نص رسالة="";
    رسالة=استقبل_قناة(قناة);
    ارجع رسالة;
}

// إغلاق
دالة إغلاق_القناة(قناة صحيح) {
    إغلاق_قناة(قناة);
}

// الحجم
دالة حجم_القناة(قناة صحيح) -> صحيح {
    صحيح حجم=0;
    حجم=حجم_قناة(قناة);
    ارجع حجم;
}

// فارغة؟
دالة فارغة_القناة(قناة صحيح) -> صحيح {
    صحيح فارغة=0;
    إذا(هل_فارغة(قناة)==1){ فارغة=1; }
    ارجع فارغة;
}

// إنشاء
دالة إنشاء_قناة_متعددة(صحيح عدد,صحيح حجم) -> صحيح {
    صحيح قناة=0;
    قناة=إنشاء_قناة_متعددة(عدد,حجم);
    ارجع قناة;
}

// إرسال متعدد
دالة إرسال_متعدد(قناة صحيح,رسالة نص) -> صحيح {
    إرسال_متعدد(قناة,رسالة);
    ارجع صحيحاً;
}

// استقبال متعدد
دالة استقبال_متعدد(قناة صحيح) -> صحيح {
    نص رسالة="";
    رسالة=استقبال_متعدد(قناة);
    ارجع رسالة;
}

// الإحصائيات
دالة إحصائيات_القنوات() -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_قنوات();
    ارجع إحصائيات;
}


