// ض مكتبة: الألوان_والتنسيق
// الفئة: المدخلات_والمخرجات
// الوصف: تنسيق النصوص

// تنسيق بلون
دالة نص_ملون(نص text,لون color) -> صحيح {
    نص منسق=color+text+"\033[0m";
    ارجع منسق;
}

// تنسيق بعريض
دالة نص_عريض(نص text) -> صحيح {
    نص منسق="\033[1m"+text+"\033[0m";
    ارجع منسق;
}

// تنسيق بمائل
دالة نص_مائل(نص text) -> صحيح {
    نص منسق="\033[3m"+text+"\033[0m";
    ارجع منسق;
}

// تحت خط
دالة نص_تحته_خط(نص text) -> صحيح {
    نص منسق="\033[4m"+text+"\033[0m";
    ارجع منسق;
}

// الأحمر
دالة احمر() -> نص {
    ارجع "\033[31m";
}

// الأخضر
دالة أخضر() -> نص {
    ارجع "\033[32m";
}

// الأزرق
دالة أزرق() -> نص {
    ارجع "\033[34m";
}

// الأصفر
دالة أصفر() -> نص {
    ارجع "\033[33m";
}

// إعادة تعيين
دالة إعادة_تعيين() -> نص {
    ارجع "\033[0m";
}

// خلفية ملونة
دالة نص_خلفية(نص text,لون bg) -> صحيح {
    نص منسق=bg+text+"\033[0m";
    ارجع منسق;
}


