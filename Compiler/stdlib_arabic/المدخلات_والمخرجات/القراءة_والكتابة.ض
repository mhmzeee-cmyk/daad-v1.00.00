// الوصف: قراءة وكتابة الم ملفات

// قراءة محتوى ملف
دالة اقرأ_ملف(مسار نص) -> صحيح {
    نص محتوى="";
    صحيح ملف=افتح(مسار,0);
    طالما(ليس_نهاية(ملف)){
      محتوى+=اقرأ_سطر(ملف);
    }
    أغلق(ملف);
    ارجع محتوى;
}

// كتابة لملف
دالة اكتب_لملف(مسار نص,محتوى نص) -> صحيح {
    صحيح ملف=افتح(مسار,1);
    اكتب_سطر(ملف,محتوى);
    أغلق(ملف);
    ارجع صحيحاً;
}

// التحقق من وجود ملف
دالة ملف_موجود(مسار نص) -> صحيح {
    صحيح موجود=0;
    إذا(مسار!=""){ موجود=1; }
    ارجع موجود;
}

// حذف ملف
دالة احذف_ملف(مسار نص) -> صحيح {
    حذف(مسار);
    ارجع صحيحاً;
}

// نسخ ملف
دالة انسخ_ملف(مصدر نص,وجهة نص) -> صحيح {
    نسخ(مصدر,وجهة);
    ارجع صحيحاً;
}

// حجم ملف
دالة حجم_الملف(مسار نص) -> صحيح {
    صحيح حجم=0;
    حجم=احصل_حجم(مسار);
    ارجع حجم;
}

// إعادة تسمية
دالة إعادة_التسمية(قديم نص,جديد نص) -> صحيح {
    إعادة_تسمية(قديم,جديد);
    ارجع صحيحاً;
}

// إنشاء ملف فارغ
دالة إنشاء_ملف(مسار نص) -> صحيح {
    صحيح ملف=افتح(مسار,2);
    أغلق(ملف);
    ارجع صحيحاً;
}

// وجود مجلد
دالة مجلد_موجود(مسار نص) -> صحيح {
    صحيح موجود=0;
    إذا(مسار!=""){ موجود=1; }
    ارجع موجود;
}

// الامتداد صحيح
دالة امتداد_صحيح(مسار نص) -> صحيح {
    صحيح صحيح=0;
    إذا(يحتوي(مسار,".")){ صحيح=1; }
    ارجع صحيح;
}


