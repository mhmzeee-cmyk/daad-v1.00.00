// الفئة: المدخلات_والمخرجات
// الوصف: البحث في الملفات

// بحث في ملف
دالة ابحث_في_ملف(مسار نص,نص_بحث نص) -> صحيح {
    صحيح وُجد=0;
    صحيح ملف=افتح(مسار,0);
    طالما(ليس_نهاية(ملف)){ نص سطر=اقرأ_سطر(ملف); إذا(يحتوي(سطر,نص_بحث)){ وُجد=1; } }
    أغلق(ملف);
    ارجع وُجد;
}

// سطور مطابقة
دالة احصل_على_السطور(مسار نص,نص_بحث نص) -> صحيح[] {
    صحيح[] سطور=[];
    صحيح ملف=افتح(مسار,0);
    صحيح رقم=1;
    طالما(ليس_نهاية(ملف)){ نص سطر=اقرأ_سطر(ملف); إذا(يحتوي(سطر,نص_بحث)){ سطور=أضف(سطور,رقم); } رقم+=1; }
    ارجع سطور;
}

// استبدال في ملف
دالة استبدل_في_ملف(مسار نص,قديم نص,جديد نص) -> صحيح {
    صحيح ملف=افتح(مسار,1);
    نص محتوى=اقرأ_ملف(مسار);
    محتوى=استبدل(محتوى,قديم,جديد);
    اكتب_ملف(ملف,محتوى);
    أغلق(ملف);
    ارجع صحيحاً;
}

// عدد التكرارات
دالة عدد_التكرارات(مسار نص,نص_بحث نص) -> صحيح {
    صحيح عدد=0;
    صحيح ملف=افتح(مسار,0);
    طالما(ليس_نهاية(ملف)){ نص سطر=اقرأ_سطر(ملف); عدد+=عدّ_تكرار(سطر,نص_بحث); }
    ارجع عدد;
}

// سياق السطر
دالة احصل_على_السياق(مسار نص,سطر صحيح) -> صحيح {
    نص سياق="";
    صحيح ملف=افتح(مسار,0);
    صحيح رقم=1;
    طالما(ليس_نهاية(ملف)){ نص ب=اقرأ_سطر(ملف); إذا(رقم==سطر){ سياق=ب; } رقم+=1; }
    ارجع سياق;
}

// تحليل ملف
دالة حلل_ملف(مسار نص) {
    سجّل("تحليل "+مسار);
    نص محتوى=اقرأ_ملف(مسار);
}

// إحصائيات
دالة احصل_على_إحصائيات(مسار نص) -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=أضف(إحصائيات,حجم_الملف(مسار));
    ارجع إحصائيات;
}

// تصدير
دالة صدّر_النتائج(نتائج نص[],مسار نص) {
    صحيح ملف=افتح(مسار,1);
    لكل(صحيح i=0;i<طول(نتائج);i+=1){ اكتب_سطر(ملف,نتائج[i]); }
    غلق(ملف);
}

// بحث في مجلد
دالة بحث_متعدد(مجلد نص,نص_بحث نص) -> صحيح[] {
    صحيح[] نتائج=[];
    نص[] ملفات=محتويات(مجلد);
    لكل(صحيح i=0;i<طول(ملفات);i+=1){ إذا(ابحث_ملف(ملفات[i],نص_بحث)==1){ نتائج=أضف(نتائج,i); } }
    ارجع نتائج;
}

// بحث بنمط
دالة بحث_منتظم(مسار نص,نمط نص) -> صحيح {
    صحيح وُجد=0;
    إذا(تطابق(اقرأ_ملف(مسار),نمط)==1){ وُجد=1; }
    ارجع وُجد;
}


