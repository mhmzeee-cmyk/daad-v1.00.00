// ض مكتبة: ضغط_واستخراج
// الفئة: المدخلات_والمخرجات
// الوصف: ضغط واستخراج

// ضغط ملف
دالة اضغط_ملف(مسار نص) -> صحيح {
    ضغط(مسار);
    ارجع صحيحاً;
}

// استخراج ملف
دالة استخرج_ملف(مسار نص) -> صحيح {
    استخرج(مسار);
    ارجع صحيحاً;
}

// ضغط مجلد
دالة اضغط_مجلد(مسار نص) -> صحيح {
    اضغط_كل(مسار);
    ارجع صحيحاً;
}

// نسبة الضغط
دالة نسبة_الضغط(مسار نص) -> عشري {
    عشري نسبة=0.0;
    نسبة=حساب_نسبة(مسار);
    ارجع نسبة;
}

// سلامة الأرشيف
دالة تحقق_من_الأرشيف(مسار نص) -> صحيح {
    صحيح سليم=0;
    إذا(تحقق(مسار)==1){ سليم=1; }
    ارجع سليم;
}

// محتويات الأرشيف
دالة احصل_على_المحتويات(مسار نص) -> صحيح[] {
    صحيح[] محتوى=[];
    محتوى=فهرس(مسار);
    ارجع محتوى;
}

// ضغط محمي
دالة اضغط_بكلمة_مرور(مسار نص,كلمة_مرور نص) -> صحيح {
    اضغط_محمي(مسار,كلمة_مرور);
    ارجع صحيحاً;
}

// حجم بعد الضغط
دالة حجم_بعد_الضغط(مسار نص) -> صحيح {
    صحيح حجم=0;
    حجم=احصل_حجم(مسار);
    ارجع حجم;
}

// استخراج محمي
دالة استخرج_بكلمة_مرور(مسار نص,كلمة_مرور نص) -> صحيح {
    استخرج_محمي(مسار,كلمة_مرور);
    ارجع صحيحاً;
}

// عدد الملفات
دالة ملفات_مضغوطة(مسار نص) -> صحيح {
    صحيح عدد=0;
    عدد=عدّ(مسار);
    ارجع عدد;
}


