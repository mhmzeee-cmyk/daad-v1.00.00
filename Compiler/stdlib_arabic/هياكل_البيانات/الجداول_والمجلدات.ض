// جدول فارغ
دالة إنشاء_جدول() -> صحيح {
    صحيح جدول=0;
    جدول=إنشاء_جدول();
    ارجع جدول;
}

// إضافة صف
دالة أضف_صف(جدول صحيح,قيم صحيح[]) -> صحيح {
    أضف_صف(جدول,قيم);
    ارجع صحيحاً;
}

// جلب صف
دالة احصل_على_صف(جدول صحيح,فهرس صحيح) -> صحيح[] {
    صحيح[] صف=جلب_صف(جدول,فهرس);
    ارجع صف;
}

// عدد الصفوف
دالة عدد_الصفوف(جدول صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=عدّ_صفوف(جدول);
    ارجع عدد;
}

// عدد الأعمدة
دالة عدد_الأعمدة(جدول صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=عدّ_أعمدة(جدول);
    ارجع عدد;
}

// تفريغ
دالة فرّغ_الجدول(جدول صحيح) {
    فرّغ_جدول(جدول);
}

// حذف صف
دالة احذف_صف(جدول صحيح,فهرس صحيح) -> صحيح {
    حذف_صف(جدول,فهرس);
    ارجع صحيحاً;
}

// فرز
دالة فرز_الجدول(جدول صحيح,عمود صحيح) -> صحيح {
    فرز_جدول(جدول,عمود);
    ارجع صحيحاً;
}

// بحث
دالة ابحث_في_الجدول(جدول صحيح,قيمة صحيح) -> صحيح {
    صحيح موقع=-1;
    موقع=ابحث_جدول(جدول,قيمة);
    ارجع موقع;
}

// تصدير
دالة تصدير_الجدول(جدول صحيح,مسار نص) -> صحيح {
    تصدير_جدول(جدول,مسار);
    ارجع صحيحاً;
}


