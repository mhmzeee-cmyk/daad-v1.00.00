// إنشاء قائمة فارغة
دالة إنشاء_قائمة() -> صحيح {
    صحيح قائمة=0;
    قائمة=إنشاء();
    ارجع قائمة;
}

// إضافة للنهاية
دالة أضف_للنهاية(قائمة صحيح,قيمة صحيح) -> صحيح {
    أضف(قائمة,قيمة);
    ارجع صحيحاً;
}

// إضافة للبداية
دالة أضف_للبداية(قائمة صحيح,قيمة صحيح) -> صحيح {
    أضف_بداية(قائمة,قيمة);
    ارجع صحيحاً;
}

// حذف عنصر
دالة احذف_عنصر(قائمة صحيح,قيمة صحيح) -> صحيح {
    حذف(قائمة,قيمة);
    ارجع صحيحاً;
}

// البحث
دالة ابحث_في_القائمة(قائمة صحيح,قيمة صحيح) -> صحيح {
    صحيح موقع=ابحث(قائمة,قيمة);
    ارجع موقع;
}

// الحجم
دالة حجم_القائمة(قائمة صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=طول(قائمة);
    ارجع عدد;
}

// عرض
دالة اعرض_القائمة(قائمة صحيح) {
    اطبع(قائمة);
}

// عكس
دالة عكس_القائمة(قائمة صحيح) -> صحيح {
    عكس(قائمة);
    ارجع صحيحاً;
}

// دمج
دالة ادمج_قوائم(قائمة a,قائمة b) -> صحيح {
    ادمج(a,b);
    ارجع صحيحاً;
}

// العنصر رقم n
دالة _nth_عنصر(قائمة صحيح,رقم صحيح) -> صحيح {
    صحيح قيمة=0;
    قيمة=جلب(قائمة,رقم);
    ارجع قيمة;
}


