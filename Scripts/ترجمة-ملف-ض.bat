@echo off
chcp 65001 >nul 2>&1
title ترجمة ملف ض — Dhad Compiler Quick
color 0A

if "%~1"=="" (
    echo.
    echo  ═══════════════════════════════════════════════════════════════
    echo   سحب ملف .ض وأفلته على هذا الملف مباشرة
    echo  ═══════════════════════════════════════════════════════════════
    echo.
    pause
    exit /b
)

echo.
echo  ╔══════════════════════════════════════════════════════════════════╗
echo  ║              ترجمة ملف — Daad Compiler                         ║
echo  ╚══════════════════════════════════════════════════════════════════╝
echo.
echo  الملف المصدر: %~1

:: تحديد ملف الإخراج
set outfile=%~dpn1.cpp
echo  ملف الإخراج: %outfile%
echo.
echo  ═══════════════════════════════════════════════════════════════
echo   جاري الترجمة...
echo  ═══════════════════════════════════════════════════════════════
echo.

"%~dp0Daad-Compiler\daad-compiler.exe" "%~1" -o "%outfile%"

if %errorlevel%==0 (
    echo  ═══════════════════════════════════════════════════════════════
    echo   ✓ تم الترجمة بنجاح!
    echo   الملف المترجم: %outfile%
    echo  ═══════════════════════════════════════════════════════════════
) else (
    echo  ═══════════════════════════════════════════════════════════════
    echo   ✗ فشلت الترجمة
    echo  ═══════════════════════════════════════════════════════════════
)
echo.
echo  اضغط أي زر للخروج...
pause >nul
