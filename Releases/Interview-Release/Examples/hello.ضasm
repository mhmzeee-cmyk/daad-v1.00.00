# برنامج: مرحبا بالعالم
# ═══════════════════════════════════════

# طباعة الحرف 'م' (ASCII 77 = 12 + 5*12 = ... للتبسيط)
# سنطبع الحرف المقابل للرقم 0 (حرف A)
حمّل مح، 0       # المح = 0 → الحرف 'A'
اطبع_حرف         # طباعة الحرف

# طباعة أحرف "مرحبا"
حمّل مح، 12      # 'M' = 77... للتبسيط: سنستخدم أرقاماً
اطبع_حرف

حمّل مح، 4       # 'H'
اطبع_حرف

حمّل مح، 0       # 'A'
اطبع_حرف

# سطر جديد (ASCII 10)
حمّل مح، 10
اطبع_حرف

توقف
