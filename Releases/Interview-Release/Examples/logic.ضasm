# اختبار AND: 12 & 10 = 8
حمّل مح، 12      # 12 = 1100
حمّل س0، 10      # 10 = 1010
ومنطقي س0         # مح = 12 & 10 = 8
اطبع             # طباعة: 8

حمّل مح، 10
اطبع_حرف         # سطر جديد

# اختبار OR: 12 | 10 = 14
حمّل مح، 12
حمّل س0، 10
أومنطقي س0        # مح = 12 | 10 = 14
اطبع             # طباعة: 14

حمّل مح، 10
اطبع_حرف

# اختبار NOT: ~5 = 10
حمّل مح، 5
ليس              # مح = ~5 = 10
اطبع             # طباعة: 10

حمّل مح، 10
اطبع_حرف

توقف
