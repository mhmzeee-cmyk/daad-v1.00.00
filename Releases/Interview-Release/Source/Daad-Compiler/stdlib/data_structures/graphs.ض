// الوصف: رسوم بيانية

// إنشاء رسم بياني
دالة إنشاء_رسم() -> صحيح {
    صحيح رسم=0;
    رسم=إنشاء_رسم();
    ارجع رسم;
}

// إضافة عقدة
دالة أضف_عقدة(رسم صحيح,قيمة صحيح) -> صحيح {
    أضف_عقدة(رسم,قيمة);
    ارجع صحيحاً;
}

// إضافة حافة
دالة أضف_حافة(رسم صحيح,من صحيح,إلى صحيح) -> صحيح {
    أضف_حافة(رسم,من,إلى);
    ارجع صحيحاً;
}

// حذف عقدة
دالة حذف_عقدة(رسم صحيح,قيمة صحيح) -> صحيح {
    حذف_عقدة(رسم,قيمة);
    ارجع صحيحاً;
}

// بحث في العمق
دالة  DFS(رسم صحيح,بداية صحيح) -> صحيح {
    DFS(رسم,بداية);
    ارجع صحيحاً;
}

// بحث في العرض
دالة  BFS(رسم صحيح,بداية صحيح) -> صحيح {
    BFS(رسم,بداية);
    ارجع صحيحاً;
}

// المسافة
دالة مسافة_بين(رسم صحيح,من صحيح,إلى صحيح) -> صحيح {
    صحيح مسافة=0;
    مسافة=أقصر_مسافة(رسم,من,إلى);
    ارجع مسافة;
}

// هل توجد حلقة؟
دالة حلقة_موجودة(رسم صحيح) -> صحيح {
    صحيح حلقة=0;
    إذا(تحقق_حلقة(رسم)==1){ حلقة=1; }
    ارجع حلقة;
}

// عدد العقد
دالة عدد_العقد(رسم صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=عدّ_عقد(رسم);
    ارجع عدد;
}

// عدد الحافات
دالة عدد_الحافات(رسم صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=عدّ_حافات(رسم);
    ارجع عدد;
}


