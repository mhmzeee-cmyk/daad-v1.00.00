// ض مكتبة: HTTP_و_HTTPS
// Category: networking
// الوصف: HTTP و HTTPS

// طلب HTTP
دالة طلب_http(طريقة نص,عنوان نص) -> صحيح {
    صحيح رمز=0;
    رمز=طلب_http(طريقة,عنوان);
    ارجع رمز;
}

// GET
دالة GET(عنوان نص) -> صحيح {
    صحيح رمز=0;
    رمز=GET(عنوان);
    ارجع رمز;
}

// POST
دالة POST(عنوان نص,بيانات نص) -> صحيح {
    صحيح رمز=0;
    رمز=POST(عنوان,بيانات);
    ارجع رمز;
}

// PUT
دالة PUT(عنوان نص,بيانات نص) -> صحيح {
    صحيح رمز=0;
    رمز=PUT(عنوان,بيانات);
    ارجع رمز;
}

// DELETE
دالة DELETE(عنوان نص) -> صحيح {
    صحيح رمز=0;
    رمز=DELETE(عنوان);
    ارجع رمز;
}

// الجواب
دالة جواب_HTTP(عنوان نص) -> صحيح {
    صحيح جواب=0;
    جواب=جواب_HTTP(عنوان);
    ارجع جواب;
}

// الجودة
دالة جودة_HTTPS(عنوان نص) -> صحيح {
    صحيح جودة=0;
    جودة=جودة_HTTPS(عنوان);
    ارجع جودة;
}

// تحميل
دالة تحميل_ملف(url نص,مسار نص) -> صحيح {
    صحيح نجاح=0;
    نجاح=تحميل(url,مسار);
    ارجع نجاح;
}

// العناوين
دالة Headers(url نص) -> صحيح {
    صحيح headers=0;
    headers=Headers(url);
    ارجع headers;
}

// الحالة
دالة حالة_الخادم(عنوان نص) -> صحيح {
    صحيح حالة=0;
    حالة=حالة_خادم(عنوان);
    ارجع حالة;
}


