// ض مكتبة: DNS_والعناوين
// Category: networking
// الوصف: DNS والعناوين

// تحليل الاسم
دالة حل_اسم(اسم نص) -> نص {
    نص عنوان="";
    عنوان=حل_اسم(اسم);
    ارجع عنوان;
}

// عكس DNS
دالة عكس_الاسم(عنوان نص) -> نص {
    نص اسم="";
    اسم=عكس_اسم(عنوان);
    ارجع اسم;
}

// المضيف المحلي
دالة عنوان_lokal() -> نص {
    نص عنوان="";
    عنوان=مضيف_lokal();
    ارجع عنوان;
}

// جميع العناوين
دالة عناوين_المضيف(اسم نص) -> صحيح[] {
    صحيح[] عناوين=[];
    عناوين=عناوين_مضيف(اسم);
    ارجع عناوين;
}

// هل متصل؟
دالة تحقق_من_الاتصال() -> صحيح {
    صحيح متصل=0;
    إذا(هل_متصل()==1){ متصل=1; }
    ارجع متصل;
}

// سرعة الاتصال
دالة سرعة_الاتصال() -> عشري {
    عشري سرعة=0.0;
    سرعة=سرعة_اتصال();
    ارجع سرعة;
}

// اختبار الاتصال
دالة ping(عنوان نص) -> صحيح {
    صحيح استجابة=0;
    استجابة=ping(عنوان);
    ارجع استجابة;
}

// nslookup
دالة nslookup(اسم نص) -> صحيح {
    صحيح ناتج=0;
    ناتج=nslookup(اسم);
    ارجع ناتج;
}

// خوادم البريد
دالة mx_البريد(نطاق نص) -> صحيح {
    صحيح mx=0;
    mx=mx_البريد(نطاق);
    ارجع mx;
}

// Nameserver
دالة Nameserver(نطاق نص) -> صحيح {
    صحيح ns=0;
    ns=Nameserver(نطاق);
    ارجع ns;
}


