// ض مكتبة: نموذج_الممثل
// Category: concurrency
// الوصف: Actor Model

// إنشاء
دالة إنشاء_ممثل(دالة نص) -> صحيح {
    صحيح ممثل=0;
    ممثل=إنشاء_ممثل(دالة);
    ارجع ممثل;
}

// إرسال
دالة أرسل_للممثل(ممثل صحيح,رسالة نص) -> صحيح {
    أرسل_ممثل(ممثل,رسالة);
    ارجع صحيحاً;
}

// استقبال
دالة استقبل_من_الممثل(ممثل صحيح) -> نص {
نص رسالة="";
    رسالة=استقبل_ممثل(ممثل);
    ارجع رسالة;
}

// إنهاء
دالة إنهاء_الممثل(ممثل صحيح) {
    إنهاء_ممثل(ممثل);
}

// الحالة
دالة حالة_الممثل(ممثل صحيح) -> صحيح {
    صحيح حالة=0;
    حالة=حالة_ممثل(ممثل);
    ارجع حالة;
}

// العدد
دالة عدد_الممثلين() -> صحيح {
    صحيح عدد=0;
    عدد=عدّ_ممثلين();
    ارجع عدد;
}

// مسح
دالة مسح_الممثلين() {
    مسح_ممثلين();
}

// إحصائيات
دالة إحصائيات_الممثلين() -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_ممثلين();
    ارجع إحصائيات;
}

// إعادة
دالة إعادة_توجيه(ممثل صحيح,رسالة نص) -> صحيح {
    إعادة_توجيه_ممثل(ممثل,رسالة);
    ارجع صحيحاً;
}

// حجم الصندوق
دالة صندوق_الممثل(ممثل صحيح) -> صحيح {
    صحيح حجم=0;
    حجم=صندوق_ممثل(ممثل);
    ارجع حجم;
}


