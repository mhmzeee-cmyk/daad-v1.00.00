// الوصف: الأعداد المركبة

// إنشاء مركب
دالة عدد_مركب(عشري حقيقي,عشري تخيلي) -> عشري[] {
    عشري[] z=[];
    z=أضف(z,حقيقي);
    z=أضف(z,تخيلي);
    ارجع z;
}

// الجزء الحقيقي
دالة حقيقي(عشري[] z) -> عشري {
    ارجع z[0];
}

// الجزء التخيلي
دالة تخيلي(عشري[] z) -> عشري {
    ارجع z[1];
}

// جمع مركبين
دالة جمع_مركبين(عشري[] a,عشري[] b) -> عشري[] {
    ارجع عدد_مركب(a[0]+b[0],a[1]+b[1]);
}

// ضرب مركبين
دالة ضرب_مركبين(عشري[] a,عشري[] b) -> عشري[] {
    عشري ر=a[0]*b[0]-a[1]*b[1];عشري و=a[0]*b[1]+a[1]*b[0];
    ارجع عدد_مركب(ر,و);
}

// قيمة المركب المطلقة
دالة حجم_المركب(عشري[] z) -> عشري {
    ارجع جذر(z[0]*z[0]+z[1]*z[1]);
}

// العقد المركب
دالة عقد(عشري[] z) -> عشري[] {
    ارجع عدد_مركب(z[0],-z[1]);
}

// قوة مركب
دالة قوة_مركبة(عشري[] z,صحيح أس) -> عشري[] {
    عشري[] نتيجة=z;
    لكل(صحيح i=1;i<أس;i+=1){ نتيجة=ضرب_مركبين(نتيجة,z); }
    ارجع نتيجة;
}

// لوغاريتم مركب
دالة لوغاريتم_مركبي(عشري[] z) -> عشري[] {
    ارجع عدد_مركب(لn(modge(z)),atan2(z[1],z[0]));
}

// أُس مركب
دالة أُس_مركب(عشري[] z,عشري أس) -> عشري[] {
    عشري ر=قوة(modge(z),أس);عشري theta=atan2(z[1],z[0])*أس;
    ارجع عدد_مركب(ر*جيب(theta),ر*جيب_تربيعي(theta));
}


