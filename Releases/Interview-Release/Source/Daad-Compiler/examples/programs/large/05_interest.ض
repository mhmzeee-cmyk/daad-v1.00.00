// البرنامج 5: محاسبة الInterest البسيطة
// حساب الفائدة البسيطة والمركبة

دالة فائدة_بسيطة(صحيح رأس_المال, صحيح معدل, صحيح سنوات) -> صحيح {
    ارجع رأس_المال * معدل * سنوات / 100 ؛
}

دالة فائدة_مركبة(صحيح رأس_المال, صحيح معدل, صحيح سنوات) -> صحيح {
    صحيح مجموع = رأس_المال ؛
    لكل(صحيح i = 0; i < سنوات; i = i + 1) {
        مجموع += مجموع * معدل / 100 ؛
    }
    ارجع مجموع - رأس_المال ؛
}

دالة إجمالي(صحيح رأس_المال, صحيح فائدة) -> صحيح {
    ارجع رأس_المال + فائدة ؛
}

// حسابات
صحيح رأس = 10000 ؛
صحيح معدل = 5 ؛
صحيح سنوات = 3 ؛

صحيح ف_بسيطة = فائدة_بسيطة(رأس, معدل, سنوات) ؛
صحيح ف_مركبة = فائدة_مركبة(رأس, معدل, سنوات) ؛

طباعة("=== محاسبة الفائدة ===") ؛
طباعة("رأس المال: ") ؛
طباعة(رأس) ؛
طباعة("معدل الفائدة: ") ؛
طباعة(معدل) ؛
طباعة("السنوات: ") ؛
طباعة(سنوات) ؛
طباعة("الفائدة البسيطة: ") ؛
طباعة(ف_بسيطة) ؛
طباعة("الإجمالي (بسيطة): ") ؛
طباعة(إجمالي(رأس, ف_بسيطة)) ؛
طباعة("الفائدة المركبة: ") ؛
طباعة(ف_مركبة) ؛
طباعة("الإجمالي (مركبة): ") ؛
طباعة(إجمالي(رأس, ف_مركبة)) ؛

// مقارنة الفارق
صحيح فارق = ف_مركبة - ف_بسيطة ؛
طباعة("الفارق بين المركبة والبسيطة: ") ؛
طباعة(فارق) ؛
