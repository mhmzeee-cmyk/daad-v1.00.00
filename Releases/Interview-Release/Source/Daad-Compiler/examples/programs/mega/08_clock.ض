// البرنامج 8: ساعة مع تقويم
// محاكاة ساعة وتقويم بسيط

دالة تحديد_اليوم(صحيح يوم) -> نص {
    إذا(يوم == 1) { ارجع "الاثنين" ؛ }
    إذا(يوم == 2) { ارجع "الثلاثاء" ؛ }
    إذا(يوم == 3) { ارجع "الأربعاء" ؛ }
    إذا(يوم == 4) { ارجع "الخميس" ؛ }
    إذا(يوم == 5) { ارجع "الجمعة" ؛ }
    إذا(يوم == 6) { ارجع "السبت" ؛ }
    إذا(يوم == 7) { ارجع "الأحد" ؛ }
    ارجع "غير معروف" ؛
}

دالة تحديد_الشهر(صحيح شهر) -> نص {
    إذا(شهر == 1) { ارجع "يناير" ؛ }
    إذا(شهر == 2) { ارجع "فبراير" ؛ }
    إذا(شهر == 3) { ارجع "مارس" ؛ }
    إذا(شهر == 4) { ارجع "أبريل" ؛ }
    إذا(شهر == 5) { ارجع "مايو" ؛ }
    إذا(شهر == 6) { ارجع "يونيو" ؛ }
    إذا(شهر == 7) { ارجع "يوليو" ؛ }
    إذا(شهر == 8) { ارجع "أغسطس" ؛ }
    إذا(شهر == 9) { ارجع "سبتمبر" ؛ }
    إذا(شهر == 10) { ارجع "أكتوبر" ؛ }
    إذا(شهر == 11) { ارجع "نوفمبر" ؛ }
    إذا(شهر == 12) { ارجع "ديسمبر" ؛ }
    ارجع "غير معروف" ؛
}

دالة هل_كبيسة(صحيح سنة) -> صحيح {
    إذا(سنة % 4 == 0) {
        إذا(سنة % 100 != 0) { ارجع 1 ؛ }
    }
    إذا(سنة % 400 == 0) { ارجع 1 ؛ }
    ارجع 0 ؛
}

دالة شهر_31(صحيح شهر) -> صحيح {
    إذا(شهر == 1) { ارجع 1 ؛ }
    إذا(شهر == 3) { ارجع 1 ؛ }
    إذا(شهر == 5) { ارجع 1 ؛ }
    إذا(شهر == 7) { ارجع 1 ؛ }
    إذا(شهر == 8) { ارجع 1 ؛ }
    إذا(شهر == 10) { ارجع 1 ؛ }
    إذا(شهر == 12) { ارجع 1 ؛ }
    ارجع 0 ؛
}

دالة شهر_30(صحيح شهر) -> صحيح {
    إذا(شهر == 4) { ارجع 1 ؛ }
    إذا(شهر == 6) { ارجع 1 ؛ }
    إذا(شهر == 9) { ارجع 1 ؛ }
    إذا(شهر == 11) { ارجع 1 ؛ }
    ارجع 0 ؛
}

دالة أيام_الشهر(صحيح شهر, صحيح سنة) -> صحيح {
    إذا(شهر_31(شهر) == 1) { ارجع 31 ؛ }
    إذا(شهر_30(شهر) == 1) { ارجع 30 ؛ }
    إذا(شهر == 2) {
        إذا(هل_كبيسة(سنة) == 1) { ارجع 29 ؛ }
        ارجع 28 ؛
    }
    ارجع 30 ؛
}

// البيانات
صحيح اليوم = 26 ؛
صحيح الشهر = 6 ؛
صحيح السنة = 2026 ؛
صحيح يوم_الأسبوع = 5 ؛
صحيح الساعة = 10 ؛
صحيح الدقيقة = 30 ؛

طباعة("=== الساعة والتقويم ===") ؛
طباعة("الوقت: ") ؛
طباعة(الساعة) ؛
طباعة(":") ؛
إذا(الدقيقة < 10) { طباعة("0") ؛ }
طباعة(الدقيقة) ؛
طباعة("التاريخ: ") ؛
طباعة(اليوم) ؛
طباعة("/") ؛
طباعة(الشهر) ؛
طباعة("/") ؛
طباعة(السنة) ؛
طباعة("اليوم: ") ؛
طباعة(تحديد_اليوم(يوم_الأسبوع)) ؛
طباعة("الشهر: ") ؛
طباعة(تحديد_الشهر(الشهر)) ؛

صحيح أيام = أيام_الشهر(الشهر, السنة) ؛
طباعة("عدد أيام هذا الشهر: ") ؛
طباعة(أيام) ؛

إذا(هل_كبيسة(السنة) == 1) {
    طباعة("السنة كبيسة") ؛
}
وإلا {
    طباعة("السنة ليست كبيسة") ؛
}

// عد تنازلي لنهاية الشهر
صحيح متبقية = أيام - اليوم ؛
طباعة("الأيام المتبقية من الشهر: ") ؛
طباعة(متبقية) ؛
