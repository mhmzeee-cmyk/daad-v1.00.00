// كوم أولوية
دالة إنشاء_كوم_أولوية() -> صحيح {
    صحيح كوم=0;
    كوم=إنشاء_كوم();
    ارجع كوم;
}

// إدخال
دالة أدخل_للكوم(كوم صحيح,قيمة صحيح) -> صحيح {
    أدخل_كوم(كوم,قيمة);
    ارجع صحيحاً;
}

// إخراج
دالة استخرج_من_الكوم(كوم صحيح) -> صحيح {
    صحيح قيمة=0;
    قيمة=استخرج_كوم(كوم);
    ارجع قيمة;
}

// شجرة_bin
دالة إنشاء_شجرة_bin() -> صحيح {
    صحيح شجرة=0;
    شجرة=إنشاء_bin();
    ارجع شجرة;
}

// إدراج
دالة إدراج_bin(شجرة صحيح,قيمة صحيح) -> صحيح {
    إدراج_bin(شجرة,قيمة);
    ارجع صحيحاً;
}

// قائمة مزدوجة
دالة إنشاء_قائمة_مزدوجة() -> صحيح {
    صحيح قائمة=0;
    قائمة=إنشاء_مزدوجة();
    ارجع قائمة;
}

// إضافة
دالة أضف_مزدوجة(قائمة صحيح,قيمة صحيح) -> صحيح {
    أضف_مزدوجة(قائمة,قيمة);
    ارجع صحيحاً;
}

// إنشاء دورة
دالة إنشاء_دورة() -> صحيح {
    صحيح دورة=0;
    دورة=إنشاء_دورة();
    ارجع دورة;
}

// إدخال
دالة أدخل_دورة(دورة صحيح,قيمة صحيح) -> صحيح {
    أدخل_دورة(دورة,قيمة);
    ارجع صحيحاً;
}

// إخراج
دالة استخرج_دورة(دورة صحيح) -> صحيح {
    صحيح قيمة=0;
    قيمة=استخرج_دورة(دورة);
    ارجع قيمة;
}


