// إنشاء خريطة
دالة إنشاء_خريطة() -> صحيح {
    صحيح خريطة=0;
    خريطة=إنشاء_خريطة();
    ارجع خريطة;
}

// إضافة
دالة أضف_لخريطة(خريطة صحيح,مفتاح نص,قيمة صحيح) -> صحيح {
    أضف_خريطة(خريطة,مفتاح,قيمة);
    ارجع صحيحاً;
}

// جلب
دالة احصل_من_خريطة(خريطة صحيح,مفتاح نص) -> صحيح {
    صحيح قيمة=0;
    قيمة=جلب_خريطة(خريطة,مفتاح);
    ارجع قيمة;
}

// حذف
دالة احذف_من_خريطة(خريطة صحيح,مفتاح نص) -> صحيح {
    حذف_خريطة(خريطة,مفتاح);
    ارجع صحيحاً;
}

// هل يوجد؟
دالة مفتاح_موجود(خريطة صحيح,مفتاح نص) -> صحيح {
    صحيح موجود=0;
    إذا(يوجد_مفتاح(خريطة,مفتاح)==1){ موجود=1; }
    ارجع موجود;
}

// الحجم
دالة حجم_الخريطة(خريطة صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=حجم_خريطة(خريطة);
    ارجع عدد;
}

// إنشاء مجموعة
دالة إنشاء_مجموعة() -> صحيح {
    صحيح مجموعة=0;
    مجموعة=إنشاء_مجموعة();
    ارجع مجموعة;
}

// إضافة
دالة أضف_لمجموعة(مجموعة صحيح,قيمة صحيح) -> صحيح {
    أضف_مجموعة(مجموعة,قيمة);
    ارجع صحيحاً;
}

// عضو؟
دالة عضو_في_المجموعة(مجموعة صحيح,قيمة صحيح) -> صحيح {
    صحيح عضو=0;
    إذا(عضو_مجموعة(مجموعة,قيمة)==1){ عضو=1; }
    ارجع عضو;
}

// دمج
دالة دمج_مجموعات(مجموعة a,مجموعة b) -> صحيح {
    دمج(a,b);
    ارجع صحيحاً;
}


