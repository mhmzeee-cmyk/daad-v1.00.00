// ض مكتبة: الهياكل_المتهمة_المتقدمة
// الفئة: هياكل_البيانات
// الوصف: hash متقدم

// إحصائيات
دالة إحصائيات_hash(hash صحيح) -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_hash(hash);
    ارجع إحصائيات;
}

// الكثافة
دالة كثافة_hash(hash صحيح) -> عشري {
    عشري كثافة=0.0;
    كثافة=كثافة_hash(hash);
    ارجع كثافة;
}

// rehash
دالة إعادة_الهيكلة(hash صحيح) {
    إعادة_هيكلة(hash);
}

// دمج
دالة دمج_hash(hash a,hash b) -> صحيح {
    دمج_hash(a,b);
    ارجع صحيحاً;
}

// توازن؟
دالة تحقق_من_التوازن(hash صحيح) -> صحيح {
    صحيح متوازن=0;
    إذا(توازن_hash(hash)==1){ متوازن=1; }
    ارجع متوازن;
}

// عدد الحلقات
دالة حلقات_التصادم(hash صحيح) -> صحيح {
    صحيح عدد=0;
    عدد=حلقات_hash(hash);
    ارجع عدد;
}

// الحضور
دالة إحصاء_الحضور(hash صحيح) -> صحيح {
    صحيح حضور=0;
    حضور=حضور_hash(hash);
    ارجع حضور;
}

// فرز المفاتيح
دالة فرز_المفاتيح(hash صحيح) -> صحيح[] {
    صحيح[] مفاتيح=[];
    مفاتيح=فرز_مفاتيح(hash);
    ارجع مفاتيح;
}

// قلب
دالة قلب_hash(hash صحيح) {
    قلب_hash(hash);
}

// إحصائيات مختصرة
دالة إحصائي_hash(hash صحيح) -> صحيح {
    صحيح إحصائي=0;
    إحصائي=إحصائي_hash(hash);
    ارجع إحصائي;
}


