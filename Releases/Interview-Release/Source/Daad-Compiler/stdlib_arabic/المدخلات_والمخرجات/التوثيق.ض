// الوصف: التوثيق التلقائي

// توثيق دالة
دالة وثّق_دالة(اسم نص,وصف نص) {
    سجّل("دالة: "+اسم);
    سجّل("الوصف: "+وصف);
}

// توثيق صنف
دالة وثّق_صنف(اسم نص,وصف نص) {
    سجّل("صنف: "+اسم);
    سجّل("الوصف: "+وصف);
}

// توثيق متغير
دالة وثّق_متغير(اسم نص,وصف نص,نوع نص) {
    سجّل("متغير: "+اسم+" من نوع "+نوع);
}

// إنشاء ملف
دالة أنشئ_ملف_توثيق(مسار نص) -> صحيح {
    صحيح ملف=افتح(مسار,2);
    أغلق(ملف);
    ارجع صحيحاً;
}

// وصف
دالة احصل_على_الوصف(اسم نص) -> نص {
    ارجع "وصف "+اسم;
}

// هل يوجد؟
دالة تحقق_من_التوثيق(مسار نص) -> صحيح {
    صحيح موجود=0;
    إذا(ملف_موجود(مسار)==1){ موجود=1; }
    ارجع موجود;
}

// تصدير
دالة صدّر_التوثيق(مسار نص,صيغة نص) {
    سجّل("تصدير إلى "+مسار);
}

// عناصر موثقة
دالة قائمة_العناصر() -> صحيح[] {
    صحيح[] عناصر=[];
    عناصر=جلب_عناصر();
    ارجع عناصر;
}

// تحديث
دالة حدّث_التوثيق(مسار نص) {
    إذا(ملف_موجود(مسار)==1){ سجّل("تحديث "+مسار); }
}

// المستوى
دالة مستوى_التوثيق(اسم نص) -> صحيح {
    صحيح مستوى=0;
    مستوى=جلب_مستوى(اسم);
    ارجع مستوى;
}


