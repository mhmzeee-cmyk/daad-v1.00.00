// إنشاء
دالة إنشاء_موجه() -> صحيح {
    صحيح موجه=0;
    موجه=إنشاء_موجه();
    ارجع موجه;
}

// إضافة
دالة إضافة_مسار(موجه صحيح,مسار نص,دالة نص) -> صحيح {
    إضافة_مسار(موجه,مسار,دالة);
    ارجع صحيحاً;
}

// توجيه
دالة توجيه(موجه صحيح,مسار نص) -> صحيح {
    توجيه(موجه,مسار);
    ارجع صحيحاً;
}

// رجوع
دالة رجوع(موجه صحيح) -> صحيح {
    رجوع(موجه);
    ارجع صحيحاً;
}

// المسار
دالة المسار_الحالي(موجه صحيح) -> صحيح {
    نص مسار="";
    مسار=المسار_الحالي(موجه);
    ارجع مسار;
}

// السابق
دالة مسار_سابق(موجه صحيح) -> صحيح {
    نص مسار="";
    مسار=مسار_سابق(موجه);
    ارجع مسار;
}

// إضافة
دالة إضافة_guard(موجه صحيح,دالة نص) -> صحيح {
