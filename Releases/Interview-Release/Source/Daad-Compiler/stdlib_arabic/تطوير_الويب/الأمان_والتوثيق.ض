// المصادقة
دالة تحقق_من_المصادقة(بيانات نص) -> صحيح {
    صحيح صحيح=0;
    إذا(مصادقة(بيانات)==1){ صحيح=1; }
    ارجع صحيح;
}

// إنشاء token
دالة إنشاء_رمز(مدة صحيح) -> صحيح {
    نص رمز="";
    رمز=إنشاء_رمز(مدة);
    ارجع رمز;
}

// التحقق
دالة تحقق_من_الرمز(رمز نص) -> صحيح {
    صحيح صحيح=0;
    إذا(تحقق_رمز(رمز)==1){ صحيح=1; }
    ارجع صحيح;
}

// إلغاء
دالة إلغاء_الرمز(رمز نص) {
    إلغاء_رمز(رمز);
}

// تجديد
دالة تجديد_الرمز(رمز نص) -> صحيح {
    نص جديد="";
    جديد=تجديد_رمز(رمز);
    ارجع جديد;
}

// التشفير
دالة تشفير_المدخلات(بيانات نص) -> صحيح {
    نص مشفر="";
    مشفر=تشفير_مدخلات(بيانات);
    ارجع مشفر;
}

// CSRF
دالة التحقق_من_ال CSRF(url نص) -> صحيح {
    صحيح صحيح=0;
    إذا(تحقق_ CSRF(url)==1){ صحيح=1; }
    ارجع صحيح;
}

// تأمين
دالة تأمين_الرأس(url نص,بيانات نص) -> صحيح {
    تأمين_رأس(url,بيانات);
    ارجع صحيحاً;
}

// التصاريح
دالة قائمة_التصريح() -> صحيح[] {
    صحيح[] تصاريح=[];
    تصريح=قائمة_تصريح();
    ارجع تصاريح;
}

// إضافة
دالة إضافة_تصريح(url نص,نوع نص) -> صحيح {
    إضافة_تصريح(url,نوع);
    ارجع صحيحاً;
}


