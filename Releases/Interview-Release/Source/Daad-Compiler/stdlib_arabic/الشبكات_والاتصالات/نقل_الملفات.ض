// تحميل FTP
دالة FTP_تحميل(خادم نص,مستخدم نص,كلمة نص,ملف نص) -> صحيح {
    صحيح نجاح=0;
    نجاح=FTP_تحميل(خادم,مستخدم,كلمة,ملف);
    ارجع نجاح;
}

