دالة FTP_رفع(خادم نص,مستخدم نص,كلمة نص,ملف نص) -> صحيح {
    صحيح نجاح=0;
    نجاح=FTP_رفع(خادم,مستخدم,كلمة,ملف);
    ارجع نجاح;
}

