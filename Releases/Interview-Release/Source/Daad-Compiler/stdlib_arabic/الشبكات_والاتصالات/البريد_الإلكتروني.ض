// ض مكتبة: البريد_الإلكتروني
// الفئة: الشبكات_والاتصالات
// الوصف: البريد الإلكتروني

// إرسال
دالة أرسل_بريد(إلى نص,موضوع نص,محتوى نص) -> صحيح {
    صحيح نجاح=0;
    نجاح=أرسل_بريد(إلى,موضوع,محتوى);
    ارجع نجاح;
}

// إرسال مرفقات
دالة أرسل_بمرفقات(إلى نص,موضوع نص,مرفقات نص[]) -> صحيح {
    صحيح نجاح=0;
    نجاح=أرسل_مرفقات(إلى,موضوع,مرفقات);
    ارجع نجاح;
}

// استقبال
دالة استقبل_البريد() -> صحيح[] {
    صحيح[] رسائل=[];
    رسائل=استقبل_بريد();
    ارجع رسائل;
}

// قراءة
دالة قراءة_رسالة(رسالة صحيح) -> صحيح {
    صحيح قراءة=0;
    قراءة=قراءة_رسالة(رسالة);
    ارجع قراءة;
}

// حذف
دالة حذف_رسالة(رسالة صحيح) -> صحيح {
    حذف_رسالة(رسالة);
    ارجع صحيحاً;
}

// التحقق
دالة تحقق_من_البريد(بريد نص) -> صحيح {
    صحيح صحيح=0;
    إذا(تحقق_بريد(بريد)==1){ صحيح=1; }
    ارجع صحيح;
}

// إرسال SMTP
دالة إرسال_ SMTP(خادم نص,رسالة نص) -> صحيح {
    صحيح نجاح=0;
    نجاح=SMTP(خادم,رسالة);
    ارجع نجاح;
}

// استقبال POP3
دالة استقبال_POP3(خادم نص,مستخدم نص,كلمة نص) -> صحيح {
    صحيح نجاح=0;
    نجاح=POP3(خادم,مستخدم,كلمة);
    ارجع نجاح;
}

// استقبال IMAP
دالة استقبال_IMAP(خادم نص,مستخدم نص,كلمة نص) -> صحيح {
    صحيح نجاح=0;
    نجاح=IMAP(خادم,مستخدم,كلمة);
    ارجع نجاح;
}

// القوالب
دالة قوالب_البريد() -> صحيح[] {
    صحيح[] قوالب=[];
    قوالب=قوالب_بريد();
    ارجع قوالب;
}


