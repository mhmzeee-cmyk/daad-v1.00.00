// تشغيل
دالة تشغيل_فيديو(مسار نص) -> صحيح {
    تشغيل_فيديو(مسار);
    ارجع صحيحاً;
}

// إيقاف
دالة إيقاف_فيديو() {
    إيقاف_فيديو();
}

// إضافة مقطع
دالة إضافة_مقطع(مسار نص) -> صحيح {
    إضافة_مقطع(مسار);
    ارجع صحيحاً;
}

// صورة
دالة صورة_من_فيديو(فيديو صحيح,ثانية صحيح) -> صحيح {
    صحيح صورة=0;
    صورة=صورة_من_فيديو(فيديو,ثانية);
    ارجع صورة;
}

// المدة
دالة مدة_الفيديو(فيديو صحيح) -> عشري {
    عشري مدة=0.0;
    مدة=مدة_فيديو(فيديو);
    ارجع مدة;
}

// الصوت
دالة صوت_فيديو(فيديو صحيح) -> صحيح {
    صحيح صوت=0;
    صوت=صوت_فيديو(فيديو);
    ارجع صوت;
}

// تحويل
دالة تحويل_الفيديو(فيديو صحيح,صيغة نص,مسار نص) -> صحيح {
    تحويل_فيديو(فيديو,صيغة,مسار);
    ارجع صحيحاً;
}

// قص
دالة قص_فيديو(فيديو صحيح,بداية صحيح,نهاية صحيح) -> صحيح {
    قص_فيديو(فيديو,بداية,نهاية);
    ارجع صحيحاً;
}

// استخراج صوت
دالة استخراج_الصوت(فيديو صحيح,مسار نص) -> صحيح {
    استخراج_صوت(فيديو,مسار);
    ارجع صحيحاً;
}

// إحصائيات
دالة إحصائيات_الفيديو(فيديو صحيح) -> صحيح[] {
    صحيح[] إحصائيات=[];
    إحصائيات=إحصائيات_فيديو(فيديو);
    ارجع إحصائيات;
}


