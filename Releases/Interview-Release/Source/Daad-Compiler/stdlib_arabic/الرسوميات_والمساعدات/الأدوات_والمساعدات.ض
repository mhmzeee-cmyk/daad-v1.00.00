// الحجم
دالة مساحة_النافذة() -> صحيح[] {
    صحيح[] حجم=[];
    حجم=حجم_الشاشة();
    ارجع حجم;
}

// المؤشر
دالة مؤشر_الفأرة() -> صحيح[] {
    صحيح[] مؤشر=[];
    مؤشر=مؤشر_فأرة();
    ارجع مؤشر;
}

// تحريك
دالة  تحريك_المؤشر(x صحيح,y صحيح) {
    تحريك_مؤشر(x,y);
}

// نقر
دالة نقر_الفأرة(صحيح نوع) {
    نقر_فأرة(نوع);
}

// اللوحة
دالة لوحة_المفاتيح([]) -> صحيح[] {
    صحيح[] لوحة=[];
    لوحة=لوحة_مفاتيح();
    ارجع لوحة;
}

// الحافظة
دالة clipboard() -> صحيح {
    نص حافظة="";
    حافظة=clipboard();
    ارجع حافظة;
}

// تعيين الحافظة
دالة عيّن_clipboard(نص نص) {
    عيّن_clipboard(نص);
}

// تشغيل صوت
دالة صوت(مسار نص) -> صحيح {
    صوت(مسار);
    ارجع صحيحاً;
}

// إيقاف
دالة إيقاف_صوت() {
    إيقاف_صوت();
}

// إشعار
دالة إشعاع(عنوان نص,رسالة نص) -> صحيح {
    إشعار(عنوان,رسالة);
    ارجع صحيحاً;
}


