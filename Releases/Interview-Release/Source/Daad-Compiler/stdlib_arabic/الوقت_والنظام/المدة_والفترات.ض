// ض مكتبة: المدة_والفترات
// الفئة: الوقت_والنظام
// الوصف: المدة والفترات

// مدة من ثواني
دالة إنشاء_مدة(ثانية صحيح) -> صحيح {
    صحيح مدة=0;
    مدة=إنشاء_مدة(ثانية);
    ارجع مدة;
}

// مدة بالميلي
دالة مدة_بـms(ms صحيح) -> صحيح {
    صحيح مدة=0;
    مدة=إنشاء_مدة_ms(ms);
    ارجع مدة;
}

// بالثواني
دالة  ثوانٍ_المدة(مدة صحيح) -> صحيح {
    صحيح ثوانٍ=0;
    ثوانٍ=مدة_ثوانٍ(مدة);
    ارجع ثوانٍ;
}

// بالميلي
دالة  ms_المدة(مدة صحيح) -> صحيح {
    صحيح ms=0;
    ms=مدة_ms(مدة);
    ارجع ms;
}

// جمع
دالة جمع_المدات(مدة a,مدة b) -> صحيح {
    صحيح نتيجة=0;
    نتيجة=جمع_مدات(a,b);
    ارجع نتيجة;
}

// طرح
دالة طرح_المدات(مدة a,مدة b) -> صحيح {
    صحيح نتيجة=0;
    نتيجة=طرح_مدات(a,b);
    ارجع نتيجة;
}

// مقارنة
دالة مقارنة_المدات(مدة a,مدة b) -> صحيح {
    صحيح نتيجة=0;
    نتيجة=مقارنة_مدات(a,b);
    ارجع نتيجة;
}

// هل صفرية؟
دالة المدة_الصفرية(مدة صحيح) -> صحيح {
    صحيح نعم=0;
    إذا(صفرية(مدة)==1){ نعم=1; }
    ارجع نعم;
}

// تنسيق
دالة نسّق_المدة(مدة صحيح) -> صحيح {
    صحيح منسق=تنسيق_مدة(مدة);
    ارجع منسق;
}

// مضاعفة
دالة مضاعفة_المدة(مدة صحيح,صحيح عدد) -> صحيح {
    صحيح نتيجة=0;
    نتيجة=مضاعفة(مدة,عدد);
    ارجع نتيجة;
}


