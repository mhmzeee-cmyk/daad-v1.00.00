// هل رقم؟
دالة رقم_صحيح(نص s) -> صحيح {
    صحيح نعم=0;
    إذا(أرقام(s)==1){ نعم=1; }
    ارجع نعم;
}

// هل حرف؟
دالة حرف_صحيح(نص s) -> صحيح {
    صحيح نعم=0;
    إذا(طول(s)==1){ نعم=1; }
    ارجع نعم;
}

// هل بريد؟
دالة بريد_صحيح(نص s) -> صحيح {
    صحيح نعم=0;
