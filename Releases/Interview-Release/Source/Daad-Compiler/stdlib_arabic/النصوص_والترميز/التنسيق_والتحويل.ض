// ض مكتبة: التنسيق_والتحويل
// الفئة: النصوص_والترميز
// الوصف: تنسيق النصوص

// تنسيق بقالب
دالة نسّق(قالب نص,قيم نص[]) -> صحيح {
    نص نتيجة=تطبيق(قالب,قيم);
    ارجع نتيجة;
}

// تحويل صحيح
دالة صحيح_لنص(صحيح قيمة) -> صحيح {
    صحيح نتيجة=تحويل_نص(قيمة);
    ارجع نتيجة;
}

// تحويل عشري
دالة عشري_لنص(عشري قيمة) -> صحيح {
    صحيح نتيجة=تحويل_نص_عشري(قيمة);
    ارجع نتيجة;
}

// تحويل منطقي
دالة منطقي_لنص(صحيح قيمة) -> صحيح {
    صحيح نتيجة=0;
    إذا(قيمة==1){ نتيجة=1; }
    ارجع نتيجة;
}

// نص لصحيح
دالة نص_لصحيح(نص s) -> صحيح {
    صحيح نتيجة=تحويل_صحيح(s);
    ارجع نتيجة;
}

// نص لعشري
دالة نص_لعشري(نص s) -> عشري {
    عشري نتيجة=تحويل_عشري(s);
    ارجع نتيجة;
}

// تنسيق رقم
دالة نسّق_رقم(رقم صحيح,خانات صحيح) -> صحيح {
    صحيح نتيجة=تنسيق(رقم,خانات);
    ارجع نتيجة;
}

// للسداسي
دالة تحويل_ست_عشري(صحيح رقم) -> صحيح {
    صحيح نتيجة=إلى_سداسي(رقم);
    ارجع نتيجة;
}

// من السداسي
دالة من_ست_عشري(نص s) -> صحيح {
    صحيح نتيجة=من_سداسي(s);
    ارجع نتيجة;
}

// طول بترميز
دالة طول_بـ(نص s,ترميز نص) -> صحيح {
    صحيح عدد=طول_ترميز(s,ترميز);
    ارجع عدد;
}


