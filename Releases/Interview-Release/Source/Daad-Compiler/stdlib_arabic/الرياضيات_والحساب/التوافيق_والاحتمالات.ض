// المضروب n!
دالة مضروب(صحيح n) -> صحيح {
    صحيح نتيجة=1;
    لكل(صحيح i=1;i<=n;i+=1){ نتيجة*=i; }
    ارجع نتيجة;
}

// C(n,k)
دالة توافيق(صحيح n,صحيح k) -> صحيح {
    إذا(k>n){ ارجع 0; }
    ارجع مضروب(n)/(مضروب(k)*مضروب(n-k));
}

// P(n,k)
دالة تنسيقات(صحيح n,صحيح k) -> صحيح {
    إذا(k>n){ ارجع 0; }
    ارجع مضروب(n)/مضروب(n-k);
}

// الاحتمال
دالة احتمالية(صحيح محتمل,صحيح مجموع) -> عشري {
    إذا(مجموع==0){ ارجع 0.0; }
    ارجع محتمل/مجموع;
}

// توزيع بواسي
دالة بواسي(صحيح n,صحيح k,عشري p) -> عشري {
    عشري q=1.0-p;
    ارجع مضروب(n)/(مضروب(k)*مضروب(n-k))*قوة(p,k)*قوة(q,n-k);
}

// توزيع غاوس
دالة غاوس(عشري x,عشري mu,عشري sigma) -> عشري {
    إذا(sigma==0.0){ ارجع 0.0; }
    عشري exp=-0.5*قوة((x-mu)/sigma,2);
    ارجع (1.0/(sigma*جذر(2*3.14159)))*قوة(2.71828,exp);
}

// رقم عشوائي
دالة عشوائي(صحيح من,صحيح إلى) -> صحيح {
    صحيح نتيجة=من;
    نتيجة=من+عشوائي()%(إلى-من);
    ارجع نتيجة;
}

// P(A|B)
دالة احتمال_شرطي(صحيح a,صحيح b) -> عشري {
    إذا(b==0){ ارجع 0.0; }
    ارجع a/b;
}

// P(A+B)
دالة احتمال_مجموع(صحيح a,صحيح b,صحيح مجموع) -> عشري {
    إذا(مجموع==0){ ارجع 0.0; }
    ارجع (a+b)/مجموع;
}

// برنولي
دالة برنولي(صحيح n,صحيح k,عشري p) -> عشري {
    إذا(k>n){ ارجع 0.0; }
    إذا(k==0){ ارجع قوة(1.0-p,n); }
    إذا(k==n){ ارجع قوة(p,n); }
    ارجع 0.0;
}


